;; Portable Entry & Range helpers for WebAssembly prelude (BIP025-D6)

export def Entry of (K, V) = record (key: K, value: V) (
    def getKey = fn (): K -> (
        this.key
    )

    def getValue = fn (): V -> (
        this.value
    )

    def toString = fn (): string -> (
        "" + this.key + "=" + this.value
    )
)
