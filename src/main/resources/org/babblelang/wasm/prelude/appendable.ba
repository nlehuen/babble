;; Portable output-sink contract & string buffer for WebAssembly targets (BIP025-D12)

export def Appendable = interface (
    def append: fn mut (s: string): any?
)

export def StringBuffer = class () implements Appendable (
    private def buf: string = ""

    def append = fn mut (s: string): StringBuffer -> (
        this.buf += s
        this
    )

    def toString = fn (): string -> (
        this.buf
    )

    def length = fn (): int -> (
        this.buf.length()
    )

    def clear = fn mut () -> (
        this.buf = ""
    )
)
