;; Curated axioms for java.util (BIP019-I4, I6, BIP030-I2)

axiom java.util.AbstractMap.SimpleEntry of (K, V): class (
) static (
    def new: fn shared
)

axiom java.util.AbstractMap.SimpleImmutableEntry of (K, V): class (
) static (
    def new: fn shared
)

axiom java.util.ArrayDeque of E: class (
) static (
    def new: fn shared
)

axiom java.util.ArrayList of E: class (
) static (
    def new: fn shared
)

axiom java.util.Arrays: class (
) static (
    def asList: fn of T ... (a: (array of T)!): (java.util.List of T)!
    def copyOf: fn ... (original: (array of byte)!, newLength: int): (array of byte)!
    def copyOf: fn ... (original: (array of char)!, newLength: int): (array of char)!
    def copyOf: fn ... (original: (array of double)!, newLength: int): (array of double)!
    def copyOf: fn ... (original: (array of float)!, newLength: int): (array of float)!
    def copyOf: fn ... (original: (array of int)!, newLength: int): (array of int)!
    def copyOf: fn ... (original: (array of long)!, newLength: int): (array of long)!
    def copyOf: fn of T ... (original: (array of T?)!, newLength: int): (array of T?)!
    def copyOf: fn ... (original: (array of short)!, newLength: int): (array of short)!
    def copyOf: fn ... (original: (array of bool)!, newLength: int): (array of bool)!
    def copyOfRange: fn of T ... (original: (array of T?)!, from: int, to: int): (array of T?)!
    def stream: fn ... (arr: (array of double)!): java.util.stream.DoubleStream!
    def stream: fn ... (arr: (array of int)!): java.util.stream.IntStream!
    def stream: fn ... (arr: (array of long)!): java.util.stream.LongStream!
    def stream: fn of T ... (arr: (array of T)!): (java.util.stream.Stream of T)!
    def toString: fn ... (a: (array of byte)?): string!
    def toString: fn ... (a: (array of char)?): string!
    def toString: fn ... (a: (array of double)?): string!
    def toString: fn ... (a: (array of float)?): string!
    def toString: fn ... (a: (array of int)?): string!
    def toString: fn ... (a: (array of long)?): string!
    def toString: fn ... (a: (array of any?)?): string!
    def toString: fn ... (a: (array of short)?): string!
    def toString: fn ... (a: (array of bool)?): string!
)

;; QUESTIONABLE : assumes every Collection implementation obeys core collection effects
axiom java.util.Collection of E: class notnull (
    def add: fn mut shared shallow (shared e: E): bool
    def addAll: fn mut shared shallow (c: (java.util.Collection of E)!): bool
    def clear: fn mut shared shallow (): void
    def contains: fn (o: any?): bool
    def equals: fn (o: any?): bool
    def hashCode: fn (): int
    def isEmpty: fn nothrow (): bool
    def iterator: fn shared nothrow view (): (java.util.Iterator of E)!
    def remove: fn mut shared shallow (o: any?): bool
    def removeAll: fn mut shared shallow (c: (java.util.Collection of any?)!): bool
    def retainAll: fn mut shared shallow (c: (java.util.Collection of any?)!): bool
    def size: fn nothrow (): int
    ;; Elements may be null (a collection of nullable elements, or the null written after the last
    ;; element when the argument array is longer)
    def toArray: fn ... (): (array of any?)!
    def toArray: fn of T ... (generator: (java.util.function.IntFunction of ((array of T?)!))!): (array of T?)!
    def toArray: fn of T ... (a: (array of T?)!): (array of T?)!
    def toString: fn (): string!
)

axiom java.util.Collections: class (
) static (
    def emptyEnumeration: fn of T ... : (java.util.Enumeration of T)!
    def emptyIterator: fn of T ... : (java.util.Iterator of T)!
    def emptyList: fn of T ... : (java.util.List of T)!
    def emptyListIterator: fn of T ... : (java.util.ListIterator of T)!
    def emptyMap: fn of (K, V) ... : java.util.Map of (K, V)!
    def emptyNavigableMap: fn of (K, V) ... : java.util.NavigableMap of (K, V)!
    def emptyNavigableSet: fn of T ... : (java.util.NavigableSet of T)!
    def emptySet: fn of T ... : (java.util.Set of T)!
    def emptySortedMap: fn of (K, V) ... : java.util.SortedMap of (K, V)!
    def emptySortedSet: fn of T ... : (java.util.SortedSet of T)!
    def nCopies: fn of T ... (n: int, o: T): (java.util.List of T)!
    def reverseOrder: fn of T ... (): (java.util.Comparator of T)!
    def reverseOrder: fn of T ... (cmp: (java.util.Comparator of T)?): (java.util.Comparator of T)!
    def singleton: fn of T ... (o: T): (java.util.Set of T)!
    def singletonList: fn of T ... (o: T): (java.util.List of T)!
    def singletonMap: fn of (K, V) ... (key: K, value: V): java.util.Map of (K, V)!
    def synchronizedCollection: fn of T ... (c: (java.util.Collection of T)!): (java.util.Collection of T)!
    def synchronizedList: fn of T ... (xs: (java.util.List of T)!): (java.util.List of T)!
    def synchronizedMap: fn of (K, V) ... (m: java.util.Map of (K, V)!): java.util.Map of (K, V)!
    def synchronizedSet: fn of T ... (s: (java.util.Set of T)!): (java.util.Set of T)!
    def unmodifiableCollection: fn of T ... (c: (java.util.Collection of T)!): (java.util.Collection of T)!
    def unmodifiableList: fn of T ... (xs: (java.util.List of T)!): (java.util.List of T)!
    def unmodifiableMap: fn of (K, V) ... (m: java.util.Map of (K, V)!): java.util.Map of (K, V)!
    def unmodifiableSet: fn of T ... (s: (java.util.Set of T)!): (java.util.Set of T)!
    def unmodifiableSortedMap: fn of (K, V) ... (m: java.util.SortedMap of (K, V)!): java.util.SortedMap of (K, V)!
    def unmodifiableSortedSet: fn of T ... (s: (java.util.SortedSet of T)!): (java.util.SortedSet of T)!
)

;; QUESTIONABLE : assumes every Comparator.compare implementation is pure
axiom java.util.Comparator of T: class notnull (
    def compare: fn (o1: T, o2: T): int
)

axiom java.util.Deque of E: class notnull (
    def peekFirst: fn (): E?
    def peekLast: fn (): E?
    def pollFirst: fn mut (): E?
    def pollLast: fn mut (): E?
)

axiom java.util.HashMap of (K, V): class (
) static (
    def new: fn shared
)

axiom java.util.HashSet of E: class (
) static (
    def new: fn shared
)

;; QUESTIONABLE : assumes every Iterator implementation obeys core iterator effects
axiom java.util.Iterator of E: class notnull (
    def hasNext: fn nothrow (): bool
    def next: fn mut shallow (): E
    def remove: fn mut shared (): void
)

axiom java.util.LinkedHashMap of (K, V): class (
) static (
    def new: fn shared
)

axiom java.util.LinkedHashSet of E: class (
) static (
    def new: fn shared
)

axiom java.util.LinkedList of E: class (
) static (
    def new: fn shared
)

;; QUESTIONABLE : assumes every List implementation obeys core list effects
axiom java.util.List of E: class notnull (
    def add: fn mut shared shallow (index: int, shared element: E): void
    def addAll: fn mut shared shallow (index: int, c: (java.util.Collection of E)!): bool
    def get: fn (index: int): E
    def indexOf: fn (o: any?): int
    def lastIndexOf: fn (o: any?): int
    def listIterator: fn view (): (java.util.ListIterator of E)!
    def listIterator: fn view (index: int): (java.util.ListIterator of E)!
    def remove: fn mut shared shallow (index: int): E
    def replaceAll: fn mut shared shallow (operator: (java.util.function.UnaryOperator of E)!): void
    def reversed: fn nothrow view (): (java.util.List of E)!
    def set: fn mut shared shallow (index: int, shared element: E): E
    def sort: fn mut shared shallow (c: (java.util.Comparator of E)?): void
    def subList: fn view (fromIndex: int, toIndex: int): (java.util.List of E)!
)

;; QUESTIONABLE : assumes every ListIterator implementation obeys core iterator effects
axiom java.util.ListIterator of E: class notnull (
    def add: fn mut shared (shared e: E): void
    def hasPrevious: fn nothrow (): bool
    def set: fn mut shared (shared e: E): void
)

;; QUESTIONABLE : assumes every Map implementation obeys core map effects
axiom java.util.Map of (K, V): class notnull (
    def clear: fn mut shared shallow (): void
    def compute: fn ... (key: K, remappingFunction: java.util.function.BiFunction of (K, V?, V?)!): V?
    def computeIfAbsent: fn ... (key: K, mappingFunction: java.util.function.Function of (K, V)!): V?
    def computeIfPresent: fn ... (key: K, remappingFunction: java.util.function.BiFunction of (K, V, V?)!): V?
    def containsKey: fn (key: any?): bool
    def containsValue: fn (value: any?): bool
    def entrySet: fn nothrow view (): java.util.Set of (java.util.Map.Entry of (K, V)!)!
    def equals: fn (o: any?): bool
    def get: fn (key: any?): V?
    def getOrDefault: fn (key: any?, defaultValue: V): V
    def hashCode: fn (): int
    def isEmpty: fn nothrow (): bool
    def keySet: fn nothrow view (): (java.util.Set of K)!
    def merge: fn ... (key: K, value: V, remappingFunction: java.util.function.BiFunction of (V, V, V?)!): V?
    def put: fn mut shared shallow (shared key: K, shared value: V): V?
    def putAll: fn mut shared shallow (m: java.util.Map of (K, V)!): void
    def putIfAbsent: fn mut shared shallow (shared key: K, shared value: V): V?
    def remove: fn mut shared shallow (key: any?): V?
    def remove: fn mut shared shallow (key: any?, value: any?): bool
    def replace: fn mut shared shallow (shared key: K, shared value: V): V?
    def replace: fn mut shared shallow (shared key: K, oldValue: V, shared newValue: V): bool
    def replaceAll: fn mut shared shallow (function: java.util.function.BiFunction of (K, V, V)!): void
    def size: fn nothrow (): int
    def toString: fn (): string!
    def values: fn nothrow view (): (java.util.Collection of V)!
)

axiom java.util.Map.Entry of (K, V): class notnull (
    def equals: fn (o: any?): bool
    def getKey: fn nothrow (): K
    def getValue: fn nothrow (): V
    def hashCode: fn (): int
    def setValue: fn mut shared shallow (shared value: V): V
    def toString: fn (): string!
)

axiom java.util.NavigableMap of (K, V): class notnull (
    def ceilingEntry: fn ... (key: K): (java.util.Map.Entry of (K, V))?
    def ceilingKey: fn ... (key: K): K?
    def descendingMap: fn nothrow view (): java.util.NavigableMap of (K, V)!
    def firstEntry: fn ... : (java.util.Map.Entry of (K, V))?
    def floorEntry: fn ... (key: K): (java.util.Map.Entry of (K, V))?
    def floorKey: fn ... (key: K): K?
    def headMap: fn view (toKey: K, inclusive: bool): java.util.NavigableMap of (K, V)!
    def higherEntry: fn ... (key: K): (java.util.Map.Entry of (K, V))?
    def higherKey: fn ... (key: K): K?
    def lastEntry: fn ... : (java.util.Map.Entry of (K, V))?
    def lowerEntry: fn ... (key: K): (java.util.Map.Entry of (K, V))?
    def lowerKey: fn ... (key: K): K?
    def pollFirstEntry: fn ... : (java.util.Map.Entry of (K, V))?
    def pollLastEntry: fn ... : (java.util.Map.Entry of (K, V))?
    def subMap: fn view (fromKey: K, fromInclusive: bool, toKey: K, toInclusive: bool): java.util.NavigableMap of (K, V)!
    def tailMap: fn view (fromKey: K, inclusive: bool): java.util.NavigableMap of (K, V)!
)

axiom java.util.NavigableSet of E: class notnull (
    def ceiling: fn ... (e: E): E?
    def descendingSet: fn nothrow view (): (java.util.NavigableSet of E)!
    def floor: fn ... (e: E): E?
    def headSet: fn view (toElement: E, inclusive: bool): (java.util.NavigableSet of E)!
    def higher: fn ... (e: E): E?
    def lower: fn ... (e: E): E?
    def pollFirst: fn ... : E?
    def pollLast: fn ... : E?
    def subSet: fn view (fromElement: E, fromInclusive: bool, toElement: E, toInclusive: bool): (java.util.NavigableSet of E)!
    def tailSet: fn view (fromElement: E, inclusive: bool): (java.util.NavigableSet of E)!
)

axiom java.util.Optional of T: class notnull immutable (
    def get: fn ... : T!
    def orElse: fn ... (other: T): T
    def orElseThrow: fn ... : T!
) static (
    def of: fn of T ... (value: T!): (java.util.Optional of T)!
    def ofNullable: fn of T ... (value: T?): (java.util.Optional of T)!
)

axiom java.util.PriorityQueue of E: class (
) static (
    def new: fn shared
)

axiom java.util.Queue of E: class notnull (
    def element: fn (): E
    def peek: fn (): E?
    def poll: fn mut (): E?
)

axiom java.util.SequencedCollection of E: class notnull (
    def addFirst: fn mut shared shallow (shared e: E): void
    def addLast: fn mut shared shallow (shared e: E): void
    def getFirst: fn (): E
    def getLast: fn (): E
    def removeFirst: fn mut shared shallow (): E
    def removeLast: fn mut shared shallow (): E
    def reversed: fn nothrow view (): (java.util.SequencedCollection of E)!
)

axiom java.util.SequencedMap of (K, V): class notnull (
    def putFirst: fn mut shared shallow (shared k: K, shared v: V): V?
    def putLast: fn mut shared shallow (shared k: K, shared v: V): V?
    def reversed: fn nothrow view (): java.util.SequencedMap of (K, V)!
)

axiom java.util.SortedMap of (K, V): class notnull (
    def comparator: fn nothrow (): (java.util.Comparator of K)?
    def firstKey: fn (): K
    def headMap: fn view (toKey: K): java.util.SortedMap of (K, V)!
    def lastKey: fn (): K
    def subMap: fn view (fromKey: K, toKey: K): java.util.SortedMap of (K, V)!
    def tailMap: fn view (fromKey: K): java.util.SortedMap of (K, V)!
)

axiom java.util.SortedSet of E: class notnull (
    def comparator: fn nothrow (): (java.util.Comparator of E)?
    def first: fn (): E
    def headSet: fn view (toElement: E): (java.util.SortedSet of E)!
    def last: fn (): E
    def subSet: fn view (fromElement: E, toElement: E): (java.util.SortedSet of E)!
    def tailSet: fn view (fromElement: E): (java.util.SortedSet of E)!
)

axiom java.util.StringTokenizer: class (
    def nextToken: fn ... (): string!
    def nextToken: fn ... (delim: string!): string!
)

axiom java.util.TreeMap of (K, V): class (
) static (
    def new: fn shared
)

axiom java.util.TreeSet of E: class (
) static (
