;; Curated axioms for java.lang (BIP019-I4, I5, I6, BIP030-I2)

axiom java.lang.Boolean: class notnull (
)

axiom java.lang.Byte: class notnull (
)

axiom java.lang.CharSequence: class notnull (
)

axiom java.lang.Character: class notnull (
)

axiom java.lang.Class of T: class (
    def getCanonicalName: fn nothrow (): string?
    def getName: fn nothrow (): string!
    def getSimpleName: fn nothrow (): string!
) static (
    def forName: fn ... (className: string!): (java.lang.Class of any?)!
    def forName: fn ... (name: string!, initialize: bool, loader: java.lang.ClassLoader?): (java.lang.Class of any?)!
)

;; QUESTIONABLE : assumes every Comparable.compareTo implementation is pure
axiom java.lang.Comparable of T: class (
    def compareTo: fn (o: T): int
)

axiom java.lang.Double: class notnull (
) static (
    def doubleToRawLongBits: fn nothrow (value: double): long
    def longBitsToDouble: fn nothrow (bits: long): double
)

;; JFR : since JDK 22 the constructors read the mutable static Throwable.jfrTracing and, when Flight Recorder
;; traces exceptions, report the new Error to it (JDK-8319374, https://github.com/openjdk/jdk/commit/e8418972474d41c6cc1985df5c650461ded34313).
;; A program cannot observe that, so these keep the effects inferred without it (as on JDK 21).
axiom java.lang.Error: class (
) static (
    def new: fn nothrow fresh ()
    def new: fn nothrow (shared message: string?)
    def new: fn nothrow (shared message: string?, shared cause: java.lang.Throwable?)
)

axiom java.lang.Float: class notnull (
) static (
    def floatToRawIntBits: fn nothrow (value: float): int
    def intBitsToFloat: fn nothrow (bits: int): float
)

axiom java.lang.Integer: class notnull (
) static (
    def getInteger: fn ... (nm: string!): int?
    def getInteger: fn ... (nm: string!, val: int): java.lang.Integer!
    def getInteger: fn ... (nm: string!, val: int?): java.lang.Integer!
)

;; QUESTIONABLE : assumes every Iterable.iterator implementation is pure shared nothrow view
axiom java.lang.Iterable of T: class notnull (
    def iterator: fn shared nothrow view (): (java.util.Iterator of T)!
)

axiom java.lang.Long: class notnull (
) static (
    def getLong: fn ... (nm: string!): long?
    def getLong: fn ... (nm: string!, val: long): java.lang.Long!
    def getLong: fn ... (nm: string!, val: long?): java.lang.Long!
)

axiom java.lang.Math: class (
) static (
    def IEEEremainder: fn nothrow
    def abs: fn nothrow idempotent foldable
    def acos: fn nothrow foldable
    def asin: fn nothrow foldable
    def atan: fn nothrow foldable
    def atan2: fn nothrow foldable
    def cbrt: fn nothrow foldable
    def ceil: fn nothrow idempotent foldable
    def copySign: fn nothrow
    def cos: fn nothrow foldable
    def cosh: fn nothrow foldable
    def exp: fn nothrow foldable
    def expm1: fn nothrow
    def floor: fn nothrow idempotent foldable
    def fma: fn nothrow
    def hypot: fn nothrow foldable
    def log: fn nothrow foldable
    def log10: fn nothrow foldable
    def log1p: fn nothrow
    def max: fn nothrow foldable
    def min: fn nothrow foldable
    def nextDown: fn nothrow
    def nextUp: fn nothrow
    def pow: fn nothrow foldable
    def rint: fn nothrow idempotent foldable
    def round: fn nothrow foldable
    def scalb: fn nothrow
    def signum: fn nothrow foldable
    def sin: fn nothrow foldable
    def sinh: fn nothrow foldable
    def sqrt: fn nothrow foldable
    def tan: fn nothrow foldable
    def tanh: fn nothrow foldable
    def toDegrees: fn nothrow foldable
    def toRadians: fn nothrow foldable
    def ulp: fn nothrow
)

;; QUESTIONABLE : assumes Object's own hashCode and toString are pure volatile
axiom java.lang.Object: class exact (
    def getClass: fn nothrow (): (java.lang.Class of any?)!
    def hashCode: fn volatile (): int
    def toString: fn volatile (): string!
)

;; QUESTIONABLE : assumes every Object.equals implementation is pure
axiom java.lang.Object.equals: fn (obj: any?): bool

axiom java.lang.ProcessBuilder: class notnull (
)

axiom java.lang.Runtime: class (
) static (
    def getRuntime: fn ... : java.lang.Runtime!
)

axiom java.lang.Short: class notnull (
)

axiom java.lang.StrictMath: class (
) static (
    def IEEEremainder: fn nothrow
    def acos: fn nothrow
    def asin: fn nothrow
    def atan: fn nothrow
    def atan2: fn nothrow
    def cbrt: fn nothrow
    def cos: fn nothrow
    def cosh: fn nothrow
    def exp: fn nothrow
    def expm1: fn nothrow
    def hypot: fn nothrow
    def log: fn nothrow
    def log10: fn nothrow
    def log1p: fn nothrow
    def pow: fn nothrow
    def sin: fn nothrow
    def sinh: fn nothrow
    def sqrt: fn nothrow
    def tan: fn nothrow
    def tanh: fn nothrow
)

axiom java.lang.String: class notnull (
    def *: fn pure
    def compareTo: fn nothrow
    def compareToIgnoreCase: fn nothrow
    def concat: fn nothrow
    def contains: fn nothrow
    def contentEquals: fn nothrow
    def endsWith: fn nothrow
    def equals: fn nothrow (anObject: any?): bool
    def equalsIgnoreCase: fn nothrow (anotherString: string?): bool
    def formatted: fn (args: (array of any?)!): string!
    def hashCode: fn nothrow
    def indexOf: fn nothrow
    def isBlank: fn nothrow
    def isEmpty: fn nothrow foldable (): bool
    def lastIndexOf: fn nothrow
    def length: fn nothrow foldable (): int
    def replace: fn nothrow
    def startsWith: fn nothrow
    def strip: fn nothrow
    def stripLeading: fn nothrow
    def stripTrailing: fn nothrow
    def toLowerCase: fn nothrow
    def toString: fn nothrow
    def toUpperCase: fn nothrow
    def trim: fn nothrow idempotent foldable (): string!
) static (
    def *: fn pure
    def new: fn pure
    def format: fn (format: string!, args: (array of any?)!): string!
    def format: fn (l: java.util.Locale?, format: string!, args: (array of any?)!): string!
    def valueOf: fn (obj: any?): string!
)

axiom java.lang.StringBuffer: class notnull (
)

axiom java.lang.StringBuilder: class notnull (
)

axiom java.lang.System: class (
) static (
    def getProperty: fn io (key: string!): string?
    def getProperty: fn io (key: string!, defVal: string!): string!
    def getenv: fn io (): java.util.Map of (string!, string!)!
    def getenv: fn io (name: string!): string?
    def lineSeparator: fn volatile nothrow (): string!
)

axiom java.lang.Thread: class (
    def getName: fn ... : string!
    def getStackTrace: fn ... : (array of java.lang.StackTraceElement!)!
) static (
    def currentThread: fn ... : java.lang.Thread!
)

;; JFR : since JDK 22 the constructors read the mutable static jfrTracing and, when Flight Recorder traces
;; exceptions, report the new Throwable to it (JDK-8319374, https://github.com/openjdk/jdk/commit/e8418972474d41c6cc1985df5c650461ded34313).
;; A program cannot observe that, so these keep the effects inferred without it (as on JDK 21); new(cause) stays
;; inferred, since it calls cause.toString().
axiom java.lang.Throwable: class (
    def fillInStackTrace: fn mut nothrow (): java.lang.Throwable!
    def getStackTrace: fn volatile nothrow (): (array of java.lang.StackTraceElement!)!
    def getSuppressed: fn nothrow (): (array of java.lang.Throwable!)!
) static (
    def new: fn nothrow fresh ()
    def new: fn nothrow (shared message: string?)
    def new: fn nothrow (shared message: string?, shared cause: java.lang.Throwable?)
)
