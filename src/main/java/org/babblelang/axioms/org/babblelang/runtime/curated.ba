;; Curated axioms for org.babblelang.runtime (BIP031-I1)

axiom org.babblelang.runtime.CharRange: class notnull immutable (
    def contains: fn nothrow (value: any?): bool
    def containsChar: fn nothrow (value: char): bool
    def descending: fn nothrow (): bool
    def end: fn nothrow (): java.lang.Character!
    def endChar: fn nothrow (): char
    def equals: fn nothrow (obj: any?): bool
    def hashCode: fn nothrow (): int
    def inclusive: fn nothrow (): bool
    def isEmpty: fn nothrow (): bool
    def iterator: fn shared nothrow view (): (java.util.Iterator of java.lang.Character!)!
    def reversed: fn nothrow fresh (): org.babblelang.runtime.CharRange!
    def start: fn nothrow (): java.lang.Character!
    def startChar: fn nothrow (): char
    def step: fn nothrow (): int
    def step: fn fresh (k: int): org.babblelang.runtime.CharRange!
    def toString: fn nothrow (): string!
) static (
    def of: fn nothrow fresh (start: char, end: char, inclusive: bool): org.babblelang.runtime.CharRange!
    def of: fn fresh (start: char, end: char, inclusive: bool, step: int): org.babblelang.runtime.CharRange!
)

