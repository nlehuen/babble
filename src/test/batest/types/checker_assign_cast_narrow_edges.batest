{{{{{
;; Narrowing edges: is with Babble interfaces, Java interfaces, final/non-final classes, not/and/or, subtractType
def I1 = interface ( def a : fn () : int )
def I2 = interface ( def b : fn () : int )
def Both = class () implements I1, I2 (
    def a = fn () : int -> ( 1 )
    def b = fn () : int -> ( 2 )
)
def Only1 = class () implements I1 (
    def a = fn () : int -> ( 3 )
)
def testIface = fn (x : I1, obj : any?, u : int | double | string) : string -> (
    def r = ""
    if x is I2 then ( r += "" + x.b() ) else ( r += "no2" )
    if not (u is string) then (
        if u is int then ( r += ":i" ) else ( r += ":d" )
    ) else (
        r += ":" + u
    )
    if obj is java.lang.Runnable then ( r += ":run" )
    if obj is Both then ( r += ":both" )
    if not (obj == null) and obj is any then ( r += ":any" )
    r
)
println(testIface(Both(), Both(), 1), "|", testIface(Only1(), "s", 2.5))
}}}}}
2:i:both:any|no2:d:any

{{{{{
;; Impossible 'is' warnings / false branches
def testImp = fn (s : string) : bool -> ( s is int )
println(testImp("a"))
}}}}}
false

{{{{{
;; Reassignment join and intersectCompatibleFunctions (pure vs impure, mut param, borrow param, null/nullable, int->double)
def Box = class (def n : int) ()
def count = 0
def func = fn (x : int) : int -> ( x + 1 )
func = fn impure (x : int) : int -> ( count += 1 ; x + 2 )
def fnMut : fn (mut b : Box) : int = fn (borrow b : Box) : int -> ( b.n )
fnMut = fn (mut b : Box) : int -> ( b.n += 1 ; b.n )
def v : int? = null
v = 42
def w : int | double? = 3
w = null
w = 2.5
def pick = fn (flag : bool) -> (
    if flag then ( fn (x : int) : int -> ( x ) )
    else ( fn impure (x : int) : int -> ( count += 1 ; x ) )
)
def bx = Box(10)
println(func(1), ":", count, ":", fnMut(bx), ":", v, ":", w, ":", pick(true)(5), ":", pick(false)(5), ":", count)
}}}}}
3:1:11:42:2.5:5:5:2

