;; TypeChecker edge cases: casting, flow narrowing, reassignment joins, operators, compound assigns, members

{{{{{
;; canCast and alwaysIs across primitives, unions, interfaces, Java final/non-final classes
def dyn = fn (v : any?) : any? -> ( v )
def I1 = interface ( def a : fn () : int )
def I2 = interface ( def b : fn () : int )
def C = class () implements I1 ( def a = fn () : int -> ( 1 ) )
def cs : java.lang.CharSequence = java.lang.StringBuilder("abc")
def sb = cs as java.lang.StringBuilder
def u : int | string = 1
println(sb.toString(), ":", u as int | string, ":", (dyn(C()) as I1).a())
}}}}}
Warning : Redundant cast : int | string
abc:1:1

