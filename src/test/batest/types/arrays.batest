;; BIP020 array types, ArraySupport, BabbleObjects plain-class metadata, covariance, casts, effects, and generics

========== arr_mod.ba ==========
export def Ints = type array of int
export def Grid of T = type array of (array of T)
export def ModBag of T = class (def xs: array of T) ()
export def sumInts = fn (xs: Ints): int -> (
    def acc = 0
    for x in xs then (acc += x)
    acc
)

==========
def arrMod = import("arr_mod.ba")
def tests = import("org.babblelang.tests")

{{{{{
;; LARGE: legacy test pending refactoring
;; All 8 primitive arrays, reference arrays, creation, get/set/size, for, content equality/hash/string, cycle guard, NaN/-0.0
def bs = (array of byte)(2) ; bs.set(0, 3) ; bs.set(1, -1)
def ss = (array of short).of(10, 20)
def ints = array(from: list(1, 2, 3))
def ls = array.of(5L, 6L)
def fs = (array of float).of(1.5f, 2.5f)
def ds = (array of double)(from: ints)
def zs = (array of bool)(2) ; zs.set(1, true)
def cs = array.of('x', 'y')

def cyc: array of any? = array(2)
cyc.set(0, "self")
cyc.set(1, cyc)

def nestedObj: array of any? = array.of(null, array.of(1, 2), array.of("a", "b"))
def nan = 0.0 / 0.0
def fnan = 0.0f / 0.0f
def R = record (tag: string, xs: frozen array of int) ()
def r1 = R("k", freeze(array.of(1, 2)))
def r2 = R("k", freeze(array.of(1, 2)))

println(bs, ":", ss.get(1), ":", ints, ":", ls.get(0), ":", fs.get(0) + fs.get(1), ":", ds, ":", zs.get(1), ":", cs)
println(cyc, ":", nestedObj)
println(array.of(nan) == array.of(nan), ":", array.of(fnan) == array.of(fnan), ":", array.of(0.0) == array.of(-0.0), ":", array.of(0.0f) == array.of(-0.0f))
println(ints.equals(array.of(1, 2, 3)), ":", ints.hashCode() == array.of(1, 2, 3).hashCode(), ":", r1 == r2, ":", arrMod.sumInts(ints))
}}}}}
