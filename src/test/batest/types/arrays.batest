{{{{{
;; LARGE: legacy test pending refactoring
;; java.base parametric nullness & effect profiles (BigInteger, Stream, Optional, NavigableMap/Set, Collections, Arrays, String, LocalDate)
def bi = java.math.BigInteger.valueOf(12L)
def bi2 = java.math.BigInteger.valueOf(5L)
def biSum = bi.add(bi2).subtract(bi2).multiply(bi2).divide(bi2).remainder(bi2).mod(bi2).pow(2).abs().negate().negate()
def biBits = bi.min(bi2).max(bi).gcd(bi2).xor(bi2).shiftLeft(1).shiftRight(1)

def stList = java.util.stream.Stream.of(array.of("b", "a", "b", "c")).distinct().sorted().skip(1L).limit(2L).toList()
def stArr = java.util.stream.IntStream.range(1, 4).boxed().toArray()

def opt1 = java.util.Optional.of("ok")
def opt2: java.util.Optional of string? = java.util.Optional.ofNullable(null)
def opt3: java.util.Optional of string = java.util.Optional.empty()

def tm = (java.util.TreeMap of (string, int))()
tm.put("b", 2)
tm.putIfAbsent("a", 1)
tm.replace("b", 20)
tm.putAll(map(entry("c", 3)))
def tmSub = tm.headMap("c").tailMap("a").subMap("a", "c")

def ts = (java.util.TreeSet of string)()
ts.addAll(list("a", "b", "c"))
ts.retainAll(list("a", "b", "c"))
ts.removeAll(list("z"))
def tsSub = ts.headSet("c").tailSet("a").subSet("a", "c")

def c1: java.util.List of string = java.util.Collections.emptyList()
def c2 = java.util.Collections.singletonList("x")
def c3 = java.util.Collections.unmodifiableList(c2)
def c4 = java.util.Collections.synchronizedList(c2)
def c5 = java.util.Collections.nCopies(2, "y")
def c6: java.util.Comparator of string = java.util.Collections.reverseOrder()

def arrCopy = java.util.Arrays.copyOf(array.of(1, 2, 3), 2)
def arrRange = java.util.Arrays.copyOfRange(array.of(1, 2, 3), 1, 3)
def arrStr = java.util.Arrays.toString(arrCopy)
def arrCnt = java.util.Arrays.stream(arrCopy).count()

def s = "hello-world"
def sChecks = s.startsWith("he") and s.endsWith("ld") and s.contains("-") and s.matches("hello.*") and s.equalsIgnoreCase("HELLO-WORLD")
def sEdit = s.concat("!").replace("!", "?").replaceAll("\\?", "").replaceFirst("-", "_")
def sCmp = s.compareTo("hello") > 0 and s.compareToIgnoreCase("HELLO") > 0 and s.indexOf("-") == 5 and s.lastIndexOf("o") == 7

def ld = java.time.LocalDate.parse("2025-01-10").plusDays(2L).minusDays(1L).withDayOfMonth(15)
def sb = java.lang.StringBuilder("hi").append("!").toString()
def cb = java.nio.CharBuffer.wrap("ab").length()
def tok = java.util.StringTokenizer("first second").nextToken()
def hex = java.lang.Integer.toHexString(15) + ":" + java.lang.Integer.toBinaryString(2) + ":" + java.lang.Integer.toOctalString(8) + ":" + java.lang.Integer.toUnsignedString(9)

println(biSum, ":", biBits, ":", stList, ":", stArr.size(), ":", opt1.get(), ":", opt2.orElse("d"), ":", opt3.isEmpty())
println(tm.firstKey(), ":", tm.lastKey(), ":", tm.lowerKey("b"), ":", tm.floorKey("b"), ":", tm.ceilingKey("b"), ":", tm.higherKey("b"), ":", tm.getOrDefault("z", 9), ":", tmSub.size())
println(ts.first(), ":", ts.last(), ":", ts.lower("b"), ":", ts.floor("b"), ":", ts.ceiling("b"), ":", ts.higher("b"), ":", tsSub.size(), ":", c1.size() + c3.size() + c4.size() + c5.size(), ":", c6 != null)
println(arrStr, ":", arrRange, ":", arrCnt, ":", sChecks, ":", sEdit, ":", sCmp, ":", ld, ":", sb, ":", cb, ":", tok, ":", hex)
}}}}}
