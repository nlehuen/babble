{{{{{
;; Ownership & effects : unique array creation, pure helper mutating local array, freeze, frozen indexing
def buildSquares = fn (n: int): unique array of int -> (
    def out = (array of int)(n)
    def i = 0
    while i < n then (
        out.set(i, (i + 1) * (i + 1))
        i += 1
    )
    move(out)
)
def sq = freeze(buildSquares(4))
println(sq, ":", sq.get(2), ":", sq.size())
}}}}}
[1, 4, 9, 16]:9:4

{{{{{
;; Babble element arrays, exact-store covariance, ArrayStoreException parity
def Shape = interface (def area: fn (): int)
def Circle = class (def r: int) implements Shape (def area = fn (): int -> (this.r))
def Square = class (def s: int) implements Shape (def area = fn (): int -> (this.s))
def cs = array.of(Circle(3))
def shapes: array of Shape = cs
shapes.set(0, Square(4))
}}}}}
java.lang.ArrayStoreException: Square

{{{{{
;; Nested Babble array store check parity
def Circle = class (def r: int) ()
def Square = class (def s: int) ()
def mat = array.of(array.of(Circle(1)))
def anyRows: array of any = mat
anyRows.set(0, array.of(Square(2)))
}}}}}
java.lang.ArrayStoreException: array of Square

{{{{{
;; LARGE: legacy test pending refactoring
;; Generic reference-array helper, explicit of T, generic class/record, Java generic interface bridge & ArrayExportable default preservation
def first of T = fn io (a: array of T): T -> (a.get(0))
def Box of T = class (def items: array of T) (
    def head = fn io shared (): T -> (this.items.get(0))
)
def Upper = class () implements tests.JavaClassDemo.ArrayTransformer of string (
    def transform = fn io (a: array of string): array of string -> (
        array.of(a.get(0).toUpperCase(), a.get(1).toUpperCase())
    )
)
def Exp = class () implements tests.JavaClassDemo.ArrayExportable of string (
    def toArray = fn io (mut dst: array of string): array of string -> (
        if dst.size() >= 2 then (
            dst.set(0, "p")
            dst.set(1, "q")
            dst
        ) else (
            array.of("p", "q")
        )
    )
)
def ExpAny = class () implements tests.JavaClassDemo.ArrayExportable of string (
    def toArray = fn io (mut dst: array of any?): array of any? -> (
        dst.set(0, "p")
        dst
    )
)
def parts = "ab,cd".split(",")
def box = (Box of string)(parts)
def exp = Exp()
def expJava: tests.JavaClassDemo.ArrayExportable of string = ExpAny()
def sampleRes = tests.JavaClassDemo.echoArrayWithSample("fallback", null)
def asListRes = java.util.Arrays.asList(array.of("m", "n"))
println((first of string)(parts), ":", box.head(), ":", tests.JavaClassDemo.invokeArrayTransformer(Upper(), parts))
println(tests.JavaClassDemo.invokeExportableStrings(exp), ":", expJava.toArray(), ":", sampleRes, ":", asListRes)
}}}}}
ab:ab:[AB, CD]
[p, q]:2:fallback:[m, n]

