{{{{{
;; LARGE: legacy test pending refactoring
;; for-loop union/frozen/iterator/custom-iterable targets, entry/sortedset/sortedmap comparators, and nested/Java array covariance
def sumUnion = fn (seq: list of int | array of int): int -> (
    def s = 0
    for x in seq then (s += x)
    s
)
def sumJavaUnion = fn (seq: list of int | set of int): int -> (
    def s = 0
    for x in seq then (s += x)
    s
)
def frArr: frozen array of int = freeze(array.of(1, 2, 3))
def frList: frozen list of int = freeze(list(4, 5))
def frSum = 0
for x in frArr then (frSum += x)
for x in frList then (frSum += x)
def rawIt = list(10, 20).iterator()
for x in rawIt then (frSum += x)

def MyIter = class (def i: int = 0) (
    def hasNext = fn shared (): bool -> (this.i < 2)
    def next = fn mut (): int -> (this.i += 1 ; this.i)
)
def MySeq = class () (
    def iterator = fn (): MyIter -> (MyIter())
)
for x in MySeq() then (frSum += x)

def e1 = entry(value: 9, key: "k")
def e2 = (entry of (string, int))("m", 7)
def revInt = java.util.Comparator(fn (a: int, b: int): int -> (b - a))
def revStr = java.util.Comparator(fn (a: string, b: string): int -> (b.compareTo(a)))
def ssCmp1 = (sortedset of int)(comparator: revInt) ; ssCmp1.add(1) ; ssCmp1.add(3)
def ssCmp2 = (sortedset of int)(comparator: revInt, from: list(1, 3))
def smCmp1 = (sortedmap of (string, int))(comparator: revStr) ; smCmp1.put("a", 1) ; smCmp1.put("z", 2)
def smCmp2 = (sortedmap of (string, int))(comparator: revStr, from: map(entry("a", 1), entry("z", 2)))

def Circle = record (r: int) implements java.lang.Comparable of Circle (
    def compareTo = fn (o: Circle): int -> (this.r - o.r)
)
def cmpArr: array of (java.lang.Comparable of Circle) = array.of(Circle(5))
def cloneRef: java.lang.Cloneable = array.of(1, 2)

println(sumUnion(array.of(1, 2)), ":", sumUnion(list(3, 4)), ":", sumJavaUnion(list(5, 6)), ":", frSum)
println(e1.getKey(), ":", e2.getValue(), ":", ssCmp1.first(), ":", ssCmp2.first(), ":", smCmp1.firstKey(), ":", smCmp2.firstKey(), ":", cmpArr.size(), ":", cloneRef is array of int)
}}}}}
