{{{{{
;; LARGE: legacy test pending refactoring
;; Extended java.base nullability & effect overlays (Stream ops, Comparator, java.util.function, System, Runtime, Reflection, Regex)
def sEmpty: java.util.stream.Stream of string = java.util.stream.Stream.empty()
def sGen = java.util.stream.Stream.generate(fn (): string -> ("g")).limit(1L)
def sIter = java.util.stream.Stream.iterate("i", fn (x: string): string -> (x)).limit(1L)
def sCat = java.util.stream.Stream.concat(sGen, sIter).unordered().sequential()
def sFlat = sCat.flatMap(fn io (x: string): java.util.stream.Stream of string -> (java.util.stream.Stream.of(x))).takeWhile(fn (x: string): bool -> (x != "")).dropWhile(fn (x: string): bool -> (false)).findFirst()
def iStats = java.util.stream.IntStream.rangeClosed(1, 3).asLongStream().asDoubleStream().summaryStatistics()
def iAvg = java.util.stream.IntStream.range(1, 3).average()
def iMin = java.util.stream.IntStream.range(2, 5).min()
def iMax = java.util.stream.IntStream.range(2, 5).max()
def ssport = java.util.stream.StreamSupport.stream(list("s").spliterator(), false).findAny()

def natCmp: java.util.Comparator of string = java.util.Comparator.naturalOrder()
def nfCmp = java.util.Comparator.nullsFirst(natCmp)
def nlCmp = java.util.Comparator.nullsLast(natCmp)

def pBase = java.util.function.Predicate(fn (x: string): bool -> (x.length() > 1))
def pComb = pBase.negate().negate()
def pEq: java.util.function.Predicate of string = java.util.function.Predicate.isEqual("ab")
def fId: java.util.function.Function of (string, string) = java.util.function.Function.identity()
def fChain = fId.andThen(fId).compose(fId)
def minOp = java.util.function.BinaryOperator.minBy(natCmp)
def maxOp = java.util.function.BinaryOperator.maxBy(natCmp)

def sysSep = java.lang.System.lineSeparator().length() > 0
def sysProp = java.lang.System.getProperty("babble.nonexistent.key", "fallback")
def rtOk = java.lang.Runtime.getRuntime() != null
def swBuf = java.io.StringWriter().getBuffer().length()
def thName = java.lang.Thread.currentThread().getName().length() > 0
def clsName = java.lang.Class.forName("java.lang.String").getSimpleName()
def patOk = java.util.regex.Pattern.compile("a+").pattern()

println(sEmpty.count(), ":", sFlat.orElse("?"), ":", iStats.getCount(), ":", iAvg.isPresent(), ":", iMin.getAsInt(), ":", iMax.getAsInt(), ":", ssport.orElse("?"))
println(nfCmp.compare("a", "b") < 0, ":", nlCmp.compare("a", "b") < 0, ":", pComb.test("ab") and pEq.test("ab"), ":", fChain.apply("ok"), ":", minOp.apply("a", "b"), ":", maxOp.apply("a", "b"))
println(sysSep, ":", sysProp, ":", rtOk, ":", swBuf, ":", thName, ":", clsName, ":", patOk)
