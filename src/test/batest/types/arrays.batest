;; Core array types : creation, indexing, mutation, equality, stringification, covariance, nullability, casts, and errors
;; References : BIP020 (array types), BIP008 (nullable casts)

{{{{{
def bs = (array of byte)(2) ; bs.set(0, 3) ; bs.set(1, -1)
def ss = (array of short).of(10, 20)
def ints = array(from: list(1, 2, 3))
def ls = array.of(5L, 6L)
assert(string(bs) == "[3, -1]")
assert(ss.get(1) == 20)
assert(string(ints) == "[1, 2, 3]")
assert(ls.get(0) == 5L)
assert(ints.equals(array.of(1, 2, 3)))
assert(ints.hashCode() == array.of(1, 2, 3).hashCode())
}}}}}

{{{{{
def ints = array(from: list(1, 2, 3))
def fs = (array of float).of(1.5f, 2.5f)
def ds = (array of double)(from: ints)
def zs = (array of bool)(2) ; zs.set(1, true)
def cs = array.of('x', 'y')
assert(fs.get(0) + fs.get(1) == 4.0f)
assert(string(ds) == "[1.0, 2.0, 3.0]")
assert(zs.get(1))
assert(string(cs) == "[x, y]")
}}}}}

{{{{{
def cyc: array of any? = array(2)
cyc.set(0, "self")
cyc.set(1, cyc)
def nested: array of any? = array.of(null, array.of(1, 2), array.of("a", "b"))
assert(string(cyc) == "[self, [...]]")
assert(string(nested) == "[null, [1, 2], [a, b]]")
}}}}}

{{{{{
;; Array equality follows java.util.Arrays.equals : NaN == NaN, 0.0 != -0.0
def nan = 0.0 / 0.0
def fnan = 0.0f / 0.0f
assert(array.of(nan) == array.of(nan))
assert(array.of(fnan) == array.of(fnan))
assert(array.of(0.0) != array.of(-0.0))
assert(array.of(0.0f) != array.of(-0.0f))
}}}}}

{{{{{
def b1 = (array of byte).of(1, 2) ; def b2 = (array of byte).of(1, 2) ; def b3 = (array of byte).of(1, 3)
def s1 = (array of short).of(4, 5) ; def s2 = (array of short).of(4, 5)
def l1 = array.of(7L, 8L) ; def l2 = array.of(7L, 8L)
assert(b1 == b2 and b1 != b3 and s1 == s2 and l1 == l2)
assert(b1.hashCode() == b2.hashCode() and s1.hashCode() == s2.hashCode() and l1.hashCode() == l2.hashCode())
}}}}}

{{{{{
def f1 = array.of(1.25f, 2.5f) ; def f2 = array.of(1.25f, 2.5f)
def d1 = array.of(1.5, 2.5) ; def d2 = array.of(1.5, 2.5)
assert(f1 == f2 and d1 == d2)
assert(f1.hashCode() == f2.hashCode() and d1.hashCode() == d2.hashCode())
}}}}}

{{{{{
def z1 = array.of(true, false) ; def z2 = array.of(true, false)
def c1 = array.of('a', 'b') ; def c2 = array.of('a', 'b')
assert(z1 == z2 and c1 == c2)
assert(z1.hashCode() == z2.hashCode() and c1.hashCode() == c2.hashCode())
}}}}}

{{{{{
def o1 = array.of("x", "y") ; def o2 = array.of("x", "y")
def o3 = array.of("x") ; def o4 = array.of("x", "z")
def optArr: (array of string)? = null
assert(o1 == o1)
assert(o1 == o2)
assert(o1 != o3)
assert(o1 != o4)
assert(o1 != optArr)
assert(o1.hashCode() == o2.hashCode())
}}}}}

{{{{{
def Circle = record (r: int) ()
def optCircles = (array of Circle?)(2)
optCircles.set(1, Circle(9))
def fromList = (array of Circle)(from: list(Circle(1), Circle(2)))
def fromArr = (array of Circle)(from: fromList)
assert(string(optCircles) == "[null, Circle(r: 9)]")
assert(fromList == fromArr)
}}}}}

{{{{{
def CountIter = class (def max: int) implements java.lang.Iterable of int (
    def iterator = fn shared (): java.util.Iterator of int -> (list(10, 20).iterator())
)
assert(string((array of int)(from: CountIter(2))) == "[10, 20]")
}}}}}

{{{{{
def bList = list(byte(1), byte(2))
def wShort = (array of short?)(from: bList)
def wInt = (array of int?)(from: bList)
def wLong = (array of long?)(from: list(3, 4))
def wFloat = (array of float?)(from: list(5, 6))
def wDouble = (array of double?)(from: list(7, 8))
assert(wShort.get(0) == short(1) and wInt.get(1) == 2 and wLong.get(0) == 3L)
assert(wFloat.get(1) == 6.0f and wDouble.get(0) == 7.0)
}}}}}

{{{{{
;; Non-null array element checks are erased to String[] at runtime and emit Unchecked cast warnings
def raw1: any = array.of("hi", "there")
def raw2: any = (array of string?)(2)
raw2 as array of string?
def c1 = raw1 as array of string
def c2 = raw2 as array of string?
assert(raw1 is array of string)
assert(raw2 is array of string)
assert(raw2 is array of string?)
assert(c1.get(0) == "hi")
assert(c2.size() == 2)
}}}}}
Warning : Unchecked cast : array of string
Warning : Unchecked cast : array of string
Warning : Unchecked cast : array of string

{{{{{
def Shape = interface (def area: fn (): int)
def Circle = class (def r: int) implements Shape (def area = fn (): int -> (this.r))
def Square = class (def s: int) implements Shape (def area = fn (): int -> (this.s))
def cs = array.of(Circle(3))
def shapes: array of Shape = cs
shapes.set(0, Square(4))
}}}}}
java.lang.ArrayStoreException: Square

{{{{{
def Circle = class (def r: int) ()
def Square = class (def s: int) ()
def mat = array.of(array.of(Circle(1)))
def anyRows: array of any = mat
anyRows.set(0, array.of(Square(2)))
}}}}}
java.lang.ArrayStoreException: array of Square

{{{{{
def Circle = record (r: int) implements java.lang.Comparable of Circle (
    def compareTo = fn (o: Circle): int -> (this.r - o.r)
)
def cmpArr: array of (java.lang.Comparable of Circle) = array.of(Circle(5))
def cloneRef: java.lang.Cloneable = array.of(1, 2)
assert(cmpArr.size() == 1)
assert(cloneRef is array of int)
}}}}}

{{{{{
array.of(1, 2).length
}}}}}
No such name in array of int : length (use size())

{{{{{
(array of string)(2)
}}}}}
No default element : array of string has non-null elements

{{{{{
(array of int)(-1)
}}}}}
java.lang.NegativeArraySizeException: -1

{{{{{
array.of(1, 2).get(5)
}}}}}
java.lang.ArrayIndexOutOfBoundsException: Index 5 out of bounds for length 2
