;; BIP009-P4 Batch 4c: targeted Shared Runtime & Shared Front-End coverage closures

========== fe_mod_b.ba ==========
export def IB = interface (
    def id : fn () : int
)
export def DupB = class (def v : int) ()

========== fe_mod_a.ba ==========
export def sub = import("fe_mod_b.ba")
export def IA = interface (
    def get : fn () : int
)

{{{{{
;; Implicit names (int, double, STDOUT, javax) and ClassofFunction (String instance)
def c = javax.swing.SwingConstants.CENTER
def s = java.lang.String.valueOf(true)
println(int, ":", double, ":", STDOUT != null, ":", s, ":", c, ":", classof("hi"))
}}}}}
int:double:true:true:0:java.lang.String

{{{{{
;; ClassofFunction error on JavaPackage and JavaClass
def u = import("java.util")
println(classof(u))
}}}}}
classof : a package has no class

{{{{{
;; Types.decodeComponent (%2C), Types.JavaClassType.accepts, Types.UnionType
def fnOpt : (fn (a : int, b : int) : int)? = fn (a : int, b : int) : int -> ( a + b )
def optVal : (fn (a : int, b : int) : int)? = null
def f = fnOpt
def rAny : any = fn () -> ( () )
def r : java.lang.Runnable = rAny as java.lang.Runnable
r.run()
println(f != null, ":", optVal == null)
}}}}}
true:true

{{{{{
;; BabbleInterface.extendsType, BabbleClass.implementsType, BabbleInstance.equals, BabbleInterface.findDefault, value class toString
def IParent = interface (
    def p = fn () : int -> ( 42 )
)
def IChild = interface extends IParent, java.lang.Runnable (
    def c : fn () : int
)
def IOther = interface (
    def o : fn () : int
)
def Impl = class (private def secret : int = 7, def pub : int = 3) implements IChild (
    def run = fn () -> ( () )
    def c = fn () : int -> ( super.p() )
)
def Val = record (x : int) ()
def Diff = class (def pub : int = 3) ()
def inst = Impl()
def a : any = inst
def d : any = Diff()
println(a is IChild, ":", a is IParent, ":", a is java.lang.Runnable, ":", a is IOther, ":", a == inst, ":", a == d, ":", inst.c(), ":", Val(3))
}}}}}
true:true:true:false:true:false:42:Val(x: 3)

{{{{{
;; Supers with Java default method (Comparator.reversed)
def MyCmp = class (def sign : int) implements java.util.Comparator of java.awt.Point (
    def compare = fn (a : java.awt.Point, b : java.awt.Point) : int -> ( (a.x - b.x) * this.sign )
    def makeRev = fn io shared () -> ( super.reversed() )
)
def mc = MyCmp(1)
def p1 = java.awt.Point(1, 0)
def p2 = java.awt.Point(3, 0)
println(mc.compare(p1, p2) < 0, ":", mc.makeRev().compare(p1, p2) > 0)
}}}}}
true:true

{{{{{
;; JavaTypes.checkParameter across Double, Boolean, String, JavaInstance; Overloads OBJECT_CLASS_KIND
def dPred = java.util.function.DoublePredicate(fn (d : double) : bool -> ( d > 0.0 ))
def bPred = java.util.function.Predicate(fn (b : bool) : bool -> ( b ))
def sPred = java.util.function.Predicate(fn (s : string) : bool -> ( s == "ok" ))
def pCons = java.util.function.Consumer(fn io (p : java.awt.Point) -> ( println(p.x) ))
def Holder = class (def x : int) ()
pCons.accept(java.awt.Point(9, 1))
println(dPred.test(1.5), ":", bPred.test(true), ":", sPred.test("ok"), ":", java.lang.String.valueOf(Holder) != null)
}}}}}
9
true:true:true:true

{{{{{
;; Values.is with Java types and builtins via `any`, plus Java array length & package-private accessibleType
def p : any = java.awt.Point(1, 2)
def arr = java.util.regex.Pattern.compile(",").split("a,b")
def it = java.util.Collections.singletonList("a").iterator()
def i : any = 5
def d : any = 2.5
def b : any = true
def s : any = "hi"
println(p is java.awt.Point, ":", arr.size(), ":", it.hasNext(), ":", i is int, ":", i is double, ":", d is double, ":", b is bool, ":", s is string)
}}}}}
true:2:true:true:false:true:true:true

{{{{{
;; EffectSet.intersect eitherMut, EffectSet.satisfies shared/mut, Type.Function.describeAgainst
def C = class (def v : int) (
    def mMut = fn mut () : int -> ( this.v = 1 ; this.v )
    def mPure = fn () : int -> ( this.v )
    def pick = fn shared (flag : bool) -> (
        if flag then ( this.mMut ) else ( this.mPure )
    )
)
def obj = C(5)
println(obj.pick(false)(), ":", obj.pick(true)())
}}}}}
5:1

{{{{{
;; EffectSet.satisfies shared error message & Type.Function.describeAgainst
def C = class (def v : int) (
    def make = fn shared () : fn () : int -> ( fn () -> ( this.v ) )
)
def obj = C(4)
def func : fn () : fn () : int = obj.make
}}}}}
Type error : expected () : () : int, got shared () : () : int

{{{{{
;; TypeChecks.exportedModule and LogicalPaths leading slash
def I = interface ( def f : fn () : int )
def C = class (def x : int) implements I (
    def f = fn () : int -> ( this.x )
)
def ma = import("/fe_mod_a.ba")
def C2 = class (def n : int) implements I, ma.sub.IB, java.lang.Runnable (
    def f = fn () : int -> ( this.n )
    def id = fn () : int -> ( this.n * 2 )
    def run = fn () -> ( () )
)
def c1 : C = C(3)
def c2 = C2(4)
c2.run()
println(c1.f(), ":", c2.f(), ":", c2.id())
}}}}}
3:4:8

{{{{{
;; TypeChecker.satisfiesJavaBound (ParameterizedType bound Enum<E>): valid
def modes : java.util.EnumSet of java.nio.file.AccessMode = java.util.EnumSet.of(java.nio.file.AccessMode.READ)
println(modes.size())
}}}}}
1

{{{{{
;; TypeChecker.satisfiesJavaBound error path
def badEnum : (java.util.EnumSet of java.lang.String)? = null
}}}}}
Type error : type argument string does not satisfy bound E of java.util.EnumSet

{{{{{
;; EffectChecker static block inside hermetic function
def Box = class (def v : int) (
    def fHerm = fn volatile mut () -> (
        def C = class () () static ( println("side") )
        this.v += 1
        ()
    )
)
}}}}}
static block inside hermetic function violates hermetic guarantee

{{{{{
;; EffectChecker static block inside pure function
def fPure = fn () -> (
    def C = class () () static ( println("side") )
    ()
)
}}}}}
static block inside pure function violates pure guarantee

{{{{{
;; EffectChecker static block inside deterministic function
axiom volatile on java.lang.System.nanoTime
def fDet = fn () -> (
    def C = class () () static ( java.lang.System.nanoTime() )
    ()
)
}}}}}
static block inside deterministic function violates deterministic guarantee

{{{{{
;; EffectChecker relationalProps negate, double +, int odd *, string concat left/right, compound assign on local var
def negF : fn monotone (x : double) : double = fn (x : double) : double -> ( -(-x) )
def dblSum : fn monotone (x : double) : double = fn (x : double) : double -> ( x + x )
def oddMul : fn injective (x : int) : int = fn (x : int) : int -> ( x * 3 )
def sLeft : fn injective (x : string) : string = fn (x : string) : string -> ( x + "!" )
def sRight : fn injective (x : int) : string = fn (x : int) : string -> ( "!" + x )
def loc = 1
loc += 2
println(negF(2.5), ":", dblSum(1.5), ":", oddMul(4), ":", sLeft("ok"), ":", sRight(4), ":", loc)
}}}}}
2.5:3.0:12:ok!:!4:3

