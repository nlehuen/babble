{{{{{
;; extractNarrowing: null != x, not (null == x), &&, ||, paren-wrapped, and nullable bool
def Box = class (def v : int) ()
def check = (a : Box?, b : Box?, c : bool?) : string -> (
    def s = ""
    if null != a then ( s += a.v ) else ( s += "-" )
    if not (null == b) then ( s += b.v ) else ( s += "-" )
    if (a != null and b != null) then ( s += (a.v + b.v) ) else ( s += "n" )
    if (a == null or b == null) then ( s += "z" ) else ( s += "p" )
    if ((a != null)) then ( s += "!" )
    if c == true then ( s += "T" )
    s
)
println(check(Box(2), Box(3), true), ":", check(null, Box(4), false))
}}}}}
