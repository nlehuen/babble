{{{{{
;; unify: union actual, nullable pattern, Babble generic class pattern, Java generic interface pattern, function pattern
def Box(T) = class (def v : T) ()
def unbox(T) = (b : Box(T)) : T -> ( b.v )
def first(T) = (xs : java.util.List(T)) : T? -> ( xs.get(0) )
def orDefault(T) = (x : T?, d : T) : any? -> ( if x != null then ( x ) else ( d ) )
def id(T) = (x : T) : T -> ( x )
def apply(A, B) = (x : A, f : (a : A) : B) : B -> ( f(x) )
def u : int | string = 7
def xs = java.util.Collections.singletonList("hi")
println(unbox(Box(3)), ":", first(xs), ":", orDefault(null, 9), ":", orDefault(4, 9), ":", id(u), ":", apply(5, (n : int) : int -> ( n + 1 )))
}}}}}
3:hi:9:4:7:6

{{{{{
;; canMatchAtRuntime & isRuntimeSubtype across classes, value classes, interfaces, Java classes/interfaces, unions, functions
def I1 = interface ( def m : () : int )
def I2 = interface ( def n : () : int )
def C1 = class () implements I1 ( def m = () : int -> ( 1 ) )
def V1 = value class (x : int) implements I1 ( def m = () : int -> ( this.x ) )
def a : any = C1()
def v : any = V1(2)
def u : int | string = 5
def sb : java.lang.CharSequence = java.lang.StringBuilder("x")
def r : java.lang.Runnable? = null
def f : any = (x : int) : int -> ( x )
println(
    (a is I1), ":", (a is I2), ":", (v is V1), ":", (u is int), ":", (u is string), ":",
    (sb is java.lang.Appendable), ":", (sb is java.lang.String), ":", (r is java.lang.Runnable), ":",
    (f is any)
)
}}}}}
