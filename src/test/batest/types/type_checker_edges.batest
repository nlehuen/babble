{{{{{
;; genericBabbleCall with deferred unannotated lambda + unify JavaInstance SAM with Function + Java Optional.map deferred lambda
def apply(A, B) = (x : A, f : (a : A) : B) : B -> ( f(x) )
def runSam(T) = (f : java.util.function.Function(T, int), x : T) : int? -> ( f.apply(x) )
def opt = java.util.Optional.of(5).map((x : int) -> ( x + 1 ))
println(apply(10, (n) -> ( n + 1 )), ":", runSam((s : string) : int -> ( java.lang.String(s).length() ), "hello"), ":", opt.orElse(0))
}}}}}
