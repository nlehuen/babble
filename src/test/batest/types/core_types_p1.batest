;; BIP011-P1: Postfix non-null assertion (e!), memberName selectors, keyword reservation,
;; and extended string/char escapes.

{{{{{
;; Non-null assertion on nullable string and int?
def s : string? = "hello"
def n : int? = 41
println(s! + "!", "|", n! + 1)
}}}}}
hello!|42

{{{{{
;; Non-null assertion throwing at runtime when value is null
def s : string? = null
println(s!)
}}}}}
Type error : expected string, got null

{{{{{
;; Non-null assertion on null literal is a compile-time error
def x = null!
}}}}}
Type error : expected any, got null

{{{{{
;; Non-null assertion inside nothrow function fails effect check
def f = fn nothrow (s : string?) : string -> (
    s!
)
println(f("ok"))
}}}}}
Function f declared nothrow violates nothrow guarantee

{{{{{
;; Core type keywords allowed as member names after '.' (e.g., Java List.set)
def xs : java.util.ArrayList(int) = java.util.ArrayList()
xs.add(1)
xs.set(0, 7)
println(xs.get(0))
}}}}}
7

{{{{{
;; Reserved core type keyword rejected as def name
def list = 1
}}}}}
Syntax error : unexpected 'list'

{{{{{
;; Extended string escapes: \n, \t, \r, \b, \f, \0, \', \", \\, \uXXXX
def s = "A\tB\u0043\'\"\\"
println(s)
}}}}}
A	BC'"\

{{{{{
;; Char literals with escapes
def a = 'A'
def u = '\u0042'
def q = '\''
println(a, "|", u, "|", q)
}}}}}
A|B|'
