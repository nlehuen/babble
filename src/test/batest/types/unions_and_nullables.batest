;; Union types, nullability (T?), parenthesized type annotations, and nullability mismatches

{{{{{
def fmt = fn (v : int | string | null) : string -> (
    if v == null then ( "nil" )
    else if v is int then ( "int:" + v )
    else ( "str:" + v )
)
println(fmt(42), "|", fmt("ok"), "|", fmt(null))
}}}}}
int:42|str:ok|nil

{{{{{
;; Parenthesized union nullable type ((int | string)?)
def maybe : (int | string)? = 7
maybe = "hi"
maybe = null
println(maybe)
}}}}}
null

{{{{{
;; Assigning null to non-null variable rejected statically
def x : int = null
}}}}}
Type error : expected int, got null

{{{{{
;; Dereferencing/calling on nullable without narrowing rejected
def s : string? = null
def C = class (def x : int) ()
def c : C? = null
print(c.x)
}}}}}
Not a scope : c

{{{{{
;; Late null reassignment widens inferred non-null variable to T? or fails if incompatible
def x = 10
x = null
println(x)
}}}}}
null

{{{{{
;; T? is T | null, so null passes is T? and as T? for any T, but not is T
def Named = interface ( def name: fn (): string )
def Disk = class () ( def r = 1 )
def d: Disk? = null
def i: int? = null
println(d is Named?, " ", d as Named?, " ", d is Named, " ", i as string?)
}}}}}
true null false null

{{{{{
;; as T rejects null at runtime
def Named = interface ( def name: fn (): string )
def a: any? = null
def n = a as Named
}}}}}
Type error : expected Named, got null

{{{{{
;; int? and string share no value, so the cast is rejected statically
def i: int? = null
def s = i as string
}}}}}
Type error : expected string, got int?
