;; BIP011-P2: 9-scalar type system, contextual literals, JLS promotion, conversions, transparent string

{{{{{
;; All 9 core scalar types and java.lang.* annotation aliases
def b : byte = 127
def bMin : byte = -128
def s : short = 32767
def sMin : short = -32768
def i : int = 2147483647
def iMin : int = -2147483648
def l : long = 9223372036854775807L
def lMin : long = -9223372036854775808L
def lCtx : long = 9223372036854775807
def lCtxMin : long = -9223372036854775808
def f : float = 1.5f
def fCtx : float = 1.5
def d : double = 2.5
def flag : bool = true
def ch : char = 'Z'
def str : string = "hello"

def jb : java.lang.Byte = b
def js : java.lang.Short = s
def ji : java.lang.Integer = i
def jl : java.lang.Long = l
def jf : java.lang.Float = f
def jd : java.lang.Double = d
def jbool : java.lang.Boolean = flag
def jc : java.lang.Character = ch
def jstr : java.lang.String = str

println(classof(b) == java.lang.Byte, ":", classof(bMin) == java.lang.Byte, ":", b, ":", bMin)
println(classof(s) == java.lang.Short, ":", classof(sMin) == java.lang.Short, ":", s, ":", sMin)
println(classof(i) == java.lang.Integer, ":", classof(iMin) == java.lang.Integer, ":", i, ":", iMin)
println(classof(l) == java.lang.Long, ":", classof(lMin) == java.lang.Long, ":", lCtx == l, ":", lCtxMin == lMin)
println(classof(f) == java.lang.Float, ":", classof(fCtx) == java.lang.Float, ":", f == fCtx)
println(classof(d) == java.lang.Double, ":", classof(flag) == java.lang.Boolean, ":", classof(ch) == java.lang.Character, ":", classof(str) == java.lang.String)
println(jb == b, ":", js == s, ":", ji == i, ":", jl == l, ":", jf == f, ":", jd == d, ":", jbool == flag, ":", jc == ch, ":", jstr == str)
}}}}}
true:true:127:-128
true:true:32767:-32768
true:true:2147483647:-2147483648
true:true:true:true
true:true:true
true:true:true:true
true:true:true:true:true:true:true:true:true

{{{{{
;; Out-of-range contextual byte literal
def b : byte = 128
}}}}}
Out of byte range : 128

{{{{{
;; Out-of-range contextual negative byte literal
def b : byte = -129
}}}}}
Out of byte range : -129

{{{{{
;; Out-of-range contextual short literal
def s : short = 32768
}}}}}
Out of short range : 32768

{{{{{
;; Explicit double suffix cannot narrow to float
def f : float = 1.5d
}}}}}
Type error : expected float, got double

{{{{{
;; All 9 conversion functions
def b : byte = byte(42)
def s : short = short(1000)
def i : int = int(3.9)
def l : long = long("9000000000")
def f : float = float("2.5")
def d : double = double(7L)
def t : bool = bool("true")
def f2 : bool = bool("false")
def c1 : char = char(65)
def c2 : char = char("Z")
def s1 : string = string(123L)
def s2 : string = string('!')
println(classof(b) == java.lang.Byte, ":", b)
println(classof(s) == java.lang.Short, ":", s)
println(classof(i) == java.lang.Integer, ":", i, ":", int('A'))
println(classof(l) == java.lang.Long, ":", l)
println(classof(f) == java.lang.Float, ":", f)
println(classof(d) == java.lang.Double, ":", d)
println(t, ":", f2, ":", c1, ":", c2, ":", s1, ":", s2)
}}}}}
true:42
true:1000
true:3:65
true:9000000000
true:2.5
true:7.0
true:false:A:Z:123:!

{{{{{
;; JLS binary numeric promotion, float-preserving division, and unary minus
def b1 : byte = 10
def b2 : byte = 20
def s1 : short = 100
def s2 : short = 200
def i1 : int = 5
def l1 : long = 10L
def f1 : float = 5.0f
def d1 : double = 2.0

def rBB = b1 + b2
def rSS = s1 + s2
def rIL = i1 + l1
def rLF = l1 + f1
def rFD = f1 + d1
def rDivFI = f1 / 2
def rDivFF = f1 / 2.0f
def rDivII = i1 / 2
def rDivLF = l1 / 2.0f
def rNegB = -b1
def rNegL = -l1
def rNegF = -f1

println(classof(rBB) == java.lang.Integer, ":", rBB)
println(classof(rSS) == java.lang.Integer, ":", rSS)
println(classof(rIL) == java.lang.Long, ":", rIL)
println(classof(rLF) == java.lang.Float, ":", rLF)
println(classof(rFD) == java.lang.Double, ":", rFD)
println(classof(rDivFI) == java.lang.Float, ":", rDivFI)
println(classof(rDivFF) == java.lang.Float, ":", rDivFF)
println(classof(rDivII) == java.lang.Double, ":", rDivII)
println(classof(rDivLF) == java.lang.Double, ":", rDivLF)
println(classof(rNegB) == java.lang.Integer, ":", rNegB)
println(classof(rNegL) == java.lang.Long, ":", rNegL)
println(classof(rNegF) == java.lang.Float, ":", rNegF)
}}}}}
true:30
true:300
true:15
true:15.0
true:7.0
true:2.5
true:2.5
true:2.5
true:5.0
true:-10
true:-10
true:-5.0

{{{{{
;; 6-level implicit widening in assignments, calls, returns, and if/else joins
def b : byte = 7
def s : short = b
def i : int = s
def l : long = i
def f : float = l
def d : double = f
println(classof(b) == java.lang.Byte, ":", classof(s) == java.lang.Short, ":", classof(i) == java.lang.Integer, ":", classof(l) == java.lang.Long, ":", classof(f) == java.lang.Float, ":", classof(d) == java.lang.Double)

def pick = fn (c : bool) -> ( if c then ( 1 ) else ( 2L ) )
def picked = pick(true)
println(classof(picked) == java.lang.Long, ":", picked)

def takeLong = fn (x : long) : long -> ( x + 1L )
println(classof(takeLong(b)) == java.lang.Long, ":", takeLong(b))
}}}}}
true:true:true:true:true:true
true:1
true:8

{{{{{
;; Non-numeric char: comparisons work, arithmetic is rejected
def a : char = 'a'
def z : char = 'z'
println(a < z, ":", a == 'a', ":", z > a, ":", a <= a, ":", z >= a)
}}}}}
true:true:true:true:true

{{{{{
;; char is strictly non-numeric
def x = 'a' + 1
}}}}}
Not a number : 'a'

{{{{{
;; Transparent string methods, non-null assertion, safe navigation, and Java supertypes
def s : string = "hello"
def opt : string? = "world"
def empty : string? = null
def cs : java.lang.CharSequence = s
def cmp : java.lang.Comparable(string) = s
println(s.length(), ":", s.toUpperCase(), ":", opt!.toUpperCase(), ":", empty?.toUpperCase(), ":", cs.length(), ":", cmp.compareTo("hello") == 0)
}}}}}
5:HELLO:WORLD:null:5:true

{{{{{
;; Memberless primitives: long has no members
def x = (1L).toString()
}}}}}
Not a scope : (1L)

{{{{{
;; Memberless primitives: char has no members
def x = 'a'.toString()
}}}}}
Not a scope : 'a'

{{{{{
;; is / as with all 9 scalars
def dyn = fn (v : any?) : any? -> ( v )
println(dyn(byte(1)) is byte, ":", dyn(short(2)) is short, ":", dyn(3L) is long, ":", dyn(1.5f) is float, ":", dyn('x') is char)
def l : long = dyn(5) as long
def f : float = dyn(5) as float
println(classof(l) == java.lang.Long, ":", l, ":", classof(f) == java.lang.Float, ":", f)
}}}}}
true:true:true:true:true
true:5:true:5.0
