{{{{{
;; EffectChecker.propagateSamCallbackEffects: pure vs impure lambda & Consumer class
axiom pure on java.util.Collections.singletonList
axiom pure on java.lang.Iterable.forEach
axiom pure on java.util.List.size
def GoodCons = class () implements java.util.function.Consumer of java.lang.Object (
    def accept = fn pure (x : java.lang.Object) -> ( () )
)
def okSam = fn pure () : int -> (
    def item : java.lang.Object = 1
    def xs : java.util.List of java.lang.Object = java.util.Collections.singletonList(item)
    xs.forEach(fn (x) -> ( def y = x ))
    xs.forEach(GoodCons())
    xs.size()
)
println(okSam())
}}}}}
1

{{{{{
axiom pure deterministic on java.util.ArrayList()
axiom hermetic mut on java.util.ArrayList.add
axiom pure on java.util.ArrayList.forEach
def badSamLambda = fn pure () -> (
    def xs : java.util.ArrayList of java.lang.Object = java.util.ArrayList()
    xs.add(1)
    xs.forEach(fn (x) -> ( println(x) ))
)
}}}}}
Function badSamLambda declared pure violates pure guarantee

{{{{{
axiom pure deterministic on java.util.ArrayList()
axiom hermetic mut on java.util.ArrayList.add
axiom pure on java.util.ArrayList.forEach
def BadCons = class () implements java.util.function.Consumer of java.lang.Object (
    def accept = fn (x : java.lang.Object) -> ( println(x) )
)
def badSamClass = fn pure () -> (
    def xs : java.util.ArrayList of java.lang.Object = java.util.ArrayList()
    xs.add(1)
    xs.forEach(BadCons())
)
}}}}}
Function badSamClass declared pure violates pure guarantee

{{{{{
;; EffectChecker exclusivity error & mut target violations
def Box = class (def v : int) (
    def swapWith = fn hermetic mut (mut other : Box) -> (
        def t = this.v
        this.v = other.v
        other.v = t
    )
)
def b = Box(1)
b.swapWith(b)
}}}}}
Exclusivity error : mut target b aliases argument b

{{{{{
;; EffectChecker relationalProps, binaryWrapperProps, isUnaryIdempotentWrapper, isMutCommutativeBody
axiom pure deterministic idempotent on java.nio.file.Path.normalize
def badMonoJ = fn (f : fn pure monotone (s : java.lang.StringBuilder) : int) : int -> ( 1 )
def addD = fn (a : double, b : double) : double -> ( a + b )
def addI = fn (a : int, b : int) : int -> ( a + b )
def impBin = fn (a : int, b : int) : int -> ( println(a) ; a + b )
def w1 = fn (x : double) : double -> ( 1.0 + x )
def w2 = fn (x : int) : string -> ( "" + x + "!" )
def w3 = fn (x : double) : string -> ( "d=" + x )
def w4 = fn (x : int, y : int) : int -> ( addI(a = x, b = y) )
def w5 = fn (x : int, y : int) : int -> ( impBin(x, y) )
def m1 : fn pure monotone (x : double) : double = w1
def j1 : fn pure injective (x : int) : string = w2
def normWrap = fn (p : java.nio.file.Path) : java.nio.file.Path -> ( p.normalize() )
def pIdem : fn pure idempotent (p : java.nio.file.Path) : java.nio.file.Path = normWrap
def cleanOp = fn pure deterministic idempotent (s : string) : string -> ( s )
def cleanWrap = fn (s : string) : string -> ( cleanOp(s) )
def sIdem : fn pure idempotent (s : string) : string = cleanWrap
def MBox = class (def v : int) (
    def addLeft = fn hermetic mut commutative (d : int) : int -> ( this.v = this.v + d )
    def addRight = fn hermetic mut commutative (d : int) : int -> ( this.v = d + this.v )
    def addPlus = fn hermetic mut commutative (d : int) : int -> ( this.v += d )
)
def mb = MBox(0)
def mc1 : fn hermetic commutative mut (d : int) : int = mb.addLeft
def mc2 : fn hermetic commutative mut (d : int) : int = mb.addRight
def mc3 : fn hermetic commutative mut (d : int) : int = mb.addPlus
def nDet = class () () static (
    def s = MBox(1)
)
def badStaticRead = fn deterministic () : int -> ( nDet.s.v )
}}}}}
Function badStaticRead declared deterministic violates deterministic guarantee

{{{{{
;; EffectChecker: algebraic signature mismatches
def badAssocDom = fn (f : fn pure associative (a : int, b : double) : double) : int -> ( 1 )
}}}}}
associative requires a pure binary (T, T) : T signature

{{{{{
def badCommDom = fn (f : fn pure commutative (a : int, b : double) : double) : int -> ( 1 )
}}}}}
commutative without mut requires a pure binary (T, T) : R signature

{{{{{
def Box = class (def v : int) ()
def badCommMutOne = fn (f : fn hermetic commutative (mut a : Box) : null) : int -> ( 1 )
}}}}}
mut commutative requires a value parameter on the mutated target

{{{{{
def badIdemRet = fn (f : fn pure idempotent (a : int) : string) : int -> ( 1 )
}}}}}
idempotent without mut requires a pure unary (T) : T signature or an effectful axiom

{{{{{
def badInjBool = fn (f : fn pure injective (x : int) : bool) : int -> ( 1 )
def badInjNull = fn (f : fn pure injective (x : int) : null) : int -> ( 1 )
}}}}}
injective requires at least one parameter, no mut, and a non-null return type

