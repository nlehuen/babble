{{{{{
;; TypeChecks: nested Java interface, invalid Java parent, package interface, multi-arg checkJavaArity, super errors, module exports
def EntryImpl = class (def k : java.lang.Object, def v : java.lang.Object) implements java.util.Map.Entry(java.lang.Object, java.lang.Object) (
    def getKey = () -> ( this.k )
    def getValue = () -> ( this.v )
    def setValue = mut (nv : java.lang.Object) -> (
        def old = this.v
        this.v = nv
        old
    )
)
def I1 = interface ( def a : () : int )
package Pkg (
    def IPkg = interface ( def b : () : int )
)
def C1 = class () implements I1, Pkg.IPkg (
    def a = () : int -> ( 1 )
    def b = () : int -> ( 2 )
)
def e = EntryImpl("k", 42)
def c = C1()
println(e.getKey(), ":", e.setValue(99), ":", e.getValue(), ":", c.a(), ":", c.b())
}}}}}
k:42:99:1:2

