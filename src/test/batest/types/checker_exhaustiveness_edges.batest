{{{{{
;; EffectChecker.propagateSamCallbackEffects: pure vs impure lambda & Consumer class
axiom pure java.util.Collections.singletonList
axiom pure java.lang.Iterable.forEach
axiom pure java.util.List.size
def GoodCons = class () implements java.util.function.Consumer(java.lang.Object) (
    def accept = pure (x : java.lang.Object) -> ( () )
)
def okSam = pure () : int -> (
    def item : java.lang.Object = 1
    def list : java.util.List(java.lang.Object) = java.util.Collections.singletonList(item)
    list.forEach((x) -> ( def y = x ))
    list.forEach(GoodCons())
    list.size()
)
println(okSam())
}}}}}
1

{{{{{
axiom pure deterministic java.util.ArrayList()
axiom hermetic mut java.util.ArrayList.add
axiom pure java.util.ArrayList.forEach
def badSamLambda = pure () -> (
    def list : java.util.ArrayList(java.lang.Object) = java.util.ArrayList()
    list.add(1)
    list.forEach((x) -> ( println(x) ))
)
}}}}}
Function badSamLambda declared pure violates pure guarantee

{{{{{
axiom pure deterministic java.util.ArrayList()
axiom hermetic mut java.util.ArrayList.add
axiom pure java.util.ArrayList.forEach
def BadCons = class () implements java.util.function.Consumer(java.lang.Object) (
    def accept = (x : java.lang.Object) -> ( println(x) )
)
def badSamClass = pure () -> (
    def list : java.util.ArrayList(java.lang.Object) = java.util.ArrayList()
    list.add(1)
    list.forEach(BadCons())
)
}}}}}
Function badSamClass declared pure violates pure guarantee

{{{{{
;; EffectChecker exclusivity error & mut target violations
def Box = class (def v : int) (
    def swapWith = hermetic mut (mut other : Box) -> (
        def t = this.v
        this.v = other.v
        other.v = t
    )
)
def b = Box(1)
b.swapWith(b)
}}}}}
Exclusivity error : mut target b aliases argument b

{{{{{
;; EffectChecker relationalProps, binaryWrapperProps, isUnaryIdempotentWrapper, isMutCommutativeBody
axiom pure deterministic idempotent java.nio.file.Path.normalize
def badMonoJ = (f : pure monotone (s : java.lang.StringBuilder) : int) : int -> ( 1 )
def addD = (a : double, b : double) : double -> ( a + b )
def addI = (a : int, b : int) : int -> ( a + b )
def impBin = (a : int, b : int) : int -> ( println(a) ; a + b )
def w1 = (x : double) : double -> ( 1.0 + x )
def w2 = (x : int) : string -> ( "" + x + "!" )
def w3 = (x : double) : string -> ( "d=" + x )
def w4 = (x : int, y : int) : int -> ( addI(a = x, b = y) )
def w5 = (x : int, y : int) : int -> ( impBin(x, y) )
def m1 : pure monotone (x : double) : double = w1
def j1 : pure injective (x : int) : string = w2
def normWrap = (p : java.nio.file.Path) : java.nio.file.Path -> ( p.normalize() )
def pIdem : pure idempotent (p : java.nio.file.Path) : java.nio.file.Path = normWrap
def cleanOp = pure deterministic idempotent (s : string) : string -> ( s )
def cleanWrap = (s : string) : string -> ( cleanOp(s) )
def sIdem : pure idempotent (s : string) : string = cleanWrap
def MBox = class (def v : int) (
    def addLeft = hermetic mut commutative (d : int) : int -> ( this.v = this.v + d )
    def addRight = hermetic mut commutative (d : int) : int -> ( this.v = d + this.v )
    def addPlus = hermetic mut commutative (d : int) : int -> ( this.v += d )
)
def mb = MBox(0)
def mc1 : hermetic commutative mut (d : int) : int = mb.addLeft
def mc2 : hermetic commutative mut (d : int) : int = mb.addRight
def mc3 : hermetic commutative mut (d : int) : int = mb.addPlus
def nDet = class () () static (
    def s = MBox(1)
)
def badStaticRead = deterministic () : int -> ( nDet.s.v )
}}}}}
Function badStaticRead declared deterministic violates deterministic guarantee

{{{{{
;; EffectChecker: algebraic signature mismatches
def badAssocDom = (f : pure associative (a : int, b : double) : double) : int -> ( 1 )
}}}}}
associative requires a pure binary (T, T) : T signature

{{{{{
def badCommDom = (f : pure commutative (a : int, b : double) : double) : int -> ( 1 )
}}}}}
commutative without mut requires a pure binary (T, T) : R signature

{{{{{
def Box = class (def v : int) ()
def badCommMutOne = (f : hermetic commutative (mut a : Box) : null) : int -> ( 1 )
}}}}}
mut commutative requires a value parameter on the mutated target

{{{{{
def badIdemRet = (f : pure idempotent (a : int) : string) : int -> ( 1 )
}}}}}
idempotent without mut requires a pure unary (T) : T signature or an effectful axiom

{{{{{
def badInjBool = (f : pure injective (x : int) : bool) : int -> ( 1 )
def badInjNull = (f : pure injective (x : int) : null) : int -> ( 1 )
}}}}}
injective requires at least one parameter, no mut, and a non-null return type

