{{{{{
;; TypeChecker: intersectCompatibleFunctions, reassignmentJoin, generic double widening, compound assign on param/this
def Box = class (def v : int) (
    def bump = mut (d : int) : int -> ( this.v += d ; this.v )
)
def pickFn = (flag : bool) -> (
    if flag then ( (mut b : Box) : int -> ( b.v = 1 ; b.v ) )
    else ( pure (b : Box) : int -> ( b.v ) )
)
def pickDiffName = (flag : bool) -> (
    if flag then ( (a : int) : int -> ( a ) ) else ( (b : int) : int -> ( b + 1 ) )
)
def rf = pure (b : Box) : int -> ( b.v )
rf = (mut b : Box) : int -> ( b.v = 2 ; b.v )
def n1 = null
n1 = 1
n1 = 2.5
def n2 = 1
n2 = null
n2 = 3.5
def wrapGen(T) = (fn : () : T) : T -> ( fn() )
def dWid : double = wrapGen(() -> ( 1 ))
def addParam = (p : int) : int -> ( p += 4 ; p )
def bx = Box(5)
println(pickFn(false)(bx), ":", rf(bx), ":", n1, ":", n2, ":", dWid, ":", addParam(6), ":", bx.bump(3))
}}}}}
5:2:2.5:3.5:1.0:10:5

