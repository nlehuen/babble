;; BIP009-P4 Batch 4b: TypeChecker, TypeChecks, EffectChecker, EffectSet, Type & runtime edge cases

========== ce_mod_a.ba ==========
export def Dup = class (def k : int) ()
export def ModCustom = class (def x : int) (
    def toString = fn pure deterministic () : string -> ( "M:" + this.x )
)
export def ExportCls = class (def n : int) (
    private def priv = fn (a : int) -> ( a + this.n )
    def pub = fn (a : int) : int -> ( this.priv(a) )
)
export def IMod = interface (
    def id : fn () : int
)
export def ModWrap of T = class (def v : T) ()
export def x = 10
export def subMod = import("ce_mod_b.ba")

========== ce_mod_b.ba ==========
export def Dup = class (def k : int) ()
export def y = 20

{{{{{
;; EffectSet.keywordOf violations: hermetic, deterministic, nothrow
def g = 1
g = 2
def badHerm = fn hermetic () -> ( g = 3 )
}}}}}
Function badHerm declared hermetic violates hermetic guarantee

{{{{{
def badDet = fn deterministic () -> ( java.lang.Math.random() )
}}}}}
Function badDet declared deterministic violates deterministic guarantee

{{{{{
def badNothrow = fn nothrow () -> ( java.lang.Integer.parseInt("1") )
}}}}}
Function badNothrow declared nothrow violates nothrow guarantee

{{{{{
;; EffectChecker.toStringProfile across module, non-value class, JavaInstance
def ma = import("ce_mod_a.ba")
def Reg = class (def v : int) ()
def useRegOk = fn pure (r : Reg) : string -> ( "r=" + r )
def useModOk = fn pure deterministic (m : ma.ModCustom) : string -> ( "m=" + m )
def useJavaOk = fn pure deterministic (p : java.awt.Point) : string -> ( "p=" + p.x )
def useJavaStr = fn pure (p : java.awt.Point) : string -> ( "p=" + p )
println(useModOk(ma.ModCustom(7)), "|", useJavaStr(java.awt.Point(1, 2)))
}}}}}
m=M:7|p=java.awt.Point[x=1,y=2]

