{{{{{
;; TypeChecker: canCast, isRuntimeSubtype, canMatchAtRuntime
def I1 = interface ( def a : () : int )
def I2 = interface ( def b : () : int )
def Both = class () implements I1, I2, java.lang.Runnable (
    def a = () : int -> ( 1 )
    def b = () : int -> ( 2 )
    def run = () -> ( () )
)
def obj : Both = Both()
def i1 : I1 = obj
def i2 = i1 as I2
def r = i1 as java.lang.Runnable
def back = r as I1
def nil : null = null as null
def arr = java.util.regex.Pattern.compile(",").split("a,b")
def arrCopy = java.util.Arrays.copyOf(arr, 3)
def arrObj = arrCopy as java.lang.Object
def genTest(T) = (x : T) : bool -> ( x is string )
println(i2.b(), ":", back.a(), ":", nil, ":", arrCopy.length, ":", arrObj != null, ":", genTest("hi"), ":", genTest(1))
}}}}}
Warning : Redundant cast : any
2:1:null:3:true:true:false

