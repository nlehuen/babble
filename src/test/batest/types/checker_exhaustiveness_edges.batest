{{{{{
;; TypeChecker: intersectCompatibleFunctions, reassignmentJoin, generic double widening, compound assign on param/this
def Box = class (def v : int) (
    def bump = fn mut (d : int) : int -> ( this.v += d ; this.v )
)
def pickFn = fn (flag : bool) -> (
    if flag then ( fn (mut b : Box) : int -> ( b.v = 1 ; b.v ) )
    else ( fn pure (b : Box) : int -> ( b.v ) )
)
def pickDiffName = fn (flag : bool) -> (
    if flag then ( fn (a : int) : int -> ( a ) ) else ( fn (b : int) : int -> ( b + 1 ) )
)
def rf = fn pure (b : Box) : int -> ( b.v )
rf = fn (mut b : Box) : int -> ( b.v = 2 ; b.v )
def n1 = null
n1 = 1
n1 = 2.5
def n2 = 1
n2 = null
n2 = 3.5
def wrapGen of T = fn (func : fn () : T) : T -> ( func() )
def dWid : double = wrapGen(fn () -> ( 1 ))
def addParam = fn (p : int) : int -> ( p += 4 ; p )
def bx = Box(5)
println(pickFn(false)(bx), ":", rf(bx), ":", n1, ":", n2, ":", dWid, ":", addParam(6), ":", bx.bump(3))
}}}}}
5:2:2.5:3.5:1.0:10:5

