{{{{{
;; TypeChecks: nested Java interface, invalid Java parent, multi-arg checkJavaArity, super errors, module exports
def EntryImpl = class (def k : java.lang.Object, def v : java.lang.Object) implements java.util.Map.Entry of (java.lang.Object, java.lang.Object) (
    def getKey = fn () -> ( this.k )
    def getValue = fn () -> ( this.v )
    def setValue = fn mut (nv : java.lang.Object) -> (
        def old = this.v
        this.v = nv
        old
    )
)
def I1 = interface ( def a : fn () : int )
def I2 = interface ( def b : fn () : int )
def C1 = class () implements I1, I2 (
    def a = fn () : int -> ( 1 )
    def b = fn () : int -> ( 2 )
)
def e = EntryImpl("k", 42)
def c = C1()
println(e.getKey(), ":", e.setValue(99), ":", e.getValue(), ":", c.a(), ":", c.b())
}}}}}
k:42:99:1:2

