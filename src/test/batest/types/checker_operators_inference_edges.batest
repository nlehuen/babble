{{{{{
;; Generic Babble calls: function pattern, BabbleInstance pattern, List pattern, nullable pattern, return hint widening, failure
def Box(T) = class (def v : T) ()
def wrap(T) = (x : T) : Box(T) -> ( Box(x) )
def applyFn(A, B) = (x : A, f : (v : A) : B) : B -> ( f(x) )
def wrapOpt(T) = (x : T?) : T? -> ( x )
def firstElem(T) = (xs : java.util.List(T)) : T? -> ( if xs.isEmpty() then ( null ) else ( xs.get(0) ) )

def bd : Box(double) = wrap(1)
def mapped = applyFn(4, (n) -> ( n * 2 + 1 ))
def optN = wrapOpt(1)
def fe = firstElem(java.util.List.of("k"))
println(bd.v, ":", mapped, ":", optN, ":", fe)
}}}}}
1.0:9:1:k

