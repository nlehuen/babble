{{{{{
;; Reassignment join (null <-> int, int -> double, fn effect intersect) & intersectCompatibleFunctions
def a = null
a = 5
def b = 1
b = null
def c = 2
c = 3.5
def d = 1
d = null
d = 2.5

def pureFn = (x : int) : int -> ( x + 1 )
def impFn = impure (x : int) : int -> ( x + 2 )
def pick = (flag : bool) -> (
    if flag then ( pureFn ) else ( impFn )
)
def fVar = pureFn
fVar = impFn
println(a, ":", b, ":", c, ":", d, ":", pick(true)(10), ":", fVar(10))
}}}}}
5:null:3.5:2.5:11:12

{{{{{
;; Widening note on assignment: "because of the assignment"
def x = 1
def takeInt = (n : int) : int -> ( n )
takeInt(x)
x = 1.5
}}}}}
Type error : expected int, got double (x is double because of the assignment)

{{{{{
;; Widening note on parameter call: "because of the call"
def f = (x) -> ( x + 1 )
def takeInt = (n : int) : int -> ( n )
takeInt(f(1))
f(1.5)
}}}}}
Type error : expected int, got double (x is double because of the call)

{{{{{
;; BabbleInstance operatorCall success, widening, union, and error paths
def Vec = class (def x : int) (
    def plus = (other : Vec) : Vec -> ( Vec(this.x + other.x) )
    def neg = () : Vec -> ( Vec(-(this.x)) )
)
def Alt = class (def x : int) (
    def plus = (other : int) : Alt -> ( Alt(this.x + other) )
)
def WidenOp = class () (
    def plus = (n) -> ( n + 1 )
)
def w = WidenOp()
println(w + 1, ":", w + 2.5)
def u : Vec | Vec = Vec(4)
println((u + Vec(5)).x, ":", (-u).x)
}}}}}
2.0:3.5
9:-4

