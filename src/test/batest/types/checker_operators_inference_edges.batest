{{{{{
;; Unannotated & recursive function inference + computeBodyResult + null default param + Java SAM / overload / effect assignability
def fact = (n : int) -> (
    if n <= 1 then ( 1 ) else ( n * recurse(n - 1) )
)
def withEarlyRet = (n : int) -> (
    if n < 0 then ( return 0.5 )
    n
)
def nullDef = (x = null) -> ( x )
println(fact(5), ":", withEarlyRet(-1), ":", withEarlyRet(3), ":", nullDef(), ":", nullDef(9))

def fnPrint : (s : string) : () = println
def fnAppend : (c : java.lang.CharSequence) : java.lang.StringBuilder = java.lang.StringBuilder().append
def samFn : java.util.function.Function(int, double) = java.util.function.Function((x) -> ( x + 1 ))
println(samFn.apply(4))
}}}}}
