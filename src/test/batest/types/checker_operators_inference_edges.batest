;; TypeChecker & TypeChecks edge cases: operators, reassignmentJoin, generics, narrowing/casts, recursive inference, Java interop

========== mod_tc_infer.ba ==========
export def inc = (x : int) -> ( x + 1 )
export def Box(T) = class (def v : T) ()
export def id(T) = (x : T) : T -> ( x )
export def optDef = (x = 7) -> ( x )
export def lang = import("java.lang")

{{{{{
;; Cross-module inferred/generic exports + importedPackage type/interface resolution + package-private accessibleType
def m = import("mod_tc_infer.ba")
def lang = import("java.lang")
def MyRun = class (def mut ran : bool) implements lang.Runnable (
    def run = mut () -> ( this.ran = true )
)
def r = MyRun(false)
r.run()
def sb : lang.StringBuilder = lang.StringBuilder("hi")
def it : java.util.Iterator(int) = java.util.Collections.emptyIterator()
def b : m.Box(int) = m.Box(9)
def f : (v : int) : int = m.id
println(m.inc(4), ":", m.optDef(), ":", m.id("ok"), ":", r.ran, ":", sb.toString(), ":", it.hasNext(), ":", b.v, ":", f(8))
}}}}}
5:7:ok:true:hi:false:9:8

{{{{{
;; Narrowing (&&, ||, not, reversed null), runtime subtype/cast checks (Babble/Java interfaces, final classes)
def IA = interface ( def a : () : int )
def IB = interface ( def b : () : int )
def C = class () implements IA, IB (
    def a = () : int -> ( 1 )
    def b = () : int -> ( 2 )
)
def DynBox = class (def v : any?) ()
def check = (x : int | string | null, y : int?, ia : IA, cs : java.lang.CharSequence) : string -> (
    def r1 = if null != y and y > 0 then ( y + 1 ) else ( 0 )
    def r2 = if null == y or not (x is int) then ( -1 ) else ( x + y )
    def r3 = if ia is IB then ( ia.b() ) else ( 0 )
    def r4 = if ia is java.lang.Runnable then ( 1 ) else ( 0 )
    def r5 = if cs is IA then ( 1 ) else ( 0 )
    def num : java.lang.Number = 42
    def r6 = num is java.lang.Comparable
    def r7 = "hi" is java.lang.CharSequence
    "" + r1 + ":" + r2 + ":" + r3 + ":" + r4 + ":" + r5 + ":" + r6 + ":" + r7
)
println(check(5, 3, C(), java.lang.StringBuilder("z")), "|", check("s", null, C(), java.lang.StringBuilder("z")))
}}}}}
4:8:2:0:0:true:true|0:-1:2:0:0:true:true

