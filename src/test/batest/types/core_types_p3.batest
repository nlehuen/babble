;; BIP011-P3: Java nullability alignment, JDK java.base overlay, @NotNull, and defensive checks

{{{{{
;; Unannotated Java returns/fields are nullable (T?); e! asserts non-null at runtime
def Demo = import("org.babblelang.tests").JavaClassDemo
def maybeInt : int? = Demo.boxedInt(false)
def maybeOk : int? = Demo.boxedInt(true)
def mustInt : int = maybeOk!
def prop : string? = java.lang.System.getProperty("babble.nonexistent.p3.key")
def defProp : string = java.lang.System.getProperty("babble.nonexistent.p3.key", "fallback")
println(maybeInt, ":", mustInt, ":", prop, ":", defProp)
}}}}}
null:42:null:fallback

{{{{{
;; e! on null Java return raises Type error : expected int, got null
def Demo = import("org.babblelang.tests").JavaClassDemo
Demo.boxedInt(false)!
}}}}}
Type error : expected int, got null

{{{{{
;; JDK java.base overlay: List.get(i) is T, Map.get(k) is V?, Map.getOrDefault(k, d) is V, Optional.get() is T
def xs : java.util.List(string) = java.util.ArrayList()
xs.add("alpha")
def first : string = xs.get(0)
def m : java.util.Map(string, int) = java.util.HashMap()
m.put("a", 7)
def hit : int? = m.get("a")
def miss : int? = m.get("b")
def defaulted : int = m.getOrDefault("b", 99)
def opt : java.util.Optional(string) = java.util.Optional.of("ok")
def optVal : string = opt.get()
println(first, ":", hit, ":", miss, ":", defaulted, ":", optVal, ":", first.startsWith("al"))
}}}}}
alpha:7:null:99:ok:true

{{{{{
;; @NotNull Java field/method and String.startsWith rejecting string?
def s : string? = null
"hello".startsWith(s)
}}}}}
Type error : expected string, got string?

{{{{{
;; List.of rejects nullable arguments statically
def s : string? = "a"
java.util.List.of(s)
}}}}}
Type error : expected string, got string?

{{{{{
;; Defensive runtime check on raw-polluted List(int) catching null element
def xs : java.util.List(int) = java.util.ArrayList()
def raw = xs as java.util.List
raw.add(null)
xs.get(0)
}}}}}
Warning : Redundant cast : java.util.List(any?)
Type error : expected int, got null

{{{{{
;; Defensive runtime check on raw-polluted List(int) catching wrong element type
def xs : java.util.List(int) = java.util.ArrayList()
def raw = xs as java.util.List
raw.add("oops")
xs.get(0)
}}}}}
Warning : Redundant cast : java.util.List(any?)
Type error : expected int, got string
