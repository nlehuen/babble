;; Casts, warnings, narrowing invalidation, callable class assignments, selector escapes, and array/Java field errors

{{{{{
;; Redundant casts, runtime casts, array/interface/Java casts
def I1 = interface ( def a : () : int )
def I2 = interface ( def b : () : string )
def C = class (def x : int) implements I1 (
    def a = () : int -> ( this.x )
)
def C2 = class () implements I1 (
    def a = () : int -> ( 0 )
)
def D = class () ()
def c = C(4)
def red1 = c as C
def red2 = 3 as int
def i1 : I1 = if true then ( c ) else ( C2() )
def cBack = i1 as C
def stack = java.lang.Thread.currentThread().getStackTrace()
println(red1.x, ":", red2, ":", cBack.x, ":", stack.length > 0)
}}}}}
Warning : Redundant cast : C
Warning : Redundant cast : int
4:3:4:true

