{{{{{
;; Flow-sensitive narrowing: is double, is bool, is any, and, or, early return, and kill on reassign
def checkAll = (x : any?, flag : bool) : string -> (
    def r1 = if x is double then ( "d:" + (x + 1.0) )
        else if x is bool then ( "b:" + (not x) )
        else if x is any then ( "a" )
        else ( "null" )
    def y : int | string = 10
    def ok1 = if (y is int) and (y > 5) then ( y + 1 ) else ( 0 )
    def z : int? = if flag then ( 7 ) else ( null )
    def early = () : int -> (
        if z == null or not flag then ( return -1 )
        z + 2
    )
    def w : int | string = 1
    def killedIf = if w is int then (
        w = "s"
        1
    ) else ( 0 )
    def k : int | string = 3
    if flag then ( k = "z" )
    def u = 2
    def closureKill = () : int | string -> ( u )
    if u is int then (
        def f = () -> ( u = 9 )
        f()
    )
    r1 + ":" + ok1 + ":" + early() + ":" + killedIf + ":" + closureKill() + ":" + (k is string)
)
println(checkAll(2.5, true), "|", checkAll(false, false), "|", checkAll("hi", true), "|", checkAll(null, true))
}}}}}
d:3.5:11:9:1:9:true|b:true:11:-1:1:9:false|a:11:9:1:9:true|null:11:9:1:9:true

{{{{{
;; Parameter default skips later parameter in same list via notBoundYet (binds outer b)
def b = 10
def f = (a : int = b, b : int = 1) : int -> ( a + b )
println(f())
}}}}}
11

{{{{{
;; Passing ClassValue / JavaMethod / print to function types (nonFunctionCallableAssignable)
def Box = class (def v : int) ()
def MutBox = class (def v : int) (
    def n = ( println(this.v) ; 1 )
)
def apply = (x : int, fn : (a : int) : Box) : int -> ( fn(x).v )
def mk : (a : int) : Box = Box
def takeMut = (m : MutBox) -> ( m )
println(apply(5, Box), ":", mk(7).v)
}}}}}
5:7

