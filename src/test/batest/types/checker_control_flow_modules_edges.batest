{{{{{
;; Cross-module interface, package-qualified interface, super default call, and TypeChecks errors
def m = import("tc_exp.ba")
package localPkg (
    def ILocal = interface (
        def val : () : int
    )
)
def Impl = class () implements m.IExp, localPkg.ILocal, m.expPkg.INested (
    def ping = () : int -> ( 1 )
    def val = () : int -> ( 2 )
    def pong = () : int -> ( 3 )
    def callSuper = () : int -> ( super(m.IExp).defm() )
)
def im = Impl()
println(im.ping(), ":", im.val(), ":", im.pong(), ":", im.callSuper(), ":", im is m.IExp, ":", im is localPkg.ILocal)
}}}}}
1:2:3:9:true:true

