;; TypeChecker & TypeChecks edge cases: control flow, narrowing, negate, safe selector, Java arrays, deferred lambdas, generics, modules

========== tc_exp.ba ==========
export def IExp = interface (
    def ping : () : int
    def defm = () : int -> ( 9 )
)
export package expPkg (
    def InnerC = class () ()
    def INested = interface (
        def pong : () : int
    )
)

{{{{{
;; visitIfExpression & visitWhileExpression: unused incompatible branches, missing else, double widening, union join
def pickIf = (flag : bool) : string -> (
    if flag then ( 1 ) else ( "ok" )
    def d : double = if flag then ( 1 ) else ( 2.5 )
    def k = 0
    while k < 2 then ( k += 1; 99 )
    def wk = 0
    def wd : double? = while wk < 2 then ( wk += 1; 42 )
    "" + d + ":" + wd
)
def unionIf = (flag : bool) -> ( if flag then ( 1 ) else ( "a" ) )
def unionWhile = (k : int) -> ( while k < 2 then ( k += 1; 42 ) )
println(pickIf(true), "|", pickIf(false), "|", unionIf(true), "|", unionWhile(0), "|", unionWhile(5))
}}}}}
1.0:42.0|2.5:42.0|1|42|null

