        def keep : T = this.v
        x
    )
)
println(Box("ok").inner(42))
}}}}}
42

{{{{{
;; Compound assignment on class members (int, double, string, union) & private static member error
def Comp = class (def i : int, def d : double, def s : string, def u : int | double) (
    def run = mut () : string -> (
        this.i += 2
        this.i -= 1
        this.d /= 2
        this.s += "!"
        this.u += 1.5
        "" + this.i + ":" + this.d + ":" + this.s + ":" + this.u
    )
)
def c = Comp(5, 9.0, "hi", 2)
c.i += 3
c.u /= 2
println(c.i, ":", c.u, ":", c.run())
}}}}}
8:1.0:9:4.5:hi!:2.5
