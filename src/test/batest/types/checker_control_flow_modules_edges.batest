{{{{{
;; Java arrays, Object[] assignability, cast/is on Java & Babble interfaces, TypeVar assignability, stream deferred lambda
def parts = java.util.regex.Pattern.compile(",").split("a,b,c")
def takeArr = (arr : java.util.List(any?)) : int -> ( arr.size() )
def asList = java.util.Arrays.asList(parts)

def id(T) = (x : T) : any? -> (
    def y : any? = x
    def z : T | int = x
    z
)

def mapped = java.util.List.of(1, 2, 3).stream().map((x) -> ( x * 10 )).toList()
def listCtor = java.util.ArrayList(java.util.List.of(4, 5))
def mapCtor = java.util.HashMap(java.util.Map.of("k", 9))

def rev : java.util.Comparator(int) = java.util.Collections.reverseOrder()
def cDyn : java.lang.CharSequence = java.lang.StringBuilder("hi")

println(takeArr(asList), ":", parts.length, ":", id(7), ":", mapped.toString(), ":", listCtor.size(), ":", mapCtor.get("k"), ":", STDOUT != null, ":", cDyn is java.lang.Appendable, ":", rev is java.lang.Comparable)
}}}}}
3:3:7:[10, 20, 30]:2:9:true:true:false

