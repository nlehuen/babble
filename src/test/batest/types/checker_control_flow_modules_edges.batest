{{{{{
;; visitBlock early-return flow narrowing guards (whenTrue and whenFalse)
def guardNull = (x : int?) : int -> (
    if x == null then ( return -1 )
    x + 1
)
def guardNonNull = (x : int?) : int -> (
    if x != null then ( x + 2 ) else ( return -2 )
)
def guardElse = (x : int?) : int -> (
    if x != null then ( def ok = x + 3 ) else ( return -3 )
    x + 3
)
println(guardNull(null), ":", guardNull(10), ":", guardNonNull(null), ":", guardNonNull(10), ":", guardElse(null), ":", guardElse(10))
}}}}}
-1:11:-2:12:-3:13

{{{{{
;; Safe selector ?. and safe call on nullable, null, and non-nullable error
def Box = class (def v : int) (
    def get = () : int -> ( this.v )
)
def readSafe = (b : Box?) : int? -> ( b?.v )
def callSafe = (b : Box?) : int? -> ( b?.get() )
def nilBox : Box? = null
println(readSafe(null), ":", readSafe(Box(4)), ":", callSafe(null), ":", callSafe(Box(5)), ":", nilBox?.v)
}}}}}
null:4:null:5:null

