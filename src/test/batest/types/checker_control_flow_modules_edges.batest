{{{{{
;; Escaping this from class constructor disables ctor inference; private & interface-impl method inferrability
def holder = object ( def c : any? = null )
def Esc = class (x) (
    def _ = ( holder.c = this )
    def r : int = x + 1
)
}}}}}
Missing type : x

