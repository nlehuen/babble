{{{{{
;; reassignmentJoin and compoundAssignment across locals, params, this, objects, nullables, and functions
def Counter = class () (
    def v : int = 1
    def inc = fn mut (d : int) : int -> (
        this.v += d
        this.v
    )
)
def obj = object ( def n = 2 )
obj.n += 3
def x = 1
x += 2.5
def y = 1
y = null
def z = null
z = "ok"
def f = fn (a : int) : int -> ( a + 1 )
f = fn (a : int) : int -> ( a + 2 )
def c = Counter()
println(c.inc(4), ":", obj.n, ":", x, ":", y, ":", z, ":", f(10))
}}}}}
5:5:3.5:null:ok:12


