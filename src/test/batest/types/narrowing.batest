;; Flow-sensitive type narrowing with 'is', 'not (x is T)', short-circuit 'and'/'or', and early return guards

{{{{{
;; LARGE: legacy test pending refactoring
def Point = class (def x : int) ()
def Pair = class (def x : int, def y : int) ()

def describe = fn (v : Point | Pair | string | null) : string -> (
    if v is Pair then (
        "pair:" + (v.x + v.y)
    ) else if v is Point then (
        "pt:" + v.x
    ) else if v is string then (
        "str:" + v
    ) else (
        "null"
    )
)
println(describe(Point(3)), "|", describe(Pair(4, 5)), "|", describe("ok"), "|", describe(null))
}}}}}
pt:3|pair:9|str:ok|null

{{{{{
;; LARGE: legacy test pending refactoring
;; Logical-path narrowing with short-circuit 'and' / 'or' and negated guard with early return
def Point = class (def x : int) ()
def checkAnd = fn (p : any?) : bool -> ( p is Point and p.x > 0 )
def checkOr = fn (p : any?) : bool -> ( not (p is Point) or p.x > 0 )
def getX = fn (p : any?) : int -> (
    if not (p is Point) then ( return -1 )
    p.x
)
println(checkAnd(Point(2)), ":", checkAnd(Point(-1)), ":", checkAnd(null))
println(checkOr(Point(2)), ":", checkOr(Point(-1)), ":", checkOr("x"))
println(getX(Point(9)), ":", getX("nope"))
}}}}}
true:false:false
true:false:true
9:-1

{{{{{
;; 'is null' and negated narrowing on nullable class
def Box = class (def v : int) ()
def unwrap = fn (b : Box?) : int -> (
    if b == null then ( return 0 )
    b.v
)
println(unwrap(Box(7)), ":", unwrap(null))
}}}}}
7:0

{{{{{
;; Un-narrowed branch member access still rejected statically
def Point = class (def x : int) ()
def bad = fn (p : any) -> (
    if not (p is Point) then ( p.x ) else ( 0 )
)
}}}}}
Not a scope : p

{{{{{
;; LARGE: legacy test pending refactoring
;; Narrowing evicted on while-loop reassignment and branch kill, preserved when unrelated var reassigned
def Point = class (def x : int) ()
def testWhileEvict = fn (p : Point?) : int -> (
    def cur = p
    def n = 0
    if cur != null then (
        def f = fn (): int -> ( n = n + 1 ; n )
        f()
        while n < 2 then (
            cur = null
            n = n + 1
        )
    )
    n
)
def testBranchKill = fn (p : Point?, flag : bool) : int -> (
    def cur = p
    if cur != null then (
        if flag then ( cur = null ) else ( cur.x )
        if cur != null then ( cur.x ) else ( -1 )
    ) else (
        -2
    )
)
println(testWhileEvict(Point(3)), ":", testBranchKill(Point(5), true), ":", testBranchKill(Point(5), false), ":", testBranchKill(null, false))
}}}}}
2:-1:5:-2

{{{{{
;; Reading member after while loop that may reassign narrowed variable fails statically
def Point = class (def x : int) ()
def bad = fn (p : Point?) : int -> (
    def cur = p
    def n = 0
    if cur != null then (
        while n < 1 then (
            cur = null
            n = n + 1
        )
        cur.x
    ) else (
        0
    )
)
}}}}}
Not a scope : cur

{{{{{
;; LARGE: legacy test pending refactoring
;; canMatchAtRuntime & isRuntimeSubtype across interfaces, Java classes, unions, and any
def I1 = interface ( def a = fn () : int -> ( 1 ) )
def I2 = interface ( def b = fn () : int -> ( 2 ) )
def Both = class () implements I1, I2, java.lang.Runnable (
    def run = fn () -> ( )
)
def checkIfaces = fn (x : I1, y : java.lang.Runnable, u : int | string, d : any) : string -> (
    def b1 = x is I2
    def b2 = x is java.lang.Runnable
    def b3 = y is I1
    def b4 = y is java.lang.StringBuilder
    def b5 = u is int
    def b6 = d is string
    def b7 = d is any
    "" + b1 + ":" + b2 + ":" + b3 + ":" + b4 + ":" + b5 + ":" + b6 + ":" + b7
)
def obj = Both()
println(checkIfaces(obj, obj, 42, "hi"))
}}}}}
true:true:true:false:true:true:true

{{{{{
;; canCast across interfaces, unions, int->double, and invalid double->int / null->int
def I1 = interface ()
def I2 = interface ()
def Both = class () implements I1, I2, java.lang.Runnable (
    def run = fn () -> ( )
)
def i1 : I1 = Both()
def r1 : I2 = i1 as I2
def r2 : java.lang.Runnable = i1 as java.lang.Runnable
def r3 : I1 = r2 as I1
def r4 : double = 3 as double
def u : int | string = 5
def r5 : int = u as int
println(r4, ":", r5)
}}}}}
3.0:5

