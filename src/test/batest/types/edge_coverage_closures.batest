{{{{{
;; EffectChecker checkDeclarationPlacement: axiom inside verified constrained function & Invalid axiom on non-function
def f = fn () : int -> (
    axiom pure on java.lang.Math.abs
    1
)
}}}}}
Warning : Deprecated syntax : 'axiom ... on ...' is deprecated, use 'axiom Target: fn ...' instead
axiom declaration is not allowed inside a verified constrained function

{{{{{
def y = 1
def x = axiom on y
}}}}}
Invalid axiom target : expected a Java class, Java method, or function

{{{{{
;; EffectChecker io declaration and io function literal
io on java.lang.System.nanoTime
def f = fn io () : int -> ( 1 )
println(f(), ":", java.lang.System.nanoTime() != 0)
}}}}}
Warning : Deprecated syntax : 'io on ...' is deprecated, use 'axiom Target: fn io' instead
1:true

{{{{{
;; validateAlgebraicSignature errors: monotone on non-ordered type (any)
def f : fn monotone (x : any) : any = fn (x : any) : any -> ( x )
}}}}}
monotone requires ordered parameter and return types without mut

{{{{{
;; validateAlgebraicSignature errors: injective returning null
def f : fn injective (x : int) : null = fn (x : int) : null -> ( null )
}}}}}
injective requires at least one parameter, no mut, and a non-null return type

{{{{{
;; validateAlgebraicSignature errors: commutative with mismatched parameter types
def f : fn commutative (a : int, b : string) : int = fn (a : int, b : string) : int -> ( a )
}}}}}
commutative without mut requires a pure binary (T, T) : R signature

{{{{{
;; validateAlgebraicSignature errors: associative with return type mismatch
def f : fn associative (a : int, b : int) : double = fn (a : int, b : int) : double -> ( a + b )
}}}}}
associative requires a pure binary (T, T) : T signature

{{{{{
;; validateAlgebraicSignature errors: idempotent on 2-arg pure function
def f : fn idempotent (a : int, b : int) : int = fn (a : int, b : int) : int -> ( a + b )
}}}}}
idempotent without mut requires a pure unary (T) : T signature or an effectful axiom

{{{{{
;; binaryWrapperProps: associative string +, commutative double +, non-commutative int -
def sCat : fn associative (a : string, b : string) : string = fn (a : string, b : string) : string -> ( a + b )
def dAdd : fn commutative (a : double, b : double) : double = fn (a : double, b : double) : double -> ( a + b )
println(sCat("a", "b"), ":", dAdd(1.5, 2.5))
}}}}}
