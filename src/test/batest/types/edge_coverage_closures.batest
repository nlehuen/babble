{{{{{
;; isRuntimeSubtype & canMatchAtRuntime across interfaces, Java interfaces, final classes, unions
def I1 = interface ( def a : fn () : int )
def I2 = interface ( def b : fn () : int )
def Both = class () implements I1, I2, java.lang.Runnable (
    def a = fn () : int -> ( 1 )
    def b = fn () : int -> ( 2 )
    def run = fn () -> ( () )
)
def x : I1 = Both()
def r : java.lang.Runnable = Both()
def lst : java.util.List of int = java.util.Collections.singletonList(3)
def cs : java.lang.CharSequence = "abc"
println(x is I2, ":", x is java.lang.Runnable, ":", r is I1, ":", cs is string, ":", lst is java.util.ArrayList, ":", (null as int?) is int)
}}}}}
true:true:true:true:false:false

