;; BIP009-P4 Batch 4d: additional Shared Runtime & Shared Front-End coverage closures

========== ec_mod.ba ==========
export def exportedNum = 42
export def exportedPair = java.util.AbstractMap.SimpleEntry("k", 7)

{{{{{
;; Cross-module unannotated export + JavaClass nested class + JavaClass/JavaObject equals/hashCode
def m = import("ec_mod.ba")
def e = java.util.AbstractMap.SimpleEntry("a", 1)
def p1 = java.awt.Point(1, 2)
def p2 = java.awt.Point(1, 2)
println(m.exportedNum, ":", m.exportedPair.getValue(), ":", e.getKey(), ":", e.getValue(), ":", java.util.Objects.hashCode(java.lang.String) != 0, ":", java.util.Objects.hashCode(p1) == java.util.Objects.hashCode(p2))
}}}}}
42:7:a:1:true:true

{{{{{
;; BabbleInterface extending Java interface checked against super-interface via `is`
def IList = interface extends java.util.Collection of java.lang.Object ()
def Dummy = class () ()
def d : any = Dummy()
println(d is IList, ":", java.lang.String == java.lang.String)
}}}}}
false:true

{{{{{
;; BabbleInstance Member used before definition
def Runner = class () (
    def go = fn (mut b : Box) -> ( b.x = 1 )
)
def Box = class () (
    Runner().go(this)
    def x = 0
)
Box()
}}}}}
Member used before definition : x

