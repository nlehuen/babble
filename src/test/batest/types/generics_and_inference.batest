;; Generics, type inference, widening hints, Java generic bounds, recursive signatures, and unions

{{{{{
;; Generic Babble function value instantiation (to function type & Java SAM) and inference failure
def id(T) = (x : T) : T -> ( x )
def intId : (x : int) : int = id
def strId : (x : string) : string = id
def s = java.util.stream.IntStream.range(1, 4).map(id).sum()
def o = java.util.Optional.of(5).map(id).get()
println(intId(4), ":", strId("ok"), ":", s, ":", o)
}}}}}
4:ok:6:5

{{{{{
def id(T) = (x : T) : T -> ( x )
def bad = id
}}}}}
Missing type : cannot infer type arguments for id

{{{{{
;; Deferred lambda arg + return-type hint fallback + widening hints across union/fn/class/Java
def id(T) = (x : T) : T -> ( x )
def apply(A, B) = (x : A, f : (a : A) : B) : B -> ( f(x) )
def d1 : double = id(1)
def u1 : int | double = id(2)
def r = apply(3, (x) -> ( x * 2.5 ))
def Box(T) = class (def v : T) ()
def opt : java.util.Optional(int) = java.util.Optional.of(5)
def opt2 = opt.map((x) -> ( x + 1 ))
def b1 : Box(double) = Box(3)
def mkPair(A, B) = (a : A, b : B) : A -> ( a )
def p : double = mkPair(2, "z")
println(d1, ":", u1, ":", r, ":", opt2.get(), ":", b1.v, ":", p)
}}}}}
1.0:2:7.5:6:3.0:2.0

{{{{{
;; Generic Java SAM target typing (deferred lambda) + Collections.sort / List.replaceAll
def lenOpt = java.util.Optional.of("abc").map((s) -> ( java.lang.StringBuilder(s).length() )).get()
def fn : java.util.function.Function(string, int) = (s) -> ( java.lang.StringBuilder(s).length() )
def xs : java.util.List(string) = java.util.ArrayList()
xs.add("bb")
xs.add("a")
xs.add("ccc")
java.util.Collections.sort(xs, (a, b) -> ( java.lang.StringBuilder(a).length() - java.lang.StringBuilder(b).length() ))
xs.replaceAll((s) -> ( s + ":" + java.util.Optional.of(s).map(fn).get() ))
println(lenOpt, ":", xs.get(0), ",", xs.get(1), ",", xs.get(2))
}}}}}
3:a:1,bb:2,ccc:3

{{{{{
def fn = java.util.function.Function((s) -> ( s ))
}}}}}
Missing type : cannot infer type arguments for java.util.function.Function

{{{{{
;; Generic interface extending generic interface with default substitution
def BaseI(A) = interface (
    def get : () : A
    def pair = () : java.util.List(A) -> (
        def out : java.util.List(A) = java.util.ArrayList()
        out.add(this.get())
        out
    )
)
def SubI(B) = interface extends BaseI(B) (
    def get2 = () : B -> ( this.get() )
)
def Impl(C) = class (def item : C) implements SubI(C) (
    def get = () : C -> ( this.item )
)
def i : SubI(string) = Impl("hi")
println(i.get(), ":", i.get2(), ":", i.pair().get(0))
}}}}}
hi:hi:hi

