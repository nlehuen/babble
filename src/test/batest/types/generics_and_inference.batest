;; Generics, type inference, widening hints, Java generic bounds, recursive signatures, and unions

{{{{{
;; Generic Babble function value instantiation (to function type & Java SAM) and inference failure
def id of T = fn (x : T) : T -> ( x )
def intId : fn (x : int) : int = id
def strId : fn (x : string) : string = id
def s = java.util.stream.IntStream.range(1, 4).map(id).sum()
def o = java.util.Optional.of(5).map(id).get()
println(intId(4), ":", strId("ok"), ":", s, ":", o)
}}}}}
4:ok:6:5

{{{{{
def id of T = fn (x : T) : T -> ( x )
def bad = id
}}}}}
Missing type : cannot infer type arguments for id

{{{{{
;; Deferred lambda arg + return-type hint fallback + widening hints across union/func/class/Java
def id of T = fn (x : T) : T -> ( x )
def apply of (A, B) = fn (x : A, f : fn (a : A) : B) : B -> ( f(x) )
def d1 : double = id(1)
def u1 : int | double = id(2)
def r = apply(3, fn (x) -> ( x * 2.5 ))
def Box of T = class (def v : T) ()
def opt : java.util.Optional of int = java.util.Optional.of(5)
def opt2 = opt.map(fn (x) -> ( x + 1 ))
def b1 : Box of double = Box(3)
def mkPair of (A, B) = fn (a : A, b : B) : A -> ( a )
def p : double = mkPair(2, "z")
println(d1, ":", u1, ":", r, ":", opt2.get(), ":", b1.v, ":", p)
}}}}}
1.0:2:7.5:6:3.0:2.0

{{{{{
;; Generic Java SAM target typing (deferred lambda) + Collections.sort / List.replaceAll
def lenOpt = java.util.Optional.of("abc").map(fn (s) -> ( java.lang.StringBuilder(s).length() )).get()
def func : java.util.function.Function of (string, int) = fn (s) -> ( java.lang.StringBuilder(s).length() )
def xs : java.util.List of string = java.util.ArrayList()
xs.add("bb")
xs.add("a")
xs.add("ccc")
java.util.Collections.sort(xs, fn (a, b) -> ( java.lang.StringBuilder(a).length() - java.lang.StringBuilder(b).length() ))
xs.replaceAll(fn (s) -> ( s + ":" + java.util.Optional.of(s).map(func).get() ))
println(lenOpt, ":", xs.get(0), ",", xs.get(1), ",", xs.get(2))
}}}}}
3:a:1,bb:2,ccc:3

{{{{{
def func = java.util.function.Function(fn (s) -> ( s ))
}}}}}
Missing type : cannot infer type arguments for java.util.function.Function

{{{{{
;; Generic interface extending generic interface with default substitution
def BaseI of A = interface (
    def get : fn () : A
    def pair = fn () : java.util.List of A -> (
        def out : java.util.List of A = java.util.ArrayList()
        out.add(this.get())
        out
    )
)
def SubI of B = interface extends BaseI of B (
    def get2 = fn () : B -> ( this.get() )
)
def Impl of C = class (def item : C) implements SubI of C (
    def get = fn () : C -> ( this.item )
)
def i : SubI of string = Impl("hi")
println(i.get(), ":", i.get2(), ":", i.pair().get(0))
}}}}}
hi:hi:hi

