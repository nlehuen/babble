{{{{{
;; Unary minus on union int|double and nullable union, plus union of functions call
def negU = (flag : bool) : int | double -> (
    def v : int | double = if flag then ( 3 ) else ( 2.5 )
    -v
)
def f1 = (x : int) : int -> ( x + 1 )
def f2 = (x : int) : double -> ( x * 0.5 )
def pick = (flag : bool) -> (
    def fn = if flag then ( f1 ) else ( f2 )
    fn(4)
)
println(negU(true), ":", negU(false), ":", pick(true), ":", pick(false))
}}}}}
-3:-2.5:5:2.0

{{{{{
;; Calling union containing null fails TypeChecker
def f : ((x : int) : int)? = null
f(1)
}}}}}
f is not callable

{{{{{
;; Widening notes ("because of the assignment" and "because of the call")
def x = 1
def takeInt = (n : int) -> ( n )
takeInt(x)
x = 1.5
}}}}}
Type error : expected int, got double (x is double because of the assignment)

{{{{{
def takeInt = (n : int) -> ( n )
def f = (x) -> (
    takeInt(x)
    x
)
f(1)
f(1.5)
}}}}}
Type error : expected int, got double (x is double because of the call)

{{{{{
;; Java generic bound check rejects non-Comparable Babble class in Collections.max
def Box = class (def x : int) ()
def xs : java.util.List(Box) = java.util.ArrayList()
xs.add(Box(1))
println(java.util.Collections.max(xs))
}}}}}
Type error : type argument Box does not satisfy bound T of java.util.Collections.max

{{{{{
;; Generic union rollback (ConstraintStore.reset) and class-to-SAM assignability
def Box(T) = value class (v : T) ()
def Pair = value class (v : int) ()
def wrap(T) = (x : T) : Box(T) -> ( Box(x) )
def u : string | Box(int) = wrap(42)
def fn : java.util.function.Function(int, Pair) = Pair
def a = 1
a = 2.5
def b = null
b = "ok"
def uv = if u is Box then ( u.v ) else ( 0 )
println(uv, ":", fn.apply(7).v, ":", a, ":", b)
}}}}}
42:7:2.5:ok
