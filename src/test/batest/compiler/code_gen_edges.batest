{{{{{
;; CodeGenerator compound assignment boxed/fallback branches (local /=, this./=, dyn +=, static /=)
;; and condition/negate/binary lowering
def C = class (def n : int, def d : double, def b : bool) (
    def run = mut () : string -> (
        def dynNum = (v : int | double) : int | double -> ( v )
        def loc : int | double = 9
        loc /= 2
        loc += dynNum(2)
        this.n *= 2
        this.n -= 1
        this.d /= 2
        this.d += dynNum(2)
        "" + loc + ":" + this.n + ":" + this.d
    )
)
println(C(9, 6.0, true).run())

def StaticBox = class () () static (
    def sx : int | double = 9
    def go = () : int | double -> (
        this.sx /= 2
        this.sx
    )
)
println(StaticBox.go())

def neg = (a : int, b : double, c : int | double) : string -> (
    def ia = -a
    def db = -b
    def dc = -c
    "" + ia + ":" + db + ":" + dc
)
println(neg(4, 1.5, 9))

def checkConds = (a : int, b : int, d1 : double, d2 : double) : string -> (
    def out = ""
    if a == b then ( out += "1" ) else ( out += "0" )
    if a != b then ( out += "1" ) else ( out += "0" )
    if d1 == d2 then ( out += "1" ) else ( out += "0" )
    if d1 != d2 then ( out += "1" ) else ( out += "0" )
    if d1 < d2 then ( out += "1" ) else ( out += "0" )
    if d1 <= d2 then ( out += "1" ) else ( out += "0" )
    if d1 > d2 then ( out += "1" ) else ( out += "0" )
    if d1 >= d2 then ( out += "1" ) else ( out += "0" )
    if a > 0 and b > 0 then ( out += "1" ) else ( out += "0" )
    if a < 0 or b < 0 then ( out += "1" ) else ( out += "0" )
    out
)
println(checkConds(2, 2, 1.0, 2.0), ":", checkConds(2, 3, 2.0, 1.0))
}}}}}
