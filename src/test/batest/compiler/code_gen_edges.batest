{{{{{
;; this.field compound assign, union primitive field SelectCache, BabbleInterface 2-level super/extends,
;; Bootstrap BoundMethod(CompiledFunction) direct & TypedCallCache 0-arg BoundJavaMethod, Java compound assign
def Counter = class (def n : int) (
    def bump = mut (d : int) : int -> ( this.n += d ; this.n )
)
def ctr = Counter(10)

def UA = class (def v : int) ()
def UB = class (def v : int) ()
def pickU = (flag : bool) : UA | UB -> ( if flag then ( UA(3) ) else ( UB(7) ) )

def G0 = interface (
    def deep = () : string -> ( "g0" )
)
def G1 = interface extends G0 ()
def G2 = interface extends G1 ()
def GG = class () implements G2 (
    def deep = () : string -> ( super(G2).deep() + ":gg" )
)
def SubP = interface extends java.util.function.IntPredicate (
    def test = (x : int) : bool -> ( x > 0 )
)
def SubPC = class () implements SubP ()
def sp = SubPC()
def dyn = (v : any) : any -> ( v )
def gVal : G0 = dyn(GG()) as G0

def IfaceDef = interface (
    def defm = (x : int | string) : any -> ( x )
)
def CDef = class () implements IfaceDef ()
def callAny : (x : int) : any = CDef().defm
def sb = java.lang.StringBuilder("abc")
def sbLen : () : int = sb.length

def tk = java.io.StreamTokenizer(java.io.StringReader("1"))
tk.nval = 1.5
tk.nval += 2.0
tk.ttype = 10
tk.ttype += 5

println(ctr.bump(5), ":", pickU(true).v, ":", pickU(false).v, ":", gVal.deep(), ":", GG() is G0, ":", GG() is G1, ":", sp is java.util.function.IntPredicate, ":", callAny(42), ":", sbLen(), ":", tk.nval, ":", tk.ttype)
}}}}}
