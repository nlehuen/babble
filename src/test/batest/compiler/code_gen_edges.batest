;; Exceed MAX_DEPTH (4) in SelectCache, CallCache, and TypedCallCache
def HasV = interface ( def getV : fn () : int )
def S1 = class (def v : int) implements HasV ( def getV = fn () : int -> ( this.v ) )
def S2 = class (def v : int) implements HasV ( def getV = fn () : int -> ( this.v ) )
def S3 = class (def v : int) implements HasV ( def getV = fn () : int -> ( this.v ) )
def S4 = class (def v : int) implements HasV ( def getV = fn () : int -> ( this.v ) )
def S5 = class (def v : int) implements HasV ( def getV = fn () : int -> ( this.v ) )
def S6 = class (def v : int) implements HasV ( def getV = fn () : int -> ( this.v ) )
def pickObj = fn (k : int) : HasV -> (
    if k == 0 then ( S1(1) )
    else if k == 1 then ( S2(2) )
    else if k == 2 then ( S3(3) )
    else if k == 3 then ( S4(4) )
    else if k == 4 then ( S5(5) )
    else ( S6(6) )
)
def ssum = 0
def i = 0
while i < 6 then (
    ssum += pickObj(i).getV()
    i += 1
)

def f1 = fn (x : int) : int -> ( x + 1 )
def f2 = fn (x : int) : int -> ( x + 2 )
def f3 = fn (x : int) : int -> ( x + 3 )
def f4 = fn (x : int) : int -> ( x + 4 )
def f5 = fn (x : int) : int -> ( x + 5 )
def f6 = fn (x : int) : int -> ( x + 6 )
def pickFn = fn (k : int) : fn (x : int) : int -> (
    if k == 0 then ( f1 )
    else if k == 1 then ( f2 )
    else if k == 2 then ( f3 )
    else if k == 3 then ( f4 )
    else if k == 4 then ( f5 )
    else ( f6 )
)
def g1 = fn (x : int, y : int = 0) : int -> ( x + y + 1 )
def g2 = fn (x : int, y : int = 0) : int -> ( x + y + 2 )
def g3 = fn (x : int, y : int = 0) : int -> ( x + y + 3 )
def g4 = fn (x : int, y : int = 0) : int -> ( x + y + 4 )
def g5 = fn (x : int, y : int = 0) : int -> ( x + y + 5 )
def g6 = fn (x : int, y : int = 0) : int -> ( x + y + 6 )
def pickOpt = fn (k : int) : fn (x : int) : int -> (
    if k == 0 then ( g1 )
    else if k == 1 then ( g2 )
    else if k == 2 then ( g3 )
    else if k == 3 then ( g4 )
    else if k == 4 then ( g5 )
    else ( g6 )
)
def fsum = 0
i = 0
while i < 6 then (
    def func = pickFn(i)
    fsum += func(10)
    def opt = pickOpt(i)
    fsum += opt(0)
    i += 1
)
println(ssum, ":", fsum)
}}}}}
