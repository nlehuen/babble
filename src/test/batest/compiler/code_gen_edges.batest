{{{{{
;; Bootstrap CallCache & TypedCallCache polymorphic predicate guards (isFunction, isBoundFunction, isBoundFunctionSpec, isBoundMethod)
;; plus SelectCache javaDefaultMethods miss on BabbleInstance & BabbleInstance operatorCall/neg/arithmetic
def I1 = interface (
    def dmSpec = (x : int) : int -> ( x + 100 )
    def dmSpread = (x : int, y : int = 10) : int -> ( x + y + 100 )
)
def I2 = interface (
    def dmSpec2 = (x : int) : int -> ( x + 200 )
    def dmSpread2 = (x : int, y : int = 20) : int -> ( x + y + 200 )
)
def Impl1 = class (def bias : int) implements I1, java.util.Comparator(int) (
    def mSpec = (x : int) : int -> ( x + this.bias )
    def mSpread = (x : int, y : int = 1) : int -> ( x + y + this.bias )
    def compare = (a : int, b : int) : int -> ( a - b )
)
def Impl2 = class (def bias : int) implements I2 (
    def mSpec2 = (x : int) : int -> ( x + this.bias )
    def mSpread2 = (x : int, y : int = 2) : int -> ( x + y + this.bias )
)
def c1 = Impl1(10)
def c2 = Impl2(20)
def fSpec = (x : int) : int -> ( x + 1 )
def fSpec2 = (x : int) : int -> ( x + 2 )
def fSpread = (x : int, y : int = 3) : int -> ( x + y )
def fSpread2 = (x : int, y : int = 4) : int -> ( x + y )

def totalCall = 0
def totalTyped = 0
def pass = 0
while pass < 2 then (
    def i = 0
    while i < 4 then (
        def fnSpread : (x : int) : int = if i == 0 then ( c1.dmSpread ) else if i == 1 then ( c2.dmSpread2 ) else if i == 2 then ( c1.mSpread ) else ( fSpread )
        totalCall += fnSpread(i)

