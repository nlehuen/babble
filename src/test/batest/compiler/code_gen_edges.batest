    def neg = () : Vec -> ( Vec(-this.n) )
    def plus = (o : any) : Vec -> ( Vec(this.n + (o as int)) )
    def minus = (o : any) : Vec -> ( Vec(this.n - (o as int)) )
    def times = (o : any) : Vec -> ( Vec(this.n * (o as int)) )
    def div = (o : any) : Vec -> ( Vec(int(this.n / (o as int))) )
)
