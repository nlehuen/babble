def hits = 0
if d < 3.0 then ( hits += 1 )
if d <= 2.5 then ( hits += 1 )
if d == 2.5 then ( hits += 1 )
if d != 1.0 then ( hits += 1 )
if d >= 2.5 then ( hits += 1 )
if d > 2.0 then ( hits += 1 )
