{{{{{
;; this.method(...) direct spec, spread direct (with missing optional arg), named-arg method,
;; recurse with omitted optional arg inside class method, boxed field assign, spread-to-double field assign,
;; and method capturing enclosing mutable cell (methodClass != null in loadCapturedCells)
def enclosing = 10
def C = class (def d : double, def label : string) (
    def specM = (a : int) : int -> ( a + 1 )
    def optM = (a : int, b : int = 10) : int -> ( a + b )
    def recOpt = (n : int, step : int = 1) : int -> (
        if n <= 0 then ( 0 ) else ( step + recurse(n - 1) )
    )
    def runAll = mut () : string -> (
        this.label = "abc"
        this.label += "!"
        this.d = this.optM(1)
        enclosing += 1
        "" + this.specM(2) + ":" + this.optM(2) + ":" + this.optM(a: 3) + ":" + this.recOpt(3) + ":" + this.d + ":" + this.label + ":" + enclosing
    )
)
println(C(0.0, "init").runAll())
}}}}}
