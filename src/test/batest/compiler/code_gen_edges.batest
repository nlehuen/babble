{{{{{
;; CodeGenerator compound assignment boxed/fallback branches (local /=, this./=, dyn +=, static /=)
;; and condition/negate/binary lowering
def C = class (def n : int, def d : double, def b : bool) (
    def run = mut () : string -> (
        def dynNum = (v : int | double) : int | double -> ( v )
        def loc : int | double = 9
        loc /= 2
        loc += dynNum(2)
        this.n *= 2
        this.n -= 1
        this.d /= 2
        this.d += dynNum(2)
        "" + loc + ":" + this.n + ":" + this.d
    )
)
println(C(9, 6.0, true).run())

def StaticBox = class () () static (
    def sx : int | double = 9
    def go = () : int | double -> (
        this.sx /= 2
        this.sx
    )
)
