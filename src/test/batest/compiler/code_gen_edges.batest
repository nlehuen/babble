{{{{{
;; Loop calls to exercise Bootstrap isBoundFunction, isBoundFunctionSpec, boundFunction, isSame,
;; and CodeGenerator Java field assign/compound assign (float, int, double, String, typed Object, boxed fallback)
def extSpec = (x : int) : int -> ( x + 10 )
def extSpread = (x : int, y : int = 5) : int -> ( x + y )
def Holder = class () (
    def ms = extSpec
    def md = extSpread
)
def h = Holder()
def bmSpec : (x : int) : int = h.ms
def bmDirect = h.md
def s1 = 0
def s2 = 0
def i = 0
while i < 3 then (
    s1 += bmSpec(i)
    s2 += bmDirect(i)
    def eof = java.io.StreamTokenizer(java.io.StringReader("x")).TT_EOF
    s1 += eof
    i += 1
)
println(s1, ":", s2)

def pf = java.awt.geom.Point2D.Float()
pf.x = java.lang.Float.valueOf(3)
pf.y = java.lang.Float.valueOf(4)
def dynNum = (v : int | double) : int | double -> ( v )
def pt = java.awt.Point(1, 2)
pt.x = 5
pt.x += 3
pt.x *= 2
pt.y += 2
def tk = java.io.StreamTokenizer(java.io.StringReader("hi"))
tk.nval = 1.5
tk.nval += 2
tk.nval += dynNum(2)
tk.sval = "a"
tk.sval += "b"
def gbc = java.awt.GridBagConstraints()
gbc.insets = java.awt.Insets(1, 2, 3, 4)
gbc.weightx = 2.0
gbc.weightx += 1
println(pf.x, ":", pt.x, ":", pt.y, ":", tk.nval, ":", tk.sval, ":", gbc.insets.top, ":", gbc.weightx)
}}}}}
