def checkConds = (a : int, b : int, d1 : double, d2 : double) : string -> (
    def out = ""
    if a == b then ( out += "1" ) else ( out += "0" )
    if a != b then ( out += "1" ) else ( out += "0" )
    if d1 == d2 then ( out += "1" ) else ( out += "0" )
    if d1 != d2 then ( out += "1" ) else ( out += "0" )
    if d1 < d2 then ( out += "1" ) else ( out += "0" )
    if d1 <= d2 then ( out += "1" ) else ( out += "0" )
    if d1 > d2 then ( out += "1" ) else ( out += "0" )
    if d1 >= d2 then ( out += "1" ) else ( out += "0" )
    if a > 0 and b > 0 then ( out += "1" ) else ( out += "0" )
    if a < 0 or b < 0 then ( out += "1" ) else ( out += "0" )
    out
)
println(checkConds(2, 2, 1.0, 2.0), ":", checkConds(2, 3, 2.0, 1.0))
}}}}}
