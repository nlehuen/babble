{{{{{
;; Constructor package scope, static package scope, and static block `this` assign / compound assign
def C = class () (
    package inner (
        def v = 7
    )
    def getV = () : int -> ( inner.v )
) static (
    package sp (
        def k = 5
    )
    def x = 1
    def bump = () : string -> (
        this.x = 2
        this.x += 3
        "" + this.x + ":" + sp.k
    )
    def me = () -> ( this )
)
println(C().getV(), ":", C.bump(), ":", C.me() == C)
}}}}}
