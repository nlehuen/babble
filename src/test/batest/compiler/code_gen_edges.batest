def c2 = Impl2(20)
def fSpec = fn (x : int) : int -> ( x + 1 )
def fSpec2 = fn (x : int) : int -> ( x + 2 )
def fSpread = fn (x : int, y : int = 3) : int -> ( x + y )
def fSpread2 = fn (x : int, y : int = 4) : int -> ( x + y )

def totalCall = 0
def totalTyped = 0
def pass = 0
while pass < 2 then (
    def i = 0
    while i < 4 then (
        def fnSpread : fn (x : int) : int = if i == 0 then ( c1.dmSpread ) else if i == 1 then ( c2.dmSpread2 ) else if i == 2 then ( c1.mSpread ) else ( fSpread )
        totalCall += fnSpread(i)

        def fnSpreadB : fn (x : int) : int = if i == 0 then ( c1.mSpread ) else if i == 1 then ( c2.mSpread2 ) else if i == 2 then ( fSpread ) else ( fSpread2 )
        totalCall += fnSpreadB(i)

        def fnSpec : fn (x : int) : int = if i == 0 then ( c1.dmSpec ) else if i == 1 then ( c2.dmSpec2 ) else if i == 2 then ( c1.mSpec ) else ( fSpec )
        totalTyped += fnSpec(i)

        def fnSpecB : fn (x : int) : int = if i == 0 then ( c1.mSpec ) else if i == 1 then ( c2.mSpec2 ) else if i == 2 then ( fSpec ) else ( fSpec2 )
        totalTyped += fnSpecB(i)
        i += 1
    )
    pass += 1
)

def rev1 = c1.reversed()
def rev2 = c1.reversed()

def Vec = class (def n : int) (
    def neg = fn () : Vec -> ( Vec(-this.n) )
    def plus = fn (o : any) : Vec -> ( Vec(this.n + (o as int)) )
    def minus = fn (o : any) : Vec -> ( Vec(this.n - (o as int)) )
    def times = fn (o : any) : Vec -> ( Vec(this.n * (o as int)) )
    def div = fn (o : any) : Vec -> ( Vec(int(this.n / (o as int))) )
)
def v = Vec(10)
def negV = -v
def negI = -(1 + 1)
def vPlus = v + 2
def vMinus = v - 3
def vTimes = v * 4
def vDiv = v / 2
def vComp = Vec(5)
vComp += 3

println(totalCall, ":", totalTyped, ":", rev1.compare(1, 5) > 0, ":", rev2.compare(5, 1) > 0, ":", negV.n, ":", negI, ":", vPlus.n, ":", vMinus.n, ":", vTimes.n, ":", vDiv.n, ":", vComp.n)
}}}}}
