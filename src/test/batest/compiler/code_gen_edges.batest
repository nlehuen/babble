{{{{{
;; Bootstrap BoundMethod(CompiledFunction) spec/direct, TypedCallCache 0-arg, and MAX_DEPTH (>4) caches
def extSpec = (x : int) : int -> ( x + 10 )
def extSpread = (x : int, y : int = 5) : int -> ( x + y )
def Holder = class () (
    def ms = extSpec
    def md = extSpread
)
def h = Holder()
def bmSpec : (x : int) : int = h.ms
def bmDirect = h.md
println(bmSpec(4), ":", bmDirect(4))

def Z = class () ()
def makeZ : () : Z = Z
def z = makeZ()
println(classof(z) == Z)

;; Exceed MAX_DEPTH (4) in SelectCache, CallCache, and TypedCallCache
def HasV = interface ( def getV : () : int )
def S1 = class (def v : int) implements HasV ( def getV = () : int -> ( this.v ) )
def S2 = class (def v : int) implements HasV ( def getV = () : int -> ( this.v ) )
def S3 = class (def v : int) implements HasV ( def getV = () : int -> ( this.v ) )
def S4 = class (def v : int) implements HasV ( def getV = () : int -> ( this.v ) )
def S5 = class (def v : int) implements HasV ( def getV = () : int -> ( this.v ) )
def S6 = class (def v : int) implements HasV ( def getV = () : int -> ( this.v ) )
def pickObj = (k : int) : HasV -> (
    if k == 0 then ( S1(1) )
    else if k == 1 then ( S2(2) )
    else if k == 2 then ( S3(3) )
    else if k == 3 then ( S4(4) )
    else if k == 4 then ( S5(5) )
    else ( S6(6) )
)
def ssum = 0
def i = 0
while i < 6 then (
    ssum += pickObj(i).getV()
    i += 1
)

def f1 = (x : int) : int -> ( x + 1 )
def f2 = (x : int) : int -> ( x + 2 )
def f3 = (x : int) : int -> ( x + 3 )
def f4 = (x : int) : int -> ( x + 4 )
def f5 = (x : int) : int -> ( x + 5 )
def f6 = (x : int) : int -> ( x + 6 )
def pickFn = (k : int) : (x : int) : int -> (
    if k == 0 then ( f1 )
    else if k == 1 then ( f2 )
    else if k == 2 then ( f3 )
    else if k == 3 then ( f4 )
    else if k == 4 then ( f5 )
    else ( f6 )
)
def g1 = (x : int, y : int = 0) : int -> ( x + y + 1 )
def g2 = (x : int, y : int = 0) : int -> ( x + y + 2 )
def g3 = (x : int, y : int = 0) : int -> ( x + y + 3 )
def g4 = (x : int, y : int = 0) : int -> ( x + y + 4 )
def g5 = (x : int, y : int = 0) : int -> ( x + y + 5 )
def g6 = (x : int, y : int = 0) : int -> ( x + y + 6 )
def pickOpt = (k : int) : (x : int) : int -> (
    if k == 0 then ( g1 )
    else if k == 1 then ( g2 )
    else if k == 2 then ( g3 )
    else if k == 3 then ( g4 )
    else if k == 4 then ( g5 )
    else ( g6 )
)
def fsum = 0
i = 0
while i < 6 then (
    def fn = pickFn(i)
    fsum += fn(10)
    def opt = pickOpt(i)
    fsum += opt(0)
    i += 1
)
println(ssum, ":", fsum)
}}}}}
