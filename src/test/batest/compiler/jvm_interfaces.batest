{{{{{
;; Multi-input REPL session sharing compiled JVM interfaces and classes across ScriptClassLoaders
def Measurable = interface (
    def measure : () : int
    def doubled = () : int -> ( this.measure() * 2 )
)
def Boxed = class (n : int) implements Measurable (
    def measure = () : int -> ( n )
)
def evalM = (m : Measurable) : int -> ( m.measure() + m.doubled() )
println(evalM(Boxed(4)))
----------
def Extra = class (a : int, b : int) implements Measurable (
    def measure = () : int -> ( a + b )
    def doubled = () : int -> ( super.doubled() + 1 )
)
def e : Measurable = Extra(2, 3)
println(evalM(e), ":", (e is Measurable), ":", (e is Extra), ":", (e is Boxed))
}}}}}
