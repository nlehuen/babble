{{{{{
;; Interface override adding optional defaulted parameters and dispatch through base signature
def Unary = interface (
    def apply : (x : int) : int
)
def WithOptional = interface extends Unary (
    def apply = (x : int, step : int = 10) : int -> ( x + step )
)
def DefaultImpl = class () implements WithOptional ()
def CustomImpl = class () implements WithOptional (
    def apply = (x : int, step : int = 25) : int -> ( x + step )
)
def u1 : Unary = DefaultImpl()
def w1 : WithOptional = DefaultImpl()
def u2 : Unary = CustomImpl()
def w2 : WithOptional = CustomImpl()
println(u1.apply(5), ":", w1.apply(5, 2), ":", u2.apply(5), ":", w2.apply(5, 3))
}}}}}
