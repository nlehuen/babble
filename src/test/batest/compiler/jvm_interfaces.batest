{{{{{
;; Diamond inheritance and sibling abstract + default resolution (JVMS 5.4.3.3 bridge conflict prevention)
def Base = interface (
    def id = (x : int) : int -> ( x + 1 )
)
def Left = interface extends Base ()
def Right = interface extends Base ()
def Diamond = interface extends Left, Right ()
def DiamondImpl = class () implements Diamond ()

def AbsA = interface (
    def f : (x : int) : int
)
def DefB = interface (
    def f = (x : int) : int -> ( x * 3 )
)
def Combined = interface extends AbsA, DefB ()
def CombinedImpl = class () implements Combined ()

def d : Diamond = DiamondImpl()
def cb : Combined = CombinedImpl()
def ca : AbsA = CombinedImpl()
println(d.id(9), ":", cb.f(7), ":", ca.f(7), ":", (d is Base), ":", (cb is AbsA), ":", (cb is DefB))
}}}}}
10:21:21:true:true:true

{{{{{
;; Re-abstracted default method hidden along one branch and supplied along a sibling branch
def Root = interface (
    def val : () : int = () : int -> ( 42 )
)
def ReAbstracted = interface extends Root (
    def val : () : int
)
def Kept = interface extends Root ()
def Sub = interface extends ReAbstracted, Kept ()
def Impl = class () implements Sub ()
def r : ReAbstracted = Impl()
def s : Sub = Impl()
println(r.val(), ":", s.val())
}}}}}
42:42

{{{{{
;; Re-abstracted interface default without sibling provider still requires implementation
def Root = interface (
    def val : () : int = () : int -> ( 42 )
)
def ReAbstracted = interface extends Root (
    def val : () : int
)
def Bad = class () implements ReAbstracted ()
}}}}}
Bad does not implement ReAbstracted.val

{{{{{
;; Generic Box(T) interface with primitive specializations, Box(double) int widening, and emitAs widened-int expression
def Box(T) = interface (
    def get : () : T
    def transform : (x : T) : T = (x : T) : T -> ( x )
)
def IntBox = class (v : int) implements Box(int) (
    def get = () : int -> ( v )
    def transform = (x : int) : int -> ( x + v )
)
def DoubleBox = class (v : double) implements Box(double) (
    def get = () : double -> ( v )
    def transform = (x : double) : double -> ( x + v )
)
def ib : Box(int) = IntBox(10)
def db : Box(double) = DoubleBox(0.5)
def cond = true
;; If-expression of ints widened to double and passed to a primitive-double receiver
def takeDouble = interface (
    def accept : (d : double) : double
)
def Sink = class () implements takeDouble (
    def accept = (d : double) : double -> ( d * 2.0 )
)
def sink : takeDouble = Sink()
def boxedIntExpr = if cond then ( def a = 3 ; a ) else ( 4 )
println(ib.get(), ":", ib.transform(5), ":", db.get(), ":", db.transform(4), ":", sink.accept(boxedIntExpr))
}}}}}
