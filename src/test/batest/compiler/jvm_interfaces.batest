{{{{{
;; Nested lambdas calling super.m() and super(Parent).m() inside both interface defaults and class methods
def P1 = interface (
    def score : (x : int) : int = (x : int) : int -> ( x + 10 )
)
def P2 = interface (
    def score : (x : int) : int = (x : int) : int -> ( x * 10 )
)
def ChildIface = interface extends P1, P2 (
    def score : (x : int) : int = (x : int) : int -> (
        def thunk = () : int -> ( super(P1).score(x) + super(P2).score(x) )
        thunk()
    )
)
def ChildClass = class (bonus : int) implements ChildIface (
    def score : (x : int) : int = (x : int) : int -> (
        def inner = (k : int) : int -> ( super.score(x) + k + bonus )
        inner(1)
    )
)
def ci : ChildIface = ChildClass(5)
println(ci.score(3))
}}}}}
49

{{{{{
;; Cross-module JVM interface implementation, dispatch, super, and `is` checks
def shapes = import("shapes.ba")
def Rect = class (w : double, h : double) implements shapes.Shape (
    def area = () : double -> ( w * h )
    def scale = (f : double) : double -> ( super.scale(f) + 1.0 )
)
def s1 : shapes.Shape = shapes.Circle(2.0)
def s2 : shapes.Shape = Rect(3.0, 4.0)
def t : shapes.Tag = shapes.Tagged("ok")
println(s1.area(), ":", s1.scale(2.0), ":", s2.scale(2.0), ":", (s1 is shapes.Circle), ":", (s2 is shapes.Shape), ":", t.label(), ":", (t is shapes.Tagged))
}}}}}
