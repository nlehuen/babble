{{{{{
;; Field-holding-function implementation and super default call in class implementing interface
def Op = interface (
    def run : (x : int) : int
    def base = (x : int) : int -> ( x + 100 )
)
def FieldImpl = class (fn : (x : int) : int) implements Op (
    def run = fn
)
def NsImpl = class (delta : int) implements Op (
    def run = (x : int) : int -> ( super.base(x) + delta )
)
def f : Op = FieldImpl((x : int) : int -> ( x * 4 ))
def n : Op = NsImpl(7)
println(f.run(6), ":", f.base(6), ":", n.run(6), ":", (n is NsImpl), ":", (n is Op))
}}}}}
