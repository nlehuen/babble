;; RM003-P2: Babble interfaces compiled to JVM interfaces with INVOKEINTERFACE, INSTANCEOF, and INVOKESPECIAL

========== shapes.ba ==========
export def Shape = interface (
    def area : () : double
    def scale : (factor : double) : double = (factor : double) : double -> ( this.area() * factor )
)

export def Circle = value class (r : double) implements Shape (
    def area = () : double -> ( 3.0 * this.r * this.r )
)

export def Tag = interface (
    def label = () : string -> ( "tag" )
)
export def Tagged = class (name : string) implements Tag (
    def label = () : string -> ( super.label() + ":" + name )
)

{{{{{
;; Primitive & reference interface methods, defaults calling abstract methods on `this`, and `is` checks
def Calc = interface (
    def compute : (a : int, b : double, negate : bool) : double
    def check = (x : int) : double -> ( this.compute(x, 2.5, false) + this.compute(x, 0.5, true) )
)
def Impl = class (bias : double) implements Calc (
    def compute = (a : int, b : double, negate : bool) : double -> (
        def v = a + b + bias
        if negate then ( -v ) else ( v )
    )
)
def c : Calc = Impl(1.0)
println(c.compute(3, 1.5, false), ":", c.check(4), ":", (c is Calc), ":", (c is Impl), ":", ("no" is Calc))
}}}}}
5.5:2.0:true:true:false

{{{{{
;; Multi-evaluation closure-capturing interface factory: each BabbleInterface keeps its own captured cell
def makeAdder = (offset : int) -> (
    def I = interface (
        def add = (x : int) : int -> ( x + offset )
    )
    def C = class (mul : int) implements I (
        def run = (x : int) : int -> ( super.add(x) * mul )
    )
    object (
        def eval = (m : int, x : int) : int -> (
            def inst = C(m)
            def asI : I = inst
            asI.add(x) + inst.run(x)
        )
    )
)
def a10 = makeAdder(10)
def a100 = makeAdder(100)
println(a10.eval(2, 5), ":", a100.eval(3, 5))
}}}}}
