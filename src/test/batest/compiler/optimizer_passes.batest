{{{{{
;; LARGE: legacy test pending refactoring
;; HirLicmPass & HirPurity: while + for loops hoisting pure invariant calls, math/record fields, array.size, logic, if, block; rejecting impure/throwing
def Vec = record (x: double, y: double) (
    def len = fn nothrow (): double -> (java.lang.Math.hypot(this.x, this.y))
)
def heavy = fn (x: double): double -> (java.lang.Math.sin(x) * java.lang.Math.cos(x))
def tickCount = 0
def tick = fn io (): int -> (tickCount += 1 ; tickCount)

def runLoops = fn io (n: int, v: Vec, xs: array of int, flag: bool): string -> (
    def acc = 0.0
    def i = 0
    while i < n then (
        def h = heavy(v.x)
        def m = java.lang.Math.hypot(v.x, v.y)
        def neg = -v.y
        def condVal = if flag and (xs.size() > 0) then (1.5) else (2.5)
        def blkVal = (def t = v.x * 2.0 ; t)
        acc = acc + h + m + neg + condVal + blkVal
        i += 1
    )
    for e in xs then (
        acc = acc + heavy(v.y) + double(e) + (if e < 0 then (-v.x) else (0.0))
    )
    def unsafeDiv = 0
    def j = 0
    while j < 0 then (
        unsafeDiv += java.lang.Math.floorDiv(10, j)
        j += 1
    )
    def ticks = 0
    def k = 0
    while k < 3 then (
        ticks += tick()
        k += 1
    )
    "" + java.lang.Math.round(acc * 100.0) + ":" + unsafeDiv + ":" + ticks
)
println(runLoops(3, Vec(3.0, 4.0), array.of(1, 2), true))
}}}}}
