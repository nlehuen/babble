;; LARGE: legacy test pending refactoring
;; ConstFoldPass (if-prune widening/convertConstToKind, logic non-bool RHS, string fold) + AlgebraicSimplifyPass + InlinePass
def tick = 0
def bump = fn io (): int -> (tick += 1 ; tick)
def widenSinkD = fn (v: double): double -> (v + 0.5)
def smallWhile = fn (x: int): int -> (def i = x ; while i < 3 then (i += 1) ; i)
def testConstEdge = fn io (p: int, opt: int?): string -> (
    def wL: long = if true then (4 + 2) else (1L)
    def wF: float = if true then (3 + 2) else (1.5f)
    def wD: double = if true then (7 + 1) else (2.5)
    def wBl: double = if true then (p + 1) else (p + 2)
    def wArgD = widenSinkD(if true then (p + 1) else (p + 2))
    def strFold = "hello" + " world"
    def mLong = java.lang.Math.min(2L, 5L)
    def mFloat = java.lang.Math.max(1.5f, 2.5f)
    def nonBoolL1: any? = true and opt
    def nonBoolL2: any? = false or opt
    def notNonBool = not (not opt)
    def impMulL = bump() * 0
    def impMulR = 0 * bump()
    def impAdd = 1 + bump()
    def impMulC = 2 * bump()
    def nonConstIf = if p > 0 then (1) else (2)
    def sw = smallWhile(p)
    "" + wL + ":" + wF + ":" + wD + ":" + wBl + ":" + wArgD + ":" + strFold + ":" + mLong + ":" + mFloat + ":" + nonBoolL1 + ":" + nonBoolL2 + ":" + notNonBool + ":" + (impMulL + impMulR + impAdd + impMulC + nonConstIf) + ":" + sw
)
println(testConstEdge(2, 9))
}}}}}
