{{{{{
;; LARGE: legacy test pending refactoring
;; Record-based HirLicmPass (hoistFromWhile + hoistFromFor + ThisRef + ThisFieldGet + DirectBabbleCall + effectiveKind 1..5)
def idByte = fn nothrow (x: byte): byte -> (x)
def idInt = fn nothrow (x: int): int -> (x)
def idFloat = fn nothrow (x: float): float -> (x)
def sink = fn nothrow (v: double): double -> (v)
def RecVec = record (a: byte, i: int, d: double, flag: bool, s: string, arr: frozen array of int) (
    def runRec = fn (n: int): double -> (
        def acc = 0.0
        def k = 0
        def fnDyn = fn (v: double): double -> (java.lang.Math.sin(v))
        while k < n then (
            def hs: short = idByte(this.a)
            def hi: int = idByte(this.a)
            def hl: long = idInt(this.i)
            def hf: float = idInt(this.i)
            def hd: double = idFloat(float(this.i))
            def sinSum = java.lang.Math.sin(this.d) + java.lang.Math.cos(this.d)
            def negSin = -java.lang.Math.sin(this.d)
            def dynCall = fnDyn(this.d)
            def logicExpr = if this.flag and (this.arr.size() > 0) then (1.0) else (2.0)
            def strVal = ("  " + this.s + "  ").trim().length()
            def asVal = (this.a as double) + double(idInt(1))
            def blkVal = (1 + 2) + idInt(this.i)
            def divVal = (this.d + 1.0) / 2.0
            def sinkVal = sink((this.a as double) + (if this.flag and (this.i > 0) or (not this.flag) then (1.0) else (2.0)))
            acc = acc + double(hs) + double(hi) + double(hl) + double(hf) + hd + sinSum + negSin + dynCall + logicExpr + double(strVal) + asVal + double(blkVal) + divVal + sinkVal
            k += 1
        )
        for e in this.arr then (
            acc = acc + (java.lang.Math.sin(this.d) + java.lang.Math.cos(this.d)) + double(e)
        )
        acc
    )
)
println(java.lang.Math.round(RecVec(byte(2), 3, 1.0, true, "hi", freeze(array.of(5, 6))).runRec(2) * 100.0))
