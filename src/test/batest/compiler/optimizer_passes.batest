{{{{{
;; LARGE: legacy test pending refactoring
;; HirPurity.collectModifiedVars & TypeApply + InlinePass.scanCalleeBody guards
def topMut = 0
topMut = 1
def bigId of T = fn nothrow (x: T): T -> (
    def a = x ; def b = a ; def c = b ; def d = c ; def e = d ; def f = e ; def g = f ; def h = g
    def i = h ; def j = i ; def k = j ; def l = k ; def m = l ; def n = m ; n
)
def BaseI = interface (
    def bm = fn (x: int): int -> (x + 1)
)
def MutC = class (def mf: int) implements BaseI (
    def helperM = fn (x: int): int -> (this.mf + x)
    def runWhile = fn mut io (n: int): int -> (
        def i = 0
        def s = 0
        while i < n then (
            topMut += 1
            this.mf += 1
            def hm = this.helperM(1)
            def sm = super.bm(2)
            def optS: string? = "ab"
            def nn = optS!.length()
            def gv = (bigId of int)(4)
            def sb = java.lang.StringBuilder("x")
            def lst = list(1, 2)
            def fnL = fn (z: int): int -> (z + 1)
            def ClsL = class (def v: int) ()
            def IfcL = interface ()
            def anyVal: any = sb
            s += hm + sm + nn + gv + sb.length() + lst.size() + fnL(1) + ClsL(3).v + (if anyVal is IfcL then (1) else (0))
            i += 1
        )
        s + topMut
    )
)
def recWhile = fn (n: int): int -> (
    def i = 0
    def s = 0
    while i < 1 then (
        if n > 0 then (s += recurse(n - 1) + 1)
        i += 1
    )
    s
)
def smallIface = fn (x: any): int -> (def LI = interface () ; if x is LI then (0) else (1))
def smallBlkCell = fn (x: int): int -> ((def c = x + 1 ; def f = fn (): int -> (c) ; f()))
def smallForCell = fn (xs: list of int): int -> (def fs = (list of (fn (): int))() ; for e in xs then (fs.add(fn (): int -> (e))) ; fs.get(0)())
println("" + MutC(1).runWhile(2) + ":" + recWhile(3) + ":" + smallIface(1) + ":" + smallBlkCell(4) + ":" + smallForCell(list(9, 10)))
}}}}}
