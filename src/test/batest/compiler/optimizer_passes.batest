{{{{{
;; LARGE: legacy test pending refactoring
;; ConstFoldPass: unary/binary folding, comparisons across bool/char/int/long/float/double, logic, if-pruning & local const propagation
def foldAll = fn (): string -> (
    def b1 = true ; def b2 = false
    def cmpBool = (b1 == b2) or (b1 != b2)
    def cmpChar = ('a' < 'b') and ('a' <= 'a') and ('b' > 'a') and ('b' >= 'b') and ('a' == 'a') and ('a' != 'b')
    def cmpInt = (-5 < 2) and (2 <= 2) and (3 > 2) and (3 >= 3) and (4 == 4) and (4 != 5)
    def cmpLong = (-5L < 2L) and (2L <= 2L) and (3L > 2L) and (3L >= 3L) and (4L == 4L) and (4L != 5L)
    def cmpFloat = (-1.5f < 2.0f) and (2.0f <= 2.0f) and (3.0f > 2.0f) and (3.0f >= 3.0f) and (4.0f == 4.0f) and (4.0f != 5.0f)
    def cmpDouble = (-2.5 < 1.5) and (1.5 <= 1.5) and (3.5 > 1.5) and (3.5 >= 3.5) and (4.5 == 4.5) and (4.5 != 5.5)

    def l0 = false and b1
    def l1 = true and b1
    def l2 = true or b2
    def l3 = false or b1

    def bConst: byte = byte(3)
    def sConst: short = bConst
    def iConst: int = sConst
    def lConst: long = iConst
    def fConst: float = 2.5f
    def dConst: double = fConst

    def iMath = (10 + 2 - 4) * 3
    def lMath = (10L + 2L - 4L) * 3L
    def fMath = (1.5f + 2.5f - 1.0f) * 2.0f / 3.0f
    def dMath = (1.5 + 2.5 - 1.0) * 2.0 / 3.0

    def emptyIf = if false then (1)
    def ifWidenS: short = if true then (byte(7)) else (short(8))
    def ifWidenL: long = if true then (9) else (10L)
    def ifWidenF: float = if false then (1.0f) else (float(4))
    def ifWidenD: double = if true then (5) else (6.5)

    def kStr: string = "hi"
    def kNull: string? = null
    def cLit = not false

    "" + cmpBool + ":" + cmpChar + ":" + cmpInt + ":" + cmpLong + ":" + cmpFloat + ":" + cmpDouble + ":" + l0 + ":" + l1 + ":" + l2 + ":" + l3 + ":" + iMath + ":" + lMath + ":" + fMath + ":" + dMath + ":" + (emptyIf == null) + ":" + ifWidenS + ":" + ifWidenL + ":" + ifWidenF + ":" + ifWidenD + ":" + dConst + ":" + lConst + ":" + kStr + ":" + (kNull == null) + ":" + cLit
)
println(foldAll())
}}}}}
