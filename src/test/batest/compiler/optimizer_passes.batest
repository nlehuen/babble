{{{{{
;; LARGE: legacy test pending refactoring
;; HirPurity.collectModifiedVars directly inside a loop + ConstFoldPass (unary negate/if-prune/convertConstToKind) + InlinePass (alphaRename)
def Iface = interface (
    def ifaceVal = fn (x: int): int -> (x + 1)
)
def Sub = class (def f: int) implements Iface (
    def m = fn (x: int): int -> (this.f + x)
    def sup = fn (x: int): int -> (super.ifaceVal(x) + this.m(x))
)
def inlWithBlocks = fn (n: int, xs: list of int): int -> (
    def res = 0
    if n > 0 then (
        def inner = n * 2
        res += inner
    ) else (
        res = 1
    )
    for e in xs then (
        res += e
    )
    res
)
def exerciseAll = fn io (n: int): string -> (
    def acc = 0
    def sub = Sub(4)
    def optSub: Sub? = sub
    def ifc: Iface = sub
    def pt = java.awt.Point(2, 3)
    def sb = java.lang.StringBuilder("a")
    def dynSub: any = sub
    def i = 0
    while i < n then (
        def arr1 = (array of int)(2)
        arr1.set(0, i + 1)
        sub.f = 5
        pt.x = 7
        def px = pt.x
        def isSub = sub is Sub
        def asSub = (dynSub as Sub)
        def lst = list.of(1, 2)
        def supRes = sub.sup(1)
        def mRes = asSub.m(1)
        def iRes = ifc.ifaceVal(1)
        def safeRes = optSub?.m(1)
        sb.append("b")
        def wj = 0
        while wj < 1 then (wj += 1)
        for v in arr1 then (acc += v)
        acc += px + supRes + mRes + iRes + (if isSub and (safeRes != null) then (1) else (0)) + lst.size()
        i += 1
    )
    def ufNeg = -(1.5f + 2.5f)
    def ulNeg = -(1L + 2L)
    def cAbsD = java.lang.Math.abs(-3.5)
    def cMinL = java.lang.Math.min(4L, 9L)
    def cFDiv = java.lang.Math.floorDiv(10, 3)
    def wS: short = if true then (byte(3)) else (short(4))
    def wL: long = if true then (5 + 1) else (2)
    def wF: float = if true then (3 + 1) else (2)
    def wD: double = if true then (4 + 2) else (1)
    def inl1 = inlWithBlocks(3, list(1, 2))
    def inl2 = inlWithBlocks(0, list(4))
    "" + acc + ":" + ufNeg + ":" + ulNeg + ":" + cAbsD + ":" + cMinL + ":" + cFDiv + ":" + wS + ":" + wL + ":" + wF + ":" + wD + ":" + inl1 + ":" + inl2 + ":" + (dynSub is Sub) + ":" + sb.length()
)
println(exerciseAll(2))
}}}}}
