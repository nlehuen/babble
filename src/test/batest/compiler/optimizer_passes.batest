{{{{{
;; LARGE: legacy test pending refactoring
;; HirPurity.collectModifiedVars + InlinePass.alphaRename across loops/AST forms + ConstFoldPass javaRetKind/convertConstToKind
def Base = interface (def tag = fn (): int -> (1))
def Holder = class (def v: int) implements Base (
    def tag = fn (): int -> (super.tag() + this.v)
    def inc = fn mut (k: int): int -> (this.v += k ; this.v)
)
def Mod = class () ()
def runAllForms = fn io (n: int, flag: bool): string -> (
    def helper = fn io (mut y: int, mut h: Holder): int -> (
        def sum = 0
        def wd: double = y
        def d2: double = int(wd)
        def locArr = (array of int).of(y, y + 1)
        locArr.set(0, y + 2)
        def pt = java.awt.Point(1, 2)
        pt.x = 3
        def optH: Holder? = h
        def xOk = optH != null and (h is Holder)
        def sOpt: string? = "abc"
        def sVal = sOpt!
        def rList = list.of(y, y + 1)
        def sb = java.lang.StringBuilder()
        sb.append(sVal)
        def s2 = h.inc(1)
        def s3 = optH?.tag()
        def fnHolder = list.of(fn (z: int): int -> (z + 1))
        for v in locArr then (sum += v)
        if xOk and (s3 != null) then (sum += int(d2) + h.tag() + pt.x + rList.size() + sb.length() + s2 + fnHolder.get(0)(2))
        while y > 0 then (
            sum += 1
            y -= 1
        )
        sum
    )

    def m = Mod()
    def h = Holder(5)
    def cRound = java.lang.Math.round(2.5)
    def cDeg = java.lang.Math.toDegrees(0.0)
    def cEmpty = "".isEmpty()
    def cLen = "hello".length()
    def cTrim = " x ".trim()

    def s: short = short(4)
    def i: int = s
    def l: long = i
    def f: float = float(2)
    def d: double = f

    def res = 0
    def k = 0
    while k < n then (
        res += helper(2, h)
        if flag then (
            def nested = array.of(1, 2)
            def tmp = if true then (def x1 = 1 ; x1 + nested.size()) else (0)
            res += tmp
        )
        k += 1
    )
    "" + res + ":" + cRound + ":" + cDeg + ":" + cEmpty + ":" + cLen + ":" + cTrim + ":" + (s + i) + ":" + l + ":" + d + ":" + (m is Mod)
)
println(runAllForms(2, true))
}}}}}
