;; LARGE: legacy test pending refactoring
;; AlgebraicSimplifyPass: boolean identities, int + long identities & reassociation, string reassociation, idempotence, IEEE-754 preservation
axiom java.lang.Character.toLowerCase: fn pure nothrow idempotent
def clamp = fn axiom pure nothrow idempotent (x: int): int -> (if x < 0 then (0) else (x))
def bigClamp = fn axiom pure nothrow idempotent (x: int): int -> (
    def a = x ; def b = a ; def c = b ; def d = c ; def e = d ; def f = e ; def g = f ; def h = g
    def i = h ; def j = i ; def k = j ; def l = k ; def m = l
    if m < 0 then (0) else (m)
)
def testAlg = fn io (x: int, lx: long, b: bool, s: string, d: double, ch: char): string -> (
    def nb = not (not b)
    def bEqT = b == true
    def bNeT = b != true
    def bEqF = b == false
    def bNeF = b != false
    def tEqB = true == b
    def fEqB = false == b
    def tNeB = true != b
    def fNeB = false != b

    def iAdd0 = (x + 0) + (0 + x)
    def iAddC = (5 + x) + ((x + 1) + 2)
    def iSub = (x - 0) + (0 - x) + (x - x)
    def iMul = (x * 1) + (1 * x) + (x * 0) + (0 * x) + (3 * x) + ((x * 2) * 3)

    def lAdd0 = (lx + 0L) + (0L + lx)
    def lAddC = (5L + lx) + ((lx + 1L) + 2L)
    def lSub = (lx - 0L) + (0L - lx) + (lx - lx)
    def lMul = (lx * 1L) + (1L * lx) + (lx * 0L) + (0L * lx) + (3L * lx) + ((lx * 2L) * 3L)

    def strR = (s + "a") + "b"
    def idBabble = clamp(clamp(x))
    def localClamp = bigClamp
    def idVarBabble = localClamp(localClamp(x))
    def idAbs = java.lang.Math.abs(java.lang.Math.abs(x))
    def idFloor = java.lang.Math.floor(java.lang.Math.floor(d))
    def idTrim = s.trim().trim()
    def idChar = java.lang.Character.toLowerCase(java.lang.Character.toLowerCase(ch))

    def nanMul = java.lang.Double.isNaN((d * 0.0) + 0.0)
    def ieeeAdd = (d + 1.0) + 2.0

    "" + nb + ":" + bEqT + ":" + bNeT + ":" + bEqF + ":" + bNeF + ":" + tEqB + ":" + fEqB + ":" + tNeB + ":" + fNeB + ":" + iAdd0 + ":" + iAddC + ":" + iSub + ":" + iMul + ":" + lAdd0 + ":" + lAddC + ":" + lSub + ":" + lMul + ":" + strR + ":" + idBabble + ":" + idVarBabble + ":" + idAbs + ":" + idFloor + ":" + idTrim + ":" + idChar + ":" + nanMul + ":" + ieeeAdd
)
println(testAlg(-5, 4L, true, "  ok ", java.lang.Double.NaN, 'B'))
println(testAlg(3, -2L, false, "hi", -0.0, 'Z'))
}}}}}
