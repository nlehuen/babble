def bigTakeLong = fn nothrow (m: bool, v: long): long -> (
    def a = v ; def b = a ; def c = b ; def d = c ; def e = d ; def f = e ; def g = f ; def h = g
    def i = h ; def j = i ; def k = j ; def l = k ; def p = l ; if m then (p) else (0L)
)
def bigTakeFloat = fn nothrow (m: bool, v: float): float -> (
    def a = v ; def b = a ; def c = b ; def d = c ; def e = d ; def f = e ; def g = f ; def h = g
    def i = h ; def j = i ; def k = j ; def l = k ; def p = l ; if m then (p) else (0.0f)
)
def bigTakeDouble = fn nothrow (m: bool, v: double): double -> (
    def a = v ; def b = a ; def c = b ; def d = c ; def e = d ; def f = e ; def g = f ; def h = g
    def i = h ; def j = i ; def k = j ; def l = k ; def p = l ; if m then (p) else (0.0)
)
def bigTakeOpt = fn nothrow (x: double?): double -> (
    def a = 1.0 ; def b = a ; def c = b ; def d = c ; def e = d ; def f = e ; def g = f ; def h = g
    def i = h ; def j = i ; def k = j ; def l = k ; def m = l ; if x is double then (m) else (0.0)
)
def nonPureThrow = fn (x: int): double -> (
    def q = 10 / x
    def a = q ; def b = a ; def c = b ; def d = c ; def e = d ; def f = e ; def g = f ; def h = g
    def i = h ; def j = i ; def k = j ; def l = k ; def m = l ; m
)

def HoistRec = record (a: byte, i: int, fl: float, d: double, flag: bool) (
    def run = fn io (n: int, ro: int): double -> (
        def acc = 0.0
        def mutLocal = 1.0
        def mutFlag = true
        def mutLong = 1L
        def mutFloat = 1.0f
        def mutDouble = 1.0
        def mutPt = java.awt.Point(1, 2)
        def captured = 2
        def bumpCap = fn io (): int -> (captured += 1 ; captured)
        def localSink = bigSink
        def k = 0
        while k < n then (
            def hs: short = bigByte(this.a)
            def hi: int = bigByte(this.a)
            def hl: long = bigInt(this.i)
            def hf: float = bigInt(this.i)
            def hd: double = bigFloat(this.fl)
            def simp = bigImplicit(this.d)
            def rich = bigSink((-this.d) + (if (this.flag and (ro > 0)) or (not this.flag) then (1.0) else (2.0)))
            def optVal = bigTakeOpt(if this.flag then (this.d))
            def locVal = localSink(this.d)
            def w1 = bigTakeShort(mutFlag, bigByte(this.a))
            def w2 = bigTakeInt(mutFlag, bigByte(this.a))
            def w3 = bigTakeLong(mutFlag, bigInt(this.i))
            def w4 = bigTakeFloat(mutFlag, bigInt(this.i))
            def w5 = bigTakeDouble(mutFlag, bigFloat(this.fl))
            def w6 = mutLong + bigInt(this.i)
            def w7 = mutFloat + bigInt(this.i)
            def w8 = mutDouble + bigInt(this.i)
            def jPure = java.lang.Integer.bitCount(ro) + (if java.util.Objects.nonNull("abc") and java.util.Objects.nonNull(this) and java.util.Objects.nonNull(mutPt) then (1) else (0))
            def strCall = bigInt("  ok  ".length())
            def negCall = java.lang.Math.sin(mutLocal) + double(bigInt(captured)) + nonPureThrow(ro)
            mutLocal += 0.5
            mutFlag = not mutFlag
            mutLong += 1L
            mutFloat += 1.0f
            mutDouble += 1.0
            acc = acc + double(hs) + double(hi) + double(hl) + double(hf) + hd + simp + rich + optVal + locVal + double(w1 + w2) + double(w3) + double(w4) + w5 + double(w6) + double(w7) + w8 + double(jPure) + double(strCall) + negCall
            if false then (acc += double(bumpCap()))
            k += 1
        )
        acc
    )
)
println(java.lang.Math.round(HoistRec(byte(2), 3, 1.5f, 1.0, true).run(2, 4) * 100.0))
}}}}}
