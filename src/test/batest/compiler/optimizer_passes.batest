;; HirDcePass top-level user discard shadowing + InlinePass parameter widening & RecurseRef scan
def discard = fn io (x: int): int -> (x * 2)
def callShadowDiscard = fn io (n: int): int -> (discard(n) ; n + 1)
def widenInside = fn (x: int): double -> (x + 0.5)
def passRec = fn (n: int): int -> (if n <= 0 then (0) else (def r = recurse ; r(n - 1) + 1))
def p = 3
println("" + discard(7) + ":" + callShadowDiscard(4) + ":" + widenInside(5) + ":" + widenInside(p) + ":" + passRec(3))
}}}}}
