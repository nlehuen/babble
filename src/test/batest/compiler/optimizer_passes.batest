def Box = class (def x: double, def name: string) (
    def run = fn io (n: int, b: byte, flag: bool, mutFlag: bool, xs: array of int): double -> (
        def acc = 0.0
        def i = 0
        def fnVar = fn (z: double): double -> (java.lang.Math.sin(z))
        def cellVal = 1
        def bumpCell = fn io (): int -> (cellVal += 1 ; cellVal)
        def rawAny: any = 1
        while i < n then (
            def l1: short = b
            def l2: int = short(4) + int(b)
            def l3: long = int(5) + 1
            def l4: float = 1.5f + 2.5f
            def l5: double = java.lang.Math.sin(this.x) / 2.0 + (-java.lang.Math.toRadians(this.x))
            def l6 = fnVar(this.x) + (if flag or (not flag and (xs.size() > 0)) then (1.0) else (2.0))
            def l7 = (this.name.trim()).length() + (if i == 0 then ((rawAny as int) + 0) else (0))
            def l8 = if true then (byte(2) as double) else (0.0)
            def l9 = (def inner = int(b) + 1 ; double(inner))
            acc = acc + double(l1) + double(l2) + double(l3) + double(l4) + l5 + l6 + double(l7) + l8 + l9
            if mutFlag and false then (acc += double(bumpCell()))
            i += 1
        )
        acc
    )
)
println(java.lang.Math.round(Box(1.0, "  hi  ").run(2, byte(2), true, true, array.of(7)) * 100.0))
