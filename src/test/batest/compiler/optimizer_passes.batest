{{{{{
;; LARGE: legacy test pending refactoring
;; InlinePass & HirDcePass: top-level, function, class body/static, interface default/static inlining, alpha-renaming, recursion, DCE after return/break/continue
def addMul = fn (a: int, b: int): int -> (
    def s = a + b
    def d = a - b
    s * d
)
def fib = fn (n: int): int -> (if n < 2 then (n) else (recurse(n - 1) + recurse(n - 2)))
def pick = fn (x: int): int -> (if x > 0 then (addMul(x, 1)) else (0))
def topRes = addMul(5, 2)

def ICalc = interface (
    def compute = fn (v: int): int -> (addMul(v, 2) + ICalc.BASE)
) static (
    def BASE = addMul(4, 1)
)
def Calc = class (def n: int) implements ICalc (
    def bodyVal = addMul(this.n, 1)
) static (
    def TAG = addMul(6, 2)
)

def log = java.lang.StringBuilder()
def stepLog = fn io (tag: string): int -> (log.append(tag) ; 1)
def testDce = fn io (xs: list of int): int -> (
    def deadPure = addMul(9, 4)
    discard(deadPure + fib(4))
    def total = 0
    for x in xs then (
        if x < 0 then (
            continue
            stepLog("C")
        )
        if x > 10 then (
            break
            stepLog("B")
        )
        total += x
    )
    stepLog("A")
    return total + pick(3)
    stepLog("Z")
)

def c = Calc(4)
def dceRes = testDce(list(-1, 2, 5, 20, 99))
println(topRes, ":", c.bodyVal, ":", c.compute(3), ":", Calc.TAG, ":", fib(7), ":", dceRes, ":", log.toString())
}}}}}
