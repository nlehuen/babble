;; RM003-P3: Babble classes and interfaces implementing/extending Java interfaces with direct JVM bridges

{{{{{
;; Primitive & reference Java interfaces on class, value class, and object literal
def Counter = class (private def n : int) implements java.util.function.IntSupplier, java.lang.Runnable (
    def run = mut () : any? -> ( this.n += 10 ; null )
    def getAsInt = () : int -> ( this.n )
)
def Weight = value class (grams : int) implements java.lang.Comparable(Weight) (
    def compareTo = (other : Weight) : int -> ( this.grams - other.grams )
)
def mulObj = object implements java.util.function.DoubleBinaryOperator (
    def applyAsDouble = (a : double, b : double) : double -> ( a * b + 0.5 )
)
def c = Counter(5)
def r : java.lang.Runnable = c
r.run()
def sup : java.util.function.IntSupplier = c
def list : java.util.List(Weight) = java.util.ArrayList()
list.add(Weight(30))
list.add(Weight(10))
list.add(Weight(20))
java.util.Collections.sort(list)
def set : java.util.Set(Weight) = java.util.HashSet()
set.add(Weight(10))
println(sup.getAsInt(), ":", (list.get(0) as Weight).grams, ":", set.contains(Weight(10)), ":", mulObj.applyAsDouble(2.0, 3.0))
}}}}}
15:10:true:6.5

{{{{{
;; Babble interface extending Java interface with default method, implemented by class & cross-called from Java
def Ranked = interface extends java.lang.Comparable(Ranked) (
    def rank : () : int
    def compareTo = (other : Ranked) : int -> ( this.rank() - other.rank() )
)
def Item = class (def label : string, def r : int) implements Ranked (
    def rank = () : int -> ( this.r )
    def toString = () : string -> ( this.label + "#" + this.r )
)
def items : java.util.List(Item) = java.util.ArrayList()
items.add(Item("b", 2))
items.add(Item("a", 1))
items.add(Item("c", 3))
java.util.Collections.sort(items)
println(java.util.Objects.toString(items), ":", (items.get(0) is java.lang.Comparable), ":", (items.get(0) is Ranked))
}}}}}
[a#1, b#2, c#3]:true:true

{{{{{
;; Overloaded Java interface methods (CharSequence + Appendable) served by Babble methods with optional params
def Buf = class () implements java.lang.Appendable, java.lang.CharSequence (
    private def sb = java.lang.StringBuilder()
    def append = (v : any?, start : int = -1, end : int = -1) : java.lang.Appendable -> (
        if v is java.lang.Character then ( this.sb.append("[" + v + "]") )
        else if start < 0 then ( this.sb.append(v as java.lang.CharSequence) )
        else ( this.sb.append(v as java.lang.CharSequence, start, end) )
        this
    )
    def length = () : int -> ( this.sb.length() )
    def charAt = (idx : int) : any -> ( this.sb.charAt(idx) )
    def subSequence = (s : int, e : int) : java.lang.CharSequence -> ( this.sb.subSequence(s, e) )
    def toString = () : string -> ( this.sb.toString() )
)
def b = Buf()
java.util.Formatter(b).format("%s-%d", java.util.List.of("ok", 7).toArray())
b.append("abcdef", 1, 4)
def cs : java.lang.CharSequence = b
println(cs.length(), ":", cs.subSequence(0, 4), ":", java.lang.String.valueOf(cs))
}}}}}
7:ok-7:ok-7bcd

{{{{{
;; Java default method inheritance and super(JavaInterface).m(...) override in both Babble interface and class
def WrappingIter = interface extends java.util.Iterator(int) (
    def forEachRemaining = (action : java.util.function.Consumer(any?)) : any? -> (
        print("<")
        super(java.util.Iterator).forEachRemaining(action)
        print(">")
    )
)
def RangeIter = class (private def cur : int, def stop : int) implements WrappingIter (
    def hasNext = () : bool -> ( this.cur < this.stop )
    def next = mut () : int -> (
        def v = this.cur
        this.cur += 1
        v
    )
)
def AddOp = class (delta : int) implements java.util.function.IntUnaryOperator (
    def applyAsInt = (x : int) : int -> ( x + delta )
)
RangeIter(1, 4).forEachRemaining(java.util.function.Consumer((x : any?) -> ( print(x) )))
def composed = AddOp(2).andThen(AddOp(10))
println(":", composed.applyAsInt(5))
}}}}}
