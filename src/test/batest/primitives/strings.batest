;; String concatenation, comparisons, Java String methods, and errors
;; References : BIP011 (transparent string type)

{{{{{
assert("a" + "b" == "ab")
assert("a" + 1 == "a1")
assert("a" + null == "anull")
assert("a" + true == "atrue")
def s = "hi"
s += 42
s += "!"
assert(s == "hi42!")
}}}}}

{{{{{
print(1 + "a")
}}}}}
Not a number : "a"

{{{{{
print(null + "a")
}}}}}
Not a number : null

{{{{{
assert("abc" == "abc")
assert("abc" < "abd")
assert("b" > "a")
assert("a" <= "a")
assert(not ("b" >= "c"))
}}}}}

{{{{{
assert("hello".length() == 5)
}}}}}

{{{{{
print(1 - "a")
}}}}}
Not a number : "a"

{{{{{
print("a" * 2)
}}}}}
Not a number : "a"

{{{{{
def s = "abc"
print(s < 1)
}}}}}
Not comparable : s and 1
