;; EffectChecker modifier validation, def-level axioms/impure, import("pkg") targets, SAM propagation, and algebraic errors

========== eff_mod.ba ==========
export axiom pure deterministic nothrow java.lang.Math.abs
export axiom mut java.util.List.add
export def abs2 = axiom pure deterministic nothrow java.lang.Math.abs

{{{{{
;; Module-exported axioms, def-level axiom/impure, import("java.lang") target, and Java inner class axiom
def em = import("eff_mod.ba")
def jmath = import("java.lang").Math
def jmathPkg = import("java.lang")
axiom pure deterministic nothrow import("java.lang").Math.max
axiom pure deterministic nothrow jmathPkg.StrictMath.min
axiom pure java.util.AbstractMap.SimpleEntry
def myAbs = axiom pure deterministic nothrow java.lang.Math.abs
def ext = impure java.lang.System.currentTimeMillis
def compute = pure (x : int, y : int) : int -> (
    def p : java.util.AbstractMap.SimpleEntry(int, int) = java.util.AbstractMap.SimpleEntry(x, y)
    def ok = p.getKey() != null
    java.lang.Math.max(em.abs2(x), jmathPkg.StrictMath.min(x, y)) + myAbs(-1) + (if ok then ( 0 ) else ( 1 ))
)
println(compute(-5, 3), ":", ext() > 0)
}}}}}
6:true

{{{{{
;; Function modifier validation diagnostics
def f = pure (mut x : int) : int -> ( x )
}}}}}
pure and mut are mutually exclusive : use hermetic with mut parameters

{{{{{
def f = axiom () : int -> ( 1 )
}}}}}
axiom requires at least one effect modifier

{{{{{
def f = pure axiom () : int -> ( 1 )
}}}}}
axiom must appear first before effect modifiers

{{{{{
def f = axiom impure () : int -> ( 1 )
}}}}}
axiom and impure cannot be combined

{{{{{
def f = impure pure () : int -> ( 1 )
}}}}}
impure cannot be combined with effect modifiers

{{{{{
def f = pure pure () : int -> ( 1 )
}}}}}
Duplicate effect modifier : pure

{{{{{
def f = (mut mut x : int) : int -> ( x )
}}}}}
Duplicate parameter modifier : mut

{{{{{
def f = (borrow borrow x : int) : int -> ( 0 )
}}}}}
Duplicate parameter modifier : borrow

{{{{{
def f = mut () : int -> ( 1 )
}}}}}
mut on a function requires a receiver (this) : mark mutated parameters with mut

{{{{{
def f = borrow () : int -> ( 1 )
}}}}}
borrow on a function requires a receiver (this) : mark borrowed parameters with borrow

{{{{{
def f : axiom () : int = () : int -> ( 1 )
}}}}}
axiom is not allowed in a function type

{{{{{
def f : impure () : int = () : int -> ( 1 )
}}}}}
impure is not allowed in a function type

{{{{{
def C = class () (
    def m = pure mut () : int -> ( 1 )
)
}}}}}
pure and mut are mutually exclusive : use hermetic mut

{{{{{
;; Java target validation errors
axiom pure import("eff_mod.ba").abs2
}}}}}
Java effect target cannot be a .ba module : eff_mod.ba

