axiom pure java.lang.Math.NoInner.foo
}}}}}
Unknown Java member class : NoInner on java.lang.Math

{{{{{
def em = import("eff_mod.ba")
axiom pure em.missing
}}}}}
Unknown export : missing in eff_mod.ba

{{{{{
def bad = axiom mut java.lang.StringBuilder
}}}}}
Bare class axiom cannot declare mut : declare mut on specific methods instead

{{{{{
axiom mut java.lang.StringBuilder()
}}}}}
Constructor axiom cannot declare mut

{{{{{
def f = pure () : int -> (
    axiom pure java.lang.Math.abs
    1
)
}}}}}
axiom declaration is not allowed inside a verified constrained function

{{{{{
;; Valid algebraic properties & failure diagnostics + SAM callback propagation & borrow escape
def idemp = pure deterministic nothrow idempotent (x : int) : int -> ( x )
def comm = pure deterministic nothrow commutative (a : double, b : double) : double -> ( a + b )
def assoc = pure deterministic nothrow associative (a : int, b : int) : int -> ( a + b )
def inj = pure deterministic nothrow injective (x : int) : int -> ( -x )
def monoD = pure deterministic nothrow monotone (x : double) : double -> ( x * 2.0 )
println(idemp(3), ":", comm(1.0, 2.0), ":", assoc(1, 2), ":", inj(4), ":", monoD(3.0))
}}}}}
3:3.0:3:-4:6.0

{{{{{
def badComm = pure deterministic commutative (a : int, b : int) : int -> ( a - b )
}}}}}
Function badComm declared commutative violates commutative guarantee

{{{{{
def badAssoc = pure deterministic associative (a : string, b : string) : string -> ( a + b + "!" )
}}}}}
Function badAssoc declared associative violates associative guarantee

{{{{{
def badIdemp = pure deterministic idempotent (x : int) : int -> ( x + 1 )
}}}}}
Function badIdemp declared idempotent violates idempotent guarantee

{{{{{
def badInj = pure deterministic injective (x : int) : int -> ( x * 0 )
}}}}}
Function badInj declared injective violates injective guarantee

{{{{{
;; SAM callback propagation: impure lambda inside pure function violates pure
def l : java.util.List(int) = java.util.ArrayList()
l.add(1)
def p = pure (xs : java.util.List(int)) -> (
    xs.forEach((x) -> ( println(x) ))
)
}}}}}
Function p declared pure violates pure guarantee

{{{{{
;; borrow escape and inner closure mutating this
def Box = class (def v : int) (
    def escape = borrow () : Box -> ( this )
)
}}}}}
borrow receiver this escapes via return value

{{{{{
def Box = class (def v : int) ()
def leak = (borrow x : Box) : Box -> ( x )
}}}}}
borrow parameter x escapes via return value

{{{{{
def Box = class (def v : int) (
    def bad = borrow () -> (
        def inner = () -> ( this.v += 1 )
        inner()
    )
)
}}}}}
Inner closure mutates this : enclosing function is not declared mut

{{{{{
def C = class (def v : int) (
    def mutThis = () -> ( this.v += 1 )
)
def g = pure (c : C) -> ( c.mutThis() )
}}}}}
Cannot mutate parameter c (mut method c.mutThis) : mark parameter as mut c
