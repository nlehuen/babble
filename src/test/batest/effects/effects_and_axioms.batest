;; RM002 effect system: pure, hermetic, mut, borrow, algebraic markers, axioms, impure, and violations

{{{{{
;; Explicit pure / deterministic / nothrow / idempotent / commutative / associative / monotone / injective
def inc = pure deterministic nothrow monotone (x : double) : double -> ( x + 1.0 )
def add = pure deterministic nothrow commutative associative (a : int, b : int) : int -> ( a + b )
def oddScale = pure deterministic nothrow injective (x : int) : int -> ( x * 3 )
def keep = pure idempotent (x : int) : int -> ( x )
def herm = hermetic (x : int) : int -> ( x * 2 )
def sum3 = pure (a : int, b : int, c : int) : int -> ( add(oddScale(a), b) + keep(c) )
println(inc(1.5), ":", sum3(1, 2, 3), ":", herm(5))
}}}}}
2.5:8:10

{{{{{
;; Wrapping 32-bit int addition cannot satisfy monotone guarantee
def badMono = pure deterministic monotone (x : int) : int -> ( x + 1 )
}}}}}
Function badMono declared monotone violates monotone guarantee

{{{{{
;; Parameter mut and borrow modifiers on functions and methods
def Box = class (def value : int) (
    def addTo = mut (k : int) : int -> ( this.value += k ; this.value )
    def read = borrow () : int -> ( this.value )
)
def bumpBox = (mut b : Box, delta : int) : int -> (
    b.addTo(delta)
)
def inspectBox = pure (borrow b : Box) : int -> (
    b.read()
)
def box = Box(10)
println(bumpBox(box, 5), ":", inspectBox(box))
}}}}}
15:15

{{{{{
;; Axiom and impure declarations for Java methods
axiom pure deterministic nothrow java.lang.Math.abs
axiom mut java.util.List.add
axiom pure java.util.List.size
def compute = pure (x : int) : int -> ( java.lang.Math.abs(x) )
def l : java.util.List(int) = java.util.ArrayList()
l.add(-7)
println(compute(-7), ":", l.size())
}}}}}
7:1

{{{{{
;; Violation: mutating non-mut parameter inside function fails EffectChecker
def Box = class (def v : int) (
    def set = mut (x : int) : int -> ( this.v = x ; this.v )
)
def bad = (b : Box) -> ( b.set(1) )
}}}}}
Cannot mutate parameter b (mut method b.set) : mark parameter as mut b

{{{{{
;; Violation: aliasing same variable to two mut parameters in a single call
def Box = class (def v : int) (
    def add = mut (k : int) : int -> ( this.v += k ; this.v )
)
def swapAdd = (mut a : Box, mut b : Box) -> ( a.add(b.v) )
def x = Box(3)
swapAdd(x, x)
}}}}}
Exclusivity error : mut target x aliases argument x

{{{{{
;; Violation: mut inside pure function rejected
def g = 0
def badPure = pure () : int -> ( g += 1 ; g )
}}}}}
Function badPure declared pure violates pure guarantee
