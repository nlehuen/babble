{{{{{
;; Deprecated syntax : constructor, class, inner interface, and inner enum targets
axiom pure on java.lang.StringBuilder()
axiom pure on java.lang.Math
axiom pure on java.util.Map.Entry
axiom pure on java.lang.Thread.State
def sb = java.lang.StringBuilder()
assert(sb.toString() == "")
}}}}}
