;; Prefix-overlap mut exclusivity, widened loop alias chains, nested WTO recursion,
;; and single-pass symbolic HOF summaries (including cross-module readParams forwarding).
;; References : BIP027-I4, BIP027-D5, BIP019 §4, Reachability, SymbolicEffectSummary, EffectFixpointDriver

def Box = class (def v: int) ()
def Pair = class (def a: Box, def b: Box) ()
def Node = class (def v: int, def next: Node?) ()

def swapBoxes = fn (mut x: Box, mut y: Box) -> (
    def t = x.v
    x.v = y.v
    y.v = t
)

def mutatePairAndReadBox = fn (mut p: Pair, b: Box): int -> (
    p.a.v = p.a.v + 1
    b.v
)

def mutateBoxAndReadPair = fn (mut b: Box, p: Pair): int -> (
    b.v = b.v + 1
    p.a.v
)

========== hof_lib.ba ==========
;; Virtual module exporting parametric HOFs (direct and nested) to verify single-pass
;; SymbolicEffectSummary parity across module boundaries.

export def Box = class (def v: int) ()
export def applyBox = fn (f: fn (Box): int, b: Box): int -> ( f(b) )
export def applyBox2 = fn (f: fn (Box): int, b: Box): int -> ( applyBox(f, b) )
export def applyMutBox = fn (f: fn (mut Box): int, mut b: Box): int -> ( f(b) )

{{{{{
;; Disjoint sibling fields of the same root remain allowed under BIP027-D5
def p = Pair(Box(1), Box(2))
swapBoxes(p.a, p.b)
assert(p.a.v == 2 and p.b.v == 1)
}}}}}

{{{{{
;; Prefix overlap : mut whole pair aliases its field pair.a (BIP027-D5)
def p = Pair(Box(1), Box(2))
mutatePairAndReadBox(p, p.a)
}}}}}
Exclusivity error : mut target p aliases argument p.a

{{{{{
;; Reverse prefix overlap : mut field pair.a aliases whole pair (BIP027-D5)
def p = Pair(Box(1), Box(2))
mutateBoxAndReadPair(p.a, p)
}}}}}
Exclusivity error : mut target p.a aliases argument p

{{{{{
;; Alias-root prefix overlap : local alias of pair overlaps pair.a
def p = Pair(Box(1), Box(2))
def alias = p
mutatePairAndReadBox(alias, p.a)
}}}}}
Exclusivity error : mut target alias aliases argument p.a

{{{{{
;; Depth-bounded access paths (k = 3) : prefix overlap still caught past depth 3
def touch = fn (mut x: Node?, y: Node?) -> ( if x != null then ( x.v = 9 ) )
def n = Node(1, Node(2, Node(3, Node(4, Node(5, null)))))
def a = n.next
def b = if a != null then ( a.next ) else ( null )
def c = if b != null then ( b.next ) else ( null )
def d = if c != null then ( c.next ) else ( null )
touch(n, d)
}}}}}
Exclusivity error : mut target n aliases argument d

{{{{{
;; Deep loop alias chain (> 8 iterations) : widened loop fixpoint detects param mutation
def f = fn (p: Box, mut q: Box): int -> (
    def a0 = p; def a1 = q; def a2 = q; def a3 = q; def a4 = q
    def a5 = q; def a6 = q; def a7 = q; def a8 = q; def a9 = q
    def i = 0
    while i < 12 then (
        a9 = a8; a8 = a7; a7 = a6; a6 = a5; a5 = a4
        a4 = a3; a3 = a2; a2 = a1; a1 = a0; i = i + 1
    )
    a9.v = 1
    p.v
)
f(Box(0), Box(0))
}}}}}
Cannot mutate parameter p (field assignment .v) : mark parameter as mut p

{{{{{
;; Widened loop traversing linked path chain converges and catches param mutation
def walkAndMut = fn (head: Node): int -> (
    def cur: Node? = head
    while cur != null then (
        cur.v = cur.v + 1
        cur = cur.next
    )
    head.v
)
walkAndMut(Node(1, null))
}}}}}
Cannot mutate parameter head (field assignment .v) : mark parameter as mut head

{{{{{
;; Cross-module single-pass HOF : pure callback and transitive nested HOF in pure context
def hof = import("hof_lib.ba")
def readBox = fn (b: hof.Box): int -> ( b.v )
def runPure = fn (b: frozen hof.Box): int -> (
    hof.applyBox(readBox, b) + hof.applyBox2(readBox, b)
)
assert(runPure(freeze(hof.Box(21))) == 42)
}}}}}

{{{{{
;; Cross-module BIP019 readParams forwarding : reading an external mutable Box via HOF is volatile
def hof = import("hof_lib.ba")
def globalBox = hof.Box(7)
def readBox = fn (b: hof.Box): int -> ( b.v )
def bad = fn (): int -> ( hof.applyBox2(readBox, globalBox) )
bad()
}}}}}
Function bad violates deterministic guarantee : mark function as volatile (or io)

{{{{{
;; Cross-module HOF mut forwarding : passing mut callback rejects non-mut caller param
def hof = import("hof_lib.ba")
def bump = fn (mut b: hof.Box): int -> ( b.v = b.v + 1; b.v )
def bad = fn (b: hof.Box): int -> ( hof.applyMutBox(bump, b) )
bad(hof.Box(1))
}}}}}
Cannot mutate parameter b (mut parameter b) : mark parameter as mut b

{{{{{
;; Intra-file transitive HOF forwarding with frame-local closure
def apply1 = fn (f: fn (int): int, x: int): int -> ( f(x) )
def apply2 = fn (f: fn (int): int, x: int): int -> ( apply1(f, x) )
def compute = fn (n: int): int -> (
    def acc = 0
    def addTo = fn (k: int): int -> ( acc = acc + k; acc )
    apply2(addTo, n) + apply2(addTo, n)
)
assert(compute(10) == 30)
}}}}}

{{{{{
;; Nested mutually recursive WTO cycle (f -> g <-> h, g -> f) propagates IO to outer head
def h = fn io (n: int): int -> ( if n > 0 then ( println(n); g(n - 1) ) else ( 0 ) )
def g = fn io (n: int): int -> ( if n > 1 then ( h(n - 1) ) else ( f(n - 1) ) )
def f = fn (n: int): int -> ( if n > 0 then ( g(n - 1) ) else ( 0 ) )
f(0)
}}}}}
Function f violates pure guarantee (performs I/O or external mutation) : mark function as io
