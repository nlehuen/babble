    def compareTo = fn io (other: Evil): int -> (
        println("side")
        this.v - other.v
    )
)
}}}}}
Function compareTo violates pure guarantee of axiom java.lang.Comparable.compareTo

{{{{{
;; Descendant contract: mutating a parameter in Comparable.compareTo is rejected
def MutEvil = class (def v: int) implements java.lang.Comparable of MutEvil (
    def compareTo = fn (mut other: MutEvil): int -> (
        other.v = 0
        this.v
    )
)
}}}}}
Function compareTo violates pure guarantee of axiom java.lang.Comparable.compareTo

{{{{{
;; BIP019-P2 reads-of-mutable-state determinism model
def Box = class (def v: int) (
    def get = fn (): int -> (this.v)
    def bump = fn mut (): int -> (this.v += 1 ; this.v)
)
def readBox = fn (b: Box): int -> (b.get())
def b = Box(10)
def r1 = readBox(b)
b.bump()
def r2 = readBox(b)
println(r1, ":", r2)
}}}}}
10:11

