{{{{{
;; Inherited axiom contracts on Babble overrides: valid Comparable.compareTo vs violating override
def Num = record (v: int) implements java.lang.Comparable of Num (
    def compareTo = fn (other: Num): int -> (this.v - other.v)
)
println(Num(3).compareTo(Num(1)) > 0, ":", Num(2).compareTo(Num(2)) == 0)
}}}}}
true:true

