{{{{{
;; Curated nullability & deep immutability (Map.Entry, Collections.emptyList/emptyIterator)
def empty: list of string = java.util.Collections.emptyList()
def it: java.util.Iterator of string = java.util.Collections.emptyIterator()
def pair: entry of (string, int) = java.util.Map.entry("k", 7)
println(empty.size(), ":", it.hasNext(), ":", pair.getKey(), ":", pair.getValue())
}}}}}
0:false:k:7

{{{{{
;; Optimizer -O1 with curated foldable/idempotent + HirPurity.allArgsPrimitiveOrImmutable in loops
def Point = record (x: int, y: int) ()
def Cell = class (def v: int) ()
def sumPair = fn nothrow (p: Point, tag: string, n: int): int -> (p.x + p.y + tag.length() + n)
def readCell = fn nothrow (c: Cell): int -> (c.v)
def run = fn io (n: int): string -> (
    def p = Point(3, 4)
    def c = Cell(5)
    def acc = 0
    def i = 0
    while i < n then (
        acc += sumPair(p, "hi", 1)
        acc += readCell(c)
        acc += java.lang.Math.abs(java.lang.Math.abs(-2))
        i += 1
    )
    def f1 = java.lang.Math.sqrt(9.0)
    def f2 = "  hi  ".trim()
    def f3 = f2.trim()
    "" + acc + ":" + f1 + ":" + f3
)
println(run(3))
}}}}}
51:3.0:hi

