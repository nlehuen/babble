{{{{{
;; BIP019-P2: reads of frozen / localFresh / parameter / this / external mutable state & demoteAlias
def Node = class (def v: int) (
    def get = fn (): int -> (this.v)
)
def Holder = class (def child: Node?) (
    def link = fn mut (shared n: Node): int -> (
        this.child = n
        n.v
    )
    def readChild = fn (): int -> (
        def c = this.child
        if c != null then (c.v) else (0)
    )
)
def readFrozen = fn (f: frozen Node): int -> (f.v)
def readLocal = fn (): int -> (
    def loc = Node(7)
    loc.v
)
def aliasIntoParam = fn (mut h: Holder): int -> (
    def loc = Node(9)
    h.link(loc)
    loc.v
)
def gNode = Node(5)
def readGlobalVolatile = fn volatile (): int -> (gNode.v)
def h = Holder(null)
println(readFrozen(freeze(Node(3))), ":", readLocal(), ":", aliasIntoParam(h), ":", h.readChild(), ":", readGlobalVolatile())
}}}}}
3:7:9:9:5

