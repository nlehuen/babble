{{{{{
;; BIP019-P2: aliasing a local unique object into an external holder demotes it so reading it is volatile
def Box = class (def v: int) ()
def Slot = class (def b: Box?) ()
def gSlot = Slot(null)
def leakAndRead = fn volatile (): int -> (
    def loc = Box(4)
    def copy = loc
    loc.v + copy.v
)
println(leakAndRead())
}}}}}
