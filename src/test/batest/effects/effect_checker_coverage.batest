{{{{{
def C = class (def v: int) (
    def mMut = fn mut (): int -> ( this.v = 1; this.v )
    def mPure = fn (): int -> ( this.v )
    def pick = fn shared (flag: bool) -> (
        if flag then ( this.mMut ) else ( this.mPure )
    )
)
def obj = C(5)
assert(obj.pick(false)() == 5)
assert(obj.pick(true)() == 1)
}}}}}

{{{{{
