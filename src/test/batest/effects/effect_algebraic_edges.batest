Function countPure declared hermetic violates hermetic guarantee

{{{{{
;; Java effect annotations (@Pure, @Hermetic, @Mut, @Borrow, @Deterministic, @Nothrow, @Idempotent, @Commutative, @Associative, @Monotone, @Injective)
def tests = import("org.babblelang.tests")
def HF = tests.EffectsTestCase.HostFixtures
def APC = tests.EffectsTestCase.AnnotatedPureClass
def MH = tests.EffectsTestCase.MutableHolder
def fPure = fn pure deterministic (x : int) : int -> (
    HF.pureCalc(x) + APC.helper(x)
)
def fNothrow = fn pure deterministic nothrow (x : int) : int -> ( HF.pureCalc(x) )
def fIdemp = fn pure idempotent (x : double) : double -> ( HF.clampUnit(x) )
def fAssocComm = fn pure associative commutative (a : int, b : int) : int -> ( HF.bitXor(a, b) )
def fMono = fn pure monotone (x : double) : double -> ( HF.expStep(x) )
def fInj = fn pure injective (x : int) : string -> ( HF.hexKey(x) )
def fHerm = fn (d : int) : int -> (
    def h1 = MH(10)
    def h2 = MH(5)
    h1.bump(d)
    HF.mutateParam(h2, h1)
    h2.value
)
def fSam = fn pure (x : int) : int -> ( HF.applyOp(x, fn (v : int) : int -> ( v + 1 )) )
println(fPure(2), ":", fIdemp(1.5), ":", fAssocComm(3, 5), ":", fInj(255), ":", fHerm(3), ":", fSam(9))
}}}}}
