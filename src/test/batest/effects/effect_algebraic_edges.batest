{{{{{
;; Inline object in pure function mutating outer binding & frame-local vs escaping closure captures
def outer = 0
def badObj = fn pure () -> (
    def o = object (
        outer = 1
    )
    ()
)
}}}}}
Function badObj declared pure violates pure guarantee

{{{{{
;; Frame-local borrow closures reading/writing enclosing unescaped locals vs bounded call-site specialization
def Box = class (def v : int) ()
def applyZero = fn (borrow f : fn () : int) : int -> ( f() )
def pureWithFrame = fn pure (n : int) : int -> (
    def acc = n
    def step = fn (k : int) : int -> (
        acc += k
        acc
    )
    def r1 = step(2)
    def r2 = applyZero(fn () : int -> ( acc += 3 ; acc ))
    r2
)
def specCaller = fn pure (n : int) : int -> (
    def invoke = fn (cb : fn (x : int) : int, v : int) : int -> ( cb(v) )
    invoke(fn (x : int) : int -> ( x + 1 ), n)
)
println(pureWithFrame(10), ":", specCaller(5))
}}}}}
