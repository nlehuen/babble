{{{{{
;; Closures: escaping closure capturing mut param vs inner closure mutating this without mut on outer
def Box = class (def v : int) (
    def okMut = fn hermetic mut () : fn mut () : int -> (
        def inner = fn () -> ( this.v += 1 )
        inner
    )
    def badBorrow = fn borrow () : fn () : int -> (
        fn () -> ( this.v )
    )
)
}}}}}
