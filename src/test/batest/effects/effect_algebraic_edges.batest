def cInt = fn pure (x : int) : int -> ( 42 )
def cNeg = fn pure (x : int) : double -> ( -(42.0) )
def dMulPos = fn pure monotone (x : double) : double -> ( 2.0 * x )
def dMulNeg = fn pure (x : double) : double -> ( -2.0 * x )
def dMulNegR = fn pure (x : double) : double -> ( x * -3.0 )
