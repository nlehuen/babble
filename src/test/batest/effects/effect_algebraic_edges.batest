{{{{{
;; toStringProfile, equalityProfile, comparisonProfile, inline object inside pure, redundant cast
def V = value class (x : int) ()
def R = class (def x : int) ()
def Custom = class (def x : int) (
    def toString = fn pure deterministic () : string -> ( "C" )
)
def arr = java.lang.String("ab").toCharArray()
def pOps = fn pure (x : int, ia : java.lang.Integer, ib : java.lang.Integer) : bool -> (
    def s = "v=" + V(x) + ":" + Custom(x) + ":" + (if x > 0 then ( x ) else ( "z" ))
    s += V(x)
    def ok1 = V(x) == V(x)
    def ok2 = R(x) == R(x)
    def ok3 = "abc" < "def"
    def ok4 = ia < ib
    def y = x as int
    ok1 and ok2 and ok3 and ok4 and (s != "") and (y == x)
)
println(pOps(1, java.lang.Integer.valueOf(1), java.lang.Integer.valueOf(2)), ":", ("arr=" + arr) != "")
}}}}}
