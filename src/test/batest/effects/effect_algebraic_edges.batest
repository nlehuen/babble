{{{{{
;; Closures: a returned closure capturing this aliases the receiver (BIP017-D6), so the caller storing it escapes
def Box = class (def v : int) (
    def okMut = fn mut shared () : fn mut () : int -> (
        def inner = fn mut () -> ( this.v += 1 )
        inner
    )
    def reader = fn () : fn () : int -> (
        fn () -> ( this.v )
    )
)
def Holder = class () (
    def ref : any? = null
)
def peek = fn (b : Box) : int -> ( b.reader()() )
def stash = fn (mut h : Holder, b : Box) -> ( h.ref = b.reader() )
}}}}}
Borrowed parameter b escapes via field .ref : mark parameter as shared b

