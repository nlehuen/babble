Cannot mutate this (field assignment .v) : function is not declared mut

{{{{{
;; While & if narrowing inside EffectChecker
def Node = class (def next : Node?) ()
def walk = fn pure (borrow start : Node?) : int -> (
    def cur : Node? = start
    def c = 0
    while cur != null then (
        c += 1
        cur = cur.next
    )
    c
)
def n1 = Node(Node(null))
println(walk(n1))
}}}}}
