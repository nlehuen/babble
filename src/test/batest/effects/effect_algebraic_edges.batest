;; EffectChecker modifier errors, target resolution, static blocks, algebraic validation/inference, closures & specialization

{{{{{
;; Parameter & effect modifier validation edge cases
def f1 = fn (mut mut x : int) : int -> ( x )
}}}}}
Duplicate parameter modifier : mut

{{{{{
def f2 = fn nothrow nothrow () : int -> ( 1 )
}}}}}
Duplicate effect modifier : nothrow

{{{{{
def f3 : fn (x : fn axiom pure (y : int) : int) : int = fn (x : fn axiom pure (y : int) : int) -> ( 1 )
}}}}}
axiom is not allowed in a function type

{{{{{
def f4 = fn nothrow axiom () : int -> ( 1 )
}}}}}
axiom must appear first before effect modifiers

{{{{{
def f5 = fn pure () : int -> ( 1 )
}}}}}
pure is the default on functions : only use pure with axiom

{{{{{
def f6 = fn axiom io () : int -> ( 1 )
}}}}}
axiom and io cannot be combined

{{{{{
def f7 = fn io volatile () : int -> ( 1 )
}}}}}
io already implies volatile : use io alone

{{{{{
def f8 = fn mut () : int -> ( 1 )
}}}}}
mut on a function requires a receiver (this) : mark mutated parameters with mut

{{{{{
def f9 = fn shared () : int -> ( 1 )
}}}}}
shared on a function requires a receiver (this) : mark escaping parameters with shared

{{{{{
def f10 = fn axiom pure (mut x : int) : int -> ( 1 )
}}}}}
pure and mut are mutually exclusive : use mut (or volatile mut)

{{{{{
;; Effect declaration inside constrained static block and non-file scopes
def makeBadStatic1 = fn () -> (
    def C = class () () static ( println("bad") )
    ()
)
}}}}}
static block inside pure function violates pure guarantee

{{{{{
def Box = class (def v : int) (
    def makeBadStatic2 = fn volatile mut () -> (
        def I = interface () static ( println("bad") )
        this.v += 1
        ()
    )
)
}}}}}
static block inside hermetic function violates hermetic guarantee

{{{{{
axiom volatile on java.lang.Math.random
def makeBadStatic3 = fn () -> (
    def C = class () () static ( def y = java.lang.Math.random() )
    ()
)
}}}}}
static block inside deterministic function violates deterministic guarantee

{{{{{
def BadPlace = ( export axiom pure on java.lang.Math.abs ; 1 )
}}}}}
export only applies to the top-level definitions of a file

{{{{{
;; Effect target resolution errors and valid target forms (constructor & member inner interface)
def import = 1
axiom pure on import("java.lang").Math
}}}}}
Invalid target : shadowed import

{{{{{
axiom pure on foo("java.lang").Math
}}}}}
Invalid target : expected import("...") or Java class path

{{{{{
axiom pure on java.lang
}}}}}
Invalid effect declaration target : expected a Java class, constructor, or method

{{{{{
def p = object ( def a = 1 )
axiom pure on p.a
}}}}}
Invalid effect declaration target : p.a

{{{{{
def badAxiom = axiom pure on java.lang.String.CASE_INSENSITIVE_ORDER
}}}}}
Invalid axiom target : expected a Java class, Java method, or function

{{{{{
axiom pure on java.lang.StringBuilder()
axiom pure on java.util.Map.Entry
def sb = java.lang.StringBuilder()
println(sb.toString())
}}}}}


{{{{{
