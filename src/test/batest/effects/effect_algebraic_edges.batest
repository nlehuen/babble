    println(x)
)
}}}}}
value class BadV2 constructor must be pure

{{{{{
def g = 1
g = 2
def BadV3 = value class (x : int) (
    def y = g
)
}}}}}
value class BadV3 constructor must be deterministic

{{{{{
;; toStringProfile, equalityProfile, comparisonProfile, inline object inside pure, redundant cast
def V = value class (x : int) ()
def R = class (def x : int) ()
def Custom = class (def x : int) (
    def toString = pure deterministic () : string -> ( "C" )
)
def arr = java.lang.String("ab").toCharArray()
def pOps = pure (x : int, ia : java.lang.Integer, ib : java.lang.Integer) : bool -> (
    def s = "v=" + V(x) + ":" + Custom(x) + ":" + (if x > 0 then ( x ) else ( "z" ))
    s += V(x)
    def ok1 = V(x) == V(x)
    def ok2 = R(x) == R(x)
    def ok3 = "abc" < "def"
    def ok4 = ia < ib
    def y = x as int
    ok1 and ok2 and ok3 and ok4 and (s != "") and (y == x)
)
println(pOps(1, java.lang.Integer.valueOf(1), java.lang.Integer.valueOf(2)), ":", ("arr=" + arr) != "")
}}}}}
Warning : Redundant cast : int
false:true

{{{{{
;; Inline object in pure function mutating outer binding & frame-local vs escaping closure captures
def outer = 0
def badObj = pure () -> (
    def o = object (
        outer = 1
    )
    ()
)
}}}}}
Function badObj declared pure violates pure guarantee

{{{{{
;; Frame-local borrow closures reading/writing enclosing unescaped locals vs bounded call-site specialization
def Box = class (def v : int) ()
def applyZero = (borrow f : () : int) : int -> ( f() )
def pureWithFrame = pure (n : int) : int -> (
    def acc = n
    def step = (k : int) : int -> (
        acc += k
        acc
    )
    def r1 = step(2)
    def r2 = applyZero(() : int -> ( acc += 3 ; acc ))
    r2
)
def specCaller = pure (n : int) : int -> (
    def invoke = (cb : (x : int) : int, v : int) : int -> ( cb(v) )
    invoke((x : int) : int -> ( x + 1 ), n)
)
println(pureWithFrame(10), ":", specCaller(5))
}}}}}
15:6

{{{{{
;; Closures: escaping closure capturing mut param vs inner closure mutating this without mut on outer
def Box = class (def v : int) (
    def okMut = hermetic mut () : mut () : int -> (
        def inner = () -> ( this.v += 1 )
        inner
    )
    def badBorrow = borrow () : () : int -> (
        () -> ( this.v )
    )
)
}}}}}
borrow receiver this escapes via captured closure

{{{{{
def Box = class (def v : int) (
    def badNoMut = () : null -> (
        this.v = 1
        null
    )
)
}}}}}
Cannot mutate this (field assignment .v) : function is not declared mut

{{{{{
;; While & if narrowing inside EffectChecker
def Node = class (def next : Node?) ()
def walk = pure (borrow start : Node?) : int -> (
    def cur : Node? = start
    def c = 0
    while cur != null then (
        c += 1
        cur = cur.next
    )
    c
)
def n1 = Node(Node(null))
println(walk(n1))
}}}}}
2
