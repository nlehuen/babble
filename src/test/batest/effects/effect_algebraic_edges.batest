println(cInt(1), ":", cNeg(1), ":", dMulPos(2.0), ":", dMulNeg(2.0), ":", dMulNegR(2.0), ":", sLeft(3), ":", sRight("ok"), ":", sSelf("a"), ":", widen(4), ":", addSame(5.0))
