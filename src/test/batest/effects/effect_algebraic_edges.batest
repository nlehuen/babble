;; EffectChecker modifier errors, target resolution, static blocks, algebraic validation/inference, closures & specialization

{{{{{
;; Parameter & effect modifier validation edge cases
def f1 = fn (mut mut x : int) : int -> ( x )
}}}}}
Duplicate parameter modifier : mut

{{{{{
def f2 = fn pure pure () : int -> ( 1 )
}}}}}
Duplicate effect modifier : pure

{{{{{
def f3 : fn (x : fn axiom pure (y : int) : int) : int = fn (x : fn axiom pure (y : int) : int) -> ( 1 )
}}}}}
axiom is not allowed in a function type

{{{{{
def f4 = fn pure axiom () : int -> ( 1 )
}}}}}
axiom must appear first before effect modifiers

{{{{{
def f5 : fn (x : fn impure () : int) : int = fn (x : fn impure () : int) -> ( 1 )
}}}}}
impure is not allowed in a function type

{{{{{
def f6 = fn axiom impure () : int -> ( 1 )
}}}}}
axiom and impure cannot be combined

{{{{{
def f7 = fn impure pure () : int -> ( 1 )
}}}}}
impure cannot be combined with effect modifiers

{{{{{
def f8 = fn mut () : int -> ( 1 )
}}}}}
mut on a function requires a receiver (this) : mark mutated parameters with mut

{{{{{
def f9 = fn borrow () : int -> ( 1 )
}}}}}
borrow on a function requires a receiver (this) : mark borrowed parameters with borrow

{{{{{
def f10 : fn pure (mut x : int) : int = fn (mut x : int) -> ( 1 )
}}}}}
pure and mut are mutually exclusive : use hermetic with mut parameters

{{{{{
;; Effect declaration inside constrained static block and non-file scopes
def makeBadStatic1 = fn pure () -> (
    def C = class () () static ( println("bad") )
    ()
)
}}}}}
static block inside pure function violates pure guarantee

{{{{{
def makeBadStatic2 = fn hermetic () -> (
    def I = interface () static ( println("bad") )
    ()
)
}}}}}
static block inside hermetic function violates hermetic guarantee

{{{{{
def makeBadStatic3 = fn deterministic () -> (
    def C = class () () static ( def y = java.lang.Math.random() )
    ()
)
}}}}}
static block inside deterministic function violates deterministic guarantee

{{{{{
def BadPlace = ( export axiom pure on java.lang.Math.abs ; 1 )
}}}}}
export only applies to the top-level definitions of a file

{{{{{
;; Effect target resolution errors and valid target forms (constructor & member inner interface)
def import = 1
axiom pure on import("java.lang").Math
}}}}}
Invalid target : shadowed import

{{{{{
axiom pure on foo("java.lang").Math
}}}}}
Invalid target : expected import("...") or Java class path

{{{{{
axiom pure on java.lang
}}}}}
Invalid effect declaration target : expected a Java class, constructor, or method

{{{{{
def p = object ( def a = 1 )
axiom pure on p.a
}}}}}
Invalid effect declaration target : p.a

{{{{{
def badAxiom = axiom pure on java.lang.String.CASE_INSENSITIVE_ORDER
}}}}}
Invalid axiom target : expected a Java class, Java method, or function

{{{{{
axiom pure deterministic on java.lang.StringBuilder()
axiom pure on java.util.Map.Entry
def sb = java.lang.StringBuilder()
println(sb.toString())
}}}}}


{{{{{
;; Invalid algebraic signatures in validateAlgebraicSignature (function types and definitions)
def badAssocType = fn (f : fn pure associative (x : int) : int) : int -> ( 1 )
}}}}}
associative requires a pure binary (T, T) : T signature

{{{{{
def badAssoc2 = fn hermetic associative (a : int, b : int) : int -> ( a + b )
}}}}}
associative requires a pure binary (T, T) : T signature

{{{{{
def badCommType = fn (f : fn pure commutative (a : int) : int) : int -> ( 1 )
}}}}}
commutative without mut requires a pure binary (T, T) : R signature

{{{{{
def badCommMutType = fn (f : fn hermetic mut commutative () : int) : int -> ( 1 )
}}}}}
mut commutative requires a value parameter on the mutated target

{{{{{
def badIdempType = fn (f : fn pure idempotent (a : int, b : int) : int) : int -> ( 1 )
}}}}}
idempotent without mut requires a pure unary (T) : T signature or an effectful axiom

{{{{{
def badMonoType = fn (f : fn pure monotone () : int) : int -> ( 1 )
}}}}}
monotone requires ordered parameter and return types without mut

{{{{{
def Box = class (def x : int) ()
def badMono2 = fn (f : fn pure monotone (b : Box) : Box) : int -> ( 1 )
}}}}}
monotone requires ordered parameter and return types without mut

{{{{{
def badInjType = fn (f : fn pure injective (x : int) : null) : int -> ( 1 )
}}}}}
injective requires at least one parameter, no mut, and a non-null return type

{{{{{
;; Compositional algebraic inference: relationalProps, binaryWrapperProps, isUnaryIdempotentWrapper, mut idempotent/commutative
def V = value class (x : int) (
    def get = fn pure () : int -> ( this.x )
)
def addInt = fn (a : int, b : int) : int -> ( a + b )
def addRev = fn (a : int, b : int) : int -> ( b + a )
def mulD = fn (a : double, b : double) : double -> ( a * b )
def catS = fn (a : string, b : string) : string -> ( a + b )
def catRev = fn (a : string, b : string) : string -> ( b + a )
def eqD = fn (a : double, b : double) : bool -> ( a == b )
def wrapAddRev = fn (a : int, b : int) : int -> ( addInt(b, a) )
def c1 : fn pure commutative associative (a : int, b : int) : int = addRev
def c2 : fn pure commutative (a : double, b : double) : double = mulD
def c3 : fn pure associative (a : string, b : string) : string = catS
def c4 : fn pure commutative (a : double, b : double) : bool = eqD
def c5 : fn pure commutative (a : int, b : int) : int = wrapAddRev

def d1 = fn (x : double) : double -> ( return -(-x) + 1.0 - (-2.0 * x) )
def d2 = fn (x : double, y : double) : double -> ( x + (y * 0.0 + 1.0) )
def d3 = fn (x : int) : double -> ( (x as double) * 2.0 )
def d4 = fn (x : double) : double -> ( 3.0 * x )
def i1 = fn (x : int) : int -> ( -x * -3 + 5 )
def i2 = fn (x : int) : int -> ( 7 - (3 * x) )
def i3 = fn (x : int) : string -> ( "k:" + x )
def i4 = fn (x : int) : string -> ( "" + (x + 1) + ":k" )
def vc = fn (x : int) : V -> ( V(x) )
def m1 : fn pure monotone (x : double) : double = d1
def m2 : fn pure monotone (x : double, y : double) : double = d2
def m3 : fn pure monotone (x : int) : double = d3
def m4 : fn pure monotone (x : double) : double = d4
def j1 : fn pure injective (x : int) : int = i1
def j2 : fn pure injective (x : int) : int = i2
def j3 : fn pure injective (x : int) : string = i3
def j4 : fn pure injective (x : int) : string = i4
def j5 : fn pure injective (x : int) : V = vc

def idemSelf = fn pure idempotent (x : int) : int -> ( x )
def wrapIdem = fn (x : int) : int -> ( idemSelf(x) )
def idCheck : fn pure idempotent (x : int) : int = wrapIdem

def Box = class (def v : int) (
    def setV = fn hermetic mut idempotent (x : int) -> ( this.v = x )
    def addAssign = fn hermetic mut commutative (d : int) -> ( this.v += d )
    def addLeft = fn hermetic mut commutative (d : int) -> ( this.v = this.v + d )
    def addRight = fn hermetic mut commutative (d : int) -> ( this.v = d + this.v )
    def fwdSet = fn hermetic mut idempotent (x : int) -> ( this.setV(x) )
    def fwdAdd = fn hermetic mut commutative (d : int) -> ( this.addAssign(d) )
)
def setParam = fn hermetic idempotent (mut b : Box, x : int) -> ( b.v = x )
def ms1 : fn hermetic mut idempotent (x : int) = Box(0).setV
def ms2 : fn hermetic mut commutative (d : int) = Box(0).addAssign
def ms3 : fn hermetic mut commutative (d : int) = Box(0).addLeft
def ms4 : fn hermetic mut commutative (d : int) = Box(0).addRight
def ms5 : fn hermetic mut idempotent (x : int) = Box(0).fwdSet
def ms6 : fn hermetic mut commutative (d : int) = Box(0).fwdAdd
def ms7 : fn hermetic idempotent (mut b : Box, x : int) = setParam

println(m1(2.0), ":", m2(1.0, 99.0), ":", m3(4), ":", i3(7), ":", catRev("a", "b"), ":", c5(2, 3))
}}}}}
