{{{{{
;; LARGE: legacy test pending refactoring
;; Megamorphic callable dispatch across 6 different closures
def f0 = fn (x : int) : int -> ( x + 1 )
def f1 = fn (x : int) : int -> ( x + 2 )
def f2 = fn (x : int) : int -> ( x + 3 )
def f3 = fn (x : int) : int -> ( x + 4 )
def f4 = fn (x : int) : int -> ( x + 5 )
def f5 = fn (x : int) : int -> ( x * 2 )
def apply = fn (func : fn (x : int) : int, v : int) : int -> ( func(v) )

def i = 0
def sum = 0
while i < 12 then (
    def m = i - int(i / 6) * 6
    def func = if m == 0 then ( f0 ) else if m == 1 then ( f1 ) else if m == 2 then ( f2 ) else if m == 3 then ( f3 ) else if m == 4 then ( f4 ) else ( f5 )
    sum += apply(func, i)
    i += 1
)
println(sum)
}}}}}
