;; Polymorphic (2-4 shapes) and megamorphic (5+ shapes) inline caches in loops (Bootstrap & JavaLinker)

{{{{{
;; LARGE: legacy test pending refactoring
;; 6 Babble classes + singleton object implementing Shape -> megamorphic SelectCache & CallSite (> 4 cache depth)
def Shape = interface (
    def val : fn () : int
)
def S1 = class (def x : int) implements Shape ( def val = fn () : int -> ( this.x + 1 ) )
def S2 = class (def x : int) implements Shape ( def val = fn () : int -> ( this.x + 2 ) )
def S3 = class (def x : int) implements Shape ( def val = fn () : int -> ( this.x + 3 ) )
def S4 = class (def x : int) implements Shape ( def val = fn () : int -> ( this.x + 4 ) )
def S5 = class (def x : int) implements Shape ( def val = fn () : int -> ( this.x + 5 ) )
def S6 = object implements Shape ( def x = 10 ; def val = fn () : int -> ( this.x + 6 ) )

def pick = fn volatile (i : int) : Shape -> (
    def k = i - int(i / 6) * 6
    if k == 0 then ( S1(i) )
    else if k == 1 then ( S2(i) )
    else if k == 2 then ( S3(i) )
    else if k == 3 then ( S4(i) )
    else if k == 4 then ( S5(i) )
    else ( S6 )
)

def invokeShape = fn (s : Shape) : int -> ( s.val() )
def total = 0
def i = 0
while i < 18 then (
    total += invokeShape(pick(i))
    i += 1
)
println(total)
}}}}}
