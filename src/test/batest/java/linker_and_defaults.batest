{{{{{
;; Types.NominalType shadowed class name diagnostic (two local classes named P)
def make = () : any -> (
    def P = class (def x : int) ()
    P(1)
)
def P = class (def x : int) ()
def v : any = make()
def bad : P = v as P
}}}}}
