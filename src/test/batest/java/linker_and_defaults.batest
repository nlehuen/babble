;; Runtime JavaLinker inline caches, Java default methods, Faces proxies, Supers, and Java field/primitive edges

{{{{{
;; Unbound JavaMethod and BoundJavaMethod select/call through Bootstrap & JavaLinker
def absFn = java.lang.Math.abs
def parseFn = java.lang.Integer.parseInt
def eqFn = java.util.Objects.equals
println(absFn(-7), ":", absFn(-2.5), ":", parseFn("42"), ":", eqFn(null, null), ":", eqFn("a", null))

def sb = java.lang.StringBuilder("hi")
def app = sb.append
app("!")
println(sb.toString())

def rawList = java.util.List.of("a", "b", "c")
def rawGet = rawList.get
println(rawGet(1))

def xs : java.util.List(any) = java.util.ArrayList()
def add = xs.add
add(sb)
println(xs.size())

def intVal = java.lang.Integer.valueOf
def dblVal = java.lang.Double.valueOf
def boolVal = java.lang.Boolean.valueOf
println(intVal(99), ":", dblVal(1.5), ":", boolVal(true))
}}}}}
7:2.5:42:true:false
hi!
b
1
99:1.5:true

{{{{{
;; Safe navigation on Java receivers (Bootstrap.select -> JavaLinker.select -> JavaLinker.call)
def sb : java.lang.StringBuilder? = java.lang.StringBuilder("ab")
def noneSb : java.lang.StringBuilder? = null
def raw : java.util.List(int)? = java.util.List.of(10, 20)
def noneRaw : java.util.List(int)? = null
println(sb?.append("c")?.toString(), ":", noneSb?.toString(), ":", raw?.get(1), ":", noneRaw?.size())
}}}}}
abc:null:20:null

{{{{{
;; Polymorphic and megamorphic JavaLinker select & call across wrapped/raw receivers and BabbleInstance args
def Box = class (def n : int) ()
def xs : java.util.List(any) = java.util.ArrayList()
def add = xs.add
add(Box(1))
println(xs.size())

def c0 : java.util.List(int) = java.util.ArrayList()
def c1 : java.util.List(int) = java.util.LinkedList()
def c2 : java.util.List(int) = java.util.Vector()
def c3 : java.util.List(int) = java.util.Stack()
def c4 : java.util.List(int) = java.util.List.of(1, 2)
def c5 : java.util.List(int) = java.util.Collections.singletonList(9)
def cols : java.util.List(java.util.List(int)) = java.util.List.of(c0, c1, c2, c3, c4, c5)

def sum = 0
def i = 0
while i < 12 then (
    def k = i - int(i / 6) * 6
    def c : java.util.List(int)? = cols.get(k)
    def sz = c?.size()
    if sz != null then ( sum += sz )
    i += 1
)
println(sum)
}}}}}
1
6

