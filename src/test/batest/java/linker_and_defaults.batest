def sb = java.lang.StringBuilder("x")
def app = sb.append
app()
}}}}}
No applicable overload of java.lang.StringBuilder.append for ()

{{{{{
;; Java default methods (JavaDefaultCall), super(JavaInterface), and Faces Object methods
def EvenPred = class () implements java.util.function.IntPredicate (
    def test = (x : int) : bool -> ( int(x / 2) * 2 == x )
    def testInverted = (x : int) : bool -> ( super(java.util.function.IntPredicate).negate().test(x) )
)
def p = EvenPred()
def neg = p.negate()
println(p.test(4), ":", neg.test(4), ":", neg.test(3), ":", p.testInverted(4))

def pred : java.util.function.IntPredicate = p
def samProxy : java.util.function.IntUnaryOperator = java.util.function.IntUnaryOperator((x : int) : int -> ( x + 10 ))
def predObj : any = pred
def samObj : any = samProxy
println(java.util.Objects.equals(predObj, p), ":", java.util.Objects.equals(samObj, samObj))
println(java.util.Objects.hashCode(predObj) == java.util.Objects.hashCode(p), ":", java.util.Objects.hashCode(samObj) != 0)
println(java.util.Objects.toString(predObj) == java.util.Objects.toString(p))
println(java.util.Objects.toString(samObj) != "" and java.lang.reflect.Proxy.isProxyClass(samProxy.getClass()) == false)
}}}}}
true:false:true:false
true:true
true:true
true
true

{{{{{
;; Multi-level Babble interface inheritance, default lookup, 'is' checks, and interface/class toString
def Base = interface (
    def req : () : int
    def tag = () : string -> ( "base" )
)
def Mid = interface extends Base (
    def midTag = () : string -> ( super(Base).tag() + "+mid" )
)
def Impl = class (def v : int) implements Mid (
    def req = () : int -> ( this.v )
    def full = () : string -> ( super(Mid).midTag() )
)
def x = Impl(7)
println(x.tag(), ":", x.midTag(), ":", x.full(), ":", x is Base, ":", x is Mid)
println(Base, ":", Impl)
}}}}}
base:base+mid:base+mid:true:true
interface Base:class Impl

{{{{{
;; Calling interface method with no default via super fails
def I = interface (
    def m : () : int
)
def C = class () implements I (
    def m = () : int -> ( super(I).m() )
)
println(C().m())
}}}}}
I.m has no default

{{{{{
;; Java array length in Babble and primitive/boxed returns (byte, short, char, long, float, void)
def frames = java.lang.Thread.currentThread().getStackTrace()
println(frames.length > 0)
def b = java.lang.Byte.parseByte("7")
def s = java.lang.Short.parseShort("12")
def ch = java.lang.Character.valueOf(java.lang.StringBuilder("abc").charAt(1))
def lg = java.lang.Long.parseLong("9000000000")
def fl = java.lang.Float.parseFloat("2.5")
def arr : java.util.List(int) = java.util.ArrayList()
arr.add(1)
arr.clear()
def ib = java.lang.Integer.valueOf(5)
def db = java.lang.Double.valueOf(2.5)
def bb = java.lang.Boolean.valueOf(true)
println(b, ":", s, ":", ch, ":", lg, ":", fl, ":", arr.isEmpty(), ":", ib + 1, ":", db + 0.5, ":", bb)
}}}}}
true
7:12:b:9000000000:2.5:true:6:3.0:true

