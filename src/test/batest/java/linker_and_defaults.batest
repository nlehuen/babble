{{{{{
;; Values.hash(null/double), Values.same(JavaObject/null), Values.is / isBuiltin, and Types runtime checks
def V = value class (d : double, n : any?) ()
def uniq : java.util.Set(V) = java.util.HashSet()
uniq.add(V(3.5, null))
uniq.add(V(2.0, null))
println(uniq.contains(V(3.5, null)), ":", uniq.contains(V(2, null)))

def sb1 = java.lang.StringBuilder("a")
def sb2 = java.lang.StringBuilder("a")
println(same(sb1, sb1), ":", same(sb1, sb2), ":", same(sb1, null), ":", same(null, null))

def I = interface ( def id : () : int )
def C = class (def v : int) implements I, java.lang.Runnable (
    def id = () : int -> ( this.v )
    def run = () -> ( )
)
def a : any = 3.5
def b : any = true
def c : any = C(9)
def n : any? = null
def jlTyped : java.util.List(any) = java.util.ArrayList()
def jl : any = jlTyped
println(a is double, ":", b is bool, ":", a is any, ":", n is any)
println(c is I, ":", c is C, ":", c is java.lang.Runnable, ":", jl is java.util.List)
}}}}}
true:true
