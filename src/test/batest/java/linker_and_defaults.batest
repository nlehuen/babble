{{{{{
;; Java public mutable fields: double, float, long, int, String, Object (assign & compound assign)
def p2d = java.awt.geom.Point2D.Double(1.0, 2.0)
p2d.x = 3
p2d.x += 1.5
p2d.y *= 2.0
p2d.y /= 2.0
p2d.x -= 0.5
println(p2d.x, ":", p2d.y)

def p2f = java.awt.geom.Point2D.Float(java.lang.Float.parseFloat("1"), java.lang.Float.parseFloat("2"))
p2f.x = java.lang.Float.parseFloat("5")
println(p2f.x)

def ev = java.awt.Event("src", java.lang.Long.parseLong("10"), 1, 2, 3, 4, 5, "init")
ev.when = java.lang.Long.parseLong("200")
ev.arg = "updated"
ev.x += 10
ev.x -= 3
ev.x *= 2
println(ev.when, ":", ev.arg, ":", ev.x)

def st = java.io.StreamTokenizer(java.io.StringReader("hi"))
st.sval = "custom"
st.nval = 7.5
st.nval += 2.5
println(st.sval, ":", st.nval)
}}}}}
4.0:2.0
5.0
200:updated:18
custom:10.0

{{{{{
;; Redirected print(to: writer) and BoundMethod equality/hash/string + classof
def sw = java.io.StringWriter()
print("hello", " world", to: sw)
println("out=", sw.toString())
def sw2 = java.io.StringWriter()
println("line1", to: sw2)
print("line2", to: sw2)
println(sw2.getBuffer().length() > 5)

def C = class (def x : int) (
    def m = () : int -> ( this.x )
)
def c = C(5)
def m1 = c.m
def m2 = c.m
def uniq : java.util.Set(any) = java.util.HashSet()
uniq.add(m1)
println(m1 == m2, ":", uniq.contains(m2), ":", m1)
println(classof(c) == C, ":", classof(java.lang.StringBuilder()) == java.lang.StringBuilder)
println(c.m)
}}}}}
out=hello world
true
true:true:bound function m
true:true
bound function m

{{{{{
;; Faces equals, FunctionHandler default method (andThen), Java long/float params, Point2D.Float/Event/StreamTokenizer compound assign
def EvenPred = class () implements java.util.function.IntPredicate (
    def test = (x : int) : bool -> ( int(x / 2) * 2 == x )
)
def p1 = EvenPred()
def p2 = EvenPred()
def pred1 : java.util.function.IntPredicate = p1
def fn1 : java.util.function.IntUnaryOperator = java.util.function.IntUnaryOperator((x : int) : int -> ( x + 1 ))
def fn2 : java.util.function.IntUnaryOperator = java.util.function.IntUnaryOperator((x : int) : int -> ( x * 2 ))
println(java.util.Objects.equals(pred1, p1), ":", java.util.Objects.equals(pred1, p2), ":", java.util.Objects.equals(fn1, fn1), ":", java.util.Objects.equals(fn1, fn2))
println(fn1.andThen(fn2).applyAsInt(3))

def pf = java.awt.geom.Point2D.Float(3, 4)
pf.x = java.lang.Float.parseFloat("5")
def ev = java.awt.Event("s", java.lang.Long.numberOfLeadingZeros(8), 1, 2, 3, 4, 5, "a")
def demo = import("org.babblelang.tests").JavaClassDemo()
demo.nonNullLabel = "go"
demo.nonNullLabel += "!"
println(pf.x, ":", ev.when > 0, ":", demo.nonNullLabel)
}}}}}
true:false:true:false
8
5.0:true:go!

{{{{{
;; Faces.function arity mismatch with function, BoundMethod, and BabbleClass (Values.arity)
