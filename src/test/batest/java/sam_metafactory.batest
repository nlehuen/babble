{{{{{
;; Boxed null parameter entering LambdaMetafactory SAM still raises Babble Type error
def Demo = import("org.babblelang.tests").JavaClassDemo
def op = Demo.BoxedIntUnaryOperator((x : int) : int -> ( x + 1 ))
assert(Demo.isProxy(op) == false)
Demo.invokeUnaryBoxed(op, Demo.boxedInt(false))
}}}}}
Type error : expected int, got null

{{{{{
;; Wrong dynamic return value from LambdaMetafactory SAM raises Babble Type error
def bad = java.util.function.IntUnaryOperator((x : int) : any? -> ( "wrong" ))
bad.applyAsInt(1)
}}}}}
Type error : IntUnaryOperator.applyAsInt must return int, got String

