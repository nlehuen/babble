;; Java instance/static fields, Java arrays via java.lang.reflect.Array, and field mutability errors

{{{{{
;; Public mutable fields on java.awt.Point and static fields on java.lang.Integer
def pt = java.awt.Point(3, 4)
def origX = pt.x
pt.x = 10
pt.y += 6
println(origX, ":", pt.x, ":", pt.y, ":", java.lang.Integer.MIN_VALUE)
}}}}}
