{{{{{
;; JavaLinker selectCache + BoundJavaMethod calls + BabbleInstance/callable Object args
def sb = java.lang.StringBuilder("hello")
def getLen : () : int = sb.length
def appStr : (s : string) : java.lang.StringBuilder = sb.append
def appInt : (n : int) : java.lang.StringBuilder = sb.append
def appBool : (b : bool) : java.lang.StringBuilder = sb.append
def appDbl : (d : double) : java.lang.StringBuilder = sb.append
appStr("!")
appInt(7)
appBool(true)
appDbl(2.5)
def C = class (def n : int) (
    def toString = () : string -> ( "C" + this.n )
)
def objList : java.util.List(any?) = java.util.ArrayList()
objList.add(C(9))
objList.add(C)
objList.add((x : int) -> ( x ))
println(getLen(), ":", sb.toString(), ":", objList.get(0), ":", objList.size())
}}}}}
14:hello!7true2.5:C9:3

