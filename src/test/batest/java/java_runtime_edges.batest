{{{{{
;; Escaping this before unboxed primitive field init triggers Member used before definition
def Esc = class () (
    def read = (e : Esc) : int -> ( e.v )
    def a = this.read(this)
    def v : int = 1
)
Esc()
}}}}}
Member used before definition : v

{{{{{
;; Megamorphic TypedCallCache fallback (>4 distinct functions at one typed call site)
def f0 = (x : int) : int -> ( x + 0 )
def f1 = (x : int) : int -> ( x + 1 )
def f2 = (x : int) : int -> ( x + 2 )
def f3 = (x : int) : int -> ( x + 3 )
def f4 = (x : int) : int -> ( x + 4 )
def f5 = (x : int) : int -> ( x + 5 )
def sum = 0
def i = 0
while i < 6 then (
    def fn : (x : int) : int = if i == 0 then ( f0 )
        else if i == 1 then ( f1 )
        else if i == 2 then ( f2 )
        else if i == 3 then ( f3 )
        else if i == 4 then ( f4 )
        else ( f5 )
    sum += fn(10)
    i += 1
)
println(sum)
}}}}}
75

{{{{{
;; FaceHandler Object methods (equals, hashCode, toString) on Java interface proxy
def Task = class (id : int) implements java.lang.Runnable (
    def run = () -> ( )
)
def t1 : java.lang.Runnable = Task(1)
def t2 : java.lang.Runnable = Task(1)
def t3 : java.lang.Runnable = Task(2)
println(java.util.Objects.equals(t1, t1), ":", java.util.Objects.equals(t1, t2), ":", java.util.Objects.equals(t1, t3), ":", java.util.Objects.hashCode(t1) == java.util.Objects.hashCode(t1), ":", java.util.Objects.toString(t1) != "")
}}}}}
true:false:false:true:true

