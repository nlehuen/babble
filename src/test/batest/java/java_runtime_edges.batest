;; Shared runtime & Java interop edge cases: JavaTypes, JavaClass, JavaLinker, Faces, Overloads, Operators, Values, Types, Members

{{{{{
;; JavaTypes widen (int->double), Faces convertResult check, and Map boxed get
def dsum = java.util.List.of(1, 2, 3).stream().mapToDouble((x : int) -> ( x + 1 )).sum()
def box : java.util.Map(string, any?) = java.util.HashMap()
box.put("k", 42)
println(dsum, ":", box.get("k"))
}}}}}
9.0:42

{{{{{
;; Faces convertResult type error when SAM implementation returns wrong type
def list : java.util.List(int) = java.util.ArrayList()
list.add(1)
list.add(2)
def bad = (x : any?, y : any?) : any? -> ( "oops" )
java.util.Collections.sort(list, bad)
}}}}}
Type error : Comparator.compare must return int, got String

{{{{{
;; JavaTypes.checkBoxed (Integer.getInteger returns null for missing property -> Type error)
def v : int = java.lang.Integer.getInteger("babble.nonexistent.prop")
println(v)
}}}}}
Type error : expected int, got null

{{{{{
;; JavaTypes.wrapInvocationException with NullPointerException (null message) and exception message
def bad = () -> ( java.util.Objects.requireNonNull(null) )
bad()
}}}}}
java.lang.NullPointerException

{{{{{
