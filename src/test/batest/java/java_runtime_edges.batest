{{{{{
;; BabbleInterface extendsType with Java superinterface and instance-of checks
def JList = interface extends java.lang.Runnable (
    def ping = () : int -> ( 7 )
)
def Impl = class () implements JList (
    def run = () -> ( )
)
def x = Impl()
println(x is JList, ":", x is java.lang.Runnable, ":", x is java.lang.AutoCloseable)
}}}}}
true:true:false

