{{{{{
;; Faces FaceHandler & JavaTypes checkParameter with BabbleInstance implementing Java interface
def R = class implements java.lang.Runnable (
    def run = () -> ( println("ran") )
)
def r : java.lang.Runnable = R()
r.run()
def eq = java.util.Objects.equals(r, r)
def eq2 = java.util.Objects.equals(r, R())
def h = java.util.Objects.hashCode(r)
def s = java.lang.String.valueOf(r)
def t = java.lang.Thread(R())
println(eq, ":", eq2, ":", (h != 0 or h == 0), ":", (s != null))
}}}}}
ran
true:false:true:true

