{{{{{
;; FaceHandler Java interface default methods (IntPredicate.negate, IntUnaryOperator.compose) & FunctionHandler Object methods
def P = class () implements java.util.function.IntPredicate (
    def test = (x : int) : bool -> ( x > 0 )
)
def p : java.util.function.IntPredicate = P()
def pNeg = p.negate()
def u : java.util.function.IntUnaryOperator = (x : int) : int -> ( x + 1 )
def uComp = u.compose((x : int) : int -> ( x * 2 ))
def fn : java.util.function.IntPredicate = (x : int) : bool -> ( x > 0 )
def ch = java.lang.String("abc").charAt(0)
println(pNeg.test(5), ":", uComp.applyAsInt(3), ":", java.util.Objects.equals(fn, fn), ":", (java.util.Objects.hashCode(fn) != 0), ":", (java.lang.String.valueOf(fn) != null), ":", ch)
}}}}}
false:7:true:true:true:a

