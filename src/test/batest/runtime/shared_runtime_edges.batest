{{{{{
;; BabbleInterface hierarchy, Values hash/same/is/isBuiltin/fromJava, Arguments rejectLeftovers
def IA = interface (
    def ping = () : int -> ( 10 )
)
def IB = interface extends IA, java.lang.Runnable (
    def pong = () : int -> ( 20 )
)
def IC = interface extends IB ()
def Impl = class () implements IC (
    def run = () -> ()
)
def Other = class () ()
def im = Impl()
def dyn = (v : any?) : any? -> ( v )
println(dyn(im) is IC, ":", dyn(im) is IB, ":", dyn(im) is IA, ":", dyn(Other()) is IA, ":", dyn(im) is java.lang.Runnable, ":", dyn(im) is java.io.Serializable)
println(dyn(java.lang.StringBuilder()) is int, ":", dyn(1) is int, ":", dyn(1.5) is double, ":", dyn("s") is string, ":", dyn(null) is any)

def jlist : java.util.List(java.lang.Runnable) = java.util.ArrayList()
jlist.add(im)
def back : java.lang.Runnable? = jlist.get(0)
println(same(back, im))

def vh = (a : any?) : int -> ( java.util.Objects.hashCode(a) )
def VBox = value class (x : any?) ()
println(VBox(java.lang.Long.valueOf(5)) == VBox(java.lang.Integer.valueOf(5)), ":", VBox(1.0) == VBox(1), ":", VBox(1.5) == VBox(1.5), ":", VBox(1.0 * 1000000000 * 1000000000 * 100) == VBox(1.0 * 1000000000 * 1000000000 * 100))
println(java.util.List.of(VBox(java.lang.Long.valueOf(5)), VBox(java.lang.Short.valueOf("1")), VBox(java.lang.Byte.valueOf("2")), VBox(1.5), VBox(1.0 * 1000000000 * 1000000000 * 100)).hashCode() != 0)
def ch1 = java.lang.Character.valueOf(java.lang.StringBuilder("a").charAt(0))
def sb1 = java.lang.StringBuilder("a")
def sb2 = java.lang.StringBuilder("a")
println(same(ch1, ch1), ":", same(sb1, sb1), ":", same(sb1, sb2))

def fnRename : (x : int) : int = (y = 0) : int -> ( y + 1 )
fnRename(x: 5)
}}}}}
