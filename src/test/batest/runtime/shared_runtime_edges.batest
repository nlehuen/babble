{{{{{
;; checkParameter double widened from int, and File non-File check via >16-arg Proxy fallback SAM
def Demo = import("org.babblelang.tests").JavaClassDemo
def findM = (cls : java.lang.Class(any?), name : string) : java.lang.reflect.Method -> (
    def xs = java.util.Arrays.asList(cls.getMethods())
    def i = 0
    while i < xs.size() then (
        def m = xs.get(i) as java.lang.reflect.Method
        if m.getName() == name then ( return m )
        i += 1
    )
    xs.get(0) as java.lang.reflect.Method
)
def args17 = (a0 : any, a1 : any, a2 : any, a3 : any) -> (
    def l : java.util.List(any?) = java.util.ArrayList(java.util.List.of(a0, a1, a2, a3))
    l.addAll(java.util.Collections.nCopies(13, 0))
    l.toArray()
)
def df = java.util.function.DoubleUnaryOperator((x : double) : double -> ( x + 1.0 ))
def ff = java.io.FilenameFilter((d : java.io.File, n : string) : bool -> ( true ))
assert(Demo.isProxy(df) == false and Demo.isProxy(ff) == false)
def p17 = Demo.Arity17Sam((a0 : int, a1 : double, a2 : java.io.File, a3 : string, a4 : int, a5 : int, a6 : int, a7 : int, a8 : int, a9 : int, a10 : int, a11 : int, a12 : int, a13 : int, a14 : int, a15 : int, a16 : int) : double -> (
    a0 + a1
))
def h = java.lang.reflect.Proxy.getInvocationHandler(p17)
def r1 = h.invoke(p17, findM(p17.getClass(), "apply"), args17(1, 3, java.io.File("."), "a"))
println(r1)
h.invoke(p17, findM(p17.getClass(), "apply"), args17(1, 3.0, 123, "a"))
}}}}}
