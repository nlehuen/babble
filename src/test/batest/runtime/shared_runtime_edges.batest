{{{{{
;; JavaLinker loop with mixed null, String, StringBuilder, BabbleInstance, BabbleClass across 2 passes
def K = class (def v : int) (
    def toString = () : string -> ( "K" )
)
def xs : java.util.List(any?) = java.util.ArrayList()
def addFn : (v : any?) : bool = xs.add
def pickItem = (idx : int) : any? -> (
    if idx == 0 then ( "s" )
    else if idx == 1 then ( null )
    else if idx == 2 then ( java.lang.StringBuilder("sb") )
    else if idx == 3 then ( K(1) )
    else ( K )
)
def p = 0
while p < 2 then (
    def i = 0
    while i < 5 then (
        addFn(pickItem(i))
        i += 1
    )
    p += 1
)
def toStr : (o : any?) : string = java.util.Objects.toString
def out = ""
def j = 0
while j < 5 then (
    out = out + toStr(pickItem(j)) + ";"
    j += 1
)
println(xs.size(), "|", out)
}}}}}
10|s;null;sb;K;class K;

