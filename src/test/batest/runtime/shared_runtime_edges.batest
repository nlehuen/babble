{{{{{
;; BabbleClass implementsType, BabbleInterface extendsType with Java interface, Supers default call on Java interface
def asAny = (v : any) : any -> ( v )
def IRun = interface extends java.lang.Runnable ()
def Runner = class () implements IRun (
    def run = () -> ( () )
)
def MyComp = class () implements java.util.Comparator(int) (
    def compare = (a : int, b : int) : int -> ( a - b )
    def rev = () : java.util.Comparator(any?) -> ( super(java.util.Comparator).reversed() )
)
def runner = Runner()
def obj = object ( def x = 42 )
println(asAny(runner) is java.lang.Runnable, ":", asAny(runner) is IRun, ":", asAny(runner) is java.io.Serializable, ":", obj.x, ":", MyComp().rev().compare(1, 5) > 0)
}}}}}
