{{{{{
;; JavaTypes.convertResult widening (IntToLongFunction + Runnable void), Faces FunctionHandler (equals/hashCode/toString/default),
;; and Faces FaceHandler (equals/hashCode/toString)
def sumL = java.util.stream.IntStream.range(1, 4).mapToLong((x : int) : int -> ( x * 2 )).sum()
def r = java.lang.Runnable(() -> ( 99 ))
r.run()
def c = java.util.function.DoubleFunction((d : double) : string -> ( "d=" + d ))
def pred = java.util.function.Predicate((x : java.lang.Boolean) : bool -> ( x ))
def inc = java.util.function.IntUnaryOperator((x : int) : int -> ( x + 1 ))
def dbl = java.util.function.IntUnaryOperator((x : int) : int -> ( x * 2 ))
def comp = inc.andThen(dbl)

def CompCls = value class (n : int) implements java.util.Comparator(CompCls) (
    def compare = (a : CompCls, b : CompCls) : int -> ( a.n - b.n )
)
def objList = java.util.List.of(CompCls(1), CompCls(2))
println(sumL, ":", c.apply(3), ":", pred.test(java.lang.Boolean.TRUE), ":", comp.applyAsInt(3), ":", r.equals(r), ":", r.hashCode() != 0, ":", objList.equals(java.util.List.of(CompCls(1), CompCls(2))), ":", objList.hashCode() != 0, ":", java.util.Objects.toString(r) != "")
}}}}}
12:d=3.0:true:8:true:true:true:true:true

{{{{{
;; Standard SAMs are LambdaMetafactory-backed (not Proxy); FunctionHandler & JavaTypes.checkParameter covered via >16-arg Proxy fallback SAM
def Demo = import("org.babblelang.tests").JavaClassDemo
def findM = (cls : java.lang.Class(any?), name : string) : java.lang.reflect.Method -> (
    def xs = java.util.Arrays.asList(cls.getMethods())
    def i = 0
    while i < xs.size() then (
        def m = xs.get(i) as java.lang.reflect.Method
        if m.getName() == name then ( return m )
        i += 1
    )
    xs.get(0) as java.lang.reflect.Method
)
def args17 = (a0 : any, a1 : any, a2 : any, a3 : any) -> (
    def l : java.util.List(any?) = java.util.ArrayList(java.util.List.of(a0, a1, a2, a3))
    l.addAll(java.util.Collections.nCopies(13, 0))
    l.toArray()
)
def fn = java.util.function.IntUnaryOperator((x : int) : int -> ( x + 1 ))
assert(Demo.isProxy(fn) == false)
def p17 = Demo.Arity17Sam((a0 : int, a1 : double, a2 : java.io.File, a3 : string, a4 : int, a5 : int, a6 : int, a7 : int, a8 : int, a9 : int, a10 : int, a11 : int, a12 : int, a13 : int, a14 : int, a15 : int, a16 : int) : double -> (
    a0 + a1
))
assert(Demo.isProxy(p17) == true)
assert(p17.equals(p17) and p17.hashCode() != 0 and java.util.Objects.toString(p17) != "" and p17.tag() == 17)
def h = java.lang.reflect.Proxy.getInvocationHandler(p17)
h.invoke(p17, findM(p17.getClass(), "apply"), args17("bad", 1.0, java.io.File("."), "s"))
}}}}}
Type error : expected int, got string

