{{{{{
;; JavaTypes: functionalMethod (Comparator), Objects.toString loop (isNull/BabbleInstance/JavaObject), AssertFunction, Overloads signature with null
def nums = java.util.ArrayList(java.util.List.of(3, 1, 2))
java.util.Collections.sort(nums, (a, b) -> ( a - b ))
def RImpl = class () implements java.lang.Runnable (
    def run = () -> ()
    def toString = () : string -> ( "R" )
)
def items : java.util.ArrayList(any?) = java.util.ArrayList()
items.add("a")
items.add(null)
items.add(java.lang.StringBuilder("z"))
items.add(RImpl())
def acc = ""
def i = 0
def toStrFn : (o : any?, d : string) : string = java.util.Objects.toString
while i < 4 then (
    acc = acc + toStrFn(items.get(i), "nil") + ";"
    i += 1
)
println(nums.toString(), "|", acc)
assert(true, "ok")
assert(false, "boom")
}}}}}
[1, 2, 3]|a;nil;z;R;
boom

{{{{{
