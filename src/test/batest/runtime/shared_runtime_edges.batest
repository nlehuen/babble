No applicable overload of java.lang.StringBuilder.append for (null, java.lang.String, java.lang.Integer) : candidates are (java.lang.StringBuffer), (java.lang.CharSequence), (java.lang.CharSequence, int, int), (char[]), (java.lang.String), (java.lang.Object), (char), (int), (long), (float), (double), (boolean), (char[], int, int)

{{{{{
;; BabbleType static read/write, Member used before definition (static), BabbleInstance javaDefaultMethods & toString(arg)
def C = class (def x : int) (
    private def secret = 99
    def m = () : int -> ( 1 )
) static (
    private def sp = 7
    def sv = 10
    def sm = () : int -> ( this.sp )
)
def V = value class (x : int) (
    def toString = (unused : int) : string -> ( "hi" )
)
def Comp = class () implements java.util.Comparator(int) (
    def compare = (a : int, b : int) : int -> ( a - b )
)
C.sv = 25
def cInst = C(3)
def revFn = Comp().reversed()
println(C.sv, ":", C.sm(), ":", V(4), ":", revFn.compare(1, 5) > 0)
}}}}}
