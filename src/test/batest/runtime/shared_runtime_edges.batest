{{{{{
;; JavaLinker.call (Bootstrap.call with all non-primitive param/return types) & JavaLinker.select (wrapped & raw in loop)
def tbl : java.util.Map(any?, any?) = java.util.HashMap()
def putFn : (k : any?, v : any?) : any? = tbl.put
def toStrFn : (o : any?) : string = java.util.Objects.toString
def s = ""
def i = 0
while i < 3 then (
    putFn("k" + i, "v" + i)
    s += toStrFn("x")
    i += 1
)
putFn(null, java.lang.StringBuilder("sb"))
s += toStrFn(null) + ":" + toStrFn(java.lang.StringBuilder("y"))

def pickSb = (k : int) : java.lang.StringBuilder -> (
    if k == 0 then ( java.lang.StringBuilder("a") ) else ( java.lang.StringBuilder("bb") )
)
def pickBig = (k : int) : java.math.BigInteger -> (
    if k == 0 then ( java.math.BigInteger.valueOf(1) ) else ( java.math.BigInteger.valueOf(2) )
)
def total = 0
def bigSum = java.math.BigInteger.ZERO
i = 0
while i < 3 then (
    def lenFn = pickSb(i).length
    total += lenFn()
    def addBigFn = pickBig(i).add
    bigSum = addBigFn(java.math.BigInteger.ONE)
    i += 1
)
println(tbl.get("k1"), ":", tbl.get(null), ":", s, ":", total, ":", bigSum.toString())
}}}}}
