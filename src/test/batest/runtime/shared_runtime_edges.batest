{{{{{
;; JavaTypes: functionalMethod (Comparator), Objects.toString loop (isNull/BabbleInstance/JavaObject), AssertFunction, Overloads signature with null
def nums = java.util.ArrayList(java.util.List.of(3, 1, 2))
java.util.Collections.sort(nums, (a, b) -> ( a - b ))
def RImpl = class () implements java.lang.Runnable (
    def run = () -> ()
    def toString = () : string -> ( "R" )
)
def items : java.util.ArrayList(any?) = java.util.ArrayList()
items.add("a")
items.add(null)
items.add(java.lang.StringBuilder("z"))
items.add(RImpl())
def acc = ""
def i = 0
def toStrFn : (o : any?, d : string) : string = java.util.Objects.toString
while i < 4 then (
    acc = acc + toStrFn(items.get(i), "nil") + ";"
    i += 1
)
println(nums.toString(), "|", acc)
assert(true, "ok")
assert(false, "boom")
}}}}}
[1, 2, 3]|a;nil;z;R;
boom

{{{{{
;; JavaTypes.checkParameter & convertResult & Overloads signature errors via raw Function/UnaryOperator/Comparator
def dyn = (v : any?) : any? -> ( v )
def cmp : java.util.Comparator(any?) = (a, b) -> ( 0 )
def fn = dyn((a : int) : int -> ( a + 1 )) as java.util.function.IntUnaryOperator
println(fn.applyAsInt(4))
def sb = java.lang.StringBuilder()
def appFn : (a : any?, b : any?, c : any?) : any? = sb.append
appFn(null, "bad", 1)
}}}}}
5
No applicable overload of java.lang.StringBuilder.append for (null, java.lang.String, java.lang.Integer) : candidates are (java.lang.StringBuffer), (java.lang.CharSequence), (java.lang.CharSequence, int, int), (char[]), (java.lang.String), (java.lang.Object), (char), (int), (long), (float), (double), (boolean), (char[], int, int)

