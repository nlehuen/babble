{{{{{
;; Faces default method invocation (FaceHandler & FunctionHandler) via Spliterator + StreamSupport, Object methods, Values.fromJava(FunctionHandler)
def MySplit = class () implements java.util.Spliterator(int) (
    def done : bool = false
    def tryAdvance = mut (action : java.util.function.Consumer(any?)) : bool -> (
        if this.done then ( false )
        else ( this.done = true ; action.accept(42) ; true )
    )
    def trySplit = () : java.util.Spliterator(int)? -> ( null )
    def estimateSize = () : int -> ( 1 )
    def characteristics = () : int -> ( 0 )
)
def streamRes = java.util.stream.StreamSupport.stream(MySplit(), false).toList()
def f1 = java.util.function.Predicate((x : any?) : bool -> ( x == 2 ))
def f2 = java.util.function.IntUnaryOperator((x : int) : int -> ( x + 10 ))
def holder : java.util.List(java.util.function.IntUnaryOperator) = java.util.ArrayList()
holder.add(f2)
def back = holder.get(0)
println(streamRes.size(), ":", streamRes.get(0), ":", java.util.Objects.equals(f1, f1), ":", java.util.Objects.equals(f1, f2), ":", java.util.Objects.hashCode(f1) != 0, ":", java.util.Objects.toString(f2) != "", ":", back.applyAsInt(5))
}}}}}
