;; Shared Runtime edge cases: JavaLinker fast paths, Values, Types, JavaTypes, Overloads, Faces

========== dir/top.ba ==========
export def val = 42

========== dir/sub/leaf.ba ==========
export def val = import("../top.ba").val

========== mod_box_a.ba ==========
export def Dup = class (def x : int) ()

========== mod_box_b.ba ==========
export def Dup = class (def x : int) ()

{{{{{
;; JavaLinker fast-path caches via loop calls (BoundJavaMethod, JavaMethod, isWrappedOf, bindWrapped,
;; bindRaw, isNull, isKind, isWrappedKind, toJava, fail)
def list : java.util.ArrayList(any?) = java.util.ArrayList()
def addLoop = (target : java.util.ArrayList(any?)) : string -> (
    def addFn : (v : any?) : bool = target.add
    def i = 0
    while i < 2 then (
        addFn("x")
        i += 1
    )
    addFn(null)
    addFn(java.lang.StringBuilder("y"))
    target.toString()
)
def staticLoop = () : string -> (
    def valOf : (n : int) : string = java.lang.String.valueOf
    valOf(1) + ":" + valOf(2)
)
println(addLoop(list), ":", staticLoop())
}}}}}
[x, x, null, y]:1:2

{{{{{
;; Overloads ambiguous null call
def sb = java.lang.StringBuilder()
def addFn : (v : any?) : java.lang.StringBuilder = sb.append
addFn(null)
}}}}}
Ambiguous call to java.lang.StringBuilder.append for (null) : candidates are (java.lang.StringBuffer), (java.lang.CharSequence), (char[]), (java.lang.String), (java.lang.Object)

{{{{{
;; JavaLinker.fail on fast-path exception (parseInt fails on 3rd call)
def parse : (s : string) : int = java.lang.Integer.parseInt
def i = 0
while i < 3 then (
    if i == 2 then ( parse("bad") ) else ( parse("12") )
    i += 1
)
}}}}}
java.lang.NumberFormatException : For input string: "bad"

{{{{{
;; JavaLinker.select fast path via polymorphic JavaObject select in loop (different instances, same JavaClass)
def pickSb = (i : int) : java.lang.StringBuilder -> (
    if i == 0 then ( java.lang.StringBuilder("a") )
    else if i == 1 then ( java.lang.StringBuilder("bb") )
    else ( java.lang.StringBuilder("ccc") )
)
def total = 0
def i = 0
while i < 3 then (
    total += pickSb(i).length()
    i += 1
)
println(total)
}}}}}
6

{{{{{
;; Values.hash (via value class with null, int, 2.0, MAX_VALUE), UnionType.convert (double | string),
;; AnyType, and Types.describe variants
def V = value class (a : any?, b : double, c : double) ()
def v1 = V(null, 2.0, java.lang.Double.MAX_VALUE)
def v2 = V(2, 2.0, java.lang.Double.MAX_VALUE)
def map : java.util.Map(V, string) = java.util.HashMap()
map.put(v1, "one")
map.put(v2, "two")
println(v1 == V(null, 2.0, java.lang.Double.MAX_VALUE), ":", map.get(V(null, 2.0, java.lang.Double.MAX_VALUE)), ":", map.get(v2))

def dyn = (v : any?) : any? -> ( v )
def dOrS : double | string = dyn(3) as double | string
def dOrS2 : double | string = dyn("ok") as double | string
def an : any = dyn(5) as any
println(dOrS, ":", dOrS2, ":", an)
}}}}}
