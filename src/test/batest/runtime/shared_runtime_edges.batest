def fn = java.util.function.DoubleUnaryOperator((x : double) : double -> ( x + 1.0 ))
def h = java.lang.reflect.Proxy.getInvocationHandler(fn)
h.invoke(fn, findM(fn.getClass(), "applyAsDouble"), java.util.List.of("bad").toArray())
