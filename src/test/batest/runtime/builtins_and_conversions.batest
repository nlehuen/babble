long(s)
}}}}}
Not a long : "nope"

{{{{{
def d : double = 1.0 / 0.0
long(d)
}}}}}
Out of the long range : d = Infinity

{{{{{
def s : string = "nope"
float(s)
}}}}}
Not a float : "nope"

{{{{{
def s : string = "maybe"
bool(s)
}}}}}
Not a boolean : "maybe"

