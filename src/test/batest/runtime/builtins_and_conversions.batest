def s : string = "ab"
char(s)
}}}}}
Expected single-character string : "ab"

{{{{{
def n : int = -1
char(n)
}}}}}
Out of the char range : n = -1

{{{{{
def n : long = long("3000000000")
int(n)
}}}}}
Out of the int range : n = 3000000000

