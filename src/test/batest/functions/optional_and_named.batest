{{{{{
;; BIP021 §2.2 (e): renamed parameter on interface method binds by static type
def I = interface (
    def m : fn (x : int, y : int = ...) : int
)
def C = class () implements I (
    def m = fn (a : int, b : int = 5) : int -> ( a * 10 + b )
)
def i : I = C()
println(i.m(x: 2))
println(i.m(y: 9, x: 2))
}}}}}
25
29

{{{{{
;; BIP021-D22: required parameter after an optional one in fn, class, and function type
def f = fn (a : int = 1, b : int) : int -> ( a + b )
}}}}}
Required parameter after an optional one : b

{{{{{
def C = class (a : int = 1, b : int) ()
}}}}}
Required parameter after an optional one : b

{{{{{
def f : fn (a : int = ..., b : int) : int = fn (a : int = 1, b : int = 2) : int -> ( a + b )
}}}}}
Required parameter after an optional one : b

{{{{{
;; BIP021-D23: positional argument after out-of-position named argument
def f = fn (a : int, b : int, c : int) : int -> ( a + b + c )
f(b: 2, 1, 3)
}}}}}
Named argument out of position : b

{{{{{
;; BIP021-D23: positional argument after in-position named argument is allowed
def f = fn (a : int, b : int, c : int) : int -> ( a * 100 + b * 10 + c )
println(f(a: 1, 2, 3))
println(f(1, b: 2, 3))
}}}}}
123
123

{{{{{
;; BIP021-D23: duplicate parameter via positional + named or named + named
def f = fn (a : int, b : int) : int -> ( a + b )
f(1, a: 2)
}}}}}
Parameter given twice : a

{{{{{
def f = fn (a : int, b : int) : int -> ( a + b )
f(a: 1, a: 2)
}}}}}
Parameter given twice : a

{{{{{
;; Keyword-only parameter passed positionally is rejected
def f = fn (a : int, ..., b : int) : int -> ( a + b )
f(1, 2)
}}}}}
Too many parameters : 1 declared, 2 given

{{{{{
;; Keyword-only parameter cannot satisfy positional parameter in function type
def f : fn (a : int, b : int) : int = fn (a : int, ..., b : int) : int -> ( a + b )
}}}}}
Type error : expected (a : int, b : int) : int, got (a : int, ..., b : int) : int

{{{{{
;; Positional callee satisfies keyword-only function type
def f : fn (a : int, ..., b : int = ...) : int = fn (x : int, y : int = 20) : int -> ( x + y )
println(f(3))
println(f(3, b: 4))
println(f(b: 5, a: 6))
}}}}}
23
7
11

{{{{{
;; Evaluation order preserved left-to-right when named args are reordered
def sb = java.lang.StringBuilder()
def log = fn io (s : string, v : int) : int -> ( sb.append(s) ; v )
def calc = fn (a : int, b : int, c : int = 0) : int -> ( a * 100 + b * 10 + c )
def r = calc(c: log("c", 3), b: log("b", 2), a: log("a", 1))
println(sb.toString(), ":", r)
}}}}}
cba:123

{{{{{
;; Cross-module optional and keyword-only functions and interfaces
def m = import("m1.ba")
def obj : m.OptIface = m.OptImpl()
println(obj.calc(4))
println(obj.calc(4, 5))
println(obj.calc(scale: 10, a: 2))
println(obj.calc(b: 6, a: 1, scale: 3))
println(m.helper(5))
println(m.helper(5, b: 7))
}}}}}
