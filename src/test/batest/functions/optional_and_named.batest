{{{{{
;; Boxed fallback for > 32 optional parameters (exceeds 32-bit $spec mask)
def big = fn (
    p0 : int = 1, p1 : int = 1, p2 : int = 1, p3 : int = 1, p4 : int = 1,
    p5 : int = 1, p6 : int = 1, p7 : int = 1, p8 : int = 1, p9 : int = 1,
    p10 : int = 1, p11 : int = 1, p12 : int = 1, p13 : int = 1, p14 : int = 1,
    p15 : int = 1, p16 : int = 1, p17 : int = 1, p18 : int = 1, p19 : int = 1,
    p20 : int = 1, p21 : int = 1, p22 : int = 1, p23 : int = 1, p24 : int = 1,
    p25 : int = 1, p26 : int = 1, p27 : int = 1, p28 : int = 1, p29 : int = 1,
    p30 : int = 1, p31 : int = 1, p32 : int = 1
) : int -> (
    p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9 +
    p10 + p11 + p12 + p13 + p14 + p15 + p16 + p17 + p18 + p19 +
    p20 + p21 + p22 + p23 + p24 + p25 + p26 + p27 + p28 + p29 +
    p30 + p31 + p32
)
println(big())
println(big(p32: 10, p0: 2))
}}}}}
33
43

{{{{{
;; Interface with optional parameters implemented by class with extra optional parameters (remapMask)
def Adder = interface (
    def add : fn (a : int, b : int = ...) : int
)
def Plus = class () implements Adder (
    def add = fn (a : int, b : int = 10, c : int = 100) : int -> ( a + b + c )
)
def run = fn (x : Adder) : string -> (
    "" + x.add(1) + ":" + x.add(1, 2) + ":" + x.add(b: 5, a: 2)
)
println(run(Plus()))
}}}}}
111:103:107

{{{{{
;; Indirect function calls with optional parameters (monomorphic & polymorphic call sites)
def f1 = fn (a : int, b : int = 10) : int -> ( a + b )
def f2 = fn (a : int, b : int = 20, c : int = 100) : int -> ( a + b + c )
def invoke = fn (f : fn (a : int, b : int = ...) : int) : string -> (
    "" + f(1) + ":" + f(1, 2)
)
println(invoke(f1), "|", invoke(f2))
}}}}}
11:3|121:103

{{{{{
;; assert with omitted optional message passes Arguments.MISSING
assert(false)
}}}}}
Assertion failed : false

{{{{{
;; assert with explicit null message
assert(false, null)
}}}}}
Assertion failed : false

{{{{{
;; Class and record with keyword-only parameters (exercises ClassShape keywordOnlyStart encode/decode)
def Box = class (def a : int, ..., def b : int = 10, def c : string = "ok") ()
def Pt = record (x : int, ..., y : int = 5) ()
def b1 = Box(1)
def b2 = Box(2, c: "hi", b: 20)
def p1 = Pt(3)
def p2 = Pt(3, y: 9)
println(b1.a, ":", b1.b, ":", b1.c, "|", b2.a, ":", b2.b, ":", b2.c, "|", p1, "|", p2)
}}}}}
1:10:ok|2:20:hi|Pt(x: 3, y: 5)|Pt(x: 3, y: 9)



