;; Named arguments, default parameters (including dependent defaults), and dynamic $call adapter errors

{{{{{
def fmt = (a : int, b : int = 10, c : int = a + b) : string -> (
    "" + a + ":" + b + ":" + c
)
println(fmt(1))
println(fmt(1, 2))
println(fmt(1, 2, 3))
println(fmt(c: 99, a: 2))
println(fmt(5, c: 20))
}}}}}
1:10:11
1:2:3
1:2:3
2:10:99
5:10:20

{{{{{
;; Named arguments passed via dynamic callable interface (exercises $call adapter)
def dynCall = (fn : (x : int, y : int, z : int) : string) : string -> (
    fn(10, 20, 30)
)
def fmt = (a : int = 1, b : int = 2, c : int = 3) : string -> ( "" + a + "-" + b + "-" + c )
println(dynCall(fmt))
}}}}}
10-20-30

{{{{{
;; Unknown named parameter error
def f = (a : int, b : int = 1) : int -> ( a + b )
print(f(1, z: 2))
}}}}}
No such parameter : z

{{{{{
;; Positional slot left unconsumed when parameter is overridden by name
def f = (a : int, b : int = 1, c : int = 2) : int -> ( a + b + c )
print(f(1, a: 2))
}}}}}
Too many parameters : 3 declared, 2 given

{{{{{
;; Repeating the same parameter name: last value wins
def f = (a : int, b : int = 10) : int -> ( a + b )
print(f(a: 1, a: 5))
}}}}}
15

{{{{{
;; Missing required argument when other argument passed by name
def f = (a : int, b : int, c : int = 5) : int -> ( a + b + c )
print(f(a: 1))
}}}}}
Missing parameter : b

{{{{{
;; Function with defaulted trailing parameter satisfies shorter function type
def f = (a : int, b : int = a * 2) : int -> ( a + b )
def indirect : (a : int) : int = f
println(indirect(4))
}}}}}
12

{{{{{
;; Function with required extra parameter does NOT satisfy shorter function type
def f = (a : int, b : int) : int -> ( a + b )
def indirect : (a : int) : int = f
}}}}}
Type error : expected (a : int) : int, got (a : int, b : int) : int
