;; Edge cases for BoolCell/DoubleCell/IntCell/Cell, TypedCallCache, non-spec functions, high-arity calls, and builtin errors

{{{{{
;; Forward capture of bool, double, int, and reference before def triggers Cell use-before-def errors (BoolCell.read)
def f = fn () : bool -> ( b )
f()
def b = true
}}}}}
Name used before definition : b

{{{{{
;; DoubleCell read before definition
def f = fn () : double -> ( d )
f()
def d = 1.5
}}}}}
Name used before definition : d

{{{{{
;; Reference Cell read before definition
def f = fn () : string -> ( s )
f()
def s = "hi"
}}}}}
Name used before definition : s

{{{{{
;; BoolCell assign before definition
def f = fn io () -> ( b = false )
f()
def b = true
}}}}}
Name used before definition : b

{{{{{
;; DoubleCell assign before definition
def f = fn io () -> ( d = 2.5 )
f()
def d = 1.5
}}}}}
Name used before definition : d

{{{{{
;; IntCell assign before definition
def f = fn io () -> ( x = 2 )
f()
def x = 1
}}}}}
Name used before definition : x

{{{{{
;; Uninitialized non-captured double and ref locals hoisted to scope block (pushDefaultZero DOUBLE/NONE)
def cond = false
if cond then ( def x = 1.0 ) else ( )
def f = fn () : double -> ( if cond then ( y ) else ( 0.0 ) )
println(f())
def y = 3.5
}}}}}
0.0

{{{{{
;; LARGE: legacy test pending refactoring
;; Non-primitive ($direct-only, hasSpec == false) function, recursion, optional params, and Bootstrap TypedCallCache paths
def join = fn (a : string, b : string = "!") : string -> ( a + b )
def repeat = fn (s : string, n : int = 2) : string -> ( if n <= 0 then ( "" ) else ( s + recurse(s, n - 1) ) )
def noPrimRec = fn io (s : string) : string -> ( if java.lang.StringBuilder(s).length() >= 3 then ( s ) else ( recurse(s + "x") ) )
println(join("hi"), ":", join("yo", "?"), ":", repeat("a"), ":", noPrimRec("z"))

;; TypedCallCache compatibleSpec return/param mismatch (int vs int?) + megamorphic TypedCallCache (>4 callees)
def f0 = fn (x : int) : int -> ( x + 1 )
def f1 = fn (x : int?) : int? -> ( if x == null then ( 0 ) else ( x + 2 ) )
def f2 = fn (x : int) : int? -> ( x + 3 )
def f3 = fn (x : int) : int? -> ( x + 4 )
def f4 = fn (x : int) : int? -> ( x + 5 )
def f5 = fn (x : int) : int? -> ( x + 6 )
def callTyped = fn (func : fn (x : int) : int?, v : int) : int? -> ( func(v) )

def i = 0
def total = 0
while i < 12 then (
    def k = i - int(i / 6) * 6
    def func : fn (x : int) : int? = if k == 0 then ( f0 ) else if k == 1 then ( f1 ) else if k == 2 then ( f2 ) else if k == 3 then ( f3 ) else if k == 4 then ( f4 ) else ( f5 )
    def r = callTyped(func, 1)
    if r != null then ( total += r )
    i += 1
)
println(total, ":", f0)

def widenParam = fn (func : fn (x : int) : int, v : int) : int -> ( func(v) )
def gNullable = fn (x : int?) : int -> ( if x == null then ( 0 ) else ( x + 10 ) )
println(widenParam(gNullable, 5))
}}}}}
hi!:yo?:aa:zxx
54:function f0
15

{{{{{
;; LARGE: legacy test pending refactoring
;; Dynamic bound method call through TypedCallCache (IS_BOUND_FUNCTION / IS_BOUND_METHOD / incompatible spec)
def C = class (def base : int) (
    def fInt = fn (x : int) : int -> ( this.base + x )
    def fOpt = fn (x : int, d : int = 5) : int -> ( this.base + x + d )
    def fStr = fn (s : string) : string -> ( s + this.base )
)
def c = C(10)
def dynF = c.fInt
def dynOpt = c.fOpt
def dynStr = c.fStr
def boxFn : fn (x : int) : int? = dynF
println(dynF(2), ":", dynOpt(3), ":", dynStr("v="), ":", boxFn(4))

def fOuter = fn (a : int) -> (
    def inner = fn (x : int) : int -> ( a + x )
    inner
)
def g1 = fOuter(10)
def g2 : fn (x : int) : int? = fOuter(20)
def applyTyped = fn (func : fn (x : int) : int?, x : int) : int? -> ( func(x) )
println(applyTyped(g1, 1), ":", applyTyped(g2, 2))
}}}}}
12:18:v=10:14
11:22

