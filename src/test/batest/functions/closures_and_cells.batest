;; Closures capturing IntCell, DoubleCell, BoolCell, Cell, nested scopes, and Namespace fallback

{{{{{
;; Mutable captures across all 4 cell specializations: IntCell, DoubleCell, BoolCell, reference Cell
def makeCounter = fn () -> (
    def i = 0
    def d = 0.5
    def b = false
    def s = "x"
    def step = fn () : string -> (
        i += 1
        d += 1.25
        b = not b
        s += "y"
        "" + i + ":" + d + ":" + b + ":" + s
    )
    step
)
def c1 = makeCounter()
def c2 = makeCounter()
println(c1())
println(c1())
println(c2())
}}}}}
1:1.75:true:xy
2:3.0:false:xyy
1:1.75:true:xy

{{{{{
;; Shared mutable capture between two sibling closures and enclosing block
def shared = fn () : string -> (
    def count = 10
    def inc = fn (k : int) : int -> ( count += k ; count )
    def read = fn () : int -> ( count )
    def a = inc(5)
    def b = read()
    count += 1
    def c = read()
    "" + a + ":" + b + ":" + c
)
println(shared())
}}}}}
15:15:16

{{{{{
;; Multi-level capture (inner closure reads outer variable unused in middle closure)
def outer = fn (x : int) -> (
    def mid = fn () -> (
        fn () : int -> ( x + 100 )
    )
    mid()
)
def func = outer(7)
println(func())
}}}}}
107

{{{{{
;; Widening a captured int variable to double (uses DoubleCell instead of IntCell)
def widenCapture = fn () : string -> (
    def v = 1
    def read = fn () -> ( v )
    v = 2.5
    "" + read() + ":" + classof(read())
)
println(widenCapture())
}}}}}
2.5:java.lang.Double

