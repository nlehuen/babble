{{{{{
;; Private member and method-assignment checks on BabbleInstance / BabbleType + Member used before definition
def C = class (private def s : int = 1, def v : int = 2) (
    def m = fn () : int -> ( this.v )
) static (
    private def ps = 9
    def sm = fn () : int -> ( 1 )
)
C().s
}}}}}
s is private

{{{{{
def C = class (private def s : int = 1, def v : int = 2) ()
C().s = 5
}}}}}
s is private

{{{{{
def C = class (def v : int = 2) (
    def m = fn () : int -> ( 1 )
)
def c = C()
c.m = c.m
}}}}}
Cannot assign method : m

{{{{{
def C = class () () static (
    private def ps = 9
)
C.ps = 1
}}}}}
ps is private

{{{{{
def C = class () () static (
    def sm = fn () : int -> ( 1 )
)
C.sm = fn () : int -> ( 2 )
}}}}}
Cannot assign method : sm

{{{{{
def C = class () () static (
    def a = this.late
    def late = 5
)
}}}}}
Member used before definition : late
