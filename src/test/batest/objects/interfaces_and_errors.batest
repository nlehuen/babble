;; BlockScopes, TypeChecks, BabbleInterface, BabbleInstance, BabbleType, and Supers coverage

========== iface_mod.ba ==========
export def MI = interface (
    def tag : fn () : string
    def shared = fn () : string -> ( "mod:" + this.tag() )
)
export def PI = interface (
    def code : fn () : int
)

{{{{{
;; Module-exported, local, alias, imported Java package, and inner Java Map.Entry
def m = import("iface_mod.ba")
def jutil = import("java.util")
def LocalI = interface (
    def ping = fn () : int -> ( 7 )
)
def AliasMI = m.MI
def Entry = java.util.Map.Entry

def Multi = class (def n : int) implements AliasMI, m.PI, LocalI, java.lang.Runnable (
    def tag = fn () : string -> ( "m" + this.n )
    def code = fn () : int -> ( this.n * 10 )
    def run = fn () -> ( println("run:" + this.tag()) )
)
def multi = Multi(3)
def mi : m.MI = multi
def pi : m.PI = multi
def li : LocalI = multi
println(mi.shared(), ":", pi.code(), ":", li.ping())
println(multi is m.MI, ":", multi is AliasMI, ":", multi is LocalI, ":", multi is java.lang.Runnable)
def r : java.lang.Runnable = multi
r.run()

;; Babble interface extending a Java interface and calling super Java default via Supers
def SubI = interface extends java.util.function.IntPredicate (
    def test = fn (x : int) : bool -> ( x > 0 )
    def alt = fn (x : int) : bool -> ( super(java.util.function.IntPredicate).negate().test(x) )
)
def SubC = class () implements SubI ()
def sub = SubC()
println(sub is SubI, ":", sub is java.util.function.IntPredicate, ":", sub.test(5), ":", sub.alt(5))

;; Inherited interface default lookup across two levels (BabbleInterface.findDefault parent recursion)
def G0 = interface ( def deep = fn () : string -> ( "deep" ) )
def G1 = interface extends G0 ()
def G2 = interface extends G1 ()
def GC = class () implements G2 ()
println(GC().deep())
}}}}}
mod:m3:30:7
true:true:true:true
run:m3
true:true:true:false
deep

