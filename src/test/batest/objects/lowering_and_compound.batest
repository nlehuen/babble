;; Lowering edges: captured class constructor locals (hiddenCells), compound assignments, static fields,
;; constant folding, operators, nested blocks, common superclasses, large strings, and split run methods

{{{{{
;; Class constructor-local variables & non-def constructor params captured by methods (hiddenCells)
def Account = class (initial : int, rate : double = 1.5, tag : string = "acct") (
    def add = fn (amount : int) : string -> (
        initial += amount
        rate += amount * 0.5
        tag += "!"
        "" + initial + ":" + rate + ":" + tag
    )
)
def a = Account(10)
println(a.add(5))
}}}}}
15:4.0:acct!

{{{{{
;; Class method recurse ($spec & $direct) and inner class closures capturing this & constructor param (hiddenCell)
def Rec = class (def base : int, extra : int = 100) (
    def sumSpec = fn (n : int) : int -> ( if n <= 0 then ( 0 ) else ( n + recurse(n - 1) ) )
    def sumDirect = fn (s : string, n : int = 2) : string -> (
        if n <= 0 then ( s ) else ( recurse(s + ".", n - 1) )
    )
    def makeAdder = fn (k : int) -> ( fn () : int -> ( this.base + extra + k ) )
)
def r = Rec(7)
def adder = r.makeAdder(3)
println(r.sumSpec(4), ":", r.sumDirect("x"), ":", adder())
}}}}}
10:x..:110

{{{{{
;; Compound assignments across local int/double, this.field (int/double/ref), external obj.field, and Vec operators
def Vec = class (def x : int, def y : int) (
    def plus = fn (o : Vec) : Vec -> ( Vec(this.x + o.x, this.y + o.y) )
    def minus = fn (o : Vec) : Vec -> ( Vec(this.x - o.x, this.y - o.y) )
    def times = fn (o : Vec) : Vec -> ( Vec(this.x * o.x, this.y * o.y) )
    def div = fn (o : Vec) : Vec -> ( Vec(int(this.x / o.x), int(this.y / o.y)) )
    def neg = fn () : Vec -> ( Vec(-this.x, -this.y) )
    def toString = fn () : string -> ( "V(" + this.x + "," + this.y + ")" )
)

def C = class (def iv : int, def dv : double, def sv : string, def vec : Vec) (
    def tick = fn mut () : string -> (
        this.iv += 2
        this.iv -= 1
        this.iv *= 3
        this.dv += 1.5
        this.dv -= 0.5
        this.dv *= 2.0
        this.dv /= 2.0
        this.sv += "!"
        def k = 10
        k -= 3
        k *= 4
        def d = 2.5
        d -= 0.5
        d *= 3.0
        d /= 2.0
        "" + this.iv + ":" + this.dv + ":" + k + ":" + d + ":" + this.sv
    )
)
def c = C(1, 2.0, "ok", Vec(10, 20))
println(c.tick())
c.iv += 5
def v = Vec(2, 3)
v += Vec(4, 5)
v -= Vec(1, 1)
v *= Vec(2, 3)
v /= Vec(2, 3)
def nv = -v
println(c.iv, ":", v, ":", nv)
}}}}}
6:3.0:28:3.0:ok!
11:V(5,7):V(-5,-7)

{{{{{
;; Static class fields/methods, static block `this`, mutable static assign & compound assign
def Counter = class (def n : int) (
    def id = fn () : int -> ( this.n )
) static (
    def count = 0
    def selfTag = fn () : string -> ( "" + this.count )
    def peek = fn () : int -> ( Counter.count )
)
Counter.count = 10
Counter.count += 5
println(Counter.selfTag(), ":", Counter.peek())
}}}}}
15:15

{{{{{
;; Static member missing/private/assign-method errors (BabbleType)
def C = class () () static (
    private def sec = 1
    def func = fn () : int -> ( 2 )
)
C.missing
}}}}}
No such member : missing

{{{{{
;; Static private field access denied externally
def C = class () () static (
    private def sec = 1
)
C.sec
}}}}}
sec is private

{{{{{
;; Arithmetic identity folding, constant folding, and comparisons across int/double/any
def f = fn (a : int, b : double, s : any) : string -> (
    def r1 = (a + 0) + (0 + a) + (a - 0) + (0 - a) + (a * 1) + (1 * a) + (a * 0) + (0 * a)
    def c1 = (10 - 3) + (4 * 5) + (-(-a))
    def cmp = "" + (a < 10) + ":" + (a <= 5) + ":" + (a > 4) + ":" + (a >= 5) + ":" + (a == 5) + ":" + (a != 6)
    def dcmp = "" + (b < 3.0) + ":" + (b <= 2.5) + ":" + (b > 2.0) + ":" + (b >= 2.5) + ":" + (b == 2.5) + ":" + (b != 1.0)
    def acmp = "" + (s == "k") + ":" + (s != "z")
    "" + r1 + "|" + c1 + "|" + cmp + "|" + dcmp + "|" + acmp
)
println(f(5, 2.5, "k"))
}}}}}
20|32|true:true:true:true:true:true|true:true:true:true:true:true|true:true

{{{{{
;; Unary negate on non-number fails type check
def bad : any = "abc"
println(-bad)
}}}}}
