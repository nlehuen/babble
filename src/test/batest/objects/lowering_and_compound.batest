{{{{{
;; Integer literal out of 32-bit int range fails at parse/check time
println(2147483648)
}}}}}
Integer out of range : 2147483648

{{{{{
;; Nested block scope shadowing, reference-typed while loop body, and common superclass frame merging
def I = interface ( def tag : fn () : string )
def A = class () implements I ( def tag = fn () : string -> ( "A" ) )
def B = class () implements I ( def tag = fn () : string -> ( "B" ) )
def pick = fn (flag : bool) : I -> (
    def a = A()
    def b = B()
    if flag then ( a ) else ( b )
)
println(pick(true).tag(), ":", pick(false).tag())

def x = 10
(
    def x = 20
    println(x)
)
println(x)

def n = 0
def last : string? = while n < 3 then (
    n += 1
    "step:" + n
)
def emptyWhile : string? = while false then ( "never" )
println(last, ":", emptyWhile)
}}}}}
A:B
20
10
step:3:null

