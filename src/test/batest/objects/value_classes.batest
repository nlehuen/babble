;; Value classes: structural equality, hashCode, toString, read-only fields, and invalid modifier error

{{{{{
def Point = record (x : int, y : double, flag : bool = true) ()
def p1 = Point(3, 4.0)
def p2 = Point(3, 4.0)
def p3 = Point(3, 5.0)
println(p1)
println(p1 == p2, ":", p1 == p3, ":", p1 != p3, ":", same(p1, p2))
println(java.util.Objects.equals(p1, p2), ":", java.util.Objects.hashCode(p1) == java.util.Objects.hashCode(p2))
}}}}}
Point(x: 3, y: 4.0, flag: true)
true:false:true:false
true:true

{{{{{
;; Value class nested value comparison and explicit constructor def disallowed? Allowed/read-only
def Pair = record (left : string, right : int) ()
def a = Pair("k", 1)
def b = Pair("k", 1)
println(a == b, ":", a.left, ":", a.right)
}}}}}
true:k:1

{{{{{
;; Value class members are read-only
def Point = record (x : int) ()
def p = Point(1)
p.x = 2
}}}}}
Value members are read-only : x

