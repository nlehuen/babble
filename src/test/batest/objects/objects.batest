;; Singleton object expressions: member access, mutation, and scope errors

{{{{{
;; Singleton object expression with private state and methods
def counter = object (
    private def n = 0
    def inc = mut (k : int = 1) : int -> ( this.n += k ; this.n )
    def read = () : int -> ( this.n )
)
println(counter.inc(), ":", counter.inc(4), ":", counter.read())
}}}}}
1:5:5

{{{{{
;; Private member on object is inaccessible outside
def o = object (
    private def hidden = 1
)
print(o.hidden)
}}}}}
hidden is private

{{{{{
;; Non-assignable primitives fail scope check
def dyn = (v : any) : any -> ( v )
dyn(1).x = 2
}}}}}
Not a scope : dyn(1)

{{{{{
;; 'package' is a regular identifier, not a reserved keyword
def package = 42
def box = object (
    def package = "ok"
)
println(package, ":", box.package)
}}}}}
42:ok
