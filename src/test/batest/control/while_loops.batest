;; While loops: 0 iterations, N iterations, dynamic truthy test, nullable return, and nested loops

{{{{{
;; Basic accumulator and nested loop
def total = 0
def i = 1
while i <= 4 then (
    def j = 1
    while j <= i then (
        total += j
        j += 1
    )
    i += 1
)
println(total)
}}}}}
20

{{{{{
;; Zero-iteration loop evaluates to null
def x = 0
def r = while x > 0 then (
    x -= 1
    x
)
println(r, ":", classof(r))
}}}}}
null:null

{{{{{
;; Non-zero iteration loop returns value of last iteration
def i = 0
def r = while i < 3 then (
    i += 1
    i * 10
)
println(r)
}}}}}
30

{{{{{
;; Dynamic truthy condition in while loop (counts down 3, 2, 1, stops at 0)
def dyn = (v : int) : any -> ( v )
def n = 3
def sum = 0
while dyn(n) then (
    sum += n
    n -= 1
)
println(sum, ":", n)
}}}}}
6:0

{{{{{
;; Mutation inside loop that captures loop-local variable per iteration
def i = 0
def lastFn : () : int = () -> ( 0 )
while i < 3 then (
    def snap = i * 2
    lastFn = () : int -> ( snap )
    i += 1
)
println(lastFn())
}}}}}
4
