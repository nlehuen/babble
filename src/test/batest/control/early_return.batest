;; Early return inside functions, loops, if branches, type widening, and top-level error

{{{{{
def findFirstEven = (n : int) : int -> (
    def i = 1
    while i <= n then (
        if i == 4 then (
            return i
        )
        i += 1
    )
    -1
)
println(findFirstEven(10), ":", findFirstEven(2))
}}}}}
4:-1

{{{{{
;; Return widens int to double when matching explicit/inferred return type
def f = (flag : bool) : double -> (
    if flag then (
        return 3
    )
    4.5
)
println(f(true), ":", classof(f(true)), ":", f(false))
}}}}}
3.0:java.lang.Double:4.5

{{{{{
;; Inferred nullable return from early return null
def f = (x : int) -> (
    if x < 0 then (
        return null
    )
    x * 2
)
println(f(-1), ":", f(5))
}}}}}
null:10

{{{{{
;; Incompatible return type rejected by TypeChecker
def f = (x : int) : int -> (
    if x < 0 then (
        return "bad"
    )
    x
)
}}}}}
Type error : expected int, got string

{{{{{
;; Top-level return outside function is rejected
return 1
}}}}}
return outside of a function
