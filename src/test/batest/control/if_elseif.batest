;; if / then / else / else if chains, branch type joins, nullable if-without-else, and any? truthiness
;; References : BIP008 (unions, nullables), BIP012 (factored ifExpr)

{{{{{
def grade = fn (n : int) : string -> (
    if n >= 90 then (
        "A"
    ) else if n >= 80 then (
        "B"
    ) else if n >= 70 then (
        "C"
    ) else (
        "F"
    )
)
assert(grade(95) == "A")
assert(grade(83) == "B")
assert(grade(71) == "C")
assert(grade(40) == "F")
}}}}}

{{{{{
def classify = fn (x : int) : int -> (
    (if x < 0 then ( 10 ) else if x == 0 then ( 20 ) else ( 30 )) + 1
)
assert(classify(-1) == 11)
assert(classify(0) == 21)
assert(classify(5) == 31)
}}}}}

{{{{{
def maybe = fn (flag : bool) : int? -> (
    if flag then ( 42 )
)
assert(maybe(true) == 42)
assert(maybe(false) == null)
}}}}}

{{{{{
def mix = fn (flag : bool) : double -> (
    if flag then ( 1 ) else ( 2.5 )
)
assert(mix(true) == 1.0)
assert(string(classof(mix(true))) == "java.lang.Double")
assert(mix(false) == 2.5)
}}}}}

{{{{{
;; Truthiness of any? values : 0, 0.0, and null are falsy; non-zero numbers and strings are truthy
def box = fn (v : any?) : any? -> ( v )
def truthy = fn (v : any?) : bool -> ( if v then ( true ) else ( false ) )
assert(not truthy(box(0)))
assert(truthy(box(1)))
assert(not truthy(box(0.0)))
assert(truthy(box(-0.5)))
assert(not truthy(box(null)))
assert(truthy(box("ok")))
}}}}}

{{{{{
def f = fn (x : int) -> ( if x == 1 then ( 10 ) else ( "ten" ) )
def r : int | string = f(1)
assert(r == 10)
assert(f(2) == "ten")
}}}}}

