;; Type aliases (BIP023) : def Name = type T names a type.

def Shape = interface (
    def area: fn (): double
)
def Named = interface (
    def name: fn (): string
)
def Label = interface (
    def text: fn (): string
)
def Tile = class () implements Shape, Named (
    def area = fn (): double -> (1.5)
    def name = fn (): string -> ("tile")
)
def Sign = class () implements Shape, Label (
    def area = fn (): double -> (2.0)
    def text = fn (): string -> ("sign")
)

;; an alias of an intersection with a union
def ShapeWithText = type Shape & (Named | Label)
def describe = fn (x: ShapeWithText): string -> (if x is Named then (x.name()) else (x.text()))
assert(describe(Tile()) == "tile")
assert(describe(Sign()) == "sign")

;; aliases in nullable, is and as positions
def maybe: ShapeWithText? = null
assert(maybe == null)
def anySign: any = Sign()
assert(anySign is ShapeWithText)
assert((anySign as ShapeWithText).area() == 2.0)

;; a generic alias
def Pair of (A, B) = type entry of (A, B)
def p: Pair of (string, int) = entry("a", 1)
assert(p.getKey() == "a" and p.getValue() == 1)

;; an alias of an alias
def Num = type int | double
def Again = type Num
def twice = fn (n: Again): Num -> (if n is int then (n * 2) else (n * 2.0))
assert(twice(2) == 4)
assert(twice(1.5) == 3.0)

;; an alias spanning lines
def Wide = type
    Shape & Named |
    Shape & Label
def wide: Wide = Tile()
assert(wide.area() == 1.5)
