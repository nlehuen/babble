;; Number conversions, int(x) and double(x), and compound assignment : +=, -=, *=, /=.

;; ---- int(x) truncates towards zero, double(x) widens ; both parse strings
assert(int(2.7) == 2)
assert(int(-2.7) == -2)
assert(classof(int(2.0)) == java.lang.Integer)
assert(int(7) == 7)
assert(int(7 / 2) == 3)
assert(int(" 42 ") == 42)
assert(int(2147483647.5) == 2147483647)
assert(int(java.lang.Long.valueOf(9)) == 9)
assert(double(3) == 3.0)
assert(classof(double(3)) == java.lang.Double)
assert(double("2.5") == 2.5)
assert(double(2.5) == 2.5)

;; Typed : int(x) is an int, double(x) a double.
def half: int = int(9 / 2)
assert(half == 4)
def ratio: double = double(half)
assert(ratio == 4.0)

;; ---- compound assignment on a variable : x op= v is x = x op v
def i = 0
i += 3
i *= 4
i -= 2
assert(i == 10)
i /= 4
assert(i == 2.5)

def s = "n = "
s += 1
assert(s == "n = 1")

;; Its value is the value assigned.
def k: int = 1
assert((k += 2) == 3)
assert(k == 3)

;; In a loop, and on a captured variable.
def total = 0
def n = 0
while n < 5 then (
    n += 1
    total += n
)
assert(total == 15)

def counter = fn () -> (
    def count = 0
    fn () -> (count += 1)
)
def next = counter()
next()
assert(next() == 2)

;; ---- on members
def Account = class () (
    def balance: int = 0
    def deposit = fn (amount) -> (this.balance += amount)
    def withdraw = fn (amount) -> (this.balance -= amount)
)
def account = Account()
account.deposit(100)
assert(account.withdraw(30) == 70)
account.balance *= 2
assert(account.balance == 140)

def box = object (def v = 1)
box.v += 1
assert(box.v == 2)

;; The receiver is evaluated once.
def calls = 0
def get = fn io () -> (
    calls += 1
    box
)
get().v += 10
assert(box.v == 12)
assert(calls == 1)

;; ---- with operator methods : x += v calls x.plus(v)
def V = record (x, y) (
    def plus = fn (o): V -> (V(this.x + o.x, this.y + o.y))
    def times = fn (k): V -> (V(this.x * k, this.y * k))
)
def v = V(1, 2)
v += V(10, 20)
v *= 2
assert(v == V(22, 44))

def Particle = class () (
    def position = V(0, 0)
    def move = fn (d) -> (this.position += d)
)
def p = Particle()
p.move(V(1, 1))
p.move(V(2, 3))
assert(p.position == V(3, 4))
