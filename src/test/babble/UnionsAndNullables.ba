;; Union types (A | B), nullable types (T?), strict non-nullable any vs any?,
;; flow-sensitive narrowing with == null / != null / <> null / truthiness / is / else,
;; and int-to-double? widening.

def Node = class (def value, def next) ()

def sumList = fn (head): int -> (
    def total = 0
    def cur: Node? = head
    while cur != null then (
        total += cur.value
        cur = cur.next
    )
    total
)

def linked = Node(1, Node(2, Node(3, null)))
assert(sumList(linked) == 6)
assert(sumList(null) == 0)

def describe = fn (x: int | string | null): string -> (
    if x is int then (
        "int:" + (x + 1)
    ) else if x is string then (
        "str:" + x
    ) else (
        def nil: null = x
        "null:" + nil
    )
)
assert(describe(10) == "int:11")
assert(describe("ok") == "str:ok")
assert(describe(null) == "null:null")

;; Subtraction narrowing via `not (x is ...)` and truthiness of T?
def headOrZero = fn (node): int -> (
    if node then (node.value) else (0)
)
assert(headOrZero(linked) == 1)
assert(headOrZero(null) == 0)

def textOrCount = fn (v: int | string): string -> (
    if not (v is int) then (return "str=" + v)
    "num=" + (v * 2)
)
assert(textOrCount(5) == "num=10")
assert(textOrCount("hi") == "str=hi")

;; Shared members and operator methods across Babble class unions
def VecA = record (x: int, tag: string = "A") (
    def plus = fn (o: int): int -> (this.x + o)
)
def VecB = record (x: int, tag: string = "B") (
    def plus = fn (o: int): int -> (this.x + o * 10)
)
def useUnion = fn (u: VecA | VecB): string -> (
    u.tag + ":" + (u + 2)
)
assert(useUnion(VecA(3)) == "A:5")
assert(useUnion(VecB(3)) == "B:23")

;; Numeric operations on (int | double) and widening to double? vs keeping int in (int | double)
def scale = fn (n: int | double): double -> (n * 2.0)
assert(scale(3) == 6.0)
assert(scale(1.5) == 3.0)

def keepIntOrDouble: int | double = 1
assert(keepIntOrDouble is int)

def maybeDouble = fn (b1, b2): double? -> (
    if b1 then (1) else if b2 then (2.5) else (null)
)
def d1 = maybeDouble(true, false)
assert(d1 is double and d1 == 1.0)
assert(maybeDouble(false, true) == 2.5)
assert(maybeDouble(false, false) == null)

def earlyNullableDouble = fn (flag): double? -> (
    if flag then (return 4)
    null
)
def d2 = earlyNullableDouble(true)
assert(d2 is double and d2 == 4.0)
assert(earlyNullableDouble(false) == null)

;; Callable unions / nullable callbacks and any vs any?
def applyOpt = fn (cb: (fn (n: int): int)?, v): int -> (
    if cb <> null then (cb(v)) else (v)
)
assert(applyOpt(fn (n: int): int -> (n + 10), 5) == 15)
assert(applyOpt(null, 5) == 5)

def acceptAny = fn (v: any): bool -> (v != null)
assert(acceptAny(42))

def nullVal: null = null
assert(nullVal == null)

;; Reassignment widening null -> int? and null -> double?
def infInt = null
infInt = 7
assert(infInt == 7)

def infDbl = null
infDbl = 1
assert(infDbl is double and infDbl == 1.0)
infDbl = 2.5
assert(infDbl == 2.5)

;; Safe-navigation operator (?.) on methods, fields, chains, unions, generics, and Java interop
def B = record (val: int) ()
def A = class (def val: int, def next: A? = null, def opt: B? = null) (
    def f = fn (delta: int = 1): B -> (B(this.val + delta))
    def getInt = fn (): int -> (this.val)
    def id of T = fn (x: T): T -> (x)
)

def makeOptA = fn (present: bool): A? -> (
    if present then (A(10, A(20, null, B(99)), B(5))) else (null)
)

def a1: A? = makeOptA(true)
def b1: B? = a1?.f()
assert(b1 != null and b1.val == 11)

def a0: A? = makeOptA(false)
def b0: B? = a0?.f()
assert(b0 == null)

;; Chaining, field reads, and multiline continuation before ?.
assert(a1?.next?.val == 20)
assert(a1?.next?.opt?.val == 99)
assert(a0?.next?.opt?.val == null)
assert(a1?.next?.f(3)?.val == 23)
assert(a0?.next?.f(3)?.val == null)
def chainedMultiline: int? = a1
    ?.next
    ?.f(5)
    ?.val
assert(chainedMultiline == 25)

;; Short-circuiting: LHS evaluated once, call arguments not evaluated when LHS is null
def rhsRuns = 0
def lhsRuns = 0
def getReceiver = fn io (present: bool): A? -> (
    lhsRuns += 1
    if present then (A(4)) else (null)
)
def bumpArg = fn io (n: int): int -> (
    rhsRuns += 1
    n
)
def resNull: B? = getReceiver(false)?.f(bumpArg(10))
assert(resNull == null and lhsRuns == 1 and rhsRuns == 0)
def resHit: B? = getReceiver(true)?.f(bumpArg(10))
assert(resHit != null and resHit.val == 14 and lhsRuns == 2 and rhsRuns == 1)

;; Int-to-double? widening from ?.
def safeDblHit: double? = a1?.getInt()
def safeDblNull: double? = a0?.getInt()
assert(safeDblHit is double and safeDblHit == 10.0)
assert(safeDblNull == null)

;; Union of Babble classes | null and Java collections / generic methods
def maybeVec: VecA | VecB | null = VecB(7)
assert(maybeVec?.tag == "B")
def nullVec: VecA | VecB | null = null
assert(nullVec?.tag == null)

def maybeList: (java.util.List of B)? = java.util.List.of(B(42))
assert(maybeList?.get(0)?.val == 42)
def nullList: (java.util.List of B)? = null
assert(nullList?.get(0)?.val == null)

def optId: (fn (x: int): int)? = a1?.id
assert(optId != null and optId(7) == 7)
def nullId: (fn (x: int): int)? = a0?.id
assert(nullId == null)
