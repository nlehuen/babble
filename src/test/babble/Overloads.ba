;; Overload sets, static ambiguity checking, union dispatch, and set types (BIP021-I5).

def show = overload (
    fn (n: int): string -> ("int:" + n),
    fn (d: double): string -> ("double:" + d),
    fn (s: string): string -> ("string:" + s),
    fn (xs: list of int): string -> ("list:" + xs.size())
)
assert(show(42) == "int:42")
assert(show(2.5) == "double:2.5")
assert(show("hi") == "string:hi")
assert(show(list(1, 2, 3)) == "list:3")

def describe = overload (
    show,
    fn (b: bool): string -> (if b then ("yes") else ("no"))
)
assert(describe(7) == "int:7")
assert(describe(true) == "yes")

;; Numeric widening ranks: byte -> int -> long -> double
def widen = overload (
    fn (x: long): string -> ("long"),
    fn (x: double): string -> ("double")
)
assert(widen(byte(1)) == "long")
assert(widen(42) == "long")
assert(widen(1.5f) == "double")

;; Union and nullable splits
def fmtOpt = overload (
    fn (n: null): string -> ("none"),
    fn (n: int): string -> ("i:" + n),
    fn (s: string): string -> ("s:" + s)
)
def runOpt = fn (v: int?): string -> (fmtOpt(v))
def runUnion = fn (v: int | string): string -> (fmtOpt(v))
assert(runOpt(null) == "none")
assert(runOpt(5) == "i:5")
assert(runUnion(9) == "i:9")
assert(runUnion("ok") == "s:ok")

;; Set types and target-type selection
def onlyInt: fn (n: int): string = show
assert(onlyInt(3) == "int:3")

def applySet = fn (f: overload (fn (n: int): string, fn (s: string): string)): string -> (
    f(1) + "|" + f("a")
)
assert(applySet(describe) == "int:1|string:a")
assert(applySet(fn (x: int | string): string -> ("g:" + x)) == "g:1|g:a")

;; Generic fallback
def genShow = overload (
    fn (n: int): string -> ("int:" + n),
    fn of T io (t: T): string -> ("any:" + t)
)
assert(genShow(1) == "int:1")
assert(genShow("x") == "any:x")

;; Overloaded methods, operator methods, and static factories (BIP021-I6)
def Vec2 = record (x: double, y: double) (
    def times = overload (
        fn (t: double): Vec2 -> (Vec2(this.x * t, this.y * t)),
        fn (v: Vec2): Vec2 -> (Vec2(this.x * v.x, this.y * v.y))
    )
) static (
    def create = overload (
        fn (s: double): Vec2 -> (Vec2(s, s)),
        fn (x: double, y: double): Vec2 -> (Vec2(x, y))
    )
)
assert(Vec2.create(2.0) * 3 == Vec2(6.0, 6.0))
assert(Vec2.create(2.0, 3.0) * Vec2(4.0, 5.0) == Vec2(8.0, 15.0))

;; Overloaded Babble interface member
def Render = interface (
    def render: overload (
        fn (n: int): string,
        fn (s: string): string
    )
)
def TagRender = class (def tag: string) implements Render (
    def render = overload (
        fn (n: int): string -> (this.tag + ":" + n),
        fn (s: string): string -> (this.tag + "=" + s)
    )
)
def runRender = fn (r: Render): string -> (r.render(1) + "|" + r.render("a"))
assert(runRender(TagRender("T")) == "T:1|T=a")

;; Java interface overload bridge (java.lang.Appendable)
def BufLog = class () implements java.lang.Appendable (
    private def sb = java.lang.StringBuilder()
    def append = overload (
        fn io mut shared (c: char): java.lang.Appendable -> (
            this.sb.append(c)
            this
        ),
        fn io mut shared (shared s: java.lang.CharSequence?): java.lang.Appendable -> (
            if s != null then (this.sb.append(s)) else (this.sb.append("null"))
            this
        ),
        fn io mut shared (shared s: java.lang.CharSequence?, start: int, end: int): java.lang.Appendable -> (
            if s != null then (this.sb.append(s, start, end)) else (this.sb.append("null", start, end))
            this
        )
    )
    def text = fn (): string -> (this.sb.toString())
)
def bufLog = BufLog()
def app: java.lang.Appendable = bufLog
app.append('x')
app.append("hello", 1, 4)
assert(bufLog.text() == "xell")

true
