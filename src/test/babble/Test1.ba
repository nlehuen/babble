;; comments

;;(
    multi-line
    comments
;;)

def add = fn (a, b) -> (  ;;
    a + b              ;; function literal
)                      ;;

;; optional types
def add2 = fn (a: int, b: int): int -> (
    a + b
)

;; function as first-type objects
;; closure support
def adder = fn (a: int): fn (b: int): int -> (
    return fn (b: int): int -> (
        a + b
    )
)

;; loops
def fac2 = fn (n) -> (
    def result = 1
    while n > 1 then (
        ;; use ";" to put several statements on one line
        result = result * n; n = n - 1
    )
    return result
)

;; recursion
def fac = fn (n) -> (
    if n < 2 then (
        1
    ) else (
        ;;(
            recurse is a keyword evaluating
            to the current function literal.
            You could write n * fac(n - 1) here,
            but for anonymous function literals,
            recurse is handy.
        ;;)

        n * recurse(n - 1)
    )
)

;; an early return abandons the rest of the function body
def sign = fn (n) -> (
    if n > 0 then (
        return "positive"
    )
    if n < 0 then (
        return "negative"
    )
    "zero"
)

;; default values, including function literals
def apply = fn (a, f: fn (v: int): int = fn (v: int) -> (v)) -> (f(a))

;; using function scopes as poor man's objects
;; like in Javascript
def counter = fn () -> (
    def c = 0

    fn () -> (
        c = c + 1
    )
)

;; object literals : members are reached through "this"
def counter2 = fn () -> (
    return object (
        def v = 0
        def inc = fn () -> (
            this.v = this.v + 1
        )
    )
)

def main = fn () -> (
    def local = "world !"

    ;; println is a native function
    println("Hello, ", local)

    ;; positional parameters
    println("0+1=", add(0, 1))
    ;; named parameters
    println("1+2=", add(a: 1, b: 2))
    ;; named parameters can have their order changed
    println("2+3=", add2(b: 3, a: 2))

    def result = adder(2)(2)

    return "ok:" + result + ":" + fac(5) + ":" + fac2(6)
)

;; Assertions
assert(1 < 2, "Something is wrong")

assert(apply(1) == 1, "apply is broken")
assert(apply(1, fn (v) -> (v + 1)) == 2, "apply is broken")

assert("ok:4:120:720" == main(), "Test failed")

;; early return
assert("positive" == sign(1), "early return is broken")
assert("negative" == sign(0 - 1), "early return is broken")
assert("zero" == sign(0), "return fall-through is broken")

;; testing counter
def c = counter()
assert(1 == c())
def c2 = counter()
assert(2 == c())
assert(1 == c2())
assert(3 == c())

;; testing counter2
def c3 = counter2()
assert(1 == c3.inc())
assert(2 == c3.inc())
assert(3 == c3.inc())

;; importing Java classes and using them in Babble
def xs: java.util.List of int = java.util.ArrayList()
;; TODO : find proper methods
;; xs.add(1) ; xs.add(2)
assert(xs.size() == 0)
