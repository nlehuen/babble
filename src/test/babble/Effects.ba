;;(
    End-to-end differential tests for RM002 / BIP016 :
    pure-by-default effect inference and verification, mut / shared & default @BORROWED,
    frame-local closures, bounded higher-order specialization,
    narrowing in nothrow, algebraic properties, and host axioms.
;;)

axiom pure nothrow on java.lang.Math

def Vec2 = record (x: double, y: double) (
    def dot = fn (other: Vec2): double -> (
        this.x * other.x + this.y * other.y
    )
)

def Counter = class (def value: int = 0) (
    def add = fn mut (delta: int): int -> (
        this.value += delta
        this.value
    )

    def readPlus = fn (other: Counter): int -> (
        this.value + other.value
    )
)

;; Pure by default (infers @NOTHROW and @TERMINATING)
def square = fn (x: int): int -> (x * x)

;; Higher-order helper with callback-effect forwarding (BIP017)
def mapInt = fn calling f (f: fn (x: int): int, v: int): int -> (f(v))

;; Verified pure nothrow caller using fn calling f + frame-local helper
def forEachUpTo = fn calling f (n: int, f: fn (i: int): int): int -> (
    def i: int = 1
    while i <= n then (
        f(i)
        i += 1
    )
    n
)

def sumSquares = fn nothrow (n: int): int -> (
    def total: int = 0
    forEachUpTo(n, fn (i: int): int -> (
        total += mapInt(square, i)
        total
    ))
    total
)

assert(sumSquares(4) == 30)

;; BIP007-D1 flow-sensitive narrowing preserves nothrow on guarded branches
def unwrapOrZero = fn nothrow (x: int?, fallback: Counter?): int -> (
    if x != null then (
        x
    ) else if fallback != null then (
        fallback.value
    ) else (
        0
    )
)

def parsePositive = fn nothrow (x: int | string): int -> (
    if x is int then (
        x
    ) else (
        -1
    )
)

assert(unwrapOrZero(42, null) == 42 and unwrapOrZero(null, Counter(9)) == 9 and unwrapOrZero(null, null) == 0)
assert(parsePositive(7) == 7 and parsePositive("nope") == -1)

;; Compositional algebraic properties
def scaleShift = fn nothrow monotone (x: double): double -> (
    x * 2.5 + 1.0
)

def affineHash = fn nothrow injective (x: int): int -> (
    x * 3 + 7
)

def tagId = fn nothrow injective (x: int): string -> (
    "id:" + x
)

def addComm = fn nothrow commutative associative (a: int, b: int): int -> (
    a + b
)

assert(scaleShift(2.0) == 6.0)
assert(affineHash(10) == 37)
assert(tagId(9) == "id:9")
assert(addComm(3, 4) == 7)

;; Mutating methods and default @BORROWED reads
def c1 = Counter(10)
def c2 = Counter(5)
assert(c1.add(3) == 13)
assert(c1.readPlus(c2) == 18)
assert(Vec2(3.0, 4.0).dot(Vec2(2.0, 1.0)) == 10.0)
assert(java.lang.Math.max(3, 9) == 9)

;; Function types with optional parameter names
def adder: fn (int, int): int = fn (a: int, b: int): int -> (a + b)
assert(adder(20, 22) == 42)
