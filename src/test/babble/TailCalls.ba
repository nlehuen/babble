;;(
    End-to-end differential tests for BIP024 : self tail calls run in constant stack space
    in every mode (recurse, a function's own def, and this.m), with a fresh activation per call.
;;)

def deep = 1000000

;; recurse(...) in tail position, unboxed int parameters ($spec)
def sumTo = fn (n: int, acc: int): int -> (
    if n == 0 then (acc) else (recurse(n - 1, acc + 1))
)
assert(sumTo(deep, 0) == deep)

;; A call of the function's own def, boxed parameters
def countDown = fn (n: int?, seen: string): string -> (
    if n == null or n == 0 then (seen) else (countDown(n - 1, "x"))
)
assert(countDown(deep, "") == "x")

;; double and bool parameters, through an else if chain
def halve = fn (x: double, steps: int, flip: bool): int -> (
    if steps == 0 then (
        if flip then (1) else (0)
    ) else if x > 1.0 then (
        recurse(x / 2.0, steps - 1, not flip)
    ) else (
        recurse(x * 2.0, steps - 1, not flip)
    )
)
assert(halve(3.0, deep, false) == 0)

;; return in statement position, inside a while loop
def firstOver = fn (n: int, limit: int): int -> (
    while true then (
        if n > limit then (return n)
        return recurse(n + 1, limit)
    )
    0
)
assert(firstOver(0, deep) == deep + 1)

;; return inside a for loop
def skipAll = fn (n: int, xs: list of int): int -> (
    for x in xs then (
        if n > 0 then (return recurse(n - 1, xs))
    )
    n
)
assert(skipAll(deep, list.of(1, 2)) == 0)

;; Optional parameters are evaluated again for each activation, named arguments bound
def withDefaults = fn (n: int, step: int = 1, total: int = 0): int -> (
    if n <= 0 then (total) else (recurse(total: total + step, n: n - step))
)
assert(withDefaults(deep) == deep)
assert(withDefaults(10, 2) == 10)

;; More than 8 parameters : the arguments go through an array
def many = fn (n: int, a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int): int -> (
    if n == 0 then (a + b + c + d + e + f + g + h) else (recurse(n - 1, b, c, d, e, f, g, h, a))
)
assert(many(deep, 1, 2, 3, 4, 5, 6, 7, 8) == 36)

;; Each activation has its own parameters : closures keep theirs
def collect = fn (n: int, mut out: list of fn (): int): list of fn (): int -> (
    if n == 0 then (out) else (
        out.add(fn (): int -> (n))
        recurse(n - 1, out)
    )
)
def closures = collect(3, list())
assert(closures.get(0)() == 3)
assert(closures.get(2)() == 1)

;; this.m(...) in method m
def Walker = class (def stride: int) (
    def walk = fn (n: int, at: int): int -> (
        if n == 0 then (at) else (this.walk(n - 1, at + this.stride))
    )
)
assert(Walker(2).walk(deep, 0) == 2 * deep)

;; Non-tail recursion is unchanged
def fact = fn (n: int): int -> (
    if n <= 1 then (1) else (n * recurse(n - 1))
)
assert(fact(10) == 3628800)
println("tail calls ok")
