;;(
    P6b : Babble generics and Java generics
;;)

;; ---------------------------------------------------------------- Generic Babble functions

def id of T = fn (x: T): T -> (x)
assert(id(42) == 42)
assert(id("hello") == "hello")

def first of (A, B) = fn (a: A, b: B): A -> (a)
assert(first(10, "ignored") == 10)
assert(first("kept", true) == "kept")

def firstOrNull of T = fn (cond: bool, x: T): T? -> (
    if cond then (x) else (null)
)
def present: int? = firstOrNull(true, 7)
def absent: int? = firstOrNull(false, 7)
assert(present == 7)
assert(absent == null)

;; Higher-order generic functions and inferred lambda parameters
def apply of (A, B) = fn (x: A, f: fn (a: A): B): B -> (f(x))
assert(apply(5, fn (n) -> (n * 2)) == 10)

def compose of (A, B, C) = fn (f: fn (b: B): C, g: fn (a: A): B, x: A): C -> (f(g(x)))
assert(compose(fn (s) -> (s + "!"), fn (n: int) -> ("" + n), 9) == "9!")

;; Recursive generic function
def repeatText of T = fn io (n: int, item: T): string -> (
    if n <= 0 then ("") else if n == 1 then ("" + item) else ("" + item + "," + recurse(n - 1, item))
)
assert(repeatText(3, 1) == "1,1,1")
assert(repeatText(2, "ab") == "ab,ab")

;; Generic function instantiated as a function value from expected type
def idInt: fn (x: int): int = id
assert(idInt(99) == 99)
assert(apply("abc", id) == "abc")

;; ---------------------------------------------------------------- Generic Babble classes and value classes

def Box of T = class (def value: T) (
    def get = fn (): T -> (this.value)
    def mapBox of U = fn (f: fn (x: T): U): Box of U -> (Box(f(this.value)))
)

def ib = Box(21)
assert(ib.get() == 21)
def sb: Box of string = ib.mapBox(fn (n) -> ("v=" + n))
assert(sb.get() == "v=21")

;; Construction inferred from expected type (including int -> double widening)
def db: Box of double = Box(3)
assert(db.get() == 3.0)
assert(db.get() is double)

def Pair of (A, B) = record (a: A, b: B) (
    def swap = fn (): Pair of (B, A) -> (Pair(this.b, this.a))
)
def p1 = Pair(1, "two")
def p2 = Pair(1, "two")
assert(p1 == p2)
assert(p1.swap() == Pair("two", 1))
def pd: Pair of (double, double) = Pair(1, 2)
assert(pd == Pair(1.0, 2.0))

;; Generic method on a non-generic class
def Mapper = class () (
    def mapPair of (A, B) = fn (p: Pair of (A, B), f: fn (a: A): B): Pair of (B, B) -> (Pair(f(p.a), p.b))
)
assert(Mapper().mapPair(Pair(4, "4"), fn (n) -> ("" + n)) == Pair("4", "4"))

;; Static blocks on a generic class work without type parameters of the class
def Tagged of T = class (def value: T) () static (
    def label = "tagged"
)
assert(Tagged.label == "tagged")
assert(Tagged(true).value == true)

;; ---------------------------------------------------------------- Generic interfaces, inheritance and defaults

def Container of T = interface (
    def get: fn (): T
    def describe = fn io (): string -> ("box:" + this.get())
)

def Mappable of T = interface extends Container of T (
    def applyTwice = fn (f: fn (x: T): T): T -> (f(f(this.get())))
)

def Holder of T = class (def item: T) implements Mappable of T (
    def get = fn (): T -> (this.item)
    def describe = fn io (): string -> ("[" + super.describe() + "]")
)

def h = Holder(5)
assert(h is Container)
assert(h is Mappable)
assert(h.describe() == "[box:5]")
assert(h.applyTwice(fn (x) -> (x + 3)) == 11)

;; Multi-level concrete instantiation of a generic interface
def IntContainer = interface extends Container of int (
    def doubled = fn (): int -> (this.get() * 2)
)
def FixedInt = class (def n: int) implements IntContainer (
    def get = fn (): int -> (this.n)
)
assert(FixedInt(6).doubled() == 12)
assert(FixedInt(6).describe() == "box:6")

;; ---------------------------------------------------------------- Covariant immutable value class types and is/as

def ValBox of T = record (value: T) (
    def get = fn (): T -> (this.value)
)
def vib: ValBox of int = ValBox(21)
def covDoubleUnion: ValBox of (int | double) = vib
def covAny: ValBox of any = vib
assert(covDoubleUnion.get() == 21)
assert(covAny.get() == 21)

def maybeBox: (Box of int)? = Box(7)
if maybeBox is Box then (
    def n: int = maybeBox.get()
    assert(n == 7)
)

def erased: any = Box("erased")
assert((erased as Box).value == "erased")

;; ---------------------------------------------------------------- Java generics

def xs: java.util.List of string = java.util.ArrayList()
xs.add("b")
xs.add("a")
def firstElem: string? = xs.get(0)
assert(firstElem == "b")
if firstElem != null then (
    assert(java.lang.String(firstElem).toUpperCase() == "B")
)

def entries: java.util.Map of (string, int) = java.util.HashMap()
entries.put("k", 10)
def presentVal: int? = entries.get("k")
def missingVal: int? = entries.get("missing")
assert(presentVal == 10)
assert(missingVal == null)

def uniq: java.util.Set of string = java.util.HashSet()
uniq.add("x")
assert(uniq.contains("x"))

;; Contextual type arguments for Java emptyList / singletonList
def empty: java.util.List of int = java.util.Collections.emptyList()
assert(empty.size() == 0)
def single = java.util.Collections.singletonList("only")
assert(single.get(0) == "only")

;; Java streams, Optional and SAM lambdas
def opt = java.util.Optional.of(41)
assert(opt.map(fn (x) -> (x + 1)).get() == 42)
def mapped = java.util.List.of(1, 2, 3).stream().map(fn (x) -> (x * 10)).toList()
assert(mapped.toString() == "[10, 20, 30]")

;; Java generic bounds: Collections.sort on Comparable Babble value class
def Score = record (points: int) implements java.lang.Comparable of Score (
    def compareTo = fn (o: Score): int -> (this.points - o.points)
)
def scores: java.util.List of Score = java.util.ArrayList()
scores.add(Score(30))
scores.add(Score(10))
scores.add(Score(20))
java.util.Collections.sort(scores)
assert(scores.get(0) == Score(10))
assert(scores.get(2) == Score(30))

;; Generic Java functional interface wrapper
def callable = java.util.concurrent.Callable(fn () -> (123))
assert(callable.call() == 123)

;; Mutable Java collection invariance, copy via from:, & raw `is`/`as`
def ints = java.util.List.of(4, 5)
def anys: list of any = list of any (from: ints)
assert(anys.size() == 2)
def dynList: any = ints
if dynList is java.util.List then (
    assert(dynList.size() == 2)
)
assert((dynList as java.util.List).get(1) == 5)

;; ---------------------------------------------------------------- BIP021-P3 : fn of T, bounds, polymorphic types

;; Generic function literals and polymorphic function values
def idLit = fn of T (t: T): T -> (t)
assert(idLit(7) == 7)
assert(idLit("seven") == "seven")

def k = id
assert(k(10) == 10)
assert(k("ten") == "ten")
def kInt: fn (x: int): int = k
assert(kInt(11) == 11)

;; Higher-order polymorphic function types (BIP021-D20)
def both = fn (f: fn of T (t: T): T): string -> ("" + f(1) + f("a"))
assert(both(id) == "1a")
assert(both(fn of T (t: T): T -> (t)) == "1a")
assert(both(fn (t) -> (t)) == "1a")

;; F-bounded type parameters (BIP021-D19)
def biggest of (T: java.lang.Comparable of T) = fn (a: T, b: T): T -> (
    if a.compareTo(b) > 0 then (a) else (b)
)
assert(biggest(3, 7) == 7)
assert(biggest("pear", "apple") == "pear")
assert(biggest(Score(10), Score(25)) == Score(25))

;; Bounded generic classes and intersection bounds (BIP021-D19 + BIP022)
def HasArea = interface (
    def area: fn (): double
)
def HasLabel = interface (
    def label: fn (): string
)
def Badge = record (tag: string, size: double) implements HasArea, HasLabel (
    def area = fn (): double -> (this.size)
    def label = fn (): string -> (this.tag)
)
def describeBounded = fn of (T: HasArea & HasLabel) (item: T): string -> (
    item.label() + "=" + item.area()
)
assert(describeBounded(Badge("box", 4.5)) == "box=4.5")

def SortedHolder of (T: java.lang.Comparable of T) = class (def a: T, def b: T) (
    def max = fn (): T -> (
        if this.a.compareTo(this.b) >= 0 then (this.a) else (this.b)
    )
)
assert(SortedHolder(12, 8).max() == 12)
assert(SortedHolder("cat", "dog").max() == "dog")

;; Implementable generic interface methods (BIP021 §2.2 (g))
def PolyMapper = interface (
    def echo of T: fn (t: T): T
    def mirror: fn of U (u: U): U
)
def PolyImpl = class () implements PolyMapper (
    def echo of X = fn (x: X): X -> (x)
    def mirror = fn of Y (y: Y): Y -> (y)
)
def pm: PolyMapper = PolyImpl()
assert(pm.echo(42) == 42)
assert(pm.echo("hi") == "hi")
assert(pm.mirror(true) == true)

;; Generics with defaults and named arguments (BIP021-D21)
def pickOrSame = fn of T (a: T, b: T = a): T -> (b)
assert(pickOrSame(5) == 5)
assert(pickOrSame(b: 9, a: 5) == 9)
def optOrNull = fn of T (x: T? = null): T? -> (x)
def emptyOpt: int? = optOrNull()
assert(emptyOpt == null)
assert(optOrNull(3) == 3)

true
