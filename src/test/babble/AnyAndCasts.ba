;; Top type `any`, built-in `is` checks & narrowing, `as` casts, Java arrays,
;; and `int`-to-`double` conversion on `if` and inferred return joins.

;; ---- `any` top type and expected-type `if` branches
def putAny = (v: any): any -> (v)
assert(putAny(1) == 1)
assert(putAny("hello") == "hello")
assert(putAny(null) == null)

def branchAny = (c: bool): any -> (
    if c then (1) else ("alt")
)
assert(branchAny(true) == 1)
assert(branchAny(false) == "alt")

;; ---- `is` on built-in types and flow-sensitive narrowing
def describe = (v: any): string -> (
    if v is int then (
        "int:" + (v + 1)
    ) else if v is double then (
        "double:" + (v * 2.0)
    ) else if v is bool then (
        if v then ("bool:true") else ("bool:false")
    ) else if v is string then (
        "string:" + v
    ) else if v is any then (
        "any:" + v
    ) else (
        "null"
    )
)
assert(describe(4) == "int:5")
assert(describe(2.5) == "double:5.0")
assert(describe(true) == "bool:true")
assert(describe(false) == "bool:false")
assert(describe("babble") == "string:babble")
assert(describe(java.lang.Object()) is string)
assert(describe(null) == "null")

;; Early-return narrowing and boolean short-circuit narrowing
def strOrDefault = (v: any): string -> (
    if not (v is string) then (return "default")
    v
)
assert(strOrDefault("abc") == "abc")
assert(strOrDefault(123) == "default")
assert(strOrDefault(null) == "default")

def positiveInt = (v: any): bool -> (
    v is int and v > 0
)
assert(positiveInt(5))
assert(not positiveInt(-1))
assert(not positiveInt("5"))

;; Shadowing a built-in type name on the right of `is`
def Box = class (def value: int) ()
def readShadowed = (v: any) -> (
    def int = Box
    if v is int then (v.value) else (0)
)
assert(readShadowed(Box(42)) == 42)
assert(readShadowed(42) == 0)
assert(int("7") == 7)

;; ---- `as` casts and operator precedence
def boxed: any = 10
assert(boxed as int + 5 == 15)
assert((1 + 2 as double) is double and 1 + 2 as double == 3.0)
assert(classof(1 as double) == java.lang.Double)
assert(1 as double == 1.0)
assert((null as string) == null)
assert((null as Box) == null)

def Shape = interface (
    def area: (): double
)
def Square = class (def side: double) implements Shape (
    def area = () -> (this.side * this.side)
)
def shape: Shape = Square(3.0)
assert((shape as Square).side == 3.0)

;; ---- Java arrays and `.length`
def parts = java.util.regex.Pattern.compile(",").split("one,two,three")
assert(parts.length == 3)
assert(java.lang.reflect.Array.get(parts, 1) == "two")
assert(java.util.Arrays.asList(parts).size() == 3)

;; ---- `int`-to-`double` conversion on `if` and inferred function results
def pickNumber = (c: bool) -> (
    if c then (1) else (2.0)
)
def w = pickNumber(true)
assert(w is double)
assert(w + w == 2.0)

def pickEarly = (c: bool) -> (
    if c then (return 1)
    2.0
)
def w2 = pickEarly(true)
assert(w2 is double)
assert(w2 + w2 == 2.0)
