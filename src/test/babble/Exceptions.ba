;; End-to-end exception handling tests (BIP028)

def AppError = interface (
    def code: fn (): int
)

def ParseError = record (line: int, message: string) implements AppError (
    def code = fn (): int -> (400)
)

def NotFound = record (id: string) implements AppError (
    def code = fn (): int -> (404)
)

def parsePort = fn io nothrow (text: string): int -> (
    try (
        def n = java.lang.Integer.parseInt(text)
        if n < 1 or n > 65535 then (
            throw exception("port out of range : " + text)
        )
        n
    ) catch : java.lang.NumberFormatException | exception then (
        8080
    ) catch then (
        8080
    )
)

assert(parsePort("80") == 80)
assert(parsePort("0") == 8080)
assert(parsePort("not-a-port") == 8080)

def parseLine = fn io (line: int, raw: string): int -> (
    try (
        java.lang.Integer.parseInt(raw)
    ) catch : java.lang.NumberFormatException then (
        throw ParseError(line, "expected integer, got " + raw)
    )
)

def log = list of string ()
def result = try (
    parseLine(4, "abc")
) catch e: ParseError then (
    log.add("line " + e.line + " : " + e.message)
    -1
) finally (
    log.add("done")
)

assert(result == -1)
assert(log == list("line 4 : expected integer, got abc", "done"))

;; Multi-catch with union narrowing and ThrownException isolation
def dispatch = fn io (n: int): int -> (
    try (
        if n == 0 then (throw ParseError(1, "p")) else if n == 1 then (throw NotFound("x")) else (java.lang.Integer.parseInt("bad"))
    ) catch : java.lang.Exception then (
        500
    ) catch e: ParseError | NotFound then (
        e.code()
    )
)

assert(dispatch(0) == 400)
assert(dispatch(1) == 404)
assert(dispatch(2) == 500)

;; Automatic addSuppressed when finally throws while unwinding
def suppressed = try (
    try (
        throw java.io.IOException("read failed")
    ) finally (
        throw java.io.IOException("close failed")
    )
) catch e: java.io.IOException then (
    "" + e.getMessage() + " / " + e.getSuppressed().get(0)!.getMessage()
)

assert(suppressed == "read failed / close failed")
