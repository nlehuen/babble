;;(
    Implementation of a simple LIFO stack
;;)
package stack (
    def Node = class (def value, def next) ()

    def Stack = class () (
        def size = 0
        def head = null

        def push = (a) -> (
            this.size = this.size + 1
            this.head = Node(a, this.head)
        )

        def first = () -> (
            if this.head == null then (
                null
            ) else (
                this.head.value
            )
        )

        def pop = () -> (
            if this.head == null then (
                null
            ) else (
                def result = this.head.value
                this.head = this.head.next
                this.size = this.size - 1
                result
            )
        )

        ;;(
            A recursive method : "recurse" evaluates to the method bound to the
            receiver, so that "this" still designates it in the recursive call.
        ;;)
        def clear = () -> (
            if this.head == null then (
                this.size
            ) else (
                this.pop()
                recurse()
            )
        )

        def join = (sep=" ") -> (
            def current = this.head
            def result = ""
            def first = true

            while current then (
                if first then (
                    first = false
                ) else (
                    result = result + sep
                )

                result = result + current.value
                current = current.next
            )

            result
        )
    )

    ;; keeps stack.create() working
    def create = () -> ( Stack() )
)

def test = () -> (
    def l = stack.create()
    assert(l.size == 0)
    l.push("world")
    assert(l.size == 1)
    l.push("hello")
    assert(l.size == 2)
    assert("hello/world" == l.join("/"))
    assert("hello world" == l.join())
    assert("hello" == l.pop());
    assert(l.size == 1)
    assert("world" == l.pop());
    assert(l.size == 0)
)

test()


def testRecursiveMethod = () -> (
    def l = stack.Stack()
    l.push("c")
    l.push("b")
    l.push("a")
    assert(l.size == 3)
    assert(0 == l.clear())
    assert(l.size == 0)
    assert(null == l.first())
)

testRecursiveMethod()
