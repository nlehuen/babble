;;(
    Implementation of a simple LIFO stack
;;)
def Node of T = class (def value: T, def next: (Node of T)?) ()

def Stack of T = class () (
    def size = 0
    def head: (Node of T)? = null

    def push = fn mut (a: T) -> (
        this.size = this.size + 1
        this.head = Node(a, this.head)
    )

    def first = fn (): T? -> (
        def head = this.head
        if head == null then (
            null
        ) else (
            head.value
        )
    )

    def pop = fn mut (): T? -> (
        def head = this.head
        if head == null then (
            null
        ) else (
            def result = head.value
            this.head = head.next
            this.size = this.size - 1
            result
        )
    )

    ;;(
        A recursive method : "recurse" evaluates to the method bound to the
        receiver, so that "this" still designates it in the recursive call.
    ;;)
    def clear = fn () -> (
        if this.head == null then (
            this.size
        ) else (
            this.pop()
            recurse()
        )
    )

    def join = fn (sep = " ") -> (
        def current = this.head
        def result = ""
        def first = true

        while current then (
            if first then (
                first = false
            ) else (
                result = result + sep
            )

            result = result + current.value
            current = current.next
        )

        result
    )
)

def create of T = fn (): Stack of T -> (Stack())

def test = fn () -> (
    def l: Stack of string = create()
    assert(l.size == 0)
    l.push("world")
    assert(l.size == 1)
    l.push("hello")
    assert(l.size == 2)
    assert("hello/world" == l.join("/"))
    assert("hello world" == l.join())
    assert("hello" == l.pop())
    assert(l.size == 1)
    assert("world" == l.pop())
    assert(l.size == 0)
)

test()

def testRecursiveMethod = fn () -> (
    def l: Stack of string = Stack()
    l.push("c")
    l.push("b")
    l.push("a")
    assert(l.size == 3)
    assert(0 == l.clear())
    assert(l.size == 0)
    assert(null == l.first())
)

testRecursiveMethod()
