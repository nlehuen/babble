<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.babblelang</groupId>
    <artifactId>babble</artifactId>
    <version>1.0-SNAPSHOT</version>

    <licenses>
        <license>
            <name>Apache-2.0 WITH LLVM-exception</name>
            <url>https://llvm.org/LICENSE.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <antlr.version>4.13.2</antlr.version>
        <junit.version>6.1.3</junit.version>
        <asm.version>9.11.1</asm.version>
        <jline.version>4.7.0</jline.version>
        <batest.filter></batest.filter>
        <batest.inspect></batest.inspect>
        <batest.top>10</batest.top>
        <batest.sort>score</batest.sort>
        <batest.minLinePct>80.0</batest.minLinePct>
        <batest.minBranchPct>80.0</batest.minBranchPct>
        <batest.minDumpSizeForUsingPartialChecks>30</batest.minDumpSizeForUsingPartialChecks>
        <batest.includes>**/BatestTestCase.java</batest.includes>
        <maven.test.redirectTestOutputToFile>true</maven.test.redirectTestOutputToFile>
        <!-- Cap test JVM heap and use ParallelGC for higher batch throughput and lower RSS under
             in-JVM JUnit parallel execution (src/test/resources/junit-platform.properties). -->
        <surefire.jvmArgs>-Xmx768m -XX:+UseParallelGC</surefire.jvmArgs>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>${antlr.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${asm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-analysis</artifactId>
            <version>${asm.version}</version>
        </dependency>
        <!-- Only for the babble.trace and babble.verify debugging switches. -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-util</artifactId>
            <version>${asm.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- Line editing, history and completion in the interactive mode (docs/design/bip004_repl.md §9). The front end's
             only : neither in the runtime jar nor in what babblec writes. jline-terminal-jni reaches the terminal natively. -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-reader</artifactId>
            <version>${jline.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal-jni</artifactId>
            <version>${jline.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>


    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>org/babblelang/axioms/**/*.ba</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <argLine>${surefire.jvmArgs}</argLine>
                    <!-- The first run interprets scripts, which is not the default mode : the
                         interpreter is the reference the compiled run is compared with. -->
                    <systemPropertyVariables>
                        <babble.mode>interpret</babble.mode>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <!-- The whole suite runs a second time with scripts compiled to bytecode at -O1
                         (the default), and every generated class checked by HirVerifier and ASM's
                         CheckClassAdapter. -->
                    <execution>
                        <id>compiled-tests</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/surefire-reports-compiled</reportsDirectory>
                            <systemPropertyVariables>
                                <babble.mode>compile</babble.mode>
                                <babble.verify>true</babble.verify>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                    <!-- And a third time at -O0 (BIP014-D9) so interpret, compile -O0, and compile -O1
                         stay continuously differential-tested across the entire suite. -->
                    <execution>
                        <id>compiled-tests-O0</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/surefire-reports-compiled-O0</reportsDirectory>
                            <systemPropertyVariables>
                                <babble.mode>compile</babble.mode>
                                <babble.opt>0</babble.opt>
                                <babble.verify>true</babble.verify>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- "java -jar target/babble-1.0-SNAPSHOT.jar" starts the interactive mode, or runs a script : the jar
                 names its main class, and its dependencies, copied next to it in target/lib. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <configuration>
                            <archive>
                                <manifest>
                                    <mainClass>org.babblelang.Main</mainClass>
                                    <addClasspath>true</addClasspath>
                                    <classpathPrefix>lib/</classpathPrefix>
                                </manifest>
                                <!-- JLine reaches the terminal natively : no restricted-method warning on JDK 22+. -->
                                <manifestEntries>
                                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </execution>
                    <!-- What a compiled program needs to run, and nothing of the front end : the
                         classes RuntimeBoundaryTestCase keeps free of the parser, the analysis,
                         the compiler, ANTLR and ASM (docs/design/bip006_module-sources-and-aot.md §3). -->
                    <execution>
                        <id>runtime-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>runtime</classifier>
                            <includes>
                                <include>org/babblelang/runtime/**</include>
                                <include>org/babblelang/engine/impl/natives/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>${antlr.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>src/main/antlr4</sourceDirectory>
                            <visitor>true</visitor>
                            <listener>false</listener>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <googleJavaFormat>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>batest-include-legacy</id>
            <activation>
                <property>
                    <name>batest.includeLegacy</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <batest.includes>**/*TestCase.java</batest.includes>
            </properties>
        </profile>
        <profile>
            <id>batest</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.16</version>
                        <executions>
                            <execution>
                                <id>prepare-agent-interpret</id>
                                <phase>process-test-classes</phase>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <propertyName>jacocoInterpretArgLine</propertyName>
                                    <destFile>${project.build.directory}/jacoco-interpret.exec</destFile>
                                    <append>false</append>
                                    <includes>
                                        <include>org.babblelang.*</include>
                                    </includes>
                                    <excludes>
                                        <exclude>org.babblelang.generated.*</exclude>
                                        <exclude>babble.*</exclude>
                                        <exclude>org.babblelang.parser.*</exclude>
                                        <exclude>org.babblelang.compiler.*</exclude>
                                        <exclude>org.babblelang.ir.*</exclude>
                                        <exclude>org.babblelang.opt.*</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>prepare-agent-compile</id>
                                <phase>process-test-classes</phase>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <propertyName>jacocoCompileArgLine</propertyName>
                                    <destFile>${project.build.directory}/jacoco-compile.exec</destFile>
                                    <append>false</append>
                                    <includes>
                                        <include>org.babblelang.*</include>
                                    </includes>
                                    <excludes>
                                        <exclude>org.babblelang.generated.*</exclude>
                                        <exclude>babble.*</exclude>
                                        <exclude>org.babblelang.parser.*</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>prepare-agent-compile-O0</id>
                                <phase>process-test-classes</phase>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <propertyName>jacocoCompileO0ArgLine</propertyName>
                                    <destFile>${project.build.directory}/jacoco-compile-O0.exec</destFile>
                                    <append>false</append>
                                    <includes>
                                        <include>org.babblelang.*</include>
                                    </includes>
                                    <excludes>
                                        <exclude>org.babblelang.generated.*</exclude>
                                        <exclude>babble.*</exclude>
                                        <exclude>org.babblelang.parser.*</exclude>
                                        <exclude>org.babblelang.opt.*</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>prepare-agent-compile-O2</id>
                                <phase>process-test-classes</phase>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <propertyName>jacocoCompileO2ArgLine</propertyName>
                                    <destFile>${project.build.directory}/jacoco-compile-O2.exec</destFile>
                                    <append>false</append>
                                    <includes>
                                        <include>org.babblelang.*</include>
                                    </includes>
                                    <excludes>
                                        <exclude>org.babblelang.generated.*</exclude>
                                        <exclude>babble.*</exclude>
                                        <exclude>org.babblelang.parser.*</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>report-interpret</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                                <configuration>
                                    <dataFile>${project.build.directory}/jacoco-interpret.exec</dataFile>
                                    <outputDirectory>${project.build.directory}/site/jacoco-interpret</outputDirectory>
                                    <excludes>
                                        <exclude>org/babblelang/parser/**</exclude>
                                        <exclude>org/babblelang/compiler/**</exclude>
                                        <exclude>org/babblelang/ir/**</exclude>
                                        <exclude>org/babblelang/opt/**</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>report-compile</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                                <configuration>
                                    <dataFile>${project.build.directory}/jacoco-compile.exec</dataFile>
                                    <outputDirectory>${project.build.directory}/site/jacoco-compile</outputDirectory>
                                    <excludes>
                                        <exclude>org/babblelang/parser/**</exclude>
                                        <exclude>org/babblelang/engine/impl/*</exclude>
                                        <exclude>org/babblelang/ir/mir/**</exclude>
                                        <exclude>org/babblelang/opt/mir/**</exclude>
                                        <exclude>org/babblelang/compiler/MirEmitter*</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>report-opt</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                                <configuration>
                                    <dataFile>${project.build.directory}/jacoco-compile.exec</dataFile>
                                    <outputDirectory>${project.build.directory}/site/jacoco-opt</outputDirectory>
                                    <includes>
                                        <include>org/babblelang/opt/**</include>
                                        <include>org/babblelang/ir/egraph/**</include>
                                    </includes>
                                    <excludes>
                                        <exclude>org/babblelang/opt/mir/**</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>report-compile-O0</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                                <configuration>
                                    <dataFile>${project.build.directory}/jacoco-compile-O0.exec</dataFile>
                                    <outputDirectory>${project.build.directory}/site/jacoco-compile-O0</outputDirectory>
                                    <excludes>
                                        <exclude>org/babblelang/parser/**</exclude>
                                        <exclude>org/babblelang/engine/impl/*</exclude>
                                        <exclude>org/babblelang/opt/**</exclude>
                                        <exclude>org/babblelang/ir/mir/**</exclude>
                                        <exclude>org/babblelang/compiler/MirEmitter*</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>report-mir</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                                <configuration>
                                    <dataFile>${project.build.directory}/jacoco-compile-O2.exec</dataFile>
                                    <outputDirectory>${project.build.directory}/site/jacoco-mir</outputDirectory>
                                    <includes>
                                        <include>org/babblelang/ir/mir/**</include>
                                        <include>org/babblelang/opt/mir/**</include>
                                        <include>org/babblelang/compiler/MirEmitter*</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.6.1</version>
                        <configuration>
                            <argLine>${jacocoInterpretArgLine} ${surefire.jvmArgs}</argLine>
                            <includes>
                                <include>${batest.includes}</include>
                            </includes>
                            <testFailureIgnore>true</testFailureIgnore>
                            <systemPropertyVariables>
                                <babble.mode>interpret</babble.mode>
                                <batest.filter>${batest.filter}</batest.filter>
                                <batest.record>${project.build.directory}/batest-report</batest.record>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <id>compiled-tests</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <configuration>
                                    <argLine>${jacocoCompileArgLine} ${surefire.jvmArgs}</argLine>
                                    <reportsDirectory>${project.build.directory}/surefire-reports-compiled</reportsDirectory>
                                    <includes>
                                        <include>${batest.includes}</include>
                                    </includes>
                                    <testFailureIgnore>true</testFailureIgnore>
                                    <systemPropertyVariables>
                                        <babble.mode>compile</babble.mode>
                                        <babble.verify>true</babble.verify>
                                        <batest.filter>${batest.filter}</batest.filter>
                                        <batest.minDumpSizeForUsingPartialChecks>${batest.minDumpSizeForUsingPartialChecks}</batest.minDumpSizeForUsingPartialChecks>
                                        <batest.record>${project.build.directory}/batest-report</batest.record>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                            <!-- Run compiled-tests-O0 with its own isolated JaCoCo agent (jacoco-compile-O0.exec)
                                 so -O0 never overwrites jacoco-interpret.exec or jacoco-compile.exec (-O1). -->
                            <execution>
                                <id>compiled-tests-O0</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <configuration>
                                    <argLine>${jacocoCompileO0ArgLine} ${surefire.jvmArgs}</argLine>
                                    <reportsDirectory>${project.build.directory}/surefire-reports-compiled-O0</reportsDirectory>
                                    <includes>
                                        <include>${batest.includes}</include>
                                    </includes>
                                    <testFailureIgnore>true</testFailureIgnore>
                                    <systemPropertyVariables>
                                        <babble.mode>compile</babble.mode>
                                        <babble.opt>0</babble.opt>
                                        <babble.verify>true</babble.verify>
                                        <batest.filter>${batest.filter}</batest.filter>
                                        <batest.minDumpSizeForUsingPartialChecks>${batest.minDumpSizeForUsingPartialChecks}</batest.minDumpSizeForUsingPartialChecks>
                                        <batest.record>${project.build.directory}/batest-report</batest.record>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                            <!-- Run compiled-tests-O2 with its own isolated JaCoCo agent (jacoco-compile-O2.exec)
                                 for SSA MIR lowering, MIR passes, and MirEmitter coverage + 4-mode parity. -->
                            <execution>
                                <id>compiled-tests-O2</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <configuration>
                                    <argLine>${jacocoCompileO2ArgLine} ${surefire.jvmArgs}</argLine>
                                    <reportsDirectory>${project.build.directory}/surefire-reports-compiled-O2</reportsDirectory>
                                    <includes>
                                        <include>${batest.includes}</include>
                                    </includes>
                                    <testFailureIgnore>true</testFailureIgnore>
                                    <systemPropertyVariables>
                                        <babble.mode>compile</babble.mode>
                                        <babble.opt>2</babble.opt>
                                        <babble.verify>true</babble.verify>
                                        <batest.filter>${batest.filter}</batest.filter>
                                        <batest.minDumpSizeForUsingPartialChecks>${batest.minDumpSizeForUsingPartialChecks}</batest.minDumpSizeForUsingPartialChecks>
                                        <batest.record>${project.build.directory}/batest-report</batest.record>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.7.0</version>
                        <executions>
                            <execution>
                                <id>batest-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>org.babblelang.tests.batest.BatestCoverageReporter</mainClass>
                                    <classpathScope>test</classpathScope>
                                    <cleanupDaemonThreads>false</cleanupDaemonThreads>
                                    <systemProperties>
                                        <systemProperty>
                                            <key>batest.filter</key>
                                            <value>${batest.filter}</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>batest.inspect</key>
                                            <value>${batest.inspect}</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>batest.top</key>
                                            <value>${batest.top}</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>batest.sort</key>
                                            <value>${batest.sort}</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>batest.minLinePct</key>
                                            <value>${batest.minLinePct}</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>batest.minBranchPct</key>
                                            <value>${batest.minBranchPct}</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>batest.report</key>
                                            <value>${project.build.directory}/batest-report</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>batest.jacocoInterpret</key>
                                            <value>${project.build.directory}/site/jacoco-interpret/jacoco.xml</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>batest.jacocoCompile</key>
                                            <value>${project.build.directory}/site/jacoco-compile/jacoco.xml</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>batest.jacocoCompileO0</key>
                                            <value>${project.build.directory}/site/jacoco-compile-O0/jacoco.xml</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>batest.jacocoOpt</key>
                                            <value>${project.build.directory}/site/jacoco-opt/jacoco.xml</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>batest.jacocoMir</key>
                                            <value>${project.build.directory}/site/jacoco-mir/jacoco.xml</value>
                                        </systemProperty>
                                    </systemProperties>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>O2</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>compiled-tests-O2</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <configuration>
                                    <reportsDirectory>${project.build.directory}/surefire-reports-compiled-O2</reportsDirectory>
                                    <systemPropertyVariables>
                                        <babble.mode>compile</babble.mode>
                                        <babble.opt>2</babble.opt>
                                        <babble.verify>true</babble.verify>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>