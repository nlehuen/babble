;; hittable_list.h

def Hittable = import("hittable.ba").Hittable

export def HittableList = class () implements Hittable (
    private def objects = java.util.ArrayList()

    def add = (item) -> (this.objects.add(item))

    def hit = (r, tmin, tmax) -> (
        def closest = null
        def closestSoFar = tmax
        def count = this.objects.size()
        def i = 0
        while i < count then (
            def rec = (this.objects.get(i) as Hittable).hit(r, tmin, closestSoFar)
            if rec <> null then (
                closest = rec
                closestSoFar = rec.t
            )
            i += 1
        )
        closest
    )
)
