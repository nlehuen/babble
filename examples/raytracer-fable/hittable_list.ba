;; hittable_list.h

def hittable = import("hittable.ba")
def Hittable = hittable.Hittable
def HitRecord = hittable.HitRecord
def Ray = import("ray.ba").Ray

export def HittableList = class () implements Hittable (
    private def objects: java.util.List(Hittable) = java.util.ArrayList()

    def add = (item: Hittable): bool -> (this.objects.add(item))

    def hit = (r: Ray, tmin: double, tmax: double): HitRecord? -> (
        def closest: HitRecord? = null
        def closestSoFar: double = tmax
        def count: int = this.objects.size()
        def i: int = 0
        while i < count then (
            def obj = this.objects.get(i)
            def rec: HitRecord? = if obj != null then (obj.hit(r, tmin, closestSoFar))
            if rec <> null then (
                closest = rec
                closestSoFar = rec.t
            )
            i += 1
        )
        closest
    )
)
