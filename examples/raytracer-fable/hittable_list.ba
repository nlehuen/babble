;; hittable_list.h

def AABB = import("aabb.ba").AABB
def hittable = import("hittable.ba")
def Hittable = hittable.Hittable
def HitRecord = hittable.HitRecord
def Ray = import("ray.ba").Ray

export def HittableList = class () implements Hittable (
    def objects: java.util.List of Hittable = java.util.ArrayList()
    private var bbox: AABB = AABB.empty

    def add = fn mut (shared item: Hittable): bool -> (
        this.bbox = AABB.enclose(this.bbox, item.boundingBox())
        this.objects.add(item)
    )

    def clear = fn mut (): null -> (
        this.objects.clear()
        this.bbox = AABB.empty
        null
    )

    def boundingBox = fn (): AABB -> (this.bbox)

    def hit = fn shared (r: Ray, tmin: double, tmax: double): HitRecord? -> (
        var closest: HitRecord? = null
        var closestSoFar: double = tmax
        def count: int = this.objects.size()
        var i: int = 0
        while i < count then (
            def rec: HitRecord? = this.objects.get(i).hit(r, tmin, closestSoFar)
            if rec <> null then (
                closest = rec
                closestSoFar = rec.t
            )
            i += 1
        )
        closest
    )
)
