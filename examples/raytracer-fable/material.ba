;; material.h

def Math = import("rtweekend.ba").Math
def Vec3 = import("vec3.ba").Vec3
def Ray = import("ray.ba").Ray
def HitRecord = import("hittable.ba").HitRecord

;; What a material does with a ray : the scattered ray and how much it is attenuated.
export def Scatter = class (def attenuation: Vec3, def scattered: Ray) ()

export def Material = interface (
    ;; a Scatter, or null when the ray is absorbed
    def scatter: fn (rIn: Ray, rec: HitRecord, mut rng: java.util.Random): Scatter?
)

export def Lambertian = class (def albedo: Vec3) implements Material (
    def scatter = fn (rIn: Ray, rec: HitRecord, mut rng: java.util.Random): Scatter? -> (
        var direction: Vec3 = rec.normal + Vec3.randomUnit(rng)
        ;; catch degenerate scatter direction
        if direction.nearZero() then (direction = rec.normal)
        Scatter(this.albedo, Ray(rec.p, direction))
    )
)

export def Metal = class (def albedo: Vec3, fuzz: double) implements Material (
    def fuzz: double = Math.min(fuzz, 1.0)

    def scatter = fn (rIn: Ray, rec: HitRecord, mut rng: java.util.Random): Scatter? -> (
        var reflected: Vec3 = rIn.direction.reflect(rec.normal)
        reflected = reflected.unit() + Vec3.randomUnit(rng) * this.fuzz
        if reflected.dot(rec.normal) > 0 then (
            Scatter(this.albedo, Ray(rec.p, reflected))
        ) else (
            null
        )
    )
)

export def Dielectric = class (def refractionIndex: double) implements Material (
    ;; Schlick's approximation for reflectance
    private def reflectance = fn (cosine, refractionIndex): double -> (
        var r0: double = (1 - refractionIndex) / (1 + refractionIndex)
        r0 *= r0
        r0 + (1 - r0) * Math.pow(1 - cosine, 5)
    )

    def scatter = fn (rIn: Ray, rec: HitRecord, mut rng: java.util.Random): Scatter? -> (
        def ri: double = if rec.frontFace then (1.0 / this.refractionIndex) else (this.refractionIndex)

        def unitDirection: Vec3 = rIn.direction.unit()
        def cosTheta: double = Math.min((-unitDirection).dot(rec.normal), 1.0)
        def sinTheta: double = Math.sqrt(1.0 - cosTheta * cosTheta)

        def cannotRefract: bool = ri * sinTheta > 1.0
        def direction: Vec3 = if cannotRefract or this.reflectance(cosTheta, ri) > rng.nextDouble() then (
            unitDirection.reflect(rec.normal)
        ) else (
            unitDirection.refract(rec.normal, ri)
        )

        Scatter(Vec3(1.0, 1.0, 1.0), Ray(rec.p, direction))
    )
)
