;; camera.h

def rtweekend = import("rtweekend.ba")
def Math = rtweekend.Math
def infinity = rtweekend.infinity
def degreesToRadians = rtweekend.degreesToRadians
def Vec3 = import("vec3.ba").Vec3
def Ray = import("ray.ba").Ray

export def Camera = class (
    def aspectRatio = 1.0,                  ;; ratio of image width over height
    def imageWidth = 100,                   ;; rendered image width in pixel count
    def samplesPerPixel = 10,               ;; count of random samples for each pixel
    def maxDepth = 10,                      ;; maximum number of ray bounces into scene
    def vfov = 90,                          ;; vertical view angle (field of view)
    def lookFrom = Vec3(0.0, 0.0, 0.0),     ;; point camera is looking from
    def lookAt = Vec3(0.0, 0.0, 0 - 1.0),   ;; point camera is looking at
    def vup = Vec3(0.0, 1.0, 0.0),          ;; camera-relative "up" direction
    def defocusAngle = 0,                   ;; variation angle of rays through each pixel
    def focusDist = 10                      ;; distance from lookFrom to plane of perfect focus
) (
    def imageHeight = Math.max(1, Math.toIntExact(Math.round(Math.floor(this.imageWidth / this.aspectRatio))))
    private def center = this.lookFrom

    ;; determine viewport dimensions
    private def theta = degreesToRadians(this.vfov)
    private def viewportHeight = 2 * Math.tan(this.theta / 2) * this.focusDist
    private def viewportWidth = this.viewportHeight * this.imageWidth / this.imageHeight

    ;; calculate the u,v,w unit basis vectors for the camera coordinate frame
    private def w = this.lookFrom.minus(this.lookAt).unit()
    private def u = this.vup.cross(this.w).unit()
    private def v = this.w.cross(this.u)

    ;; calculate the vectors across the horizontal and down the vertical viewport edges
    private def viewportU = this.u.times(this.viewportWidth)
    private def viewportV = this.v.neg().times(this.viewportHeight)

    ;; calculate the horizontal and vertical delta vectors from pixel to pixel
    private def pixelDeltaU = this.viewportU.div(this.imageWidth)
    private def pixelDeltaV = this.viewportV.div(this.imageHeight)

    ;; calculate the location of the upper left pixel
    private def viewportUpperLeft = this.center.minus(this.w.times(this.focusDist)).minus(this.viewportU.div(2)).minus(this.viewportV.div(2))
    private def pixel00 = this.viewportUpperLeft.plus(this.pixelDeltaU.plus(this.pixelDeltaV).times(0.5))

    ;; calculate the camera defocus disk basis vectors
    private def defocusRadius = this.focusDist * Math.tan(degreesToRadians(this.defocusAngle / 2))
    private def defocusDiskU = this.u.times(this.defocusRadius)
    private def defocusDiskV = this.v.times(this.defocusRadius)

    ;; a random point in the camera defocus disk
    private def defocusDiskSample = (rng) -> (
        def p = Vec3.randomInUnitDisk(rng)
        this.center.plus(this.defocusDiskU.times(p.x)).plus(this.defocusDiskV.times(p.y))
    )

    ;; a camera ray originating from the defocus disk and directed at a randomly
    ;; sampled point around the pixel location i, j
    private def getRay = (i, j, rng) -> (
        def pixelSample = this.pixel00.plus(this.pixelDeltaU.times(i + rng.nextDouble() - 0.5)).plus(this.pixelDeltaV.times(j + rng.nextDouble() - 0.5))
        def origin = if this.defocusAngle <= 0 then ( this.center ) else ( this.defocusDiskSample(rng) )
        Ray(origin, pixelSample.minus(origin))
    )

    private def rayColor = (r, depth, world, rng) -> (
        ;; if we've exceeded the ray bounce limit, no more light is gathered
        if depth <= 0 then ( return Vec3(0.0, 0.0, 0.0) )

        ;; tmin is 0.001 to ignore hits very close to the origin of the ray : no shadow acne
        def rec = world.hit(r, 0.001, infinity)
        if rec <> null then (
            def s = rec.material.scatter(r, rec, rng)
            if s == null then ( return Vec3(0.0, 0.0, 0.0) )
            return s.attenuation.mul(this.rayColor(s.scattered, depth - 1, world, rng))
        )

        ;; the sky
        def a = 0.5 * (r.direction.unit().y + 1.0)
        Vec3(1.0, 1.0, 1.0).times(1.0 - a).plus(Vec3(0.5, 0.7, 1.0).times(a))
    )

    ;; a linear color component as a gamma 2 byte
    private def toByte = (linear) -> (
        def gamma = if linear > 0 then ( Math.sqrt(linear) ) else ( 0.0 )
        Math.toIntExact(Math.round(Math.floor(256 * Math.max(0.0, Math.min(gamma, 0.999)))))
    )

    ;; Renders the world to a java.awt.image.BufferedImage. The threads take scanlines
    ;; from a shared counter until none is left.
    def render = (world, threads = 1) -> (
        def image = java.awt.image.BufferedImage(this.imageWidth, this.imageHeight, 1)  ;; 1 is TYPE_INT_RGB
        def nextLine = java.util.concurrent.atomic.AtomicInteger()

        def renderLines = () -> (
            def rng = java.util.Random()
            def j = nextLine.getAndIncrement()
            while j < this.imageHeight then (
                def i = 0
                while i < this.imageWidth then (
                    def color = Vec3(0.0, 0.0, 0.0)
                    def sample = 0
                    while sample < this.samplesPerPixel then (
                        color = color.plus(this.rayColor(this.getRay(i, j, rng), this.maxDepth, world, rng))
                        sample = sample + 1
                    )
                    color = color.div(this.samplesPerPixel)
                    image.setRGB(i, j, 65536 * this.toByte(color.x) + 256 * this.toByte(color.y) + this.toByte(color.z))
                    i = i + 1
                )
                j = nextLine.getAndIncrement()
            )
        )

        ;; start the other threads, render on this one too, then wait for the others
        def start = (n) -> (
            if n > 1 then (
                def thread = java.lang.Thread(renderLines)
                thread.start()
                start(n - 1)
                thread.join()
            ) else (
                renderLines()
            )
        )
        start(threads)
        image
    )
)
