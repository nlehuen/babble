;; camera.h

def rtweekend = import("rtweekend.ba")
def Math = rtweekend.Math
def infinity = rtweekend.infinity
def degreesToRadians = rtweekend.degreesToRadians
def Vec3 = import("vec3.ba").Vec3
def Ray = import("ray.ba").Ray
def hittable = import("hittable.ba")
def Hittable = hittable.Hittable
def HitRecord = hittable.HitRecord
def material = import("material.ba")
def Material = material.Material
def Scatter = material.Scatter

;; Background evaluated when a ray misses the scene.
export def Background = interface (
    def sample: fn (r: Ray): Vec3
)

;; Vertical gradient sky (Ray Tracing in One Weekend default).
export def SkyBackground = class (
    def bottom: Vec3 = Vec3(1.0, 1.0, 1.0),
    def top: Vec3 = Vec3(0.5, 0.7, 1.0)
) implements Background (
    def sample = fn (r: Ray): Vec3 -> (
        def a: double = 0.5 * (r.direction.unit().y + 1.0)
        this.bottom * (1.0 - a) + this.top * a
    )
)

;; Uniform solid-color backdrop (e.g. white studio cyclorama or black night sky).
export def SolidBackground = class (def color: Vec3) implements Background (
    def sample = fn (r: Ray): Vec3 -> (this.color)
)

export def Camera = class (
    def aspectRatio: double = 1.0,             ;; ratio of image width over height
    def imageWidth: int = 100,                 ;; rendered image width in pixel count
    def samplesPerPixel: int = 10,             ;; count of random samples for each pixel
    def maxDepth: int = 10,                    ;; maximum number of ray bounces into scene
    def vfov: double = 90.0,                   ;; vertical view angle (field of view)
    def lookFrom: Vec3 = Vec3(0.0, 0.0, 0.0),  ;; point camera is looking from
    def lookAt: Vec3 = Vec3(0.0, 0.0, -1.0),   ;; point camera is looking at
    def vup: Vec3 = Vec3(0.0, 1.0, 0.0),       ;; camera-relative "up" direction
    def defocusAngle: double = 0.0,            ;; variation angle of rays through each pixel
    def focusDist: double = 10.0,              ;; distance from lookFrom to plane of perfect focus
    def background: Background = SkyBackground()
) (
    def imageHeight: int
    private def center: Vec3
    private def pixelDeltaU: Vec3
    private def pixelDeltaV: Vec3
    private def pixel00: Vec3
    private def defocusDiskU: Vec3
    private def defocusDiskV: Vec3

    init (
        this.imageHeight = Math.max(1, int(this.imageWidth / this.aspectRatio))
        this.center = this.lookFrom

        ;; determine viewport dimensions
        def theta: double = degreesToRadians(this.vfov)
        def viewportHeight: double = 2 * Math.tan(theta / 2) * this.focusDist
        def viewportWidth: double = viewportHeight * this.imageWidth / this.imageHeight

        ;; calculate the u,v,w unit basis vectors for the camera coordinate frame
        def w: Vec3 = (this.lookFrom - this.lookAt).unit()
        def u: Vec3 = this.vup.cross(w).unit()
        def v: Vec3 = w.cross(u)

        ;; calculate the vectors across the horizontal and down the vertical viewport edges
        def viewportU: Vec3 = u * viewportWidth
        def viewportV: Vec3 = -v * viewportHeight

        ;; calculate the horizontal and vertical delta vectors from pixel to pixel
        this.pixelDeltaU = viewportU / this.imageWidth
        this.pixelDeltaV = viewportV / this.imageHeight

        ;; calculate the location of the upper left pixel
        def viewportUpperLeft: Vec3 = this.center - w * this.focusDist -
            viewportU / 2 - viewportV / 2
        this.pixel00 = viewportUpperLeft + (this.pixelDeltaU + this.pixelDeltaV) * 0.5

        ;; calculate the camera defocus disk basis vectors
        def defocusRadius: double = this.focusDist * Math.tan(degreesToRadians(this.defocusAngle / 2))
        this.defocusDiskU = u * defocusRadius
        this.defocusDiskV = v * defocusRadius
    )

    ;; a random point in the camera defocus disk
    private def defocusDiskSample = fn (mut rng): Vec3 -> (
        def p: Vec3 = Vec3.randomInUnitDisk(rng)
        this.center + this.defocusDiskU * p.x + this.defocusDiskV * p.y
    )

    ;; a camera ray originating from the defocus disk and directed at a randomly
    ;; sampled point around the pixel location i, j
    private def getRay = fn (i, j, mut rng): Ray -> (
        def pixelSample: Vec3 = this.pixel00 +
            this.pixelDeltaU * (i + rng.nextDouble() - 0.5) +
            this.pixelDeltaV * (j + rng.nextDouble() - 0.5)
        def origin: Vec3 = if this.defocusAngle <= 0 then (this.center) else (this.defocusDiskSample(rng))
        Ray(origin, pixelSample - origin)
    )

    private def rayColor = fn (r, depth, shared world, mut rng): Vec3 -> (
        ;; if we've exceeded the ray bounce limit, no more light is gathered
        if depth <= 0 then (return Vec3(0.0, 0.0, 0.0))

        ;; tmin is 0.001 to ignore hits very close to the origin of the ray : no shadow acne
        def rec: HitRecord? = world.hit(r, 0.001, infinity)
        if rec <> null then (
            def s: Scatter? = (rec.material as Material).scatter(r, rec, rng)
            if s == null then (return Vec3(0.0, 0.0, 0.0))
            def next: Ray? = s.scattered
            if next == null then (return s.emission)
            return s.emission + s.attenuation * this.rayColor(next, depth - 1, world, rng)
        )

        this.background.sample(r)
    )

    ;; a linear color component as a gamma 2 byte
    private def toByte = fn (linear): int -> (
        def gamma: double = if linear > 0 then (Math.sqrt(linear)) else (0.0)
        int(256 * Math.max(0.0, Math.min(gamma, 0.999)))
    )

    ;; Renders the world to a java.awt.image.BufferedImage. The threads take scanlines
    ;; from a shared counter until none is left. Passing a non-null seed makes output
    ;; deterministic per scanline regardless of thread count.
    def render = fn io shared (shared world: Hittable, threads: int = 1, seed: int? = null): java.awt.image.BufferedImage -> (
        def image = java.awt.image.BufferedImage(this.imageWidth, this.imageHeight, java.awt.image.BufferedImage.TYPE_INT_RGB)
        def nextLine = java.util.concurrent.atomic.AtomicInteger()

        def renderLines = fn io (): null -> (
            var rng = java.util.Random()
            var j: int = nextLine.getAndIncrement()
            while j < this.imageHeight then (
                if seed <> null then (rng = java.util.Random(seed + j * 1000003))
                var i: int = 0
                while i < this.imageWidth then (
                    var color = Vec3(0.0, 0.0, 0.0)
                    var sample: int = 0
                    while sample < this.samplesPerPixel then (
                        color += this.rayColor(this.getRay(i, j, rng), this.maxDepth, world, rng)
                        sample += 1
                    )
                    color /= this.samplesPerPixel
                    image.setRGB(i, j, 65536 * this.toByte(color.x) + 256 * this.toByte(color.y) + this.toByte(color.z))
                    i += 1
                )
                j = nextLine.getAndIncrement()
            )
            null
        )

        ;; start the other threads, render on this one too, then wait for the others
        def start = fn io (n): null -> (
            if n > 1 then (
                def thread = java.lang.Thread(renderLines)
                thread.start()
                start(n - 1)
                thread.join()
            ) else (
                renderLines()
            )
            null
        )
        start(threads)
        image
    )
)
