;; bvh.h : bounding volume hierarchy.

def AABB = import("aabb.ba").AABB
def hittable = import("hittable.ba")
def Hittable = hittable.Hittable
def HitRecord = hittable.HitRecord
def HittableList = import("hittable_list.ba").HittableList
def Ray = import("ray.ba").Ray

export def BVHNode = class (def left: Hittable, def right: Hittable, def bbox: AABB) implements Hittable (
    def boundingBox = (): AABB -> (this.bbox)

    def hit = (r: Ray, tmin: double, tmax: double): HitRecord? -> (
        if not this.bbox.hit(r, tmin, tmax) then (return null)

        def hitLeft: HitRecord? = this.left.hit(r, tmin, tmax)
        def rightTmax: double = if hitLeft != null then (hitLeft.t) else (tmax)
        def hitRight: HitRecord? = this.right.hit(r, tmin, rightTmax)
        if hitRight != null then (hitRight) else (hitLeft)
    )
) static (
    ;; Recursively partitions a HittableList into a balanced BVH tree
    def fromList = (list: HittableList): Hittable -> (
        def count: int = list.objects.size()
        if count == 0 then (return list)
        if count == 1 then (
            def only = list.objects.get(0)
            if only != null then (return only)
            return list
        )
        if count == 2 then (
            def first = list.objects.get(0)
            def second = list.objects.get(1)
            if first != null and second != null then (
                return this(first, second, list.boundingBox())
            )
            return list
        )

        def cbox: AABB = AABB.empty
        def i: int = 0
        while i < count then (
            def center = list.objects.get(i)?.boundingBox()?.center()
            if center != null then (
                cbox = cbox.expandPoint(center)
            )
            i += 1
        )
        def axis: int = cbox.longestAxis()
        def splitVal: double = cbox.centroid(axis)

        def leftList: HittableList = HittableList()
        def rightList: HittableList = HittableList()
        i = 0
        while i < count then (
            def item = list.objects.get(i)
            if item != null then (
                if item.boundingBox().centroid(axis) < splitVal then (
                    leftList.add(item)
                ) else (
                    rightList.add(item)
                )
            )
            i += 1
        )

        ;; Fallback even/odd partition when all centroids coincide
        if leftList.objects.size() == 0 or rightList.objects.size() == 0 then (
            leftList.clear()
            rightList.clear()
            def goLeft: bool = true
            i = 0
            while i < count then (
                def item = list.objects.get(i)
                if item != null then (
                    if goLeft then (
                        leftList.add(item)
                    ) else (
                        rightList.add(item)
                    )
                    goLeft = not goLeft
                )
                i += 1
            )
        )

        this(recurse(leftList), recurse(rightList), list.boundingBox())
    )
)
