;; vec3.h : points, directions and colors.

def rtweekend = import("rtweekend.ba")
def Math = rtweekend.Math
def randomDouble = rtweekend.randomDouble

;; Points, directions and colors.
export def Vec3 = record (x: double, y: double, z: double) (
    def neg = fn (): Vec3 -> (Vec3(-this.x, -this.y, -this.z))
    def plus = fn (v: Vec3): Vec3 -> (Vec3(this.x + v.x, this.y + v.y, this.z + v.z))
    def minus = fn (v: Vec3): Vec3 -> (Vec3(this.x - v.x, this.y - v.y, this.z - v.z))
    def times = overload (
        fn (t: double): Vec3 -> (Vec3(this.x * t, this.y * t, this.z * t)),
        fn (v: Vec3): Vec3 -> (Vec3(this.x * v.x, this.y * v.y, this.z * v.z))
    )
    def div = fn (t: double): Vec3 -> (Vec3(this.x / t, this.y / t, this.z / t))

    def dot = fn (v: Vec3): double -> (this.x * v.x + this.y * v.y + this.z * v.z)
    def cross = fn (v: Vec3): Vec3 -> (
        Vec3(this.y * v.z - this.z * v.y,
            this.z * v.x - this.x * v.z,
            this.x * v.y - this.y * v.x)
    )
    def lengthSquared = fn (): double -> (this.x * this.x + this.y * this.y + this.z * this.z)
    def length = fn (): double -> (Math.sqrt(this.lengthSquared()))
    def unit = fn (): Vec3 -> (this / this.length())

    ;; true if the vector is close to zero in all dimensions
    def nearZero = fn (): bool -> (
        def s: double = 0.00000001
        Math.abs(this.x) < s and Math.abs(this.y) < s and Math.abs(this.z) < s
    )

    def reflect = fn (n: Vec3): Vec3 -> (this - n * (2 * this.dot(n)))
    def refract = fn (n: Vec3, etaiOverEtat: double): Vec3 -> (
        def cosTheta: double = Math.min((-this).dot(n), 1.0)
        def perp: Vec3 = (this + n * cosTheta) * etaiOverEtat
        def parallel: Vec3 = n * -Math.sqrt(Math.abs(1.0 - perp.lengthSquared()))
        perp + parallel
    )
) static (
    def random = fn (mut rng: java.util.Random, min: double = 0.0, max: double = 1.0): Vec3 -> (
        Vec3(randomDouble(rng, min, max), randomDouble(rng, min, max), randomDouble(rng, min, max))
    )

    ;; a random direction, by rejection of the points outside the unit sphere
    def randomUnit = fn (mut rng: java.util.Random): Vec3 -> (
        def p: Vec3 = Vec3.random(rng, -1.0, 1.0)
        def lensq: double = p.lengthSquared()
        if 0.0 < lensq and lensq <= 1.0 then (
            p / Math.sqrt(lensq)
        ) else (
            recurse(rng)
        )
    )

    def randomInUnitDisk = fn (mut rng: java.util.Random): Vec3 -> (
        def p: Vec3 = Vec3(randomDouble(rng, -1.0, 1.0), randomDouble(rng, -1.0, 1.0), 0.0)
        if p.lengthSquared() < 1.0 then (p) else (recurse(rng))
    )
)
