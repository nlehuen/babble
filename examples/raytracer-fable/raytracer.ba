;;(
    Ray Tracing in One Weekend, in Babble.

    A port of https://raytracing.github.io/books/RayTracingInOneWeekend.html, following the
    book's structure : vec3, ray, hittable, sphere, hittable_list, material, camera, and the
    final scene of chapter 14.

    What differs from the C++ of the book :
    - a hit or a scatter is returned as a record, or null, instead of filling an out parameter ;
    - the image is written as a PNG through javax.imageio, instead of a PPM on standard output ;
    - scanlines are shared between threads, each with its own random generator, so functions
      that need random numbers take it as their "rng" parameter.

    The program is split into modules along the files of the book : rtweekend, vec3, ray,
    hittable, sphere, hittable_list, material and camera. This file is main.cc.

    Run it from the root of the repository, once "mvn package" has built the jar :
        java -jar target/babble-1.0-SNAPSHOT.jar examples/raytracer-fable/raytracer.ba
;;)

;; ---------------------------------------------------------------- Settings

def output = "examples/raytracer-fable/demo.png"
def imageWidth = 800            ;; the book renders 1200 pixels wide...
def samplesPerPixel = 20        ;; ...with 500 samples per pixel
def maxDepth = 50
def threads = 16

;; ---------------------------------------------------------------- Modules

def randomDouble = import("rtweekend.ba").randomDouble
def Vec3 = import("vec3.ba").Vec3
def HittableList = import("hittable_list.ba").HittableList
def Sphere = import("sphere.ba").Sphere
def material = import("material.ba")
def Lambertian = material.Lambertian
def Metal = material.Metal
def Dielectric = material.Dielectric
def Camera = import("camera.ba").Camera

;; ---------------------------------------------------------------- main

def world = HittableList()

world.add(Sphere(Vec3(0.0, 0 - 1000.0, 0.0), 1000.0, Lambertian(Vec3(0.5, 0.5, 0.5))))

def rng = java.util.Random(20)   ;; a fixed seed : the same scene every time
def a = 0 - 11
while a < 11 then (
    def b = 0 - 11
    while b < 11 then (
        def chooseMat = rng.nextDouble()
        def center = Vec3(a + 0.9 * rng.nextDouble(), 0.2, b + 0.9 * rng.nextDouble())

        if center.minus(Vec3(4.0, 0.2, 0.0)).length() > 0.9 then (
            if chooseMat < 0.8 then (
                ;; diffuse
                def albedo = Vec3.random(rng).mul(Vec3.random(rng))
                world.add(Sphere(center, 0.2, Lambertian(albedo)))
            ) else (
                if chooseMat < 0.95 then (
                    ;; metal
                    def albedo = Vec3.random(rng, 0.5, 1.0)
                    def fuzz = randomDouble(rng, 0.0, 0.5)
                    world.add(Sphere(center, 0.2, Metal(albedo, fuzz)))
                ) else (
                    ;; glass
                    world.add(Sphere(center, 0.2, Dielectric(1.5)))
                )
            )
        )
        b = b + 1
    )
    a = a + 1
)

world.add(Sphere(Vec3(0.0, 1.0, 0.0), 1.0, Dielectric(1.5)))
world.add(Sphere(Vec3(0 - 4.0, 1.0, 0.0), 1.0, Lambertian(Vec3(0.4, 0.2, 0.1))))
world.add(Sphere(Vec3(4.0, 1.0, 0.0), 1.0, Metal(Vec3(0.7, 0.6, 0.5), 0.0)))

def camera = Camera(
    aspectRatio: 16.0 / 9.0,
    imageWidth: imageWidth,
    samplesPerPixel: samplesPerPixel,
    maxDepth: maxDepth,
    vfov: 20,
    lookFrom: Vec3(13.0, 2.0, 3.0),
    lookAt: Vec3(0.0, 0.0, 0.0),
    vup: Vec3(0.0, 1.0, 0.0),
    defocusAngle: 0.6,
    focusDist: 10.0
)

println("Rendering ", camera.imageWidth, "x", camera.imageHeight, ", ", samplesPerPixel, " samples per pixel, on ", threads, " threads")
def started = java.lang.System.currentTimeMillis()
def image = camera.render(world, threads)
javax.imageio.ImageIO.write(image, "png", java.io.File(output))
println("Wrote ", output, " in ", (java.lang.System.currentTimeMillis() - started) / 1000, " s")
