;; Circular pacifier ring (16 segments centered at (+0.550, -0.196), r=0.056)
def ringCx: double = 0.550
def ringCy: double = -0.196
def ringZ: double = 0.58
def ringR: double = 0.056
def ringTube: double = 0.026
def ringSegs: int = 16
var ri: int = 0
while ri < ringSegs then (
    def a0: double = degreesToRadians(ri * 360.0 / ringSegs)
    def a1: double = degreesToRadians((ri + 1) * 360.0 / ringSegs)
    addCone(
        ringCx + ringR * Math.cos(a0), ringCy + ringR * Math.sin(a0), ringZ,
        ringCx + ringR * Math.cos(a1), ringCy + ringR * Math.sin(a1), ringZ,
        ringTube, ringTube, matPacifier, 0.015, 0.03
    )
    ri += 1
)

;; ---------------------------------------------------------------- Render

def bvh: Hittable = BVHNode.fromList(world)
def studio: Hittable = StudioWorld(bvh, StudioLight())

def camera = Camera(
    aspectRatio: 1.0,
    imageWidth: imageWidth,
    samplesPerPixel: samplesPerPixel,
    maxDepth: maxDepth,
    vfov: 11.421186274995679,
    lookFrom: Vec3(0.0, 0.0, 10.0),
    lookAt: Vec3(0.0, 0.0, 0.0),
    vup: Vec3(0.0, 1.0, 0.0),
    defocusAngle: 0.0,
    focusDist: 10.0
)

def started = java.lang.System.currentTimeMillis()
def image = camera.render(studio, threads)
javax.imageio.ImageIO.write(image, "png", java.io.File(output))
def elapsedMs = java.lang.System.currentTimeMillis() - started
println("Rendered ", output, " (", camera.imageWidth, "x", camera.imageHeight, ", ", samplesPerPixel, " spp) in ", elapsedMs, " ms")
