;;(
    Baby Triceratops in Babble, rendered with the fable ray tracer.

    Approximates examples/raytracer-fable/triceratops.jpg at 160x160 using genuine 3D
    primitives (Sphere, rotated Ellipsoid, tapered RoundCone, 3D Bezier chains, and
    Fourier-contoured 3D SculptedLobe cushions) accelerated by BVHNode and shaded with
    inset 3D outline shells, directional studio cel lighting, and Monte Carlo ambient
    occlusion, without modifying any of the existing fable renderer modules.

    Run from the root of the repository (after "mvn package") :
        java -jar target/babble-1.0-SNAPSHOT.jar examples/raytracer-fable/triceratops.ba [output.png]
;;)

;; ---------------------------------------------------------------- Settings

def defaultOutput: string = "examples/raytracer-fable/triceratops_render.png"
def output: string = if args.size() > 0 then (
    def arg0 = args.get(0)
    if arg0 != null then (arg0) else (defaultOutput)
) else (defaultOutput)

def imageWidth: int = 160
def samplesPerPixel: int = 32
def maxDepth: int = 5
def threads: int = 16

;; ---------------------------------------------------------------- Modules

def rtweekend = import("rtweekend.ba")
def Math = rtweekend.Math
def degreesToRadians = rtweekend.degreesToRadians
def Vec3 = import("vec3.ba").Vec3
def Ray = import("ray.ba").Ray
def AABB = import("aabb.ba").AABB
def hittable = import("hittable.ba")
def Hittable = hittable.Hittable
def HitRecord = hittable.HitRecord
def Sphere = import("sphere.ba").Sphere
def HittableList = import("hittable_list.ba").HittableList
def BVHNode = import("bvh.ba").BVHNode
def material = import("material.ba")
def Material = material.Material
def Scatter = material.Scatter
def Camera = import("camera.ba").Camera

;; ---------------------------------------------------------------- Colors (sRGB -> gamma-2 linear)

def srgb = fn (r: int, g: int, b: int): Vec3 -> (
    def rf: double = r / 255.0
    def gf: double = g / 255.0
    def bf: double = b / 255.0
    Vec3(rf * rf, gf * gf, bf * bf)
)

def colOutline: Vec3 = srgb(60, 18, 80)
def colBody: Vec3 = srgb(172, 68, 143)
def colBodyShadow: Vec3 = srgb(132, 46, 117)
def colBodyDeep: Vec3 = srgb(114, 35, 102)
def colFrill: Vec3 = srgb(213, 145, 230)
def colFrillShadow: Vec3 = srgb(196, 126, 218)
def colFrillRim: Vec3 = srgb(242, 196, 255)
def colBelly: Vec3 = srgb(229, 176, 245)
def colBellyShadow: Vec3 = srgb(189, 133, 209)
def colHorn: Vec3 = srgb(255, 232, 174)
def colHornShadow: Vec3 = srgb(240, 194, 120)
def colCream: Vec3 = srgb(246, 222, 212)
def colCreamShadow: Vec3 = srgb(224, 194, 186)
def colCheek: Vec3 = srgb(236, 104, 116)
def colPacifier: Vec3 = srgb(176, 242, 56)
def colPacifierShadow: Vec3 = srgb(134, 210, 30)
def colPacifierDark: Vec3 = srgb(104, 182, 24)
def colWhite: Vec3 = Vec3(1.0, 1.0, 1.0)
def colEyeDark: Vec3 = srgb(54, 24, 90)

;; ---------------------------------------------------------------- Studio backdrop & materials

;; Redirects escaped rays straight down (y = -1) from outside the scene so camera.ba's sky
;; evaluates to a = 0 -> exact pure white (1, 1, 1), without modifying camera.ba.
def StudioLight = class () implements Material (
    def scatter = fn (rIn: Ray, rec: HitRecord, mut rng: java.util.Random): Scatter? -> (
        Scatter(Vec3(1.0, 1.0, 1.0), Ray(Vec3(0.0, -10000.0, 0.0), Vec3(0.0, -1.0, 0.0)))
    )
)

def StudioWorld = class (def scene: Hittable, def backdrop: Material) implements Hittable (
    private def bbox: AABB = AABB(-2000.0, 2000.0, -2000.0, 2000.0, -2000.0, 2000.0)

    def boundingBox = fn (): AABB -> (this.bbox)

    def hit = fn shared (r: Ray, tmin: double, tmax: double): HitRecord? -> (
        if r.origin.y < -5000.0 then (return null)
        def rec: HitRecord? = this.scene.hit(r, tmin, tmax)
        if rec <> null then (return rec)
        HitRecord(r, r.at(1000.0), 1000.0, -r.direction.unit(), this.backdrop)
    )
)

;; 3D cartoon material : 2-band directional studio cel shading and probabilistic indirect AO.
def ToonMaterial = class (
    def baseColor: Vec3,
    def shadowColor: Vec3,
    def lightDir: Vec3,
    def aoProb: double = 0.08,
    def rampLow: double = -0.25,
    def rampHigh: double = 0.70
) implements Material (
    private def ldir: Vec3 = this.lightDir.unit()
    private def invSpan: double = 1.0 / Math.max(0.01, this.rampHigh - this.rampLow)

    def scatter = fn (rIn: Ray, rec: HitRecord, mut rng: java.util.Random): Scatter? -> (
        def isPrimary: bool = rIn.origin.z > 5.0
        def ndotl: double = rec.normal.dot(this.ldir)
        def t: double = Math.max(0.0, Math.min(1.0, (ndotl - this.rampLow) * this.invSpan))
        def shaded: Vec3 = this.shadowColor * (1.0 - t) + this.baseColor * t

        if isPrimary and rng.nextDouble() < this.aoProb then (
            var direction: Vec3 = rec.normal + Vec3.randomUnit(rng)
            if direction.nearZero() then (direction = rec.normal)
            return Scatter(shaded, Ray(rec.p, direction))
        )
        Scatter(shaded, Ray(Vec3(0.0, -10000.0, 0.0), Vec3(0.0, -1.0, 0.0)))
    )
)

;; Flat ink/highlight material for outline shells and crisp facial details.
def FlatMaterial = class (def color: Vec3) implements Material (
    def scatter = fn (rIn: Ray, rec: HitRecord, mut rng: java.util.Random): Scatter? -> (
        Scatter(this.color, Ray(Vec3(0.0, -10000.0, 0.0), Vec3(0.0, -1.0, 0.0)))
    )
)

;; ---------------------------------------------------------------- 3D Analytic Primitives

;; Oriented 3D ellipsoid with exact tight AABB and quadratic ray intersection.
def Ellipsoid = class (
    def center: Vec3,
    def u: Vec3,
    def v: Vec3,
    def w: Vec3,
    def rx: double,
    def ry: double,
    def rz: double,
    def material: Material
) implements Hittable (
    private def invRx: double = 1.0 / this.rx
    private def invRy: double = 1.0 / this.ry
    private def invRz: double = 1.0 / this.rz

    private def bbox: AABB = (
        def ux: double = this.u.x * this.rx
        def vx: double = this.v.x * this.ry
        def wx: double = this.w.x * this.rz
        def ex: double = Math.sqrt(ux * ux + vx * vx + wx * wx)

        def uy: double = this.u.y * this.rx
        def vy: double = this.v.y * this.ry
        def wy: double = this.w.y * this.rz
        def ey: double = Math.sqrt(uy * uy + vy * vy + wy * wy)

        def uz: double = this.u.z * this.rx
        def vz: double = this.v.z * this.ry
        def wz: double = this.w.z * this.rz
        def ez: double = Math.sqrt(uz * uz + vz * vz + wz * wz)

        AABB(
            this.center.x - ex, this.center.x + ex,
            this.center.y - ey, this.center.y + ey,
            this.center.z - ez, this.center.z + ez
        )
    )

    def boundingBox = fn (): AABB -> (this.bbox)

    def hit = fn shared (r: Ray, tmin: double, tmax: double): HitRecord? -> (
        def oc: Vec3 = r.origin - this.center
        def ox: double = oc.dot(this.u) * this.invRx
        def oy: double = oc.dot(this.v) * this.invRy
        def oz: double = oc.dot(this.w) * this.invRz

        def dx: double = r.direction.dot(this.u) * this.invRx
        def dy: double = r.direction.dot(this.v) * this.invRy
        def dz: double = r.direction.dot(this.w) * this.invRz

        def a: double = dx * dx + dy * dy + dz * dz
        def h: double = -(ox * dx + oy * dy + oz * dz)
        def c: double = ox * ox + oy * oy + oz * oz - 1.0

        def disc: double = h * h - a * c
        if disc < 0.0 then (return null)

        def sqrtd: double = Math.sqrt(disc)
        var root: double = (h - sqrtd) / a
        if root <= tmin or tmax <= root then (
            root = (h + sqrtd) / a
            if root <= tmin or tmax <= root then (return null)
        )

        def lx: double = ox + root * dx
        def ly: double = oy + root * dy
        def lz: double = oz + root * dz

        def nx: double = lx * this.invRx
        def ny: double = ly * this.invRy
        def nz: double = lz * this.invRz
        def outward: Vec3 = (this.u * nx + this.v * ny + this.w * nz).unit()

        HitRecord(r, r.at(root), root, outward, this.material)
    )
) static (
    def rotatedZ = fn (center: Vec3, rx: double, ry: double, rz: double, angleDeg: double, mat: Material): Ellipsoid -> (
        def rad: double = degreesToRadians(angleDeg)
        def ca: double = Math.cos(rad)
        def sa: double = Math.sin(rad)
        this(center, Vec3(ca, sa, 0.0), Vec3(-sa, ca, 0.0), Vec3(0.0, 0.0, 1.0), rx, ry, rz, mat)
    )
)

;; Analytic sphere-swept tapered capsule (rounded cone) from pa (ra) to pb (rb).
def RoundCone = class (
    def pa: Vec3,
    def pb: Vec3,
    def ra: double,
    def rb: double,
    def material: Material
) implements Hittable (
    private def ba: Vec3 = this.pb - this.pa
    private def len: double = this.ba.length()
    private def ax: Vec3 = if this.len > 0.000001 then (this.ba / this.len) else (Vec3(0.0, 1.0, 0.0))
    private def sinA: double = if this.len > 0.000001 then (
        Math.max(-0.999, Math.min(0.999, (this.ra - this.rb) / this.len))
    ) else (0.0)
    private def cosA2: double = 1.0 - this.sinA * this.sinA
    private def hMin: double = this.ra * this.sinA
    private def hMax: double = this.len + this.rb * this.sinA

    private def bbox: AABB = AABB(
        Math.min(this.pa.x - this.ra, this.pb.x - this.rb),
        Math.max(this.pa.x + this.ra, this.pb.x + this.rb),
        Math.min(this.pa.y - this.ra, this.pb.y - this.rb),
        Math.max(this.pa.y + this.ra, this.pb.y + this.rb),
        Math.min(this.pa.z - this.ra, this.pb.z - this.rb),
        Math.max(this.pa.z + this.ra, this.pb.z + this.rb)
    )

    def boundingBox = fn (): AABB -> (this.bbox)

    def hit = fn shared (r: Ray, tmin: double, tmax: double): HitRecord? -> (
        def dirLen: double = r.direction.length()
        def invDirLen: double = 1.0 / dirLen
        def rd: Vec3 = r.direction * invDirLen
        def tminL: double = tmin * dirLen
        var bestT: double = tmax * dirLen
        var bestNormal: Vec3 = Vec3(0.0, 1.0, 0.0)
        var found: bool = false

        def oa: Vec3 = r.origin - this.pa

        ;; 1. Tapered cone lateral surface
        if this.len > 0.000001 and this.cosA2 > 0.000001 then (
            def h0: double = oa.dot(this.ax)
            def hd: double = rd.dot(this.ax)
            def qa: double = this.cosA2 - hd * hd
            def qb: double = this.cosA2 * oa.dot(rd) - h0 * hd + this.ra * this.sinA * hd
            def qc: double = this.cosA2 * oa.dot(oa) - h0 * h0 + 2.0 * this.ra * this.sinA * h0 - this.ra * this.ra

            if Math.abs(qa) > 0.00000001 then (
                def disc: double = qb * qb - qa * qc
                if disc >= 0.0 then (
                    def sq: double = Math.sqrt(disc)
                    def t1: double = (-qb - sq) / qa
                    if t1 > tminL and t1 < bestT then (
                        def hh1: double = h0 + t1 * hd
                        if hh1 >= this.hMin and hh1 <= this.hMax then (
                            bestT = t1
                            def p1: Vec3 = oa + rd * t1
                            bestNormal = (p1 * this.cosA2 - this.ax * (hh1 - this.ra * this.sinA)).unit()
                            found = true
                        )
                    )
                    def t2: double = (-qb + sq) / qa
                    if t2 > tminL and t2 < bestT then (
                        def hh2: double = h0 + t2 * hd
                        if hh2 >= this.hMin and hh2 <= this.hMax then (
                            bestT = t2
                            def p2: Vec3 = oa + rd * t2
                            bestNormal = (p2 * this.cosA2 - this.ax * (hh2 - this.ra * this.sinA)).unit()
                            found = true
                        )
                    )
                )
            )
        )

        ;; 2. Sphere cap at pa
        def ba1: double = oa.dot(rd)
        def ca1: double = oa.dot(oa) - this.ra * this.ra
        def da1: double = ba1 * ba1 - ca1
        if da1 >= 0.0 then (
            def sqa: double = Math.sqrt(da1)
            var ta: double = -ba1 - sqa
            if ta <= tminL or ta >= bestT then (ta = -ba1 + sqa)
            if ta > tminL and ta < bestT then (
                bestT = ta
                bestNormal = (oa + rd * ta) / this.ra
                found = true
            )
        )

        ;; 3. Sphere cap at pb
        def ob: Vec3 = r.origin - this.pb
        def bb1: double = ob.dot(rd)
        def cb1: double = ob.dot(ob) - this.rb * this.rb
        def db1: double = bb1 * bb1 - cb1
        if db1 >= 0.0 then (
            def sqb: double = Math.sqrt(db1)
            var tb: double = -bb1 - sqb
            if tb <= tminL or tb >= bestT then (tb = -bb1 + sqb)
            if tb > tminL and tb < bestT then (
                bestT = tb
                bestNormal = (ob + rd * tb) / this.rb
                found = true
            )
        )

        if not found then (return null)
        def worldT: double = bestT * invDirLen
        HitRecord(r, r.at(worldT), worldT, bestNormal, this.material)
    )
)

;; 3D Fourier-contoured star-convex cushion :
;;   f(x, y, z) = (r / R(theta))^2 + ((z - cz) / rz)^2 - 1 <= 0
;; Uses angle-addition recurrence (zero trig calls per ray step) for smooth 3D organic
;; silhouettes (scalloped frill, pear-shaped head, curved belly) with uniform contour ink
;; and optional pastel rim highlight bands.
def SculptedLobe = class (
    def center: Vec3,
    def rz: double,
    def scale: double,
    def coeffs: array of double,
    def rMax: double,
    def fillMat: Material,
    def inkMat: Material,
    def border: double,
    def rimWidth: double,
    def rimMat: Material
) implements Hittable (
    private def invRz: double = 1.0 / this.rz
    private def invScale: double = 1.0 / this.scale
    private def maxExtent: double = this.rMax * this.scale
    private def kCount: int = (this.coeffs.size() - 1) // 2
    private def bbox: AABB = AABB(
        this.center.x - this.maxExtent, this.center.x + this.maxExtent,
        this.center.y - this.maxExtent, this.center.y + this.maxExtent,
        this.center.z - this.rz, this.center.z + this.rz
    )

    def boundingBox = fn (): AABB -> (this.bbox)

    private def evalR = fn (dx: double, dy: double, rad: double): double -> (
        if rad < 0.000001 then (return this.coeffs.get(0))
        def c1: double = dx / rad
        def s1: double = dy / rad
        var sum: double = this.coeffs.get(0)
        var ck: double = c1
        var sk: double = s1
        var k: int = 1
        while k <= this.kCount then (
            def idx: int = 2 * k - 1
            sum += this.coeffs.get(idx) * ck + this.coeffs.get(idx + 1) * sk
            def nextC: double = ck * c1 - sk * s1
            def nextS: double = sk * c1 + ck * s1
            ck = nextC
            sk = nextS
            k += 1
        )
        Math.max(0.02, sum)
    )

    private def evalF = fn (p: Vec3): double -> (
        def dx: double = (p.x - this.center.x) * this.invScale
        def dy: double = (p.y - this.center.y) * this.invScale
        def dz: double = (p.z - this.center.z) * this.invRz
        def rad: double = Math.sqrt(dx * dx + dy * dy)
        def R: double = this.evalR(dx, dy, rad)
        def u: double = rad / R
        u * u + dz * dz - 1.0
    )

    def hit = fn shared (r: Ray, tmin: double, tmax: double): HitRecord? -> (
        if not this.bbox.hit(r, tmin, tmax) then (return null)

        ;; Intersect z-slab [cz - rz, cz + rz]
        var t0: double = tmin
        var t1: double = tmax
        if Math.abs(r.direction.z) > 0.0000001 then (
            def invDz: double = 1.0 / r.direction.z
            var za: double = (this.center.z - this.rz - r.origin.z) * invDz
            var zb: double = (this.center.z + this.rz - r.origin.z) * invDz
            if za > zb then (
                def tmp: double = za
                za = zb
                zb = tmp
            )
            if za > t0 then (t0 = za)
            if zb < t1 then (t1 = zb)
        )
        if t1 <= t0 then (return null)

        ;; Bracket first crossing f(tA) > 0 -> f(tB) <= 0 along the slab
        def steps: int = 8
        def dt: double = (t1 - t0) / steps
        var prevT: double = t0
        var prevF: double = this.evalF(r.at(prevT))
        if prevF <= 0.0 then (return null)

        var found: bool = false
        var lo: double = prevT
        var hi: double = prevT
        var s: int = 1
        while s <= steps then (
            def curT: double = t0 + s * dt
            def curF: double = this.evalF(r.at(curT))
            if curF <= 0.0 then (
                lo = prevT
                hi = curT
                found = true
                s = steps + 1
            ) else (
                prevT = curT
                prevF = curF
                s += 1
            )
        )
        if not found then (return null)

        ;; Refine intersection by 7 bisection steps
        var b: int = 0
        while b < 7 then (
            def mid: double = 0.5 * (lo + hi)
            if this.evalF(r.at(mid)) <= 0.0 then (
                hi = mid
            ) else (
                lo = mid
            )
            b += 1
        )

        def hitT: double = 0.5 * (lo + hi)
        if hitT <= tmin or hitT >= tmax then (return null)

        def p: Vec3 = r.at(hitT)
        def dx: double = (p.x - this.center.x) * this.invScale
        def dy: double = (p.y - this.center.y) * this.invScale
        def rad: double = Math.sqrt(dx * dx + dy * dy)
        def R: double = this.evalR(dx, dy, rad)

        ;; Smooth 3D surface normal via gradient of f(x, y, z)
        def nx: double = (dx * this.invScale) / (R * R)
        def ny: double = (dy * this.invScale) / (R * R)
        def nz: double = (p.z - this.center.z) * this.invRz * this.invRz
        def outward: Vec3 = Vec3(nx, ny, nz).unit()

        def mat: Material = if this.border > 0.0 and rad > R - this.border then (
            this.inkMat
        ) else if this.rimWidth > 0.0 and rad > R - this.border - this.rimWidth then (
            this.rimMat
        ) else (
            this.fillMat
        )
        HitRecord(r, p, hitT, outward, mat)
    )
)

;; ---------------------------------------------------------------- Scene Construction Helpers

;; Maps desired screen position (sx, sy) in [-1, 1]^2 at 3D depth z into world coordinates
;; for a camera at (0, 0, 10) with half-height 1.0 at z = 0.
def pt = fn (sx: double, sy: double, z: double): Vec3 -> (
    def k: double = (10.0 - z) / 10.0
    Vec3(sx * k, sy * k, z)
)

def sc = fn (r: double, z: double): double -> (
    r * (10.0 - z) / 10.0
)

def lightBody: Vec3 = Vec3(0.20, 0.45, 0.87)
def lightHead: Vec3 = Vec3(0.05, 0.72, 0.69)
def lightBelly: Vec3 = Vec3(0.00, 0.78, 0.62)
def lightHorn: Vec3 = Vec3(-0.45, 0.55, 0.70)
def lightFrill: Vec3 = Vec3(-0.15, 0.40, 0.90)

def matBody = ToonMaterial(colBody, srgb(154, 58, 132), lightBody, 0.05, -0.15, 0.55)
def matBodyShade = ToonMaterial(colBodyShadow, colBodyDeep, lightBody, 0.05, -0.25, 0.55)
def matHead = ToonMaterial(colBody, colBodyShadow, lightHead, 0.04, 0.25, 0.58)
def matBodyDark = ToonMaterial(colBodyDeep, colBodyDeep, lightBody, 0.08)
def matFrill = ToonMaterial(colFrill, colFrillShadow, lightFrill, 0.04)
def matFrillRim = FlatMaterial(colFrillRim)
def matFrillCrease = FlatMaterial(srgb(156, 86, 178))
def matBelly = ToonMaterial(colBelly, colBellyShadow, lightBelly, 0.03, 0.28, 0.58)
def matHorn = ToonMaterial(colHorn, colHornShadow, lightHorn, 0.05)
def matCream = ToonMaterial(colCream, colCreamShadow, lightHorn, 0.05)
def matPacifier = ToonMaterial(colPacifier, colPacifierShadow, lightHorn, 0.05)
def matPacifierDark = FlatMaterial(colPacifierDark)
def matCheek = FlatMaterial(colCheek)
def matWhite = FlatMaterial(colWhite)
def matEyeDark = FlatMaterial(colEyeDark)
def matInk = FlatMaterial(colOutline)

def world = HittableList()

;; Inset 3D outline shell helpers
def addEll = fn io (sx: double, sy: double, z: double, rx: double, ry: double, rz: double, deg: double, shared mat: Material, border: double, zBack: double = 0.04): null -> (
    def irx: double = Math.max(0.004, rx - border)
    def iry: double = Math.max(0.004, ry - border)
    world.add(Ellipsoid.rotatedZ(pt(sx, sy, z), sc(irx, z), sc(iry, z), rz, deg, mat))
    if border > 0.0 then (
        def zb: double = z - zBack
        world.add(Ellipsoid.rotatedZ(pt(sx, sy, zb), sc(rx, zb), sc(ry, zb), rz, deg, matInk))
    )
    null
)

def addSph = fn io (sx: double, sy: double, z: double, r: double, shared mat: Material, border: double, zBack: double = 0.03): null -> (
    def ir: double = Math.max(0.004, r - border)
    world.add(Sphere(pt(sx, sy, z), sc(ir, z), mat))
    if border > 0.0 then (
        def zb: double = z - zBack
        world.add(Sphere(pt(sx, sy, zb), sc(r, zb), matInk))
    )
    null
)

def addCone = fn io (sx1: double, sy1: double, z1: double, sx2: double, sy2: double, z2: double, r1: double, r2: double, shared mat: Material, border: double, zBack: double = 0.04): null -> (
    def ir1: double = Math.max(0.004, r1 - border)
    def ir2: double = Math.max(0.004, r2 - border)
    world.add(RoundCone(pt(sx1, sy1, z1), pt(sx2, sy2, z2), sc(ir1, z1), sc(ir2, z2), mat))
    if border > 0.0 then (
        def zb1: double = z1 - zBack
        def zb2: double = z2 - zBack
        world.add(RoundCone(pt(sx1, sy1, zb1), pt(sx2, sy2, zb2), sc(r1, zb1), sc(r2, zb2), matInk))
    )
    null
)

;; Smooth quadratic 3D Bezier chain of tapered RoundCones with optional inset outline hull.
def addBezier = fn io (
    x0: double, y0: double, z0: double, r0: double,
    x1: double, y1: double, z1: double, r1: double,
    x2: double, y2: double, z2: double, r2: double,
    segs: int, shared mat: Material, border: double, zBack: double = 0.04
): null -> (
    var i: int = 0
    while i < segs then (
        def t0: double = i / double(segs)
        def t1: double = (i + 1) / double(segs)
        def u0: double = 1.0 - t0
        def u1: double = 1.0 - t1
        def ax: double = u0 * u0 * x0 + 2.0 * u0 * t0 * x1 + t0 * t0 * x2
        def ay: double = u0 * u0 * y0 + 2.0 * u0 * t0 * y1 + t0 * t0 * y2
        def az: double = u0 * u0 * z0 + 2.0 * u0 * t0 * z1 + t0 * t0 * z2
        def ar: double = u0 * u0 * r0 + 2.0 * u0 * t0 * r1 + t0 * t0 * r2
        def bx: double = u1 * u1 * x0 + 2.0 * u1 * t1 * x1 + t1 * t1 * x2
        def by: double = u1 * u1 * y0 + 2.0 * u1 * t1 * y1 + t1 * t1 * y2
        def bz: double = u1 * u1 * z0 + 2.0 * u1 * t1 * z1 + t1 * t1 * z2
        def br: double = u1 * u1 * r0 + 2.0 * u1 * t1 * r1 + t1 * t1 * r2
        addCone(ax, ay, az, bx, by, bz, ar, br, mat, border, zBack)
        i += 1
    )
    null
)

;; Flat-soled rounded 3D cartoon leg with optional cast-shadow inner side (shadeSide: -1 left, 0 none, +1 right).
def addFlatLeg = fn io (
    xTopL: double, xTopR: double, yTop: double,
    xBotL: double, xBotR: double, soleY: double,
    z: double, rC: double, shared mat: Material, border: double, zBack: double = 0.05,
    shadeSide: int = 0
): null -> (
    def yBot: double = soleY + rC
    def xTL: double = xTopL + rC
    def xTR: double = xTopR - rC
    def xBL: double = xBotL + rC
    def xBR: double = xBotR - rC
    def cols: int = 5
    var ci: int = 0
    while ci < cols then (
        def f: double = ci / double(cols - 1)
        def xt: double = xTL + (xTR - xTL) * f
        def xb: double = xBL + (xBR - xBL) * f
        def useShade: bool = (shadeSide < 0 and ci == 0) or (shadeSide > 0 and ci == cols - 1)
        def colMat: Material = if useShade then (matBodyShade) else (mat)
        addCone(xt, yTop, z, xb, yBot, z, rC, rC, colMat, border, zBack)
        ci += 1
    )
    addCone(xBL, yBot, z, xBR, yBot, z, rC, rC, mat, border, zBack)
    null
)

