;;(
    Pure-Babble self-verification suite for the unified raytracer core and scenes.
    Runs identically in interpret, JVM (-O0/-O1/-O2), and WebAssembly 3.0 (wasm-js/wasm-bare).
;;)

def core = import("core/core.ba")
def math = core.math
def color = core.color
def Vec3 = core.Vec3
def Ray = core.Ray
def Interval = core.Interval
def AABB = core.AABB
def Rng = core.Rng
def registry = import("scenes/registry.ba")
def threeSpheres = import("scenes/three_spheres.ba")

def SplitYMaterialField = record (upper: core.Metal, lower: core.Lambertian) implements core.MaterialField (
    def sample = fn (p: Vec3, normal: Vec3): core.Material -> (
        if p.y > 0.0 then (this.upper) else (this.lower)
    )
)

def runTests = fn () -> (
    ;; 1. Pure-Babble math
    assert(math.abs(-3.5) == 3.5, "abs failed")
    assert(math.min(2.0, 5.0) == 2.0 and math.max(2.0, 5.0) == 5.0, "min/max failed")
    assert(math.abs(math.sqrt(9.0) - 3.0) < 0.000000001, "sqrt(9) failed")
    assert(math.abs(math.sqrt(2.0) - 1.41421356237) < 0.00000001, "sqrt(2) failed")
    assert(math.powInt(2.0, 5) == 32.0, "powInt failed")
    assert(math.abs(math.sin(0.0)) < 0.000000001, "sin(0) failed")
    assert(math.abs(math.cos(0.0) - 1.0) < 0.000000001, "cos(0) failed")
    assert(math.abs(math.sin(math.halfPi) - 1.0) < 0.00000001, "sin(pi/2) failed")
    assert(math.toInt(225.8) == 225 and math.toInt(-42.9) == -42, "toInt failed")
    assert(math.toByte(0.0) == 0 and math.toByte(128.4) == 128 and math.toByte(300.0) == 255, "toByte failed")
    assert(math.abs(math.mix(10.0, 20.0, 0.25) - 12.5) < 0.000000001, "mix failed")
    assert(math.abs(math.smoothstep(0.0, 1.0, 0.5) - 0.5) < 0.000000001, "smoothstep failed")
    assert(math.sign(-2.0) == -1.0 and math.sign(0.0) == 0.0 and math.sign(3.0) == 1.0, "sign failed")
    assert(math.floor(2.7) == 2.0 and math.floor(-0.2) == -1.0 and math.floor(-2.0) == -2.0, "floor failed")

    ;; 2. Vec3 record semantics, operators, and sRGB helper
    def v1: Vec3 = Vec3(1.0, 2.0, 3.0)
    def v2: Vec3 = Vec3(1, 2, 3)
    assert(v1 == v2, "Vec3 structural equality failed")
    assert(not same(v1, v2), "same() should be false for distinct Vec3 instances")
    assert(v1 is Vec3 and classof(v1) == Vec3, "is / classof failed on Vec3")
    assert(v1 + Vec3(4.0, 5.0, 6.0) == Vec3(5.0, 7.0, 9.0), "Vec3.plus failed")
    assert(v1.dot(Vec3(4.0, 5.0, 6.0)) == 32.0, "Vec3.dot failed")
    assert(Vec3(1.0, 0.0, 0.0).cross(Vec3(0.0, 1.0, 0.0)) == Vec3(0.0, 0.0, 1.0), "Vec3.cross failed")
    assert(Vec3(3.0, 4.0, 0.0).length() == 5.0, "Vec3.length failed")
    assert(Vec3(1.0, -1.0, 0.0).reflect(Vec3(0.0, 1.0, 0.0)) == Vec3(1.0, 1.0, 0.0), "Vec3.reflect failed")
    assert(Vec3.srgb(0, 255, 0) == Vec3(0.0, 1.0, 0.0), "Vec3.srgb failed")
    assert(Vec3(-1.0, 2.0, -3.0).abs() == Vec3(1.0, 2.0, 3.0), "Vec3.abs failed")
    assert(Vec3(1.0, 5.0, 3.0).maxComp() == 5.0 and Vec3(1.0, 5.0, 3.0).minComp() == 1.0, "Vec3.maxComp/minComp failed")
    assert(Vec3(-1.0, 2.0, 0.0).maxScalar(0.0) == Vec3(0.0, 2.0, 0.0), "Vec3.maxScalar failed")

    def boxAabb: AABB = AABB(-1.0, 1.0, -1.0, 1.0, -3.0, -1.0)
    def boxSpan: Interval? = boxAabb.intersect(Ray(Vec3.zero, Vec3(0.0, 0.0, -1.0)), 0.001, math.infinity)
    assert(boxSpan != null and math.abs(boxSpan.min - 1.0) < 0.0000001 and math.abs(boxSpan.max - 3.0) < 0.0000001, "AABB.intersect failed")
    assert(boxAabb.intersect(Ray(Vec3(5.0, 0.0, 0.0), Vec3(0.0, 0.0, -1.0)), 0.001, math.infinity) == null, "AABB.intersect miss failed")

    ;; 3. Geometries: Sphere, Ellipsoid, RoundCone, SculptedLobe, and interface conformance
    def r: Ray = Ray(Vec3(0.0, 0.0, 0.0), Vec3(0.0, 0.0, -1.0))
    def lamMat: core.Material = core.Lambertian(Vec3(0.8, 0.3, 0.3))
    def sphere: core.Sphere = core.Sphere(Vec3(0.0, 0.0, -1.0), 0.5, lamMat)
    assert(sphere is core.Hittable and sphere is core.Describable, "Sphere interface conformance failed")
    assert(sphere.describe() == "<sphere>(r=0.5)", "super(Hittable).describe() failed")
    assert(lamMat.describe() == "<lambertian>(Vec3(x: 0.8, y: 0.3, z: 0.3))", "super.describe() failed")

    def hit: core.HitRecord? = sphere.hit(r, 0.001, math.infinity)
    if hit == null then (return assert(false, "Sphere hit failed"))
    assert(hit.frontFace, "Sphere frontFace failed")
    assert(math.abs(hit.t - 0.5) < 0.00000001, "Sphere hit t failed")
    assert(hit.p == Vec3(0.0, 0.0, -0.5), "Sphere hit point failed")
    assert(hit.normal == Vec3(0.0, 0.0, 1.0), "Sphere outward normal failed")

    def ell: core.Ellipsoid = core.Ellipsoid(Vec3(0.0, 0.0, -2.0), 0.5, 0.5, 0.5, lamMat)
    def ellHit: core.HitRecord? = ell.hit(r, 0.001, math.infinity)
    assert(ellHit != null and math.abs(ellHit.t - 1.5) < 0.00000001, "Ellipsoid hit failed")

    def cone: core.RoundCone = core.RoundCone(Vec3(-0.5, 0.0, -2.0), Vec3(0.5, 0.0, -2.0), 0.25, lamMat)
    def coneHit: core.HitRecord? = cone.hit(r, 0.001, math.infinity)
    assert(coneHit != null and math.abs(coneHit.t - 1.75) < 0.000001, "RoundCone hit failed")

    def lobeCoeffs: array of double = (array of double).of(0.5, 0.0, 0.0)
    def inkMat: core.Material = core.Emissive(Vec3.zero)
    def lobe: core.SculptedLobe = core.SculptedLobe(Vec3(0.1, 0.0, -2.0), 0.5, 1.0, lobeCoeffs, 0.6, lamMat, inkMat, 0.02)
    def lobeHit: core.HitRecord? = lobe.hit(r, 0.001, math.infinity)
    assert(lobeHit != null and lobeHit.t > 1.4 and lobeHit.t < 1.7, "SculptedLobe hit failed")

    def quad: core.Quad = core.Quad(Vec3(-1.0, -1.0, -2.0), Vec3(2.0, 0.0, 0.0), Vec3(0.0, 2.0, 0.0), lamMat)
    def quadHit: core.HitRecord? = quad.hit(r, 0.001, math.infinity)
    assert(quadHit != null and math.abs(quadHit.t - 2.0) < 0.00000001 and quadHit.normal == Vec3(0.0, 0.0, 1.0), "Quad hit failed")
    assert(quad.hit(Ray(Vec3(2.0, 0.0, 0.0), Vec3(0.0, 0.0, -1.0)), 0.001, math.infinity) == null, "Quad miss failed")

    def box: core.Box = core.Box(Vec3(-0.5, -0.5, -0.5), Vec3(0.5, 0.5, 0.5), lamMat)
    def movedBox: core.Hittable = core.Translate(core.RotateY(box, 45.0), Vec3(0.0, 0.0, -3.0))
    def boxHit: core.HitRecord? = movedBox.hit(r, 0.001, math.infinity)
    assert(boxHit != null and math.abs(boxHit.t - (3.0 - math.sqrt(0.5))) < 0.000001, "Translate/RotateY box hit failed")

    ;; 4. All 5 core materials: Lambertian, Metal, Dielectric, Emissive, Toon
    def rng: Rng = Rng(99)
    def sLam: core.Scatter? = lamMat.scatter(r, hit, rng)
    assert(sLam != null and sLam.attenuation == Vec3(0.8, 0.3, 0.3) and sLam.scattered != null, "Lambertian scatter failed")

    def metalMat: core.Material = core.Metal(Vec3(0.7, 0.6, 0.5), 0.1)
    def sMetal: core.Scatter? = metalMat.scatter(r, hit, rng)
    assert(sMetal != null and sMetal.attenuation == Vec3(0.7, 0.6, 0.5), "Metal scatter failed")

    def glassMat: core.Material = core.Dielectric(1.5)
    def sGlass: core.Scatter? = glassMat.scatter(r, hit, rng)
    assert(sGlass != null and sGlass.attenuation == Vec3.one, "Dielectric scatter failed")

    def emMat: core.Material = core.Emissive(Vec3(0.2, 0.4, 0.6))
    def sEm: core.Scatter? = emMat.scatter(r, hit, rng)
    assert(sEm != null and sEm.scattered == null and sEm.emission == Vec3(0.2, 0.4, 0.6), "Emissive scatter failed")

    def toonMat: core.Material = core.Toon(Vec3(0.9, 0.5, 0.7), Vec3(0.4, 0.2, 0.3), Vec3(0.0, 0.0, 1.0), 0.0)
    def sToon: core.Scatter? = toonMat.scatter(r, hit, rng)
    assert(sToon != null and sToon.scattered == null and sToon.emission == Vec3(0.9, 0.5, 0.7), "Toon scatter failed")

    ;; 5. HittableList, iterables, HOFs, and BVHNode parity
    def sceneList: core.HittableList = threeSpheres.buildList()
    assert(sceneList.size() == 5, "threeSpheres size failed")
    assert(sceneList.countWhere(fn (h: core.Hittable): bool -> (h is core.Sphere)) == 5, "countWhere failed")

    var spheres: int = 0
    for h in sceneList then (
        if h is core.Sphere then (spheres += 1)
    )
    assert(spheres == 5, "for over HittableList failed")

    def glass: core.Hittable? = for h in sceneList then (
        if h is core.Sphere and h.mat is core.Dielectric then (break h)
    )
    assert(glass != null and glass.describe() == "<sphere>(r=0.5)", "break with value failed")

    def bvh: core.Hittable = core.BVHNode.fromList(sceneList)
    assert(sceneList.hit(r, 0.001, math.infinity) == bvh.hit(r, 0.001, math.infinity), "BVH and HittableList diverged")

    ;; 6. Color conversion & packing
    assert(color.formatPpm(Vec3(0.0, 0.25, 1.0)) == "0 128 255", "color.formatPpm failed")
    assert(color.packRgb(1, 2, 3) == 66051, "color.packRgb failed")

    ;; 7. Scene registry & pure scanline rendering (`fn calling emit`)
    def coverScene: core.Scene = registry.buildScene("cover", imageWidth: 16, samplesPerPixel: 2, maxDepth: 6, gridRadius: 2)
    assert(coverScene.camera.imageHeight == 9, "cover aspect ratio failed")
    var coverPixels: int = 0
    coverScene.camera.renderRow(4, coverScene.world, coverScene.defaultSeed, fn (x: int, y: int, cr: int, cg: int, cb: int) -> (
        assert(cr >= 0 and cr <= 255 and cg >= 0 and cg <= 255 and cb >= 0 and cb <= 255, "cover RGB out of range")
        coverPixels += 1
    ))
    assert(coverPixels == 16, "cover renderRow pixel count failed")

    def triScene: core.Scene = registry.buildScene("triceratops", imageWidth: 16, samplesPerPixel: 2, maxDepth: 4)
    assert(triScene.camera.imageHeight == 16, "triceratops aspect ratio failed")
    var triPixels: int = 0
    triScene.camera.renderRow(8, triScene.world, triScene.defaultSeed, fn (x: int, y: int, cr: int, cg: int, cb: int) -> (
        assert(cr >= 0 and cr <= 255 and cg >= 0 and cg <= 255 and cb >= 0 and cb <= 255, "triceratops RGB out of range")
        triPixels += 1
    ))
    assert(triPixels == 16, "triceratops renderRow pixel count failed")

    def cornellScene: core.Scene = registry.buildScene("cornell-box", imageWidth: 16, samplesPerPixel: 2, maxDepth: 6)
    assert(cornellScene.camera.imageHeight == 16, "cornell-box aspect ratio failed")
    var cornellPixels: int = 0
    var cornellLit: int = 0
    cornellScene.camera.renderRow(8, cornellScene.world, cornellScene.defaultSeed, fn (x: int, y: int, cr: int, cg: int, cb: int) -> (
        assert(cr >= 0 and cr <= 255 and cg >= 0 and cg <= 255 and cb >= 0 and cb <= 255, "cornell-box RGB out of range")
        if cr > 0 or cg > 0 or cb > 0 then (cornellLit += 1)
        cornellPixels += 1
    ))
    assert(cornellPixels == 16 and cornellLit > 0, "cornell-box renderRow failed")

    ;; 8. SDF primitives, CSG combinators, transforms, and sphere-tracing RaymarchedSdf
    def sdfSph = core.SdfSphere(Vec3.zero, 1.0)
    assert(math.abs(sdfSph.distance(Vec3(2.0, 0.0, 0.0)) - 1.0) < 0.0000001, "SdfSphere outside failed")
    assert(math.abs(sdfSph.distance(Vec3.zero) + 1.0) < 0.0000001, "SdfSphere inside failed")

    def sdfBox = core.SdfBox(Vec3(1.0, 1.0, 1.0))
    assert(math.abs(sdfBox.distance(Vec3(2.0, 0.0, 0.0)) - 1.0) < 0.0000001, "SdfBox outside failed")
    assert(math.abs(sdfBox.distance(Vec3(1.0, 0.5, 0.0))) < 0.0000001, "SdfBox surface failed")
    assert(sdfBox.distance(Vec3.zero) < 0.0, "SdfBox inside failed")

    def sdfRoundBox = core.SdfRoundBox.fromOuter(Vec3(1.0, 1.0, 1.0), 0.2)
    assert(math.abs(sdfRoundBox.distance(Vec3(1.0, 0.0, 0.0))) < 0.0000001, "SdfRoundBox face failed")
    assert(sdfRoundBox.distance(Vec3(1.0, 1.0, 1.0)) > 0.0, "SdfRoundBox corner should be rounded")

    def sdfFrame = core.SdfBoxFrame(Vec3(1.0, 1.0, 1.0), 0.1)
    assert(sdfFrame.distance(Vec3.zero) > 0.5 and math.abs(sdfFrame.distance(Vec3(1.0, 1.0, 0.0))) < 0.0000001, "SdfBoxFrame failed")

    def sdfTorus = core.SdfTorus(1.0, 0.25)
    assert(math.abs(sdfTorus.distance(Vec3(1.0, 0.0, 0.0)) + 0.25) < 0.0000001, "SdfTorus core failed")
    assert(math.abs(sdfTorus.distance(Vec3(1.25, 0.0, 0.0))) < 0.0000001, "SdfTorus outer rim failed")

    def sdfCap = core.SdfCapsule(Vec3(0.0, -1.0, 0.0), Vec3(0.0, 1.0, 0.0), 0.5)
    assert(math.abs(sdfCap.distance(Vec3(0.5, 0.0, 0.0))) < 0.0000001, "SdfCapsule side failed")
    assert(math.abs(sdfCap.distance(Vec3(0.0, 1.5, 0.0))) < 0.0000001, "SdfCapsule cap failed")

    def sdfCyl = core.SdfCylinder(0.5, 1.0)
    assert(math.abs(sdfCyl.distance(Vec3(0.5, 0.0, 0.0))) < 0.0000001, "SdfCylinder side failed")
    assert(math.abs(sdfCyl.distance(Vec3(0.0, 1.0, 0.0))) < 0.0000001, "SdfCylinder cap failed")

    def sdfOct = core.SdfOctahedron(1.0)
    assert(math.abs(sdfOct.distance(Vec3(1.0, 0.0, 0.0))) < 0.0000001, "SdfOctahedron vertex failed")
    assert(sdfOct.distance(Vec3.zero) < 0.0, "SdfOctahedron inside failed")

    def sdfEll = core.SdfEllipsoid(Vec3(2.0, 1.0, 0.5))
    assert(math.abs(sdfEll.distance(Vec3(2.0, 0.0, 0.0))) < 0.0000001, "SdfEllipsoid X surface failed")
    assert(math.abs(sdfEll.distance(Vec3(0.0, 1.0, 0.0))) < 0.0000001, "SdfEllipsoid Y surface failed")
    assert(math.abs(sdfEll.distance(Vec3(0.0, 0.0, 0.5))) < 0.0000001, "SdfEllipsoid Z surface failed")
    assert(sdfEll.distance(Vec3.zero) < 0.0 and sdfEll.distance(Vec3(3.0, 0.0, 0.0)) > 0.5, "SdfEllipsoid inside/outside failed")

    def sdfRC = core.SdfRoundCone(Vec3(0.0, 0.0, 0.0), Vec3(0.0, 2.0, 0.0), 0.5, 0.25)
    assert(math.abs(sdfRC.distance(Vec3(0.0, -0.5, 0.0))) < 0.0000001, "SdfRoundCone bottom cap failed")
    assert(math.abs(sdfRC.distance(Vec3(0.0, 2.25, 0.0))) < 0.0000001, "SdfRoundCone top cap failed")
    assert(sdfRC.distance(Vec3(0.0, 1.0, 0.0)) < -0.3 and sdfRC.distance(Vec3(1.0, 0.0, 0.0)) > 0.4, "SdfRoundCone inside/outside failed")

    ;; CSG Boolean subtraction + smooth union + transforms
    def carved = core.SdfSubtraction(sdfBox, core.SdfSphere(Vec3.zero, 0.6))
    assert(carved.distance(Vec3.zero) > 0.5, "SdfSubtraction hollow center failed")
    assert(carved.distance(Vec3(0.85, 0.85, 0.85)) < 0.0, "SdfSubtraction solid corner failed")

    def blended = core.SdfSmoothUnion(
        core.SdfSphere(Vec3(-0.5, 0.0, 0.0), 0.5),
        core.SdfSphere(Vec3(0.5, 0.0, 0.0), 0.5),
        0.4
    )
    assert(blended.distance(Vec3.zero) < 0.0, "SdfSmoothUnion bridge failed")

    def rotBox = core.SdfRotateY(core.SdfBox(Vec3(1.0, 0.5, 0.5)), 90.0)
    assert(math.abs(rotBox.distance(Vec3(0.0, 0.0, 1.0))) < 0.0000001, "SdfRotateY failed")

    ;; RaymarchedSdf: exterior hit, tetrahedral normal, interior exit hit (glass refraction), and MaterialField
    def sdfLamMat = core.Lambertian(Vec3(0.8, 0.3, 0.3))
    def sdfMetalMat = core.Metal(Vec3(0.7, 0.6, 0.5), 0.1)
    def marchedSphere: core.RaymarchedSdf = core.RaymarchedSdf(
        core.SdfSphere(Vec3(0.0, 0.0, -3.0), 1.0),
        sdfLamMat,
        materialField: SplitYMaterialField(sdfMetalMat, sdfLamMat)
    )
    assert(marchedSphere is core.Hittable and marchedSphere is core.Describable, "RaymarchedSdf interface conformance failed")
    def mHit: core.HitRecord? = marchedSphere.hit(Ray(Vec3(0.0, 0.25, 0.0), Vec3(0.0, 0.0, -2.0)), 0.001, math.infinity)
    if mHit == null then (return assert(false, "RaymarchedSdf exterior hit failed"))
    assert(mHit.frontFace, "RaymarchedSdf exterior frontFace failed")
    assert(mHit.mat is core.Metal, "RaymarchedSdf MaterialField dispatch failed")
    def expectedZ: double = -3.0 + math.sqrt(1.0 - 0.25 * 0.25)
    assert(math.abs(mHit.p.z - expectedZ) < 0.002, "RaymarchedSdf exterior hit point inaccurate")
    assert(mHit.normal.z > 0.95 and mHit.normal.y > 0.20, "RaymarchedSdf tetrahedral normal inaccurate")

    ;; Interior exit hit for dielectric refraction
    def exitHit: core.HitRecord? = marchedSphere.hit(Ray(Vec3(0.0, 0.0, -3.0), Vec3(0.0, 0.0, -1.0)), 0.001, math.infinity)
    if exitHit == null then (return assert(false, "RaymarchedSdf interior exit hit failed"))
    assert(not exitHit.frontFace, "RaymarchedSdf interior exit frontFace must be false")
    assert(math.abs(exitHit.t - 1.0) < 0.002, "RaymarchedSdf interior exit t inaccurate")
    assert(exitHit.normal.z > 0.99, "RaymarchedSdf interior exit flipped normal inaccurate")

    ;; Bounding-box miss fast-path
    assert(marchedSphere.hit(Ray(Vec3(5.0, 0.0, 0.0), Vec3(0.0, 0.0, -1.0)), 0.001, math.infinity) == null, "RaymarchedSdf miss failed")

    ;; View-independent 3D cartoon silhouette outlining on RaymarchedSdf
    def outlineInk = core.Emissive(Vec3(0.1, 0.05, 0.2))
    def outlinedSphere: core.RaymarchedSdf = core.RaymarchedSdf(
        core.SdfSphere(Vec3(0.0, 0.0, -3.0), 1.0),
        sdfLamMat,
        outlineMat: outlineInk,
        outlineWidth: 0.05
    )
    def directHit: core.HitRecord? = outlinedSphere.hit(Ray(Vec3.zero, Vec3(0.0, 0.0, -1.0)), 0.001, math.infinity)
    assert(directHit != null and directHit.mat is core.Lambertian, "RaymarchedSdf direct hit should use primary material")
    def grazeHit: core.HitRecord? = outlinedSphere.hit(Ray(Vec3(1.025, 0.0, 0.0), Vec3(0.0, 0.0, -1.0)), 0.001, math.infinity)
    assert(grazeHit != null and grazeHit.mat is core.Emissive and math.abs(grazeHit.t - 3.0) < 0.1, "RaymarchedSdf grazing silhouette hit failed")
    assert(outlinedSphere.hit(Ray(Vec3(1.20, 0.0, 0.0), Vec3(0.0, 0.0, -1.0)), 0.001, math.infinity) == null, "RaymarchedSdf far miss should not outline")
    ;; Secondary AO bounce originating on the surface (d0 <= outlineWidth) must not self-outline
    assert(outlinedSphere.hit(Ray(Vec3(0.0, 0.0, -1.999), Vec3(0.0, 1.0, 0.0)), 0.001, math.infinity) == null, "RaymarchedSdf surface bounce falsely self-outlined")

    ;; Sculpted CSG Cube demo scene via registry
    def sdfScene: core.Scene = registry.buildScene("sdf-cube", imageWidth: 16, samplesPerPixel: 2, maxDepth: 4)
    assert(sdfScene.camera.imageHeight == 9, "sdf-cube aspect ratio failed")
    var sdfPixels: int = 0
    sdfScene.camera.renderRow(4, sdfScene.world, sdfScene.defaultSeed, fn (x: int, y: int, cr: int, cg: int, cb: int) -> (
        assert(cr >= 0 and cr <= 255 and cg >= 0 and cg <= 255 and cb >= 0 and cb <= 255, "sdf-cube RGB out of range")
        sdfPixels += 1
    ))
    assert(sdfPixels == 16, "sdf-cube renderRow pixel count failed")

    "selftest-ok"
)

runTests()
