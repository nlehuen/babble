        0.08650,
        -0.00603, -0.00549,
        -0.01938, 0.01834,
        -0.00115, -0.01042,
        0.00684, -0.00324,
        0.00650, 0.00434,
        -0.00261, 0.00314
    )
    world.add(SculptedLobe(pt(0.222, 0.372, 0.36), 0.07, sc(1.0, 0.36), move(leftHornCoeffs), 0.17, matHorn, matInk, 0.020))

    def rightHornCoeffs: array of double = (array of double).of(
        0.08050,
        -0.01162, -0.00682,
        -0.01256, 0.02124,
        -0.00260, -0.00880,
        0.00061, -0.00576,
        0.00504, 0.00007,
        -0.00174, 0.00627
    )
    world.add(SculptedLobe(pt(0.548, 0.402, 0.35), 0.07, sc(1.0, 0.35), move(rightHornCoeffs), 0.16, matHorn, matInk, 0.020))

    def noseHornCoeffs: array of double = (array of double).of(
        0.07050,
        -0.00306, -0.01220,
        -0.00956, 0.01138,
        -0.00290, -0.00512,
        0.00197, -0.00001,
        0.00089, -0.00090,
        -0.00012, 0.00200
    )
    world.add(SculptedLobe(pt(0.550, 0.100, 0.48), 0.06, sc(1.0, 0.48), move(noseHornCoeffs), 0.13, matHorn, matInk, 0.019))

    ;; --- 7. Eyes, Eyebrows, Cheeks, Nose Bridge, Nostrils, Smile ---
    world.add(Ellipsoid.rotatedZ(pt(0.292, 0.130, 0.42), sc(0.052, 0.42), sc(0.069, 0.42), 0.03, -6.0, matInk))
    world.add(Ellipsoid.rotatedZ(pt(0.292, 0.130, 0.44), sc(0.048, 0.44), sc(0.055, 0.44), 0.025, -6.0, matWhite))
    world.add(Ellipsoid.rotatedZ(pt(0.285, 0.118, 0.465), sc(0.035, 0.465), sc(0.043, 0.465), 0.020, -6.0, matEyeDark))
    world.add(Sphere(pt(0.300, 0.142, 0.488), sc(0.014, 0.488), matWhite))

    world.add(Ellipsoid.rotatedZ(pt(0.506, 0.156, 0.40), sc(0.042, 0.40), sc(0.055, 0.40), 0.028, -4.0, matInk))
    world.add(Ellipsoid.rotatedZ(pt(0.512, 0.156, 0.42), sc(0.033, 0.42), sc(0.046, 0.42), 0.024, -4.0, matWhite))
    world.add(Ellipsoid.rotatedZ(pt(0.499, 0.146, 0.442), sc(0.026, 0.442), sc(0.031, 0.442), 0.018, -4.0, matEyeDark))
    world.add(Sphere(pt(0.512, 0.168, 0.465), sc(0.011, 0.465), matWhite))

    addBezier(world, 0.395, 0.112, 0.44, 0.008, 0.440, 0.132, 0.44, 0.008, 0.482, 0.130, 0.44, 0.008, 2, matSoftCrease, matInk, 0.0, 0.0)
    addBezier(world, 0.240, 0.232, 0.44, 0.012, 0.282, 0.256, 0.45, 0.012, 0.316, 0.248, 0.45, 0.011, 2, matInk, matInk, 0.0, 0.0)
    addBezier(world, 0.486, 0.268, 0.42, 0.011, 0.514, 0.282, 0.42, 0.011, 0.542, 0.274, 0.42, 0.010, 2, matInk, matInk, 0.0, 0.0)

    world.add(Ellipsoid.rotatedZ(pt(0.232, 0.034, 0.46), sc(0.052, 0.46), sc(0.026, 0.46), 0.02, -4.0, matCheek))
    world.add(Ellipsoid.rotatedZ(pt(0.640, 0.082, 0.43), sc(0.034, 0.43), sc(0.022, 0.43), 0.02, 10.0, matCheek))

    world.add(Ellipsoid.rotatedZ(pt(0.462, -0.006, 0.49), sc(0.015, 0.49), sc(0.011, 0.49), 0.012, -25.0, matInk))
    world.add(Ellipsoid.rotatedZ(pt(0.585, 0.004, 0.47), sc(0.013, 0.47), sc(0.010, 0.47), 0.012, 20.0, matInk))

    addBezier(world, 0.292, -0.052, 0.48, 0.010, 0.354, -0.108, 0.49, 0.010, 0.442, -0.124, 0.50, 0.010, 3, matInk, matInk, 0.0, 0.0)
    addBezier(world, 0.268, -0.062, 0.48, 0.009, 0.292, -0.052, 0.48, 0.009, 0.312, -0.032, 0.48, 0.008, 2, matInk, matInk, 0.0, 0.0)

    ;; --- 8. Bright Lime-Green Pacifier ---
    addEll(world, 0.482, -0.118, 0.52, 0.072, 0.07, 0.032, -14.0, matPacifier, matInk, 0.020, 0.035)
    addEll(world, 0.598, -0.105, 0.52, 0.068, 0.072, 0.032, 14.0, matPacifier, matInk, 0.020, 0.035)
    addEll(world, 0.544, -0.124, 0.525, 0.056, 0.042, 0.030, 0.0, matPacifier, matInk, 0.019, 0.035)
    addEll(world, 0.562, -0.172, 0.54, 0.038, 0.028, 0.024, 0.0, matPacifierDark, matInk, 0.015, 0.025)
    world.add(Ellipsoid.rotatedZ(pt(0.562, -0.205, 0.50), sc(0.044, 0.50), sc(0.030, 0.50), 0.02, 0.0, matBodyDark))
    addEll(world, 0.562, -0.126, 0.57, 0.033, 0.035, 0.030, 0.0, matPacifier, matInk, 0.015, 0.03)

    def ringCx: double = 0.562
    def ringCy: double = -0.194
    def ringZ: double = 0.58
    def ringR: double = 0.058
    def ringTube: double = 0.023
    def ringSegs: int = 16
    for ri in 0..<ringSegs then (
        def a0: double = math.degreesToRadians(ri * 360.0 / ringSegs)
        def a1: double = math.degreesToRadians((ri + 1) * 360.0 / ringSegs)
        addCone(
            world,
            ringCx + ringR * math.cos(a0), ringCy + ringR * math.sin(a0), ringZ,
            ringCx + ringR * math.cos(a1), ringCy + ringR * math.sin(a1), ringZ,
            ringTube, ringTube, matPacifier, matInk, 0.0145, 0.03
        )
    )

    world
)

export def build = fn (
    imageWidth: int = 160,
    samplesPerPixel: int = 64,
    maxDepth: int = 5,
    seed: int = 42
): Scene -> (
    def worldList: HittableList = buildList()
    def camera: Camera = Camera(
        aspectRatio: 1.0,
        imageWidth: imageWidth,
        samplesPerPixel: samplesPerPixel,
        maxDepth: maxDepth,
        vfov: 11.421186274995679,
        lookFrom: Vec3(0.0, 0.0, 10.0),
        lookAt: Vec3(0.0, 0.0, 0.0),
        vup: Vec3(0.0, 1.0, 0.0),
        defocusAngle: 0.0,
        focusDist: 10.0,
        background: SolidBackground(colWhite)
    )
    Scene("triceratops", BVHNode.fromList(worldList), camera, seed)
)
