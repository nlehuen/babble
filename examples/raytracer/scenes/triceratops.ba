;; Baby Triceratops — 100% pure-Babble 360°-solid Toon SDF scene (`WASM_BARE`-clean).
;;
;; Sculpted entirely from true 3D Signed Distance Fields (`SdfEllipsoid`, `SdfRoundCone`,
;; `SdfSphere`, `SdfTorus`, custom curved scalloped frill `Sdf`, and smooth/exact CSG) with
;; view-independent 3D cartoon inking:
;;   - Near-miss grazing silhouette outlines (`RaymarchedSdf.outlineMat` / `outlineWidth`)
;;   - Procedural 3D CSG seam & crease inking (`MaterialField`)
;;   - Directional two-band `Toon` cel shading over a crisp white studio backdrop

def math = import("../core/math.ba")
def Vec3 = import("../core/vec3.ba").Vec3
def AABB = import("../core/aabb.ba").AABB
def Material = import("../core/interfaces.ba").Material
def Emissive = import("../core/materials.ba").Emissive
def Toon = import("../core/materials.ba").Toon
def Sdf = import("../core/geometry/sdf.ba").Sdf
def SdfSphere = import("../core/geometry/sdf.ba").SdfSphere
def SdfEllipsoid = import("../core/geometry/sdf.ba").SdfEllipsoid
def SdfRoundCone = import("../core/geometry/sdf.ba").SdfRoundCone
def SdfTorus = import("../core/geometry/sdf.ba").SdfTorus
def SdfBox = import("../core/geometry/sdf.ba").SdfBox
def SdfUnion = import("../core/geometry/sdf_ops.ba").SdfUnion
def SdfSmoothUnion = import("../core/geometry/sdf_ops.ba").SdfSmoothUnion
def SdfSmoothSubtraction = import("../core/geometry/sdf_ops.ba").SdfSmoothSubtraction
def SdfTranslate = import("../core/geometry/sdf_ops.ba").SdfTranslate
def SdfRotateX = import("../core/geometry/sdf_ops.ba").SdfRotateX
def SdfRotateY = import("../core/geometry/sdf_ops.ba").SdfRotateY
def SdfRotateZ = import("../core/geometry/sdf_ops.ba").SdfRotateZ
def MaterialField = import("../core/geometry/raymarched_sdf.ba").MaterialField
def RaymarchedSdf = import("../core/geometry/raymarched_sdf.ba").RaymarchedSdf
def HittableList = import("../core/geometry/hittable_list.ba").HittableList
def BVHNode = import("../core/geometry/bvh.ba").BVHNode
def SolidBackground = import("../core/background.ba").SolidBackground
def Camera = import("../core/camera.ba").Camera
def Scene = import("../core/scene.ba").Scene

;; ---------------------------------------------------------------- Palette (sRGB -> gamma-2 linear)

def srgb = Vec3.srgb

def colOutline: Vec3 = srgb(58, 18, 80)
def colBody: Vec3 = srgb(162, 66, 134)
def colBodyShadow: Vec3 = srgb(126, 44, 112)
def colFrill: Vec3 = srgb(206, 134, 224)
def colFrillShadow: Vec3 = srgb(176, 104, 198)
def colFrillRim: Vec3 = srgb(234, 184, 248)
def colBelly: Vec3 = srgb(228, 174, 245)
def colBellyShadow: Vec3 = srgb(186, 128, 206)
def colHorn: Vec3 = srgb(255, 232, 174)
def colHornShadow: Vec3 = srgb(236, 188, 114)
def colCream: Vec3 = srgb(246, 222, 212)
def colCreamShadow: Vec3 = srgb(220, 190, 182)
def colCheek: Vec3 = srgb(234, 103, 112)
def colPacifier: Vec3 = srgb(180, 248, 58)
def colPacifierShadow: Vec3 = srgb(142, 214, 42)
def colPacifierDark: Vec3 = srgb(104, 182, 24)
def colWhite: Vec3 = Vec3.one
def colEyeWhite: Vec3 = srgb(242, 238, 246)
def colEyeDark: Vec3 = srgb(48, 20, 82)
def colSoftCrease: Vec3 = srgb(112, 42, 126)

;; ---------------------------------------------------------------- Shared Head-Frame Transform Helpers

;; Head local frame: +Z forward (snout), +Y up, +X dino's left side.
;; Body stands in 3/4 view while the baby dino turns and playfully tilts its head toward the viewer.
def headCenter: Vec3 = Vec3(0.352, 0.072, 0.155)
def headYawDeg: double = 31.0
def headPitchDeg: double = 2.5
def headRollDeg: double = 8.5

def headYawRad: double = math.degreesToRadians(headYawDeg)
def headPitchRad: double = math.degreesToRadians(headPitchDeg)
def headRollRad: double = math.degreesToRadians(headRollDeg)
def hCosY: double = math.cos(headYawRad)
def hSinY: double = math.sin(headYawRad)
def hCosX: double = math.cos(headPitchRad)
def hSinX: double = math.sin(headPitchRad)
def hCosZ: double = math.cos(headRollRad)
def hSinZ: double = math.sin(headRollRad)

;; Maps a world-space point into head-local coordinates (inverse of Translate -> RotateY -> RotateX -> RotateZ).
def worldToHead = fn (p: Vec3): Vec3 -> (
    def d: Vec3 = p - headCenter
    def rx: double = hCosY * d.x - hSinY * d.z
    def rz: double = hSinY * d.x + hCosY * d.z
    def py: double = hCosX * d.y + hSinX * rz
    def pz: double = -hSinX * d.y + hCosX * rz
    Vec3(hCosZ * rx + hSinZ * py, -hSinZ * rx + hCosZ * py, pz)
)

;; Places a head-local SDF into world space.
def placeInHead = fn (inner: frozen Sdf): SdfTranslate -> (
    SdfTranslate(
        SdfRotateY(SdfRotateX(SdfRotateZ(inner, headRollDeg), headPitchDeg), headYawDeg),
        headCenter
    )
)

;; ---------------------------------------------------------------- True 3D Curved Scalloped Frill SDF

;; Broad curved 3D scalloped shield in frill-local coordinates (x, y in fan plane, z normal).
;; Uses angle-addition recurrence (zero trig calls per step) for a wide 5-lobe scalloped crest
;; with gentle parabolic cup curvature.
def FrillShieldSdf = record (
    rx: double,
    ry: double,
    lobeAmp: double,
    halfThick: double,
    edgeRadius: double,
    cupCurvature: double
) implements Sdf (
    private def bbox: AABB

    init (
        def maxX: double = this.rx + this.lobeAmp + this.edgeRadius + 0.08
        def maxY: double = this.ry + this.lobeAmp + this.edgeRadius + 0.08
        def maxR: double = math.max(maxX, maxY)
        def maxZ: double = this.halfThick + this.edgeRadius + this.cupCurvature * maxR * maxR + 0.06
        this.bbox = AABB(-maxX, maxX, -maxY, maxY, -maxZ, maxZ)
    )

    ;; Evaluates the scalloped outer radius along unit direction (c1, s1) in fan coordinates.
    def evalScallopRadius = fn (c1: double, s1: double): double -> (
        def c2: double = c1 * c1 - s1 * s1
        def s2: double = 2.0 * s1 * c1
        def c3: double = c2 * c1 - s2 * s1
        def s3: double = s2 * c1 + c2 * s1
        def c4: double = c3 * c1 - s3 * s1
        def s4: double = s3 * c1 + c3 * s1
        def c5: double = c4 * c1 - s4 * s1
        def s5: double = s4 * c1 + c4 * s1
        def base: double = 0.5 * (this.rx + this.ry) + 0.5 * (this.rx - this.ry) * c2
        def shoulders: double = 0.028 * s2 * s2
        def crown: double = 0.014 * s1
        def scallops: double = this.lobeAmp * s5
        math.max(0.14, base + shoulders + crown + scallops)
    )

    def distance = fn (p: Vec3): double -> (
        def rad: double = math.sqrt(p.x * p.x + p.y * p.y)
        def rEdge: double = if rad < 0.000001 then (
            0.5 * (this.rx + this.ry)
        ) else (
            this.evalScallopRadius(p.x / rad, p.y / rad)
        )
        def zCurved: double = p.z - this.cupCurvature * rad * rad
        def dRad: double = rad - rEdge
        def dZ: double = math.abs(zCurved) - this.halfThick
        def ox: double = math.max(dRad, 0.0)
        def oy: double = math.max(dZ, 0.0)
        math.sqrt(ox * ox + oy * oy) + math.min(math.max(dRad, dZ), 0.0) - this.edgeRadius
    )

    def boundingBox = fn (): AABB -> (this.bbox)

    def kind = fn (): string -> ("frill_shield_sdf")
)

;; ---------------------------------------------------------------- 3D MaterialFields (Zero-Allocation Per-Hit)

;; Shades the body + tail + 4 legs + 12 toes:
;; purple cel body, pale-lavender chest/belly/under-tail with crisp 3D seam ink, leg fold seams,
;; and 12 cream toes with dark ink borders.
def BodyMaterialField = record (
    torsoAndTail: frozen Sdf,
    legs: frozen Sdf,
    toes: frozen Sdf,
    bellyRegion: frozen Sdf,
    matBody: Toon,
    matBelly: Toon,
    matCream: Toon,
    matInk: Emissive
) implements MaterialField (
    def sample = fn (p: Vec3, normal: Vec3): Material -> (
        def dToes: double = this.toes.distance(p)
        def dLegs: double = this.legs.distance(p)
        if dToes <= 0.004 then (
            if math.abs(dToes - dLegs) < 0.010 then (
                return this.matInk
            )
            return this.matCream
        )
        if dToes < 0.014 and dLegs <= 0.008 then (
            return this.matInk
        )

        def dBelly: double = this.bellyRegion.distance(p)
        def dTorso: double = this.torsoAndTail.distance(p)

        ;; Crisp 3D ink crease where the legs tuck into the torso flank
        if dLegs < 0.013 and dTorso < 0.013 and p.y < -0.16 and p.y > -0.52 then (
            if math.abs(dLegs - dTorso) < 0.009 then (
                return this.matInk
            )
        )

        ;; Pale-lavender chest, lower belly & tail underside with clean hand-drawn seam line
        if dLegs > 0.014 then (
            def seamW: double = if p.x < -0.42 then (0.007) else (0.011)
            if math.abs(dBelly) < seamW and p.x < 0.05 then (
                return this.matInk
            )
            if dBelly < 0.0 then (
                return this.matBelly
            )
        )

        this.matBody
    )
)

;; Shades the curved 3D frill + 9 cream osteoderm scallops + pastel inner rim + 5 radial creases.
def FrillMaterialField = record (
    shield: FrillShieldSdf,
    osteoderms: frozen Sdf,
    frillOffset: Vec3,
    frillYawRelDeg: double,
    frillPitchDeg: double,
    matFrill: Toon,
    matFrillRim: Emissive,
    matCream: Toon,
    matSoftCrease: Emissive,
    matInk: Emissive
) implements MaterialField (
    private def fCosY: double
    private def fSinY: double
    private def fCosX: double
    private def fSinX: double

    init (
        def ry: double = math.degreesToRadians(this.frillYawRelDeg)
        def rx: double = math.degreesToRadians(this.frillPitchDeg)
        this.fCosY = math.cos(ry)
        this.fSinY = math.sin(ry)
        this.fCosX = math.cos(rx)
        this.fSinX = math.sin(rx)
    )

    def sample = fn (p: Vec3, normal: Vec3): Material -> (
        def dOst: double = this.osteoderms.distance(p)
        if dOst <= 0.005 then (
            return this.matCream
        )
        if dOst < 0.016 then (
            return this.matInk
        )

        def h: Vec3 = worldToHead(p)
        def d: Vec3 = h - this.frillOffset
        def rx: double = this.fCosY * d.x - this.fSinY * d.z
        def rz: double = this.fSinY * d.x + this.fCosY * d.z
        def fl: Vec3 = Vec3(rx, this.fCosX * d.y + this.fSinX * rz, -this.fSinX * d.y + this.fCosX * rz)
        def rad: double = math.sqrt(fl.x * fl.x + fl.y * fl.y)
        def c1: double = if rad > 0.000001 then (fl.x / rad) else (1.0)
        def s1: double = if rad > 0.000001 then (fl.y / rad) else (0.0)
        def rEdge: double = this.shield.evalScallopRadius(c1, s1)
        def distFromRim: double = rEdge - rad

        ;; 4 radial fold creases aligned with the scallop valleys (198, 126, 54, -18 deg)
        if fl.z > 0.0 and rad > 0.25 and rad < rEdge - 0.040 then (
            def d1: double = math.abs(fl.x * 0.309 - fl.y * 0.951)
            def d2: double = math.abs(fl.x * 0.809 + fl.y * 0.588)
            def d3: double = math.abs(fl.x * 0.809 - fl.y * 0.588)
            def d4: double = math.abs(fl.x * 0.309 + fl.y * 0.951)
            if (c1 < -0.5 and d1 < 0.0075) or
                (c1 < -0.1 and s1 > 0.3 and d2 < 0.0075) or
                (c1 > 0.1 and s1 > 0.3 and d3 < 0.0075) or
                (c1 > 0.5 and d4 < 0.0075) then (
                return this.matSoftCrease
            )
        )

        ;; Pastel inner highlight band near the rim on the front face
        if fl.z > -0.01 and distFromRim < 0.028 and distFromRim > -0.020 then (
            return this.matFrillRim
        )

        this.matFrill
    )
)

;; Shades the 3D head in head-local coordinates: eyes (sclera, dark iris, catchlight, rim),
;; arched eyebrows, rosy cheeks, nostrils, and happy smile line—all flush on the 3D surface!
def HeadMaterialField = record (
    matHead: Toon,
    matCheek: Emissive,
    matWhite: Emissive,
    matEyeDark: Emissive,
    matInk: Emissive
) implements MaterialField (
    def sample = fn (p: Vec3, normal: Vec3): Material -> (
        def h: Vec3 = worldToHead(p)

        if h.z > 0.06 then (
            def ax: double = math.abs(h.x)

            ;; 1. Symmetric big expressive cartoon eyes looking directly at the front camera
            def ex: double = (ax - 0.130) / 0.050
            def ey: double = (h.y - 0.090) / 0.062
            def eyeR2: double = ex * ex + ey * ey
            if eyeR2 <= 1.24 then (
                if eyeR2 > 0.95 then (
                    return this.matInk
                )
                def cx: double = (h.x - (if h.x >= 0.0 then (0.102) else (-0.152))) / 0.014
                def cy: double = (h.y - 0.106) / 0.014
                if cx * cx + cy * cy <= 1.0 then (
                    return this.matWhite
                )
                def px: double = (h.x - (if h.x >= 0.0 then (0.108) else (-0.146))) / 0.036
                def py: double = (h.y - 0.086) / 0.047
                if px * px + py * py <= 1.0 then (
                    return this.matEyeDark
                )
                return this.matWhite
            )

            ;; 2. Symmetric cute arched eyebrows above the eyes
            def bx: double = ax - 0.130
            if math.abs(bx) < 0.038 then (
                def browY: double = 0.194 - 5.5 * bx * bx
                if math.abs(h.y - browY) < 0.0085 then (
                    return this.matInk
                )
            )

            ;; 3. Symmetric rosy pink cheek ovals
            def rcx: double = (ax - 0.192) / 0.044
            def rcy: double = (h.y - 0.000) / 0.022
            if rcx * rcx + rcy * rcy <= 1.0 then (
                return this.matCheek
            )

            ;; 4. Symmetric nostrils on the snout tip
            if h.z > 0.22 then (
                def nx: double = (ax - 0.052) / 0.013
                def ny: double = (h.y + 0.046) / 0.010
                if nx * nx + ny * ny <= 1.0 then (
                    return this.matInk
                )
            )

            ;; 5. Happy curved smile line + corner dimple
            if h.z > 0.13 and ax < 0.184 then (
                def smileY: double = -0.146 + 2.35 * ax * ax
                if math.abs(h.y - smileY) < 0.0095 then (
                    return this.matInk
                )
                if ax > 0.162 and ax < 0.190 and math.abs(h.y - (-0.074 + 0.4 * (ax - 0.176))) < 0.0085 then (
                    return this.matInk
                )
            )
        )

        this.matHead
    )
)

;; Shades the bright lime-green pacifier (shield, darker inner recess, center button, pull ring).
def PacifierMaterialField = record (
    ringSdf: frozen Sdf,
    buttonSdf: frozen Sdf,
    matPacifier: Toon,
    matPacifierDark: Emissive,
    matInk: Emissive
) implements MaterialField (
    def sample = fn (p: Vec3, normal: Vec3): Material -> (
        def dRing: double = this.ringSdf.distance(p)
        def dBtn: double = this.buttonSdf.distance(p)
        if dRing <= 0.006 and dBtn <= 0.014 then (
            return this.matInk
        )
        if dBtn <= 0.005 then (
            return this.matPacifier
        )
        if dBtn < 0.015 and dRing > 0.012 then (
            return this.matInk
        )
        if dRing > 0.008 and dBtn < 0.045 and normal.y < -0.25 then (
            return this.matPacifierDark
        )
        this.matPacifier
    )
)

;; ---------------------------------------------------------------- Helper: Curved 3D Horn Builder

def makeCurvedHorn = fn (
    p0: Vec3, r0: double,
    p1: Vec3, r1: double,
    p2: Vec3, r2: double
): SdfSmoothUnion -> (
    SdfSmoothUnion(
        SdfRoundCone(p0, p1, r0, r1),
        SdfRoundCone(p1, p2, r1, r2),
        0.028
    )
)

;; ---------------------------------------------------------------- Scene Builder

export def buildList = fn (): unique HittableList -> (
    def lightBody: Vec3 = Vec3(0.16, 0.70, 0.69)
    def lightHead: Vec3 = Vec3(0.08, 0.68, 0.72)
    def lightFrill: Vec3 = Vec3(-0.10, 0.50, 0.86)
    def lightHorn: Vec3 = Vec3(-0.40, 0.55, 0.72)

    def matBody = Toon(colBody, colBodyShadow, lightBody, 0.03, -0.12, 0.42)
    def matHead = Toon(colBody, colBodyShadow, lightHead, 0.03, -0.12, 0.45)
    def matBelly = Toon(colBelly, colBellyShadow, Vec3(0.05, 0.82, 0.56), 0.02, -0.08, 0.45)
    def matFrill = Toon(colFrill, colFrillShadow, lightFrill, 0.02, -0.18, 0.35)
    def matFrillRim = Emissive(colFrillRim)
    def matSoftCrease = Emissive(colSoftCrease)
    def matHorn = Toon(colHorn, colHornShadow, lightHorn, 0.02, 0.05, 0.55)
    def matCream = Toon(colCream, colCreamShadow, lightHorn, 0.03, -0.15, 0.40)
    def matPacifier = Toon(colPacifier, colPacifierShadow, lightHorn, 0.03, -0.10, 0.50)
    def matPacifierDark = Emissive(colPacifierDark)
    def matCheek = Emissive(colCheek)
    def matWhite = Emissive(colEyeWhite)
    def matEyeDark = Emissive(colEyeDark)
    def matInk = Emissive(colOutline)

    def world: HittableList = HittableList()

    ;; ================================================================
    ;; 1. PLUMP 3D TORSO + CURVED TAIL + 4 CHUBBY LEGS + 12 DOME TOES
    ;; ================================================================
    def torsoCore = SdfRoundCone(
        Vec3(-0.34, -0.12, -0.14),
        Vec3(0.16, -0.16, 0.05),
        0.252,
        0.322
    )
    def backArch = SdfTranslate(
        SdfRotateZ(SdfEllipsoid(Vec3(0.31, 0.255, 0.255)), 26.0),
        Vec3(-0.10, 0.025, -0.07)
    )
    def neckJoin = SdfRoundCone(
        Vec3(0.15, -0.04, 0.05),
        Vec3(0.32, 0.04, 0.13),
        0.22,
        0.19
    )
    def torso = SdfSmoothUnion(SdfSmoothUnion(torsoCore, backArch, 0.12), neckJoin, 0.08)

    ;; Sleek sweeping upturned 3D tapered tail
    def tail1 = SdfRoundCone(Vec3(-0.35, -0.13, -0.14), Vec3(-0.55, -0.325, -0.21), 0.166, 0.080)
    def tail2 = SdfRoundCone(Vec3(-0.55, -0.325, -0.21), Vec3(-0.69, -0.355, -0.25), 0.080, 0.040)
    def tail3 = SdfRoundCone(Vec3(-0.69, -0.355, -0.25), Vec3(-0.76, -0.295, -0.26), 0.040, 0.020)
    def tail = SdfSmoothUnion(tail1, SdfSmoothUnion(tail2, tail3, 0.045), 0.065)
    def torsoAndTail = SdfSmoothUnion(torso, tail, 0.085)

    ;; Four sturdy chubby 3D legs anchored symmetrically across pelvis & shoulders
    def legFL = SdfRoundCone(Vec3(0.005, -0.23, 0.17), Vec3(0.010, -0.618, 0.20), 0.138, 0.120)
    def legFR = SdfRoundCone(Vec3(0.395, -0.24, -0.02), Vec3(0.425, -0.600, -0.02), 0.128, 0.112)
    def legBL = SdfRoundCone(Vec3(-0.350, -0.23, 0.09), Vec3(-0.345, -0.565, 0.12), 0.132, 0.112)
    def legBR = SdfRoundCone(Vec3(-0.30, -0.22, -0.21), Vec3(-0.30, -0.50, -0.21), 0.116, 0.100)

    def rawLegs = SdfUnion(SdfUnion(legFL, legFR), SdfUnion(legBL, legBR))
    def groundClipFL = SdfTranslate(SdfBox(Vec3(0.30, 0.15, 0.30)), Vec3(0.010, -0.858, 0.20))
    def groundClipFR = SdfTranslate(SdfBox(Vec3(0.30, 0.15, 0.30)), Vec3(0.425, -0.830, -0.02))
    def groundClipBL = SdfTranslate(SdfBox(Vec3(0.30, 0.15, 0.30)), Vec3(-0.345, -0.805, 0.12))
    def groundClipBR = SdfTranslate(SdfBox(Vec3(0.30, 0.15, 0.30)), Vec3(-0.30, -0.74, -0.21))
    def legsFlat = SdfSmoothSubtraction(
        rawLegs,
        SdfUnion(SdfUnion(groundClipFL, groundClipFR), SdfUnion(groundClipBL, groundClipBR)),
        0.024
    )

    ;; 12 cute cream dome toes (3 seated cleanly on the front rim of each foot)
    def toesFL = SdfUnion(
        SdfSphere(Vec3(-0.050, -0.678, 0.285), 0.032),
        SdfUnion(
            SdfSphere(Vec3(0.015, -0.678, 0.302), 0.035),
            SdfSphere(Vec3(0.075, -0.668, 0.278), 0.031)
        )
    )
    def toesFR = SdfUnion(
        SdfSphere(Vec3(0.365, -0.650, 0.085), 0.032),
        SdfUnion(
            SdfSphere(Vec3(0.430, -0.650, 0.090), 0.035),
            SdfSphere(Vec3(0.490, -0.640, 0.060), 0.031)
        )
    )
    def toesBL = SdfUnion(
        SdfSphere(Vec3(-0.405, -0.625, 0.198), 0.031),
        SdfUnion(
            SdfSphere(Vec3(-0.345, -0.625, 0.218), 0.034),
            SdfSphere(Vec3(-0.285, -0.625, 0.198), 0.030)
        )
    )
    def toesBR = SdfUnion(
        SdfSphere(Vec3(-0.34, -0.56, -0.115), 0.028),
        SdfUnion(
            SdfSphere(Vec3(-0.28, -0.56, -0.105), 0.031),
            SdfSphere(Vec3(-0.23, -0.56, -0.135), 0.028)
        )
    )
    def allToes = SdfUnion(SdfUnion(toesFL, toesFR), SdfUnion(toesBL, toesBR))

    def bodyShape = SdfUnion(SdfSmoothUnion(torsoAndTail, legsFlat, 0.06), allToes)

    ;; 3D pale-lavender chest, lower belly crescent, and under-tail mask
    def chestBellyMask = SdfTranslate(
        SdfRotateZ(SdfEllipsoid(Vec3(0.24, 0.26, 0.25)), 12.0),
        Vec3(0.31, -0.36, 0.12)
    )
    def lowerBellyMask = SdfRoundCone(
        Vec3(-0.30, -0.37, 0.14),
        Vec3(0.01, -0.43, 0.20),
        0.148,
        0.178
    )
    def tailBellyMask = SdfRoundCone(
        Vec3(-0.44, -0.36, -0.14),
        Vec3(-0.73, -0.35, -0.21),
        0.092,
        0.046
    )
    def bellyRegion = SdfSmoothUnion(
        chestBellyMask,
        SdfSmoothUnion(lowerBellyMask, tailBellyMask, 0.06),
        0.08
    )

    def bodyField = BodyMaterialField(
        torsoAndTail,
        legsFlat,
        allToes,
        bellyRegion,
        matBody,
        matBelly,
        matCream,
        matInk
    )
    world.add(RaymarchedSdf(
        bodyShape,
        matBody,
        materialField: bodyField,
        maxSteps: 110,
        stepScale: 0.9,
        outlineMat: matInk,
        outlineWidth: 0.020
    ))

    ;; ================================================================
    ;; 2. CURVED 3D SCALLOPED FRILL + 9 OSTEODERM STUDS (HEAD-ANCHORED)
    ;; ================================================================
    def frillOffset: Vec3 = Vec3(0.012, 0.130, -0.112)
    def frillYawRelDeg: double = -19.0
    def frillPitchDeg: double = -12.0
    def frillShield = FrillShieldSdf(0.425, 0.412, 0.024, 0.023, 0.022, 0.13)

    ;; 9 cream osteoderm studs seated along the curved outer rim of the frill
    def placeOst = fn (angleDeg: double, rx: double, ry: double): SdfTranslate -> (
        def a: double = math.degreesToRadians(angleDeg)
        def ca: double = math.cos(a)
        def sa: double = math.sin(a)
        def rEdge: double = frillShield.evalScallopRadius(ca, sa) + 0.020
        def ox: double = ca * rEdge
        def oy: double = sa * rEdge
        def oz: double = frillShield.cupCurvature * rEdge * rEdge
        SdfTranslate(
            SdfRotateZ(SdfEllipsoid(Vec3(rx, ry, 0.028)), angleDeg - 90.0),
            Vec3(ox, oy, oz)
        )
    )
    def ost1 = placeOst(206.0, 0.032, 0.035)
    def ost2 = placeOst(170.0, 0.036, 0.038)
    def ost3 = placeOst(135.0, 0.042, 0.042)
    def ost4 = placeOst(110.0, 0.038, 0.038)
    def ost5 = placeOst(86.0, 0.042, 0.040)
    def ost6 = placeOst(56.0, 0.040, 0.040)
    def ost7 = placeOst(32.0, 0.035, 0.035)
    def ost8 = placeOst(10.0, 0.033, 0.033)
    def ost9 = placeOst(-16.0, 0.029, 0.031)
    def ostLocal = SdfUnion(
        SdfUnion(SdfUnion(ost1, ost2), SdfUnion(ost3, ost4)),
        SdfUnion(SdfUnion(ost5, ost6), SdfUnion(ost7, SdfUnion(ost8, ost9)))
    )

    def frillLocal = SdfUnion(frillShield, ostLocal)
    def frillInHead = SdfTranslate(
        SdfRotateY(SdfRotateX(frillLocal, frillPitchDeg), frillYawRelDeg),
        frillOffset
    )
    def ostInHead = SdfTranslate(
        SdfRotateY(SdfRotateX(ostLocal, frillPitchDeg), frillYawRelDeg),
        frillOffset
    )
    def frillWorld = placeInHead(frillInHead)
    def ostWorld = placeInHead(ostInHead)

    def frillField = FrillMaterialField(
        frillShield,
        ostWorld,
        frillOffset,
        frillYawRelDeg,
        frillPitchDeg,
        matFrill,
        matFrillRim,
        matCream,
        matSoftCrease,
        matInk
    )
    world.add(RaymarchedSdf(
        frillWorld,
        matFrill,
        materialField: frillField,
        maxSteps: 110,
        stepScale: 0.85,
        outlineMat: matInk,
        outlineWidth: 0.020
    ))

    ;; ================================================================
    ;; 3. PLUMP 3D HEAD + CHUBBY CHEEKS + SNOUT + FLUSH FACIAL DETAILS
    ;; ================================================================
    def cranium = SdfEllipsoid(Vec3(0.268, 0.252, 0.258))
    def cheekL = SdfSphere(Vec3(-0.165, -0.072, 0.070), 0.155)
    def cheekR = SdfSphere(Vec3(0.165, -0.072, 0.070), 0.155)
    def snout = SdfTranslate(SdfEllipsoid(Vec3(0.180, 0.138, 0.195)), Vec3(0.0, -0.068, 0.175))
    def chin = SdfSphere(Vec3(0.0, -0.145, 0.115), 0.135)

    def headLocal = SdfSmoothUnion(
        SdfSmoothUnion(cranium, SdfUnion(cheekL, cheekR), 0.10),
        SdfSmoothUnion(snout, chin, 0.08),
        0.10
    )
    def headWorld = placeInHead(headLocal)
    def headField = HeadMaterialField(matHead, matCheek, matWhite, matEyeDark, matInk)
    world.add(RaymarchedSdf(
        headWorld,
        matHead,
        materialField: headField,
        maxSteps: 100,
        stepScale: 0.85,
        outlineMat: matInk,
        outlineWidth: 0.019
    ))

    ;; ================================================================
    ;; 4. THREE CURVED 3D CREAM-YELLOW HORNS (BILATERALLY SYMMETRIC)
    ;; ================================================================
    def hornLeft = makeCurvedHorn(
        Vec3(-0.145, 0.218, 0.060), 0.052,
        Vec3(-0.150, 0.295, 0.130), 0.036,
        Vec3(-0.136, 0.360, 0.185), 0.017
    )
    def hornRight = makeCurvedHorn(
        Vec3(0.145, 0.218, 0.060), 0.052,
        Vec3(0.150, 0.295, 0.130), 0.036,
        Vec3(0.136, 0.360, 0.185), 0.017
    )
    def hornNose = makeCurvedHorn(
        Vec3(0.0, -0.015, 0.280), 0.048,
        Vec3(0.0, 0.048, 0.335), 0.031,
        Vec3(0.0, 0.110, 0.362), 0.015
    )
    def hornsWorld = placeInHead(SdfUnion(hornNose, SdfUnion(hornLeft, hornRight)))
    world.add(RaymarchedSdf(
        hornsWorld,
        matHorn,
        maxSteps: 96,
        stepScale: 0.9,
        outlineMat: matInk,
        outlineWidth: 0.017
    ))

    ;; ================================================================
    ;; 5. TRUE 3D BRIGHT LIME-GREEN PACIFIER (WITH REAL SdfTorus RING)
    ;; ================================================================
    def pacLobeL = SdfTranslate(
        SdfRotateZ(SdfEllipsoid(Vec3(0.070, 0.062, 0.030)), -16.0),
        Vec3(-0.052, -0.155, 0.330)
    )
    def pacLobeR = SdfTranslate(
        SdfRotateZ(SdfEllipsoid(Vec3(0.070, 0.062, 0.030)), 16.0),
        Vec3(0.052, -0.155, 0.330)
    )
    def pacBridge = SdfTranslate(
        SdfEllipsoid(Vec3(0.054, 0.042, 0.032)),
        Vec3(0.0, -0.159, 0.330)
    )
    def pacShield = SdfSmoothUnion(SdfUnion(pacLobeL, pacLobeR), pacBridge, 0.026)
    def pacButtonLocal = SdfTranslate(
        SdfEllipsoid(Vec3(0.036, 0.036, 0.030)),
        Vec3(0.0, -0.161, 0.367)
    )
    def pacRingLocal = SdfTranslate(
        SdfRotateX(SdfTorus(0.054, 0.017), 78.0),
        Vec3(0.0, -0.219, 0.381)
    )
    def pacWorld = placeInHead(SdfUnion(SdfUnion(pacShield, pacButtonLocal), pacRingLocal))
    def pacButtonWorld = placeInHead(pacButtonLocal)
    def pacRingWorld = placeInHead(pacRingLocal)

    def pacField = PacifierMaterialField(pacRingWorld, pacButtonWorld, matPacifier, matPacifierDark, matInk)
    world.add(RaymarchedSdf(
        pacWorld,
        matPacifier,
        materialField: pacField,
        maxSteps: 96,
        stepScale: 0.9,
        outlineMat: matInk,
        outlineWidth: 0.015
    ))

    world
)

export def build = fn (
    imageWidth: int = 160,
    samplesPerPixel: int = 64,
    maxDepth: int = 5,
    seed: int = 42
): Scene -> (
    def worldList: HittableList = buildList()
    def camera: Camera = Camera(
        aspectRatio: 1.0,
        imageWidth: imageWidth,
        samplesPerPixel: samplesPerPixel,
        maxDepth: maxDepth,
        vfov: 11.421186274995679,
        lookFrom: Vec3(0.0, 0.0, 10.0),
        lookAt: Vec3(0.0, 0.0, 0.0),
        vup: Vec3(0.0, 1.0, 0.0),
        defocusAngle: 0.0,
        focusDist: 10.0,
        background: SolidBackground(colWhite)
    )
    Scene("triceratops", BVHNode.fromList(worldList), camera, seed)
)
