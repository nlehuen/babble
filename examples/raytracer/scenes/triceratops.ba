;; Baby Triceratops 3D scene — 100% pure Babble (zero IO, zero java.*, zero wasm.*).
;;
;; Composed from core 3D primitives (Sphere, oriented Ellipsoid, tapered RoundCone,
;; quadratic 3D Bezier tubes, and Fourier-contoured 3D SculptedLobe cushions) accelerated
;; by BVHNode and shaded with inset 3D outline shells, directional Toon cel lighting,
;; and Emissive ink details over a SolidBackground white studio backdrop.

def math = import("../core/math.ba")
def Vec3 = import("../core/vec3.ba").Vec3
def Material = import("../core/interfaces.ba").Material
def Emissive = import("../core/materials.ba").Emissive
def Toon = import("../core/materials.ba").Toon
def Sphere = import("../core/geometry/sphere.ba").Sphere
def Ellipsoid = import("../core/geometry/ellipsoid.ba").Ellipsoid
def roundCone = import("../core/geometry/round_cone.ba")
def RoundCone = roundCone.RoundCone
def addQuadraticBezierTube = roundCone.addQuadraticBezierTube
def SculptedLobe = import("../core/geometry/sculpted_lobe.ba").SculptedLobe
def HittableList = import("../core/geometry/hittable_list.ba").HittableList
def BVHNode = import("../core/geometry/bvh.ba").BVHNode
def SolidBackground = import("../core/background.ba").SolidBackground
def Camera = import("../core/camera.ba").Camera
def Scene = import("../core/scene.ba").Scene

;; ---------------------------------------------------------------- Palette (sRGB -> gamma-2 linear)

def srgb = Vec3.srgb

def colOutline: Vec3 = srgb(58, 18, 80)
def colBody: Vec3 = srgb(164, 68, 135)
def colBodyShadow: Vec3 = srgb(132, 46, 117)
def colBodyDeep: Vec3 = srgb(104, 36, 106)
def colFrill: Vec3 = srgb(213, 145, 230)
def colFrillShadow: Vec3 = srgb(196, 126, 210)
def colFrillRim: Vec3 = srgb(242, 196, 255)
def colBelly: Vec3 = srgb(229, 176, 246)
def colBellyShadow: Vec3 = srgb(190, 132, 208)
def colHorn: Vec3 = srgb(255, 232, 174)
def colHornShadow: Vec3 = srgb(240, 194, 120)
def colCream: Vec3 = srgb(246, 222, 212)
def colCreamShadow: Vec3 = srgb(224, 194, 186)
def colCheek: Vec3 = srgb(234, 103, 112)
def colPacifier: Vec3 = srgb(180, 248, 58)
def colPacifierShadow: Vec3 = srgb(142, 214, 42)
def colPacifierDark: Vec3 = srgb(104, 182, 24)
def colWhite: Vec3 = Vec3.one
def colEyeDark: Vec3 = srgb(54, 24, 90)

;; ---------------------------------------------------------------- Light Directions

def lightBody: Vec3 = Vec3(0.20, 0.63, 0.87)
def lightHead: Vec3 = Vec3(0.05, 0.72, 0.69)
def lightBelly: Vec3 = Vec3(0.00, 0.88, 0.47)
def lightLowerBelly: Vec3 = Vec3(0.00, 0.78, 0.62)
def lightBackLeftLeg: Vec3 = Vec3(-0.68, 0.25, 0.69)
def lightFrontLeftLeg: Vec3 = Vec3(0.66, 0.24, 0.71)
def lightFrontRightLeg: Vec3 = Vec3(0.68, 0.25, 0.69)
def lightHorn: Vec3 = Vec3(-0.55, 0.50, 0.67)
def lightFrill: Vec3 = Vec3(-0.15, 0.40, 0.90)

;; ---------------------------------------------------------------- Scene Construction Helpers

;; Maps desired screen position (sx, sy) in [-1, 1]^2 at 3D depth z into world coordinates
;; for a camera at (0, 0, 10) with half-height 1.0 at z = 0.
def pt = fn (sx: double, sy: double, z: double): Vec3 -> (
    def k: double = (10.0 - z) / 10.0
    Vec3(sx * k, sy * k, z)
)

def sc = fn (r: double, z: double): double -> (
    r * (10.0 - z) / 10.0
)

def addEll = fn (
    mut world: HittableList,
    sx: double, sy: double, z: double,
    rx: double, ry: double, rz: double,
    deg: double,
    shared mat: Material,
    shared ink: Material,
    border: double,
    zBack: double = 0.04
): null -> (
    def irx: double = math.max(0.004, rx - border)
    def iry: double = math.max(0.004, ry - border)
    world.add(Ellipsoid.rotatedZ(pt(sx, sy, z), sc(irx, z), sc(iry, z), rz, deg, mat))
    if border > 0.0 then (
        def zb: double = z - zBack
        world.add(Ellipsoid.rotatedZ(pt(sx, sy, zb), sc(rx, zb), sc(ry, zb), rz, deg, ink))
    )
    null
)

def addCone = fn (
    mut world: HittableList,
    sx1: double, sy1: double, z1: double,
    sx2: double, sy2: double, z2: double,
    r1: double, r2: double,
    shared mat: Material,
    shared ink: Material,
    border: double,
    zBack: double = 0.04
): null -> (
    def ir1: double = math.max(0.004, r1 - border)
    def ir2: double = math.max(0.004, r2 - border)
    world.add(RoundCone(pt(sx1, sy1, z1), pt(sx2, sy2, z2), sc(ir1, z1), sc(ir2, z2), mat))
    if border > 0.0 then (
        def zb1: double = z1 - zBack
        def zb2: double = z2 - zBack
        world.add(RoundCone(pt(sx1, sy1, zb1), pt(sx2, sy2, zb2), sc(r1, zb1), sc(r2, zb2), ink))
    )
    null
)

def addBezier = fn (
    mut world: HittableList,
    x0: double, y0: double, z0: double, r0: double,
    x1: double, y1: double, z1: double, r1: double,
    x2: double, y2: double, z2: double, r2: double,
    segs: int,
    shared mat: Material,
    shared ink: Material,
    border: double,
    zBack: double = 0.04
): null -> (
    def ir0: double = math.max(0.004, r0 - border)
    def ir1: double = math.max(0.004, r1 - border)
    def ir2: double = math.max(0.004, r2 - border)
    addQuadraticBezierTube(
        world,
        pt(x0, y0, z0), sc(ir0, z0),
        pt(x1, y1, z1), sc(ir1, z1),
        pt(x2, y2, z2), sc(ir2, z2),
        segs, mat
    )
    if border > 0.0 then (
        def zb0: double = z0 - zBack
        def zb1: double = z1 - zBack
        def zb2: double = z2 - zBack
        addQuadraticBezierTube(
            world,
            pt(x0, y0, zb0), sc(r0, zb0),
            pt(x1, y1, zb1), sc(r1, zb1),
            pt(x2, y2, zb2), sc(r2, zb2),
            segs, ink
        )
    )
    null
)

;; ---------------------------------------------------------------- Scene Builder

export def buildList = fn (): unique HittableList -> (
    def matBody = Toon(colBody, srgb(154, 58, 132), lightBody, 0.05, -0.15, 0.55)
    def matBackLeftLeg = Toon(colBody, colBodyShadow, lightBackLeftLeg, 0.04, 0.22, 0.58)
    def matFrontLeftLeg = Toon(colBody, colBodyShadow, lightFrontLeftLeg, 0.04, 0.02, 0.54)
    def matFrontRightLeg = Toon(colBody, colBodyShadow, lightFrontRightLeg, 0.04, 0.22, 0.58)
    def matHead = Toon(colBody, colBodyShadow, lightHead, 0.04, 0.25, 0.58)
    def matBodyDark = Toon(colBodyDeep, colBodyDeep, lightBody, 0.08)
    def matFrill = Toon(colFrill, colFrillShadow, lightFrill, 0.04)
    def matFrillRim = Emissive(colFrillRim)
    def matSoftCrease = Emissive(srgb(96, 30, 102))
    def matBelly = Toon(colBelly, colBellyShadow, lightBelly, 0.03, 0.16, 0.52)
    def matBellyShadow = Emissive(colBellyShadow)
    def matLowerBelly = Toon(colBelly, colBellyShadow, lightLowerBelly, 0.03, 0.22, 0.62)
    def matHorn = Toon(colHorn, colHornShadow, lightHorn, 0.04, 0.22, 0.62)
    def matCream = Toon(colCream, colCreamShadow, lightHorn, 0.05)
    def matPacifier = Toon(colPacifier, colPacifierShadow, lightHorn, 0.05)
    def matPacifierDark = Emissive(colPacifierDark)
    def matCheek = Emissive(colCheek)
    def matWhite = Emissive(colWhite)
    def matEyeDark = Emissive(colEyeDark)
    def matInk = Emissive(colOutline)

    def world: HittableList = HittableList()
    def B: double = 0.023

    ;; --- 1. Smooth Tapered 3D Tail ---
    addBezier(
        world,
        -0.388, -0.099, -0.15, 0.161,
        -0.592, -0.398, -0.22, 0.075,
        -0.746, -0.316, -0.27, 0.047,
        6, matBody, matInk, B, 0.05
    )
    addBezier(
        world,
        -0.498, -0.378, -0.18, 0.054,
        -0.586, -0.424, -0.23, 0.034,
        -0.703, -0.388, -0.28, 0.016,
        5, matLowerBelly, matInk, 0.020, 0.04
    )

    ;; --- 2. Torso & Smooth Curved Back ---
    addBezier(
        world,
        -0.129, 0.068, -0.13, 0.222,
        -0.320, 0.096, -0.14, 0.165,
        -0.440, -0.165, -0.16, 0.130,
        6, matBody, matInk, B, 0.06
    )
    addEll(world, -0.07, -0.14, -0.12, 0.38, 0.325, 0.14, 14.0, matBody, matInk, B, 0.06)

    ;; --- 3. Four Sculpted 3D Legs + Flush Dome Toes ---
    def backRightLegCoeffs: array of double = (array of double).of(
        0.07211,
        -0.00106, -0.00795,
        -0.03061, 0.00192,
        -0.00829, 0.00487,
        0.00632, -0.00496
    )
    world.add(SculptedLobe(pt(-0.147, -0.515, -0.08), 0.06, sc(1.0, -0.08), move(backRightLegCoeffs), 0.16, matBodyDark, matInk, 0.021, openTop: 0.08))

    def backLeftLegCoeffs: array of double = (array of double).of(
        0.15850,
        -0.01615, -0.01669,
        -0.03714, -0.02285,
        0.02669, -0.00387,
        -0.00475, 0.02004,
        -0.00513, -0.00039,
        0.01390, -0.00451,
        0.00169, 0.00481,
        -0.00164, -0.00248
    )
    world.add(SculptedLobe(pt(-0.357, -0.475, 0.08), 0.08, sc(1.0, 0.08), move(backLeftLegCoeffs), 0.30, matBackLeftLeg, matInk, 0.023, openTop: 0.14))
    addBezier(world, -0.518, -0.10, 0.18, 0.009, -0.516, -0.23, 0.18, 0.009, -0.506, -0.35, 0.18, 0.009, 3, matInk, matInk, 0.0, 0.0)
    addBezier(world, -0.410, -0.14, 0.18, 0.009, -0.404, -0.25, 0.18, 0.009, -0.376, -0.35, 0.18, 0.009, 3, matInk, matInk, 0.0, 0.0)
    addEll(world, -0.401, -0.626, 0.17, 0.034, 0.033, 0.028, 0.0, matCream, matInk, 0.016, 0.022)
    addEll(world, -0.337, -0.626, 0.18, 0.038, 0.036, 0.028, 0.0, matCream, matInk, 0.016, 0.022)
    addEll(world, -0.284, -0.625, 0.17, 0.033, 0.033, 0.028, 0.0, matCream, matInk, 0.016, 0.022)

    def frontRightLegCoeffs: array of double = (array of double).of(
        0.17512,
        0.00074, -0.02255,
        -0.06071, 0.03172,
        -0.03235, -0.02639,
        0.01010, -0.00565,
        0.00466, 0.01265,
        0.00342, 0.00378
    )
    world.add(SculptedLobe(pt(0.425, -0.467, 0.02), 0.07, sc(1.0, 0.02), move(frontRightLegCoeffs), 0.31, matFrontRightLeg, matInk, 0.023, openTop: 0.24))
    addEll(world, 0.407, -0.652, 0.10, 0.035, 0.034, 0.028, 0.0, matCream, matInk, 0.016, 0.022)
    addEll(world, 0.469, -0.650, 0.11, 0.038, 0.036, 0.028, 0.0, matCream, matInk, 0.016, 0.022)
    addEll(world, 0.528, -0.637, 0.10, 0.033, 0.033, 0.028, 0.0, matCream, matInk, 0.016, 0.022)

    ;; Chest, chin cast shadow, shoulder bridge & ink contour
    addEll(world, 0.185, -0.282, 0.11, 0.325, 0.245, 0.065, 23.0, matBelly, matInk, 0.023, 0.035)
    world.add(Ellipsoid.rotatedZ(pt(0.32, -0.205, 0.182), sc(0.165, 0.182), sc(0.064, 0.182), 0.022, -6.0, matBellyShadow))
    world.add(Ellipsoid.rotatedZ(pt(-0.015, -0.20, 0.195), sc(0.195, 0.195), sc(0.17, 0.195), 0.055, 12.0, matBody))
    addBezier(world, 0.178, -0.215, 0.28, 0.010, 0.158, -0.300, 0.28, 0.010, 0.132, -0.400, 0.28, 0.010, 3, matInk, matInk, 0.0, 0.0)

    ;; Lower belly crescent
    addBezier(
        world,
        -0.365, -0.308, 0.03, 0.014,
        -0.295, -0.416, 0.04, 0.052,
        -0.130, -0.448, 0.04, 0.070,
        5, matLowerBelly, matInk, 0.021, 0.03
    )

    ;; Front-left leg
    def frontLeftLegCoeffs: array of double = (array of double).of(
        0.21150,
        -0.01508, 0.01839,
        -0.06797, -0.01352,
        -0.01272, -0.00037,
        -0.01398, 0.00190,
        0.00297, -0.00658,
        0.01774, 0.00519,
        0.00288, 0.00480,
        -0.00176, -0.00241
    )
    world.add(SculptedLobe(pt(0.005, -0.495, 0.20), 0.10, sc(1.0, 0.20), move(frontLeftLegCoeffs), 0.34, matFrontLeftLeg, matInk, 0.02, openTop: 0.19))
    addBezier(world, -0.144, -0.27, 0.32, 0.009, -0.145, -0.36, 0.32, 0.009, -0.136, -0.46, 0.32, 0.009, 2, matInk, matInk, 0.0, 0.0)
    addEll(world, 0.001, -0.695, 0.31, 0.036, 0.035, 0.028, 0.0, matCream, matInk, 0.016, 0.022)
    addEll(world, 0.072, -0.694, 0.32, 0.040, 0.038, 0.028, 0.0, matCream, matInk, 0.016, 0.022)
    addEll(world, 0.136, -0.680, 0.31, 0.034, 0.034, 0.028, 0.0, matCream, matInk, 0.016, 0.022)

    ;; --- 4. Scalloped Lavender Frill ---
    def frillCoeffs: array of double = (array of double).of(
        0.43578,
        0.00969, 0.01561,
        0.02936, -0.00796,
        -0.00715, -0.00313,
        0.00708, 0.00412,
        0.00572, -0.00608,
        -0.00439, 0.00286,
        0.00604, -0.00299,
        0.00052, -0.00338,
        -0.00100, 0.00591,
        -0.00169, -0.00923,
        0.00151, -0.00097,
        0.00270, -0.00299
    )
    world.add(SculptedLobe(pt(0.28, 0.254, 0.07), 0.06, sc(1.0, 0.07), move(frillCoeffs), 0.52, matFrill, matInk, 0.0215, 0.018, matFrillRim))
    addEll(world, -0.082, 0.068, 0.066, 0.064, 0.062, 0.042, 0.0, matFrill, matInk, 0.022, 0.03)

    ;; 9 cream osteoderm scallops
    addEll(world, -0.155, 0.042, 0.055, 0.034, 0.032, 0.035, 72.0, matCream, matInk, 0.017, 0.025)
    addEll(world, -0.184, 0.221, 0.055, 0.039, 0.030, 0.035, 85.0, matCream, matInk, 0.017, 0.025)
    addEll(world, -0.166, 0.404, 0.055, 0.046, 0.031, 0.035, 68.0, matCream, matInk, 0.017, 0.025)
    addEll(world, -0.033, 0.596, 0.055, 0.042, 0.030, 0.035, 36.0, matCream, matInk, 0.017, 0.025)
    addEll(world, 0.242, 0.707, 0.055, 0.044, 0.031, 0.035, -2.0, matCream, matInk, 0.018, 0.025)
    addEll(world, 0.496, 0.654, 0.055, 0.042, 0.029, 0.035, -34.0, matCream, matInk, 0.017, 0.025)
    addEll(world, 0.647, 0.524, 0.055, 0.040, 0.029, 0.035, -52.0, matCream, matInk, 0.017, 0.025)
    addEll(world, 0.737, 0.377, 0.055, 0.038, 0.029, 0.035, -72.0, matCream, matInk, 0.017, 0.025)
    addEll(world, 0.752, 0.160, 0.055, 0.034, 0.026, 0.035, -76.0, matCream, matInk, 0.017, 0.025)

    ;; Radial frill fold creases
    addBezier(world, -0.10, 0.166, 0.14, 0.008, -0.02, 0.165, 0.14, 0.008, 0.04, 0.166, 0.14, 0.007, 2, matInk, matInk, 0.0, 0.0)
    addBezier(world, -0.065, 0.362, 0.14, 0.008, 0.005, 0.324, 0.14, 0.008, 0.075, 0.286, 0.14, 0.007, 2, matInk, matInk, 0.0, 0.0)
    addBezier(world, 0.135, 0.560, 0.14, 0.008, 0.165, 0.490, 0.14, 0.008, 0.195, 0.430, 0.14, 0.007, 2, matSoftCrease, matInk, 0.0, 0.0)
    addBezier(world, 0.402, 0.575, 0.13, 0.008, 0.390, 0.485, 0.13, 0.008, 0.382, 0.405, 0.13, 0.007, 2, matSoftCrease, matInk, 0.0, 0.0)
    addBezier(world, 0.648, 0.355, 0.13, 0.008, 0.590, 0.322, 0.13, 0.008, 0.530, 0.290, 0.13, 0.007, 2, matSoftCrease, matInk, 0.0, 0.0)

    ;; --- 5. Pear-Shaped Head & Snout ---
    def headCoeffs: array of double = (array of double).of(
        0.32691,
        -0.00854, -0.00060,
        0.00648, -0.01054,
        -0.00478, -0.01992,
        0.00096, -0.01066,
        0.00853, -0.00113,
        -0.00010, -0.00901,
        0.00367, 0.00045
    )
    world.add(SculptedLobe(pt(0.37, 0.08, 0.25), 0.14, sc(1.0, 0.25), move(headCoeffs), 0.40, matHead, matInk, 0.022))
    addBezier(world, 0.630, 0.032, 0.45, 0.009, 0.648, -0.035, 0.45, 0.009, 0.644, -0.108, 0.45, 0.009, 3, matInk, matInk, 0.0, 0.0)

    ;; --- 6. Three Cream-Yellow Horns ---
