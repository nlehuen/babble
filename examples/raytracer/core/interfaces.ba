;; Core raytracer interfaces and hit/scatter records.

def Rng = import("rng.ba").Rng
def Vec3 = import("vec3.ba").Vec3
def Ray = import("ray.ba").Ray
def AABB = import("aabb.ba").AABB

export def Describable = interface (
    def kind: fn (): string
    def describe = fn (): string -> (
        "<" + this.kind() + ">"
    )
)

;; What a material does with a ray: optional scattered ray + attenuation, and optional
;; emitted radiance. Returning null absorbs the ray completely (no emission, no bounce).
export def Scatter = record (
    attenuation: Vec3,
    scattered: Ray?,
    emission: Vec3 = Vec3.zero,
    isDiffuse: bool = false
) () static (
    ;; Pure emission: terminates the ray directly with constant radiance.
    def emit = fn (emission: Vec3): Scatter -> (
        this(Vec3.zero, null, emission, false)
    )
)

;; Planar parallelogram area light for direct light sampling (Next Event Estimation).
;; Emits along the unit normal direction of `u.cross(v)`.
export def AreaLight = record (
    q: Vec3,
    u: Vec3,
    v: Vec3,
    emission: Vec3
) (
    def normal: Vec3
    def area: double

    init (
        def n: Vec3 = this.u.cross(this.v)
        this.area = n.length()
        this.normal = n / this.area
    )

    def samplePoint = fn (mut rng: Rng): Vec3 -> (
        this.q + this.u * rng.nextDouble() + this.v * rng.nextDouble()
    )
)

export def Material = interface extends Describable (
    def scatter: fn (rIn: Ray, rec: HitRecord, mut rng: Rng): Scatter?
    def kind = fn (): string -> ("material")
)

export def HitRecord = record (
    p: Vec3,
    normal: Vec3,
    mat: Material,
    t: double,
    frontFace: bool
) () static (
    def create = fn (r: Ray, p: Vec3, outwardNormal: Vec3, t: double, mat: Material): HitRecord -> (
        def frontFace: bool = r.dir.dot(outwardNormal) < 0.0
        def normal: Vec3 = if frontFace then (outwardNormal) else (-outwardNormal)
        this(p, normal, mat, t, frontFace)
    )
)

export def Hittable = interface extends Describable (
    ;; Closest hit of the ray with tmin < t < tmax, or null.
    def hit: fn (r: Ray, tmin: double, tmax: double): HitRecord?
    def boundingBox = fn (): AABB -> (AABB.empty)
    def kind = fn (): string -> ("hittable")
)

export def emptyHittable = object implements Hittable (
    def hit = fn (r: Ray, tmin: double, tmax: double): HitRecord? -> (null)
    def boundingBox = fn (): AABB -> (AABB.empty)
    def kind = fn (): string -> ("empty")
)
