;; Axis-Aligned Bounding Box (AABB) with flat 6-double layout for zero nested
;; allocations in BVH traversal.

def math = import("math.ba")
def Vec3 = import("vec3.ba").Vec3
def Ray = import("ray.ba").Ray

export def AABB = record (
    minX: double, maxX: double,
    minY: double, maxY: double,
    minZ: double, maxZ: double
) (
    def centroid = fn (axis: int): double -> (
        match axis
            case 0 then (0.5 * (this.minX + this.maxX))
            case 1 then (0.5 * (this.minY + this.maxY))
            else (0.5 * (this.minZ + this.maxZ))
    )

    def center = fn (): Vec3 -> (
        Vec3(
            0.5 * (this.minX + this.maxX),
            0.5 * (this.minY + this.maxY),
            0.5 * (this.minZ + this.maxZ)
        )
    )

    def expandPoint = fn (p: Vec3): AABB -> (
        AABB(
            math.min(this.minX, p.x), math.max(this.maxX, p.x),
            math.min(this.minY, p.y), math.max(this.maxY, p.y),
            math.min(this.minZ, p.z), math.max(this.maxZ, p.z)
        )
    )

    def longestAxis = fn (): int -> (
        def sx: double = this.maxX - this.minX
        def sy: double = this.maxY - this.minY
        def sz: double = this.maxZ - this.minZ
        if sx >= sy and sx >= sz then (0) else if sy >= sz then (1) else (2)
    )

    def offset = fn (v: Vec3): AABB -> (
        AABB(
            this.minX + v.x, this.maxX + v.x,
            this.minY + v.y, this.maxY + v.y,
            this.minZ + v.z, this.maxZ + v.z
        )
    )

    ;; Pads any degenerate (zero-thickness) axis so planar primitives have safe BVH slabs.
    def padToMinimums = fn (): AABB -> (
        def delta: double = 0.0001
        def halfDelta: double = 0.00005
        def nx0: double = if this.maxX - this.minX < delta then (this.minX - halfDelta) else (this.minX)
        def nx1: double = if this.maxX - this.minX < delta then (this.maxX + halfDelta) else (this.maxX)
        def ny0: double = if this.maxY - this.minY < delta then (this.minY - halfDelta) else (this.minY)
        def ny1: double = if this.maxY - this.minY < delta then (this.maxY + halfDelta) else (this.maxY)
        def nz0: double = if this.maxZ - this.minZ < delta then (this.minZ - halfDelta) else (this.minZ)
        def nz1: double = if this.maxZ - this.minZ < delta then (this.maxZ + halfDelta) else (this.maxZ)
        AABB(nx0, nx1, ny0, ny1, nz0, nz1)
    )

    def hit = fn (r: Ray, tmin: double, tmax: double): bool -> (
        def orig: Vec3 = r.origin
        def dir: Vec3 = r.dir
        var curMin: double = tmin
        var curMax: double = tmax

        def invX: double = 1.0 / dir.x
        var tx0: double = (this.minX - orig.x) * invX
        var tx1: double = (this.maxX - orig.x) * invX
        if invX < 0.0 then (
            def tmpX: double = tx0
            tx0 = tx1
            tx1 = tmpX
        )
        if tx0 > curMin then (curMin = tx0)
        if tx1 < curMax then (curMax = tx1)
        if curMax <= curMin then (return false)

        def invY: double = 1.0 / dir.y
        var ty0: double = (this.minY - orig.y) * invY
        var ty1: double = (this.maxY - orig.y) * invY
        if invY < 0.0 then (
            def tmpY: double = ty0
            ty0 = ty1
            ty1 = tmpY
        )
        if ty0 > curMin then (curMin = ty0)
        if ty1 < curMax then (curMax = ty1)
        if curMax <= curMin then (return false)

        def invZ: double = 1.0 / dir.z
        var tz0: double = (this.minZ - orig.z) * invZ
        var tz1: double = (this.maxZ - orig.z) * invZ
        if invZ < 0.0 then (
            def tmpZ: double = tz0
            tz0 = tz1
            tz1 = tmpZ
        )
        if tz0 > curMin then (curMin = tz0)
        if tz1 < curMax then (curMax = tz1)
        curMax > curMin
    )
) static (
    def empty: AABB = this(
        math.infinity, math.negInfinity,
        math.infinity, math.negInfinity,
        math.infinity, math.negInfinity
    )

    def fromPoints = fn (a: Vec3, b: Vec3): AABB -> (
        this(
            math.min(a.x, b.x), math.max(a.x, b.x),
            math.min(a.y, b.y), math.max(a.y, b.y),
            math.min(a.z, b.z), math.max(a.z, b.z)
        )
    )

    def enclose = fn (box0: AABB, box1: AABB): AABB -> (
        this(
            math.min(box0.minX, box1.minX), math.max(box0.maxX, box1.maxX),
            math.min(box0.minY, box1.minY), math.max(box0.maxY, box1.maxY),
            math.min(box0.minZ, box1.minZ), math.max(box0.maxZ, box1.maxZ)
        )
    )
)
