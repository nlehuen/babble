;; Oriented 3D ellipsoid primitive with exact tight AABB and closed-form ray intersection.

def math = import("../math.ba")
def Vec3 = import("../vec3.ba").Vec3
def Ray = import("../ray.ba").Ray
def AABB = import("../aabb.ba").AABB
def HitRecord = import("../interfaces.ba").HitRecord
def Hittable = import("../interfaces.ba").Hittable
def Material = import("../interfaces.ba").Material

export def Ellipsoid = class (
    def center: Vec3,
    def u: Vec3,
    def v: Vec3,
    def w: Vec3,
    def rx: double,
    def ry: double,
    def rz: double,
    def mat: Material
) implements Hittable (
    private def invRx: double
    private def invRy: double
    private def invRz: double
    private def bbox: AABB

    init (
        this.invRx = 1.0 / this.rx
        this.invRy = 1.0 / this.ry
        this.invRz = 1.0 / this.rz

        def ux: double = this.u.x * this.rx
        def vx: double = this.v.x * this.ry
        def wx: double = this.w.x * this.rz
        def ex: double = math.sqrt(ux * ux + vx * vx + wx * wx)

        def uy: double = this.u.y * this.rx
        def vy: double = this.v.y * this.ry
        def wy: double = this.w.y * this.rz
        def ey: double = math.sqrt(uy * uy + vy * vy + wy * wy)

        def uz: double = this.u.z * this.rx
        def vz: double = this.v.z * this.ry
        def wz: double = this.w.z * this.rz
        def ez: double = math.sqrt(uz * uz + vz * vz + wz * wz)

        this.bbox = AABB(
            this.center.x - ex, this.center.x + ex,
            this.center.y - ey, this.center.y + ey,
            this.center.z - ez, this.center.z + ez
        )
    )

    ;; Secondary constructor for an axis-aligned ellipsoid.
    init (center: Vec3, rx: double, ry: double, rz: double, mat: Material) -> (
        this(center, Vec3(1.0, 0.0, 0.0), Vec3(0.0, 1.0, 0.0), Vec3(0.0, 0.0, 1.0), rx, ry, rz, mat)
    )

    def boundingBox = fn (): AABB -> (this.bbox)

    def hit = fn (r: Ray, tmin: double, tmax: double): HitRecord? -> (
        def oc: Vec3 = r.origin - this.center
        def ox: double = oc.dot(this.u) * this.invRx
        def oy: double = oc.dot(this.v) * this.invRy
        def oz: double = oc.dot(this.w) * this.invRz

        def dx: double = r.dir.dot(this.u) * this.invRx
        def dy: double = r.dir.dot(this.v) * this.invRy
        def dz: double = r.dir.dot(this.w) * this.invRz

        def a: double = dx * dx + dy * dy + dz * dz
        def h: double = -(ox * dx + oy * dy + oz * dz)
        def c: double = ox * ox + oy * oy + oz * oz - 1.0

        def disc: double = h * h - a * c
        if disc < 0.0 then (return null)

        def sqrtd: double = math.sqrt(disc)
        var root: double = (h - sqrtd) / a
        if root <= tmin or tmax <= root then (
            root = (h + sqrtd) / a
            if root <= tmin or tmax <= root then (return null)
        )

        def lx: double = ox + root * dx
        def ly: double = oy + root * dy
        def lz: double = oz + root * dz

        def nx: double = lx * this.invRx
        def ny: double = ly * this.invRy
        def nz: double = lz * this.invRz
        def outward: Vec3 = (this.u * nx + this.v * ny + this.w * nz).unit()

        HitRecord.create(r, r.at(root), outward, root, this.mat)
    )

    def kind = fn (): string -> ("ellipsoid")
) static (
    def axisAligned = fn (center: Vec3, rx: double, ry: double, rz: double, mat: Material): Ellipsoid -> (
        this(center, Vec3(1.0, 0.0, 0.0), Vec3(0.0, 1.0, 0.0), Vec3(0.0, 0.0, 1.0), rx, ry, rz, mat)
    )

    def rotatedX = fn (center: Vec3, rx: double, ry: double, rz: double, angleDeg: double, mat: Material): Ellipsoid -> (
        def rad: double = math.degreesToRadians(angleDeg)
        def ca: double = math.cos(rad)
        def sa: double = math.sin(rad)
        this(center, Vec3(1.0, 0.0, 0.0), Vec3(0.0, ca, sa), Vec3(0.0, -sa, ca), rx, ry, rz, mat)
    )

    def rotatedY = fn (center: Vec3, rx: double, ry: double, rz: double, angleDeg: double, mat: Material): Ellipsoid -> (
        def rad: double = math.degreesToRadians(angleDeg)
        def ca: double = math.cos(rad)
        def sa: double = math.sin(rad)
        this(center, Vec3(ca, 0.0, -sa), Vec3(0.0, 1.0, 0.0), Vec3(sa, 0.0, ca), rx, ry, rz, mat)
    )

    def rotatedZ = fn (center: Vec3, rx: double, ry: double, rz: double, angleDeg: double, mat: Material): Ellipsoid -> (
        def rad: double = math.degreesToRadians(angleDeg)
        def ca: double = math.cos(rad)
        def sa: double = math.sin(rad)
        this(center, Vec3(ca, sa, 0.0), Vec3(-sa, ca, 0.0), Vec3(0.0, 0.0, 1.0), rx, ry, rz, mat)
    )
)
