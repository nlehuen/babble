;; Pure-Babble mathematics (zero java.lang.Math): constants, abs, min, max, clamp,
;; sqrt (range-scaled Newton-Raphson), sin/cos/tan (Taylor series), powInt, and conversions.

export def pi: double = 3.141592653589793
export def twoPi: double = 6.283185307179586
export def halfPi: double = 1.5707963267948966
export def infinity: double = 1.0 / 0.0
export def negInfinity: double = -1.0 / 0.0

export def abs = fn (x: double): double -> (
    if x < 0.0 then (-x) else (x)
)

export def min = fn (a: double, b: double): double -> (
    if a < b then (a) else (b)
)

export def max = fn (a: double, b: double): double -> (
    if a > b then (a) else (b)
)

export def minInt = fn (a: int, b: int): int -> (
    if a < b then (a) else (b)
)

export def maxInt = fn (a: int, b: int): int -> (
    if a > b then (a) else (b)
)

export def clamp = fn (x: double, lo: double, hi: double): double -> (
    if x < lo then (
        lo
    ) else if x > hi then (hi) else (x)
)

export def degreesToRadians = fn (degrees: double): double -> (
    degrees * pi / 180.0
)

;; Integer power via Babble's built-in "recurse" keyword
export def powInt = fn (base: double, exp: int): double -> (
    if exp <= 0 then (
        1.0
    ) else (
        base * recurse(base, exp - 1)
    )
)

;; Square root via range scaling + 5 unrolled Newton-Raphson steps (full IEEE-754 double precision)
export def sqrt = fn (x: double): double -> (
    if x <= 0.0 then (
        return 0.0
    )
    var g: double = if x > 1.0 then (x * 0.5) else (0.5)
    while g * g > x * 16.0 then (
        g *= 0.25
    )
    while g * g * 16.0 < x then (
        g *= 4.0
    )
    if g * g > x * 4.0 then (g *= 0.5)
    if g * g * 4.0 < x then (g *= 2.0)
    if g * g > x * 2.0 then (g *= 0.7071067811865476)
    if g * g * 2.0 < x then (g *= 1.4142135623730951)
    g = 0.5 * (g + x / g)
    g = 0.5 * (g + x / g)
    g = 0.5 * (g + x / g)
    g = 0.5 * (g + x / g)
    0.5 * (g + x / g)
)

;; Angle reduction into [-pi, pi]
export def wrapAngle = fn (x: double): double -> (
    var a: double = x
    while a > pi then (a -= twoPi)
    while a < -pi then (a += twoPi)
    a
)

;; Taylor series for sin(x)
export def sin = fn (x: double): double -> (
    def a: double = wrapAngle(x)
    def x2: double = a * a
    var term: double = a
    var sum: double = a
    var n: int = 1
    while n <= 10 then (
        def denom: double = (2 * n) * (2 * n + 1)
        term = -term * x2 / denom
        sum += term
        n += 1
    )
    sum
)

;; Taylor series for cos(x)
export def cos = fn (x: double): double -> (
    def a: double = wrapAngle(x)
    def x2: double = a * a
    var term: double = 1.0
    var sum: double = 1.0
    var n: int = 1
    while n <= 10 then (
        def denom: double = (2 * n - 1) * (2 * n)
        term = -term * x2 / denom
        sum += term
        n += 1
    )
    sum
)

export def tan = fn (x: double): double -> (
    sin(x) / cos(x)
)

;; A clamped [0.0, 256.0) channel value as an int in [0, 255]
export def toByte = fn (x: double): int -> (int(clamp(x, 0.0, 255.999)))

;; Truncates towards zero
export def toInt = fn (x: double): int -> (int(x))
