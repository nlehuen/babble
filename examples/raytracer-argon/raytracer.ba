;;(
    Ray Tracing in One Weekend — Pure Babble Implementation
    https://raytracing.github.io/books/RayTracingInOneWeekend.html

    Implemented in 100% pure Babble with ZERO Java builtins (no java.*, javax.*,
    or import calls). Every mathematical function (sqrt, sin, cos, tan, pow,
    float-to-int conversion), random number generator (LCG), data structure
    (linked HittableList and Bounding Volume Hierarchy BVHNode), vector/ray/AABB
    geometry, material model (Lambertian, Metal, Dielectric with Schlick
    approximation), positionable defocus-blur Camera, and PPM renderer is built
    using native Babble constructs.
;;)

;; ============================================================================
;; 1. Pure-Babble Mathematics Package (no java.lang.Math)
;; ============================================================================
package math (
    def pi : double = 3.141592653589793
    def twoPi : double = 6.283185307179586
    def halfPi : double = 1.5707963267948966
    def infinity : double = 1.0 / 0.0
    def negInfinity : double = (0.0 - 1.0) / 0.0

    def abs = (x: double) : double -> (
        if x < 0.0 then ( 0.0 - x ) else ( x )
    )

    def min = (a: double, b: double) : double -> (
        if a < b then ( a ) else ( b )
    )

    def max = (a: double, b: double) : double -> (
        if a > b then ( a ) else ( b )
    )

    def minInt = (a: int, b: int) : int -> (
        if a < b then ( a ) else ( b )
    )

    def maxInt = (a: int, b: int) : int -> (
        if a > b then ( a ) else ( b )
    )

    def clamp = (x: double, lo: double, hi: double) : double -> (
        if x < lo then (
            lo
        ) else (
            if x > hi then ( hi ) else ( x )
        )
    )

    def degreesToRadians = (degrees: double) : double -> (
        degrees * pi / 180.0
    )

    ;; Integer power via Babble's built-in "recurse" keyword
    def powInt = (base: double, exp: int) : double -> (
        if exp <= 0 then (
            1.0
        ) else (
            base * recurse(base, exp - 1)
        )
    )

    ;; Square root via range scaling + Newton-Raphson (Heron's method)
    def sqrt = (x: double) : double -> (
        if x <= 0.0 then (
            return 0.0
        )
        def g : double = if x > 1.0 then ( x * 0.5 ) else ( 1.0 )
        while g * g > x * 16.0 then (
            g = g * 0.25
        )
        while g * g * 16.0 < x then (
            g = g * 4.0
        )
        def i : int = 0
        while i < 10 then (
            g = 0.5 * (g + x / g)
            i = i + 1
        )
        g
    )

    ;; Angle reduction into [-pi, pi]
    def wrapAngle = (x: double) : double -> (
        def a : double = x
        while a > pi then ( a = a - twoPi )
        while a < 0.0 - pi then ( a = a + twoPi )
        a
    )

    ;; Taylor series for sin(x)
    def sin = (x: double) : double -> (
        def a : double = wrapAngle(x)
        def x2 : double = a * a
        def term : double = a
        def sum : double = a
        def n : int = 1
        while n <= 10 then (
            def denom : double = (2 * n) * (2 * n + 1)
            term = (0.0 - term) * x2 / denom
            sum = sum + term
            n = n + 1
        )
        sum
    )

    ;; Taylor series for cos(x)
    def cos = (x: double) : double -> (
        def a : double = wrapAngle(x)
        def x2 : double = a * a
        def term : double = 1.0
        def sum : double = 1.0
        def n : int = 1
        while n <= 10 then (
            def denom : double = (2 * n - 1) * (2 * n)
            term = (0.0 - term) * x2 / denom
            sum = sum + term
            n = n + 1
        )
        sum
    )

    def tan = (x: double) : double -> (
        sin(x) / cos(x)
    )

    ;; Fast conversion of a clamped [0.0, 256.0) channel value to an int in [0, 255]
    def toByte = (x: double) : int -> (
        def v : double = clamp(x, 0.0, 255.999)
        def res : int = 0
        if v >= 128.0 then ( res = res + 128 ; v = v - 128.0 )
        if v >= 64.0  then ( res = res + 64  ; v = v - 64.0 )
        if v >= 32.0  then ( res = res + 32  ; v = v - 32.0 )
        if v >= 16.0  then ( res = res + 16  ; v = v - 16.0 )
        if v >= 8.0   then ( res = res + 8   ; v = v - 8.0 )
        if v >= 4.0   then ( res = res + 4   ; v = v - 4.0 )
        if v >= 2.0   then ( res = res + 2   ; v = v - 2.0 )
        if v >= 1.0   then ( res = res + 1 )
        res
    )

    ;; Recursive binary decomposition to truncate any non-negative double to int
    def toIntPos = (x: double, bit: int) : int -> (
        if x < bit then (
            0
        ) else (
            def higher : int = if x >= bit * 2.0 then ( recurse(x, bit * 2) ) else ( 0 )
            if x - higher >= bit then ( higher + bit ) else ( higher )
        )
    )

    def toInt = (x: double) : int -> (
        if x < 0.0 then (
            0 - toIntPos(0.0 - x, 1)
        ) else (
            toIntPos(x, 1)
        )
    )
)

;; ============================================================================
;; 2. Raytracer Core Package
;; ============================================================================
package raytracer (

    ;; ------------------------------------------------------------------------
    ;; 2.1 Deterministic 32-bit LCG Pseudo-Random Number Generator (no java.util.Random)
    ;; Exploits Babble's 32-bit signed integer wrap-around on int * int + int.
    ;; ------------------------------------------------------------------------
    def Rng = class (private def seed: int = 1337) (
        def nextDouble = () : double -> (
            this.seed = this.seed * 1664525 + 1013904223
            def u : double = if this.seed < 0 then (
                this.seed + 2147483648.0
            ) else (
                1.0 * this.seed
            )
            u / 2147483648.0
        )

        def nextRange = (minVal: double, maxVal: double) : double -> (
            minVal + (maxVal - minVal) * this.nextDouble()
        )
    )

    ;; ------------------------------------------------------------------------
    ;; 2.2 Vec3 Value Class (3D points, vectors, and RGB colors)
    ;; ------------------------------------------------------------------------
    def Vec3 = value class (x: double, y: double, z: double) (
        def neg = () : Vec3 -> (
            Vec3(0.0 - this.x, 0.0 - this.y, 0.0 - this.z)
        )

        def plus = (v: Vec3) : Vec3 -> (
            Vec3(this.x + v.x, this.y + v.y, this.z + v.z)
        )

        def minus = (v: Vec3) : Vec3 -> (
            Vec3(this.x - v.x, this.y - v.y, this.z - v.z)
        )

        def mul = (v: Vec3) : Vec3 -> (
            Vec3(this.x * v.x, this.y * v.y, this.z * v.z)
        )

        def scale = (t: double) : Vec3 -> (
            Vec3(this.x * t, this.y * t, this.z * t)
        )

        def div = (t: double) : Vec3 -> (
            this.scale(1.0 / t)
        )

        def dot = (v: Vec3) : double -> (
            this.x * v.x + this.y * v.y + this.z * v.z
        )

        def cross = (v: Vec3) : Vec3 -> (
            Vec3(
                this.y * v.z - this.z * v.y,
                this.z * v.x - this.x * v.z,
                this.x * v.y - this.y * v.x
            )
        )

        def lengthSquared = () : double -> (
            this.x * this.x + this.y * this.y + this.z * this.z
        )

        def length = () : double -> (
            math.sqrt(this.lengthSquared())
        )

        def unit = () : Vec3 -> (
            this.div(this.length())
        )

        def nearZero = () : bool -> (
            def s : double = 0.00000001
            math.abs(this.x) < s and math.abs(this.y) < s and math.abs(this.z) < s
        )

        ;; Specular reflection of incident vector about unit normal n
        def reflect = (n: Vec3) : Vec3 -> (
            this.minus(n.scale(2.0 * this.dot(n)))
        )

        ;; Snell's law refraction of unit incident vector about normal n
        def refract = (n: Vec3, etaiOverEtat: double) : Vec3 -> (
            def cosTheta : double = math.min(this.neg().dot(n), 1.0)
            def rOutPerp : Vec3 = this.plus(n.scale(cosTheta)).scale(etaiOverEtat)
            def rOutParallel : Vec3 = n.scale(0.0 - math.sqrt(math.abs(1.0 - rOutPerp.lengthSquared())))
            rOutPerp.plus(rOutParallel)
        )
    )
    static (
        def zero : Vec3 = this(0.0, 0.0, 0.0)
        def one : Vec3 = this(1.0, 1.0, 1.0)

        def random = (rng: Rng) : Vec3 -> (
            this(rng.nextDouble(), rng.nextDouble(), rng.nextDouble())
        )

        def randomRange = (rng: Rng, minVal: double, maxVal: double) : Vec3 -> (
            this(
                rng.nextRange(minVal, maxVal),
                rng.nextRange(minVal, maxVal),
                rng.nextRange(minVal, maxVal)
            )
        )

        def randomUnitVector = (rng: Rng) : Vec3 -> (
            while true then (
                def p : Vec3 = this.randomRange(rng, 0.0 - 1.0, 1.0)
                def lensq : double = p.lengthSquared()
                if lensq > 0.000000000001 and lensq <= 1.0 then (
                    return p.div(math.sqrt(lensq))
                )
            )
            this.zero
        )

        def randomOnHemisphere = (rng: Rng, normal: Vec3) : Vec3 -> (
            def onUnitSphere : Vec3 = this.randomUnitVector(rng)
            if onUnitSphere.dot(normal) > 0.0 then (
                onUnitSphere
            ) else (
                onUnitSphere.neg()
            )
        )

        def randomInUnitDisk = (rng: Rng) : Vec3 -> (
            while true then (
                def p : Vec3 = this(
                    rng.nextRange(0.0 - 1.0, 1.0),
                    rng.nextRange(0.0 - 1.0, 1.0),
                    0.0
                )
                if p.lengthSquared() < 1.0 then (
                    return p
                )
            )
            this.zero
        )
    )

    ;; ------------------------------------------------------------------------
    ;; 2.3 Ray Value Class
    ;; ------------------------------------------------------------------------
    def Ray = value class (origin: Vec3, dir: Vec3) (
        def at = (t: double) : Vec3 -> (
            this.origin.plus(this.dir.scale(t))
        )
    )

    ;; ------------------------------------------------------------------------
    ;; 2.4 Interval Value Class
    ;; ------------------------------------------------------------------------
    def Interval = value class (min: double, max: double) (
        def size = () : double -> (
            this.max - this.min
        )

        def midpoint = () : double -> (
            0.5 * (this.min + this.max)
        )

        def contains = (x: double) : bool -> (
            this.min <= x and x <= this.max
        )

        def surrounds = (x: double) : bool -> (
            this.min < x and x < this.max
        )

        def clamp = (x: double) : double -> (
            if x < this.min then (
                this.min
            ) else (
                if x > this.max then ( this.max ) else ( x )
            )
        )

        def expand = (delta: double) : Interval -> (
            def padding : double = delta / 2.0
            Interval(this.min - padding, this.max + padding)
        )
    )
    static (
        def empty : Interval = this(math.infinity, math.negInfinity)
        def universe : Interval = this(math.negInfinity, math.infinity)

        def enclose = (a: Interval, b: Interval) : Interval -> (
            this(math.min(a.min, b.min), math.max(a.max, b.max))
        )
    )

    ;; ------------------------------------------------------------------------
    ;; 2.5 Axis-Aligned Bounding Box (AABB) Value Class for BVH Acceleration
    ;; ------------------------------------------------------------------------
    def AABB = value class (x: Interval, y: Interval, z: Interval) (
        def centroid = (axis: int) : double -> (
            if axis == 0 then (
                this.x.midpoint()
            ) else (
                if axis == 1 then ( this.y.midpoint() ) else ( this.z.midpoint() )
            )
        )

        def center = () : Vec3 -> (
            Vec3(this.x.midpoint(), this.y.midpoint(), this.z.midpoint())
        )

        def expandPoint = (p: Vec3) : AABB -> (
            AABB(
                Interval(math.min(this.x.min, p.x), math.max(this.x.max, p.x)),
                Interval(math.min(this.y.min, p.y), math.max(this.y.max, p.y)),
                Interval(math.min(this.z.min, p.z), math.max(this.z.max, p.z))
            )
        )

        def longestAxis = () : int -> (
            def sx : double = this.x.size()
            def sy : double = this.y.size()
            def sz : double = this.z.size()
            if sx >= sy and sx >= sz then (
                0
            ) else (
                if sy >= sz then ( 1 ) else ( 2 )
            )
        )

        def hit = (r: Ray, rayT: Interval) : bool -> (
            def tMin : double = rayT.min
            def tMax : double = rayT.max

            def invX : double = 1.0 / r.dir.x
            def tx0 : double = (this.x.min - r.origin.x) * invX
            def tx1 : double = (this.x.max - r.origin.x) * invX
            if invX < 0.0 then (
                def tmpX : double = tx0 ; tx0 = tx1 ; tx1 = tmpX
            )
            if tx0 > tMin then ( tMin = tx0 )
            if tx1 < tMax then ( tMax = tx1 )
            if tMax <= tMin then ( return false )

            def invY : double = 1.0 / r.dir.y
            def ty0 : double = (this.y.min - r.origin.y) * invY
            def ty1 : double = (this.y.max - r.origin.y) * invY
            if invY < 0.0 then (
                def tmpY : double = ty0 ; ty0 = ty1 ; ty1 = tmpY
            )
            if ty0 > tMin then ( tMin = ty0 )
            if ty1 < tMax then ( tMax = ty1 )
            if tMax <= tMin then ( return false )

            def invZ : double = 1.0 / r.dir.z
            def tz0 : double = (this.z.min - r.origin.z) * invZ
            def tz1 : double = (this.z.max - r.origin.z) * invZ
            if invZ < 0.0 then (
                def tmpZ : double = tz0 ; tz0 = tz1 ; tz1 = tmpZ
            )
            if tz0 > tMin then ( tMin = tz0 )
            if tz1 < tMax then ( tMax = tz1 )
            tMax > tMin
        )
    )
    static (
        def empty : AABB = this(Interval.empty, Interval.empty, Interval.empty)

        def fromPoints = (a: Vec3, b: Vec3) : AABB -> (
            this(
                Interval(math.min(a.x, b.x), math.max(a.x, b.x)),
                Interval(math.min(a.y, b.y), math.max(a.y, b.y)),
                Interval(math.min(a.z, b.z), math.max(a.z, b.z))
            )
        )

        def enclose = (box0: AABB, box1: AABB) : AABB -> (
            this(
                Interval.enclose(box0.x, box1.x),
                Interval.enclose(box0.y, box1.y),
                Interval.enclose(box0.z, box1.z)
            )
        )
    )

    ;; ------------------------------------------------------------------------
    ;; 2.6 Interfaces, HitRecord, and ScatterResult
    ;; Showcases Babble interfaces, extends, default methods, and super calls.
    ;; ------------------------------------------------------------------------
    def Describable = interface (
        def kind : () : string
        def describe = () : string -> (
            "<" + this.kind() + ">"
        )
    )

    def ScatterResult = value class (attenuation: Vec3, scattered: Ray) ()

    def Material = interface extends Describable (
        def scatter : (rIn: Ray, rec: HitRecord, rng: Rng) : ScatterResult
        def kind = () : string -> ( "material" )
    )

    def HitRecord = value class (
        p: Vec3,
        normal: Vec3,
        mat: Material,
        t: double,
        frontFace: bool
    ) ()
    static (
        def create = (r: Ray, p: Vec3, outwardNormal: Vec3, t: double, mat: Material) : HitRecord -> (
            def frontFace : bool = r.dir.dot(outwardNormal) < 0.0
            def normal : Vec3 = if frontFace then ( outwardNormal ) else ( outwardNormal.neg() )
            this(p, normal, mat, t, frontFace)
        )
    )

    def Hittable = interface extends Describable (
        def hit : (r: Ray, rayT: Interval) : HitRecord
        def boundingBox = () : AABB -> ( AABB.empty )
        def kind = () : string -> ( "hittable" )
    )

    ;; Object literal implementing a Babble interface
    def emptyHittable = object implements Hittable (
        def hit = (r: Ray, rayT: Interval) : HitRecord -> ( null )
        def boundingBox = () : AABB -> ( AABB.empty )
        def kind = () : string -> ( "empty" )
    )

    ;; ------------------------------------------------------------------------
    ;; 2.7 Materials: Lambertian (diffuse), Metal (reflective), Dielectric (glass)
    ;; ------------------------------------------------------------------------
    def Lambertian = class (def albedo: Vec3) implements Material (
        def scatter = (rIn: Ray, rec: HitRecord, rng: Rng) : ScatterResult -> (
            def scatterDirection : Vec3 = rec.normal.plus(Vec3.randomUnitVector(rng))
            if scatterDirection.nearZero() then (
                scatterDirection = rec.normal
            )
            ScatterResult(this.albedo, Ray(rec.p, scatterDirection))
        )

        def kind = () : string -> ( "lambertian" )

        def describe = () : string -> (
            super.describe() + "(" + this.albedo + ")"
        )
    )

    def Metal = class (def albedo: Vec3, fuzzIn: double = 0.0) implements Material (
        def fuzz : double = if fuzzIn < 1.0 then ( math.max(0.0, fuzzIn) ) else ( 1.0 )

        def scatter = (rIn: Ray, rec: HitRecord, rng: Rng) : ScatterResult -> (
            def reflected : Vec3 = rIn.dir.reflect(rec.normal)
            reflected = reflected.unit().plus(Vec3.randomUnitVector(rng).scale(this.fuzz))
            if reflected.dot(rec.normal) > 0.0 then (
                ScatterResult(this.albedo, Ray(rec.p, reflected))
            ) else (
                null
            )
        )

        def kind = () : string -> ( "metal" )

        def describe = () : string -> (
            super.describe() + "(fuzz=" + this.fuzz + ")"
        )
    )

    def Dielectric = class (def refractionIndex: double) implements Material (
        def scatter = (rIn: Ray, rec: HitRecord, rng: Rng) : ScatterResult -> (
            def ri : double = if rec.frontFace then (
                1.0 / this.refractionIndex
            ) else (
                this.refractionIndex
            )
            def unitDirection : Vec3 = rIn.dir.unit()
            def cosTheta : double = math.min(unitDirection.neg().dot(rec.normal), 1.0)
            def sinTheta : double = math.sqrt(math.max(0.0, 1.0 - cosTheta * cosTheta))
            def cannotRefract : bool = ri * sinTheta > 1.0
            def direction : Vec3 = if cannotRefract or Dielectric.reflectance(cosTheta, ri) > rng.nextDouble() then (
                unitDirection.reflect(rec.normal)
            ) else (
                unitDirection.refract(rec.normal, ri)
            )
            ScatterResult(Vec3.one, Ray(rec.p, direction))
        )

        def kind = () : string -> ( "dielectric" )
    )
    static (
        ;; Schlick's approximation for reflectance
        def reflectance = (cosine: double, refractionIndex: double) : double -> (
            def r0 : double = (1.0 - refractionIndex) / (1.0 + refractionIndex)
            r0 = r0 * r0
            r0 + (1.0 - r0) * math.powInt(1.0 - cosine, 5)
        )
    )

    ;; ------------------------------------------------------------------------
    ;; 2.8 Sphere & Pure-Babble HittableList + BVHNode
    ;; ------------------------------------------------------------------------
    def Sphere = class (def center: Vec3, def radius: double, def mat: Material) implements Hittable, Describable (
        private def radiusSq : double = this.radius * this.radius
        private def invRadius : double = 1.0 / this.radius
        private def rAbs : double = math.abs(this.radius)
        private def rVec : Vec3 = Vec3(this.rAbs, this.rAbs, this.rAbs)
        private def bbox : AABB = AABB.fromPoints(this.center.minus(this.rVec), this.center.plus(this.rVec))

        def boundingBox = () : AABB -> (
            this.bbox
        )

        def hit = (r: Ray, rayT: Interval) : HitRecord -> (
            def oc : Vec3 = this.center.minus(r.origin)
            def a : double = r.dir.lengthSquared()
            def h : double = r.dir.dot(oc)
            def c : double = oc.lengthSquared() - this.radiusSq
            def discriminant : double = h * h - a * c
            if discriminant < 0.0 then (
                return null
            )
            def sqrtd : double = math.sqrt(discriminant)
            def root : double = (h - sqrtd) / a
            if not rayT.surrounds(root) then (
                root = (h + sqrtd) / a
                if not rayT.surrounds(root) then (
                    return null
                )
            )
            def p : Vec3 = r.at(root)
            def outwardNormal : Vec3 = p.minus(this.center).scale(this.invRadius)
            HitRecord.create(r, p, outwardNormal, root, this.mat)
        )

        def kind = () : string -> ( "sphere" )

        def describe = () : string -> (
            super(Hittable).describe() + "(r=" + this.radius + ")"
        )
    )

    ;; Linked-list node for HittableList (replaces java.util.ArrayList)
    def HittableNode = class (def item: Hittable, def next: HittableNode = null) ()

    def HittableList = class () implements Hittable (
        def size : int = 0
        private def head : HittableNode = null
        private def bbox : AABB = AABB.empty

        def add = (item: Hittable) -> (
            this.head = HittableNode(item, this.head)
            this.size = this.size + 1
            this.bbox = AABB.enclose(this.bbox, item.boundingBox())
        )

        def clear = () -> (
            this.head = null
            this.size = 0
            this.bbox = AABB.empty
        )

        def headNode = () : HittableNode -> (
            this.head
        )

        def first = () : Hittable -> (
            if this.head == null then ( emptyHittable ) else ( this.head.item )
        )

        def second = () : Hittable -> (
            if this.head == null or this.head.next == null then (
                emptyHittable
            ) else (
                this.head.next.item
            )
        )

        def boundingBox = () : AABB -> (
            this.bbox
        )

        ;; Higher-order iteration over all hittables in the list
        def forEach = (fn: (item: Hittable) : dynamic) -> (
            def cur : HittableNode = this.head
            while cur != null then (
                fn(cur.item)
                cur = cur.next
            )
        )

        ;; Higher-order predicate counter using a closure over a mutable local
        def countWhere = (pred: (item: Hittable) : bool) : int -> (
            def matched : int = 0
            this.forEach((item: Hittable) -> (
                if pred(item) then (
                    matched = matched + 1
                )
            ))
            matched
        )

        def hit = (r: Ray, rayT: Interval) : HitRecord -> (
            def closestRecord : HitRecord = null
            def closestSoFar : double = rayT.max
            def cur : HittableNode = this.head
            while cur != null then (
                def tempRec : HitRecord = cur.item.hit(r, Interval(rayT.min, closestSoFar))
                if tempRec != null then (
                    closestSoFar = tempRec.t
                    closestRecord = tempRec
                )
                cur = cur.next
            )
            closestRecord
        )

        def kind = () : string -> ( "hittable_list" )
    )

    ;; Pure-Babble Bounding Volume Hierarchy (BVH) Node
    def BVHNode = class (def left: Hittable, def right: Hittable, def bbox: AABB) implements Hittable (
        def boundingBox = () : AABB -> (
            this.bbox
        )

        def hit = (r: Ray, rayT: Interval) : HitRecord -> (
            if not this.bbox.hit(r, rayT) then (
                return null
            )
            def hitLeft : HitRecord = this.left.hit(r, rayT)
            def rightT : Interval = if hitLeft != null then ( Interval(rayT.min, hitLeft.t) ) else ( rayT )
            def hitRight : HitRecord = this.right.hit(r, rightT)
            if hitRight != null then ( hitRight ) else ( hitLeft )
        )

        def kind = () : string -> ( "bvh_node" )
    )
    static (
        ;; Recursively partitions a HittableList into a balanced BVH tree
        def fromList = (list: HittableList) : Hittable -> (
            if list.size == 0 then (
                return emptyHittable
            )
            if list.size == 1 then (
                return list.first()
            )
            if list.size == 2 then (
                return this(list.first(), list.second(), list.boundingBox())
            )
            def box : AABB = list.boundingBox()
            def cbox : AABB = AABB.empty
            def cur : HittableNode = list.headNode()
            while cur != null then (
                cbox = cbox.expandPoint(cur.item.boundingBox().center())
                cur = cur.next
            )
            def axis : int = cbox.longestAxis()
            def splitVal : double = cbox.centroid(axis)

            def leftList : HittableList = HittableList()
            def rightList : HittableList = HittableList()
            cur = list.headNode()
            while cur != null then (
                def item : Hittable = cur.item
                if item.boundingBox().centroid(axis) < splitVal then (
                    leftList.add(item)
                ) else (
                    rightList.add(item)
                )
                cur = cur.next
            )

            ;; Fallback even/odd partition when all centroids coincide
            if leftList.size == 0 or rightList.size == 0 then (
                leftList.clear()
                rightList.clear()
                def goLeft : bool = true
                cur = list.headNode()
                while cur != null then (
                    if goLeft then (
                        leftList.add(cur.item)
                    ) else (
                        rightList.add(cur.item)
                    )
                    goLeft = not goLeft
                    cur = cur.next
                )
            )

            def leftChild : Hittable = recurse(leftList)
            def rightChild : Hittable = recurse(rightList)
            this(leftChild, rightChild, box)
        )
    )

    ;; ------------------------------------------------------------------------
    ;; 2.9 Color Conversion Object (Gamma 2.0 & PPM Formatting)
    ;; ------------------------------------------------------------------------
    def Color = object (
        def intensity : Interval = Interval(0.000, 0.999)

        def linearToGamma = (linearComponent: double) : double -> (
            if linearComponent > 0.0 then (
                math.sqrt(linearComponent)
            ) else (
                0.0
            )
        )

        def formatPpm = (pixelColor: Vec3) : string -> (
            def r : double = this.linearToGamma(pixelColor.x)
            def g : double = this.linearToGamma(pixelColor.y)
            def b : double = this.linearToGamma(pixelColor.z)
            def ir : int = math.toByte(256.0 * this.intensity.clamp(r))
            def ig : int = math.toByte(256.0 * this.intensity.clamp(g))
            def ib : int = math.toByte(256.0 * this.intensity.clamp(b))
            "" + ir + " " + ig + " " + ib
        )
    )

    ;; ------------------------------------------------------------------------
    ;; 2.10 Positionable Camera with Antialiasing & Defocus Blur (Depth of Field)
    ;; ------------------------------------------------------------------------
    def Camera = class (
        def aspectRatio: double = 16.0 / 9.0,
        def imageWidth: int = 400,
        def samplesPerPixel: int = 10,
        def maxDepth: int = 10,
        def vfov: double = 20.0,
        def lookfrom: Vec3 = Vec3(13.0, 2.0, 3.0),
        def lookat: Vec3 = Vec3(0.0, 0.0, 0.0),
        def vup: Vec3 = Vec3(0.0, 1.0, 0.0),
        def defocusAngle: double = 0.6,
        def focusDist: double = 10.0
    ) (
        def imageHeight : int = math.maxInt(1, math.toInt(this.imageWidth / this.aspectRatio))
        private def pixelSamplesScale : double = 1.0 / this.samplesPerPixel
        private def center : Vec3 = this.lookfrom

        ;; Viewport dimensions
        private def theta : double = math.degreesToRadians(this.vfov)
        private def h : double = math.tan(this.theta / 2.0)
        private def viewportHeight : double = 2.0 * this.h * this.focusDist
        private def viewportWidth : double = this.viewportHeight * (1.0 * this.imageWidth / this.imageHeight)

        ;; Orthonormal camera basis vectors (u, v, w)
        def w : Vec3 = this.lookfrom.minus(this.lookat).unit()
        def u : Vec3 = this.vup.cross(this.w).unit()
        def v : Vec3 = this.w.cross(this.u)

        ;; Viewport edge and pixel delta vectors
        private def viewportU : Vec3 = this.u.scale(this.viewportWidth)
        private def viewportV : Vec3 = this.v.neg().scale(this.viewportHeight)
        private def pixelDeltaU : Vec3 = this.viewportU.div(1.0 * this.imageWidth)
        private def pixelDeltaV : Vec3 = this.viewportV.div(1.0 * this.imageHeight)

        ;; Upper-left pixel location
        private def viewportUpperLeft : Vec3 = this.center.minus(this.w.scale(this.focusDist)).minus(this.viewportU.div(2.0)).minus(this.viewportV.div(2.0))
        def pixel00Loc : Vec3 = this.viewportUpperLeft.plus(this.pixelDeltaU.plus(this.pixelDeltaV).scale(0.5))

        ;; Defocus disk basis vectors
        private def defocusRadius : double = this.focusDist * math.tan(math.degreesToRadians(this.defocusAngle / 2.0))
        private def defocusDiskU : Vec3 = this.u.scale(this.defocusRadius)
        private def defocusDiskV : Vec3 = this.v.scale(this.defocusRadius)

        private def sampleSquare = (rng: Rng) : Vec3 -> (
            Vec3(rng.nextDouble() - 0.5, rng.nextDouble() - 0.5, 0.0)
        )

        private def defocusDiskSample = (rng: Rng) : Vec3 -> (
            def p : Vec3 = Vec3.randomInUnitDisk(rng)
            this.center.plus(this.defocusDiskU.scale(p.x)).plus(this.defocusDiskV.scale(p.y))
        )

        def getRay = (i: int, j: int, rng: Rng) : Ray -> (
            def offset : Vec3 = this.sampleSquare(rng)
            def pixelSample : Vec3 = this.pixel00Loc.plus(this.pixelDeltaU.scale(i + offset.x)).plus(this.pixelDeltaV.scale(j + offset.y))
            def rayOrigin : Vec3 = if this.defocusAngle <= 0.0 then (
                this.center
            ) else (
                this.defocusDiskSample(rng)
            )
            def rayDirection : Vec3 = pixelSample.minus(rayOrigin)
            Ray(rayOrigin, rayDirection)
        )

        ;; Recursive path tracer using Babble's "recurse" keyword
        def rayColor = (r: Ray, depth: int, world: Hittable, rng: Rng) : Vec3 -> (
            if depth <= 0 then (
                return Vec3.zero
            )
            def rec : HitRecord = world.hit(r, Interval(0.001, math.infinity))
            if rec != null then (
                def scatter : ScatterResult = rec.mat.scatter(r, rec, rng)
                if scatter != null then (
                    return scatter.attenuation.mul(recurse(scatter.scattered, depth - 1, world, rng))
                )
                return Vec3.zero
            )
            def unitDirection : Vec3 = r.dir.unit()
            def a : double = 0.5 * (unitDirection.y + 1.0)
            Vec3.one.scale(1.0 - a).plus(Vec3(0.5, 0.7, 1.0).scale(a))
        )

        def renderPixel = (i: int, j: int, world: Hittable, rng: Rng) : Vec3 -> (
            def pixelColor : Vec3 = Vec3.zero
            def sample : int = 0
            while sample < this.samplesPerPixel then (
                def r : Ray = this.getRay(i, j, rng)
                pixelColor = pixelColor.plus(this.rayColor(r, this.maxDepth, world, rng))
                sample = sample + 1
            )
            pixelColor.scale(this.pixelSamplesScale)
        )

        def render = (world: Hittable, rng: Rng = Rng(1337), out = STDOUT) -> (
            println("P3", to: out)
            println(this.imageWidth, " ", this.imageHeight, to: out)
            println(255, to: out)
            def j : int = 0
            while j < this.imageHeight then (
                def i : int = 0
                while i < this.imageWidth then (
                    def pixelColor : Vec3 = this.renderPixel(i, j, world, rng)
                    println(Color.formatPpm(pixelColor), to: out)
                    i = i + 1
                )
                j = j + 1
            )
        )
    )

    ;; ------------------------------------------------------------------------
    ;; 2.11 Scene Builders (Book 1 Chapter 13 Three-Spheres & Chapter 14 Final Scene)
    ;; ------------------------------------------------------------------------
    def Scenes = object (
        ;; Chapter 13: Hollow glass sphere + Lambertian center + Metal right
        def threeSpheres = () : HittableList -> (
            def world : HittableList = HittableList()
            def matGround : Material = Lambertian(Vec3(0.8, 0.8, 0.0))
            def matCenter : Material = Lambertian(Vec3(0.1, 0.2, 0.5))
            def matLeft : Material = Dielectric(1.50)
            def matBubble : Material = Dielectric(1.00 / 1.50)
            def matRight : Material = Metal(Vec3(0.8, 0.6, 0.2), 1.0)

            world.add(Sphere(Vec3(0.0, 0.0 - 100.5, 0.0 - 1.0), 100.0, matGround))
            world.add(Sphere(Vec3(0.0, 0.0, 0.0 - 1.2), 0.5, matCenter))
            world.add(Sphere(Vec3(0.0 - 1.0, 0.0, 0.0 - 1.0), 0.5, matLeft))
            world.add(Sphere(Vec3(0.0 - 1.0, 0.0, 0.0 - 1.0), 0.4, matBubble))
            world.add(Sphere(Vec3(1.0, 0.0, 0.0 - 1.0), 0.5, matRight))
            world
        )

        ;; Chapter 14: "Where Next?" Final Cover Scene
        def finalScene = (rng: Rng = Rng(42), gridRadius: int = 11) : HittableList -> (
            def world : HittableList = HittableList()

            def groundMaterial : Material = Lambertian(Vec3(0.5, 0.5, 0.5))
            world.add(Sphere(Vec3(0.0, 0.0 - 1000.0, 0.0), 1000.0, groundMaterial))

            def a : int = 0 - gridRadius
            while a < gridRadius then (
                def b : int = 0 - gridRadius
                while b < gridRadius then (
                    def chooseMat : double = rng.nextDouble()
                    def center : Vec3 = Vec3(
                        a + 0.9 * rng.nextDouble(),
                        0.2,
                        b + 0.9 * rng.nextDouble()
                    )

                    if center.minus(Vec3(4.0, 0.2, 0.0)).length() > 0.9 then (
                        if chooseMat < 0.8 then (
                            ;; Diffuse
                            def albedo : Vec3 = Vec3.random(rng).mul(Vec3.random(rng))
                            world.add(Sphere(center, 0.2, Lambertian(albedo)))
                        ) else (
                            if chooseMat < 0.95 then (
                                ;; Metal
                                def albedo : Vec3 = Vec3.randomRange(rng, 0.5, 1.0)
                                def fuzz : double = rng.nextRange(0.0, 0.5)
                                world.add(Sphere(center, 0.2, Metal(albedo, fuzz)))
                            ) else (
                                ;; Glass
                                world.add(Sphere(center, 0.2, Dielectric(1.5)))
                            )
                        )
                    )
                    b = b + 1
                )
                a = a + 1
            )

            def material1 : Material = Dielectric(1.5)
            world.add(Sphere(Vec3(0.0, 1.0, 0.0), 1.0, material1))

            def material2 : Material = Lambertian(Vec3(0.4, 0.2, 0.1))
            world.add(Sphere(Vec3(0.0 - 4.0, 1.0, 0.0), 1.0, material2))

            def material3 : Material = Metal(Vec3(0.7, 0.6, 0.5), 0.0)
            world.add(Sphere(Vec3(4.0, 1.0, 0.0), 1.0, material3))

            world
        )
    )
)

;; ============================================================================
;; 3. Self-Verification Suite (assert / suppose, value equality, is, classof, same)
;; ============================================================================
def runTests = () -> (
    ;; Math checks
    assert(math.abs(0.0 - 3.5) == 3.5, "abs failed")
    assert(math.min(2.0, 5.0) == 2.0 and math.max(2.0, 5.0) == 5.0, "min/max failed")
    assert(math.abs(math.sqrt(9.0) - 3.0) < 0.000000001, "sqrt(9) failed")
    assert(math.abs(math.sqrt(2.0) - 1.41421356237) < 0.00000001, "sqrt(2) failed")
    assert(math.powInt(2.0, 5) == 32.0, "powInt failed")
    assert(math.abs(math.sin(0.0)) < 0.000000001, "sin(0) failed")
    assert(math.abs(math.cos(0.0) - 1.0) < 0.000000001, "cos(0) failed")
    assert(math.abs(math.sin(math.halfPi) - 1.0) < 0.00000001, "sin(pi/2) failed")
    assert(math.toInt(225.8) == 225 and math.toInt(0.0 - 42.9) == 0 - 42, "toInt failed")
    assert(math.toByte(0.0) == 0 and math.toByte(128.4) == 128 and math.toByte(300.0) == 255, "toByte failed")

    ;; Value class semantics: structural ==, cross-number ==, identity via same(), classof()
    def Vec3 = raytracer.Vec3
    def v1 : raytracer.Vec3 = Vec3(1.0, 2.0, 3.0)
    def v2 : raytracer.Vec3 = Vec3(1, 2, 3)
    assert(v1 == v2, "value class equality failed")
    assert(not same(v1, v2), "same() should be false for distinct value instances")
    assert(v1 is Vec3 and classof(v1) == Vec3, "is / classof failed on Vec3")
    assert(v1.plus(Vec3(4.0, 5.0, 6.0)) == Vec3(5.0, 7.0, 9.0), "Vec3.plus failed")
    assert(v1.dot(Vec3(4.0, 5.0, 6.0)) == 32.0, "Vec3.dot failed")
    assert(Vec3(1.0, 0.0, 0.0).cross(Vec3(0.0, 1.0, 0.0)) == Vec3(0.0, 0.0, 1.0), "Vec3.cross failed")
    assert(Vec3(3.0, 4.0, 0.0).length() == 5.0, "Vec3.length failed")

    ;; Reflection and refraction
    def normal : raytracer.Vec3 = Vec3(0.0, 1.0, 0.0)
    assert(Vec3(1.0, 0.0 - 1.0, 0.0).reflect(normal) == Vec3(1.0, 1.0, 0.0), "Vec3.reflect failed")

    ;; Ray, Interval, Sphere, HittableList, BVHNode, and Materials
    def r : raytracer.Ray = raytracer.Ray(Vec3(0.0, 0.0, 0.0), Vec3(0.0, 0.0, 0.0 - 1.0))
    def mat : raytracer.Material = raytracer.Lambertian(Vec3(0.8, 0.3, 0.3))
    def s : raytracer.Sphere = raytracer.Sphere(Vec3(0.0, 0.0, 0.0 - 1.0), 0.5, mat)
    assert(s is raytracer.Hittable and s is raytracer.Describable, "Sphere interface conformance failed")
    assert(s.describe() == "<sphere>(r=0.5)", "super(Hittable).describe() failed")
    assert(mat.describe() == "<lambertian>(Vec3(x: 0.8, y: 0.3, z: 0.3))", "super.describe() failed")

    def hit : raytracer.HitRecord = s.hit(r, raytracer.Interval(0.001, math.infinity))
    assert(hit != null and hit.frontFace, "Sphere hit failed")
    assert(math.abs(hit.t - 0.5) < 0.00000001, "Sphere hit t failed")
    assert(hit.p == Vec3(0.0, 0.0, 0.0 - 0.5), "Sphere hit point failed")
    assert(hit.normal == Vec3(0.0, 0.0, 1.0), "Sphere outward normal failed")

    ;; Verify Material scattering (Lambertian, Metal, Dielectric) and HittableList / BVHNode parity
    def rng : raytracer.Rng = raytracer.Rng(99)
    def scatterDiff : raytracer.ScatterResult = mat.scatter(r, hit, rng)
    assert(scatterDiff != null and scatterDiff.attenuation == Vec3(0.8, 0.3, 0.3), "Lambertian scatter failed")
    def metalMat : raytracer.Material = raytracer.Metal(Vec3(0.7, 0.6, 0.5), 0.1)
    def scatterMetal : raytracer.ScatterResult = metalMat.scatter(r, hit, rng)
    assert(scatterMetal != null and scatterMetal.attenuation == Vec3(0.7, 0.6, 0.5), "Metal scatter failed")
    def glassMat : raytracer.Material = raytracer.Dielectric(1.5)
    def scatterGlass : raytracer.ScatterResult = glassMat.scatter(r, hit, rng)
    assert(scatterGlass != null and scatterGlass.attenuation == Vec3.one, "Dielectric scatter failed")

    def list : raytracer.HittableList = raytracer.Scenes.threeSpheres()
    assert(list.size == 5, "threeSpheres size failed")
    assert(list.countWhere((h: raytracer.Hittable) : bool -> ( h is raytracer.Sphere )) == 5, "countWhere failed")
    def bvh : raytracer.Hittable = raytracer.BVHNode.fromList(list)
    def hitList : raytracer.HitRecord = list.hit(r, raytracer.Interval(0.001, math.infinity))
    def hitBvh : raytracer.HitRecord = bvh.hit(r, raytracer.Interval(0.001, math.infinity))
    assert(hitList == hitBvh, "BVH and HittableList diverged")

    ;; Verify Color gamma encoding
    assert(raytracer.Color.formatPpm(Vec3(0.0, 0.25, 1.0)) == "0 128 255", "Color.formatPpm failed")

    ;; Verify full Scene + Camera raytracing with named parameters
    def worldList : raytracer.HittableList = raytracer.Scenes.finalScene(rng: raytracer.Rng(7), gridRadius: 2)
    def world : raytracer.Hittable = raytracer.BVHNode.fromList(worldList)
    def cam : raytracer.Camera = raytracer.Camera(
        aspectRatio: 16.0 / 9.0,
        imageWidth: 32,
        samplesPerPixel: 4,
        maxDepth: 8
    )
    assert(cam.imageHeight == 18, "Camera aspect ratio height calculation failed")
    def centerPixel : raytracer.Vec3 = cam.renderPixel(16, 9, world, raytracer.Rng(123))
    assert(centerPixel.x >= 0.0 and centerPixel.y >= 0.0 and centerPixel.z >= 0.0, "Invalid pixel color")
)

runTests()

;; ============================================================================
;; 4. Render the Final Scene in PPM Format to STDOUT
;; ============================================================================
def renderMain = () -> (
    def rng : raytracer.Rng = raytracer.Rng(2026)
    def worldList : raytracer.HittableList = raytracer.Scenes.finalScene(rng: rng, gridRadius: 11)
    def world : raytracer.Hittable = raytracer.BVHNode.fromList(worldList)
    def camera : raytracer.Camera = raytracer.Camera(
        aspectRatio: 16.0 / 9.0,
        imageWidth: 400,
        samplesPerPixel: 20,
        maxDepth: 12,
        vfov: 20.0,
        lookfrom: raytracer.Vec3(13.0, 2.0, 3.0),
        lookat: raytracer.Vec3(0.0, 0.0, 0.0),
        vup: raytracer.Vec3(0.0, 1.0, 0.0),
        defocusAngle: 0.6,
        focusDist: 10.0
    )
    camera.render(world, rng)
)

renderMain()
