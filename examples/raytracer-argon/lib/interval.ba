def math = import("math.ba")

;; ------------------------------------------------------------------------
;; 2.4 Interval Value Class
;; ------------------------------------------------------------------------
export def Interval = record (min: double, max: double) (
    def size = fn pure deterministic nothrow borrow (): double -> (
        this.max - this.min
    )

    def midpoint = fn pure deterministic nothrow borrow (): double -> (
        0.5 * (this.min + this.max)
    )

    def contains = fn pure deterministic nothrow borrow (x: double): bool -> (
        this.min <= x and x <= this.max
    )

    def surrounds = fn pure deterministic nothrow borrow (x: double): bool -> (
        this.min < x and x < this.max
    )

    def clamp = fn pure deterministic nothrow borrow (x: double): double -> (
        if x < this.min then (
            this.min
        ) else if x > this.max then (this.max) else (x)
    )

    def expand = fn pure deterministic nothrow borrow (delta: double): Interval -> (
        def padding: double = delta / 2.0
        Interval(this.min - padding, this.max + padding)
    )
) static (
    def empty: Interval = this(math.infinity, math.negInfinity)
    def universe: Interval = this(math.negInfinity, math.infinity)

    def enclose = fn pure deterministic nothrow (borrow a: Interval, borrow b: Interval): Interval -> (
        this(math.min(a.min, b.min), math.max(a.max, b.max))
    )
)
