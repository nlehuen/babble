def Rng = import("rng.ba").Rng
def Vec3 = import("vec3.ba").Vec3
def Ray = import("ray.ba").Ray
def Interval = import("interval.ba").Interval
def AABB = import("aabb.ba").AABB

;; ------------------------------------------------------------------------
;; 2.6 Interfaces, HitRecord, and ScatterResult
;; Showcases Babble interfaces, extends, default methods, and super calls.
;; ------------------------------------------------------------------------
export def Describable = interface (
    def kind: fn pure deterministic nothrow borrow (): string
    def describe = fn pure deterministic nothrow borrow (): string -> (
        "<" + this.kind() + ">"
    )
)

export def ScatterResult = record (attenuation: Vec3, scattered: Ray) ()

export def Material = interface extends Describable (
    def scatter: fn hermetic deterministic nothrow borrow (borrow rIn: Ray, borrow rec: HitRecord, mut borrow rng: Rng): ScatterResult?
    def kind = fn pure deterministic nothrow borrow (): string -> ("material")
)

export def HitRecord = record (
    p: Vec3,
    normal: Vec3,
    mat: Material,
    t: double,
    frontFace: bool
) () static (
    def create = fn pure deterministic nothrow (borrow r: Ray, p: Vec3, outwardNormal: Vec3, t: double, mat: Material): HitRecord -> (
        def frontFace: bool = r.dir.dot(outwardNormal) < 0.0
        def normal: Vec3 = if frontFace then (outwardNormal) else (-outwardNormal)
        this(p, normal, mat, t, frontFace)
    )
)

export def Hittable = interface extends Describable (
    def hit: fn pure deterministic nothrow (borrow r: Ray, borrow rayT: Interval): HitRecord?
    def boundingBox = fn pure deterministic nothrow borrow (): AABB -> (AABB.empty)
    def kind = fn pure deterministic nothrow borrow (): string -> ("hittable")
)

;; Object literal implementing a Babble interface
export def emptyHittable = object implements Hittable (
    def hit = fn pure deterministic nothrow borrow (borrow r: Ray, borrow rayT: Interval): HitRecord? -> (null)
    def boundingBox = fn pure deterministic nothrow borrow (): AABB -> (AABB.empty)
    def kind = fn pure deterministic nothrow borrow (): string -> ("empty")
)
