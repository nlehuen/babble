def Rng = import("rng.ba").Rng
def Vec3 = import("vec3.ba").Vec3
def Dielectric = import("materials.ba").Dielectric
def HittableList = import("hittables.ba").HittableList
def Lambertian = import("materials.ba").Lambertian
def Metal = import("materials.ba").Metal
def Sphere = import("hittables.ba").Sphere

;; ------------------------------------------------------------------------
;; 2.11 Scene Builders (Book 1 Chapter 13 Three-Spheres & Chapter 14 Final Scene)
;; ------------------------------------------------------------------------
export def Scenes = object (
    ;; Chapter 13: Hollow glass sphere + Lambertian center + Metal right
    def threeSpheres = fn pure deterministic nothrow borrow (): unique HittableList -> (
        def world: HittableList = HittableList()
        world.add(Sphere(Vec3(0.0, -100.5, -1.0), 100.0, Lambertian(Vec3(0.8, 0.8, 0.0))))
        world.add(Sphere(Vec3(0.0, 0.0, -1.2), 0.5, Lambertian(Vec3(0.1, 0.2, 0.5))))
        world.add(Sphere(Vec3(-1.0, 0.0, -1.0), 0.5, Dielectric(1.50)))
        world.add(Sphere(Vec3(-1.0, 0.0, -1.0), 0.4, Dielectric(1.00 / 1.50)))
        world.add(Sphere(Vec3(1.0, 0.0, -1.0), 0.5, Metal(Vec3(0.8, 0.6, 0.2), 1.0)))
        world
    )

    ;; Chapter 14: "Where Next?" Final Cover Scene
    def finalScene = fn hermetic deterministic nothrow borrow (mut borrow rng: Rng = Rng(42), gridRadius: int = 11): unique HittableList -> (
        def world: HittableList = HittableList()

        world.add(Sphere(Vec3(0.0, -1000.0, 0.0), 1000.0, Lambertian(Vec3(0.5, 0.5, 0.5))))

        def a: int = -gridRadius
        while a < gridRadius then (
            def b: int = -gridRadius
            while b < gridRadius then (
                def chooseMat: double = rng.nextDouble()
                def center: Vec3 = Vec3(
                    a + 0.9 * rng.nextDouble(),
                    0.2,
                    b + 0.9 * rng.nextDouble()
                )

                if (center - Vec3(4.0, 0.2, 0.0)).length() > 0.9 then (
                    if chooseMat < 0.8 then (
                        ;; Diffuse
                        def albedo: Vec3 = Vec3.random(rng).mul(Vec3.random(rng))
                        world.add(Sphere(center, 0.2, Lambertian(albedo)))
                    ) else if chooseMat < 0.95 then (
                        ;; Metal
                        def albedo: Vec3 = Vec3.randomRange(rng, 0.5, 1.0)
                        def fuzz: double = rng.nextRange(0.0, 0.5)
                        world.add(Sphere(center, 0.2, Metal(albedo, fuzz)))
                    ) else (
                        ;; Glass
                        world.add(Sphere(center, 0.2, Dielectric(1.5)))
                    )
                )
                b += 1
            )
            a += 1
        )

        world.add(Sphere(Vec3(0.0, 1.0, 0.0), 1.0, Dielectric(1.5)))
        world.add(Sphere(Vec3(-4.0, 1.0, 0.0), 1.0, Lambertian(Vec3(0.4, 0.2, 0.1))))
        world.add(Sphere(Vec3(4.0, 1.0, 0.0), 1.0, Metal(Vec3(0.7, 0.6, 0.5), 0.0)))

        world
    )
)
