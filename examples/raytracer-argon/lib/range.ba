;; ------------------------------------------------------------------------
;; 2.0 Integer Ranges for `for` Loops (no java.util, no java.util.stream.IntStream)
;; A Babble iterable : Range has iterator(), its RangeCursor has hasNext() and next(),
;; which `for i in Range(0, n) then (...)` calls unboxed (BIP013).
;; ------------------------------------------------------------------------
export def RangeCursor = class (private def cur: int, private def stop: int) (
    def hasNext = fn (): bool -> (
        this.cur < this.stop
    )

    def next = fn mut (): int -> (
        def value: int = this.cur
        this.cur += 1
        value
    )
)

;; The ints from start (included) to stop (excluded)
export def Range = record (start: int, stop: int) (
    def iterator = fn (): RangeCursor -> (
        RangeCursor(this.start, this.stop)
    )
)
