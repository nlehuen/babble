def math = import("math.ba")
def Vec3 = import("vec3.ba").Vec3
def Ray = import("ray.ba").Ray
def Interval = import("interval.ba").Interval
def AABB = import("aabb.ba").AABB
def Describable = import("interfaces.ba").Describable
def HitRecord = import("interfaces.ba").HitRecord
def Hittable = import("interfaces.ba").Hittable
def Material = import("interfaces.ba").Material
def emptyHittable = import("interfaces.ba").emptyHittable

;; ------------------------------------------------------------------------
;; 2.8 Sphere & Pure-Babble HittableList + BVHNode
;; ------------------------------------------------------------------------
export def Sphere = class (def center: Vec3, def radius: double, def mat: Material) implements Hittable, Describable (
    private def radiusSq: double
    private def invRadius: double
    private def bbox: AABB

    init (
        this.radiusSq = this.radius * this.radius
        this.invRadius = 1.0 / this.radius
        def rAbs: double = math.abs(this.radius)
        def rVec: Vec3 = Vec3(rAbs, rAbs, rAbs)
        this.bbox = AABB.fromPoints(this.center - rVec, this.center + rVec)
    )

    def boundingBox = fn (): AABB -> (
        this.bbox
    )

    def hit = fn (r: Ray, rayT: Interval): HitRecord? -> (
        def oc: Vec3 = this.center - r.origin
        def a: double = r.dir.lengthSquared()
        def h: double = r.dir.dot(oc)
        def c: double = oc.lengthSquared() - this.radiusSq
        def discriminant: double = h * h - a * c
        if discriminant < 0.0 then (
            return null
        )
        def sqrtd: double = math.sqrt(discriminant)
        var root: double = (h - sqrtd) / a
        if not rayT.surrounds(root) then (
            root = (h + sqrtd) / a
            if not rayT.surrounds(root) then (
                return null
            )
        )
        def p: Vec3 = r.at(root)
        def outwardNormal: Vec3 = (p - this.center) * this.invRadius
        HitRecord.create(r, p, outwardNormal, root, this.mat)
    )

    def kind = fn (): string -> ("sphere")

    def describe = fn (): string -> (
        super(Hittable).describe() + "(r=" + this.radius + ")"
    )
)

export def HittableList = class () implements Hittable (
    private def items: list of Hittable = list()
    private var bbox: AABB = AABB.empty

    def size = fn (): int -> (
        this.items.size()
    )

    def add = fn mut (shared item: Hittable) -> (
        this.items.add(item)
        this.bbox = AABB.enclose(this.bbox, item.boundingBox())
    )

    def get = fn (index: int): Hittable -> (
        this.items.get(index)
    )

    ;; A copy of the hittables, in the order they were added
    def toList = fn (): list of Hittable -> (
        list(from: this.items)
    )

    ;; Iterable : `for item in list then (...)`
    def iterator = fn () -> (
        this.items.iterator()
    )

    def boundingBox = fn (): AABB -> (
        this.bbox
    )

    ;; Higher-order iteration over all hittables in the list
    def forEach = fn calling f (f: fn (item: Hittable): any?) -> (
        for item in this.items then (
            f(item)
        )
    )

    ;; Higher-order predicate counter using a closure over a mutable local
    def countWhere = fn calling pred (pred: fn (item: Hittable): bool): int -> (
        var matched: int = 0
        this.forEach(fn (item: Hittable) -> (
            if pred(item) then (
                matched += 1
            )
        ))
        matched
    )

    def hit = fn (r: Ray, rayT: Interval): HitRecord? -> (
        var closestRecord: HitRecord? = null
        var closestSoFar: double = rayT.max
        for item in this.items then (
            def tempRec: HitRecord? = item.hit(r, Interval(rayT.min, closestSoFar))
            if tempRec != null then (
                closestSoFar = tempRec.t
                closestRecord = tempRec
            )
        )
        closestRecord
    )

    def kind = fn (): string -> ("hittable_list")
)

;; Pure-Babble Bounding Volume Hierarchy (BVH) Node
export def BVHNode = class (def left: Hittable, def right: Hittable, def bbox: AABB) implements Hittable (
    def boundingBox = fn (): AABB -> (
        this.bbox
    )

    def hit = fn (r: Ray, rayT: Interval): HitRecord? -> (
        if not this.bbox.hit(r, rayT) then (
            return null
        )
        def hitLeft: HitRecord? = this.left.hit(r, rayT)
        def rightT: Interval = if hitLeft != null then (Interval(rayT.min, hitLeft.t)) else (rayT)
        def hitRight: HitRecord? = this.right.hit(r, rightT)
        if hitRight != null then (hitRight) else (hitLeft)
    )

    def kind = fn (): string -> ("bvh_node")
) static (
    def fromList = fn (shared items: HittableList): Hittable -> (
        this.build(items.toList())
    )

    ;; Recursively partitions hittables into a balanced BVH tree
    def build = fn (shared items: list of Hittable): Hittable -> (
        if items.size() == 0 then (
            return emptyHittable
        )
        if items.size() == 1 then (
            return items.get(0)
        )
        var box: AABB = AABB.empty
        var cbox: AABB = AABB.empty
        for item in items then (
            box = AABB.enclose(box, item.boundingBox())
            cbox = cbox.expandPoint(item.boundingBox().center())
        )
        if items.size() == 2 then (
            return this(items.get(0), items.get(1), box)
        )
        def axis: int = cbox.longestAxis()
        def splitVal: double = cbox.centroid(axis)

        def left: list of Hittable = list()
        def right: list of Hittable = list()
        for item in items then (
            if item.boundingBox().centroid(axis) < splitVal then (
                left.add(item)
            ) else (
                right.add(item)
            )
        )

        ;; Fallback even/odd partition when all centroids coincide
        if left.size() == 0 or right.size() == 0 then (
            left.clear()
            right.clear()
            var goLeft: bool = true
            for item in items then (
                if goLeft then (
                    left.add(item)
                ) else (
                    right.add(item)
                )
                goLeft = not goLeft
            )
        )

        this(recurse(left), recurse(right), box)
    )
)
